        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#burgio-liber-qui-vulgari-hominum-dicitur-elmeliole'>Liber qui vulgari hominum dicitur Elmeliole 2015</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#burgio-mascherpa-milione-latino'>BURGIO-MASCHERPA 2007</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 471-474. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/manuscript/venezia-museo-civico-correr-cicogna-2408-(2389)-manoscript/2658 </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, p. 39. </li>" ;
