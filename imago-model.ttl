        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/dlDisplay.do?docId=IAMS040-001614736&vid=IAMS_VU2&indx=1&dym=false&dscnt=1&onCampus=false&group=ALL&institution=BL&ct=search&vl(freeText0)=040-001614736&submit=search" ;
        :last_mod_form         "2024-01-26T09:57:37.686Z"^^xsd:dateTime .

