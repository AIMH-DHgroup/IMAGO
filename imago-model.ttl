<https://imagoarchive.it/ontology/resources/manuscript/firenze/bibliotecamedicealaurenziana/pluteo_lxxvi_50/33r183v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-25> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo, ff. I+186, luogo di copia: Firenze. Contiene anche: Poggio Bracciolini, De varietate fortunae (ff. 1r-33r). Note marginali di Barlomeo Fonzio che emenda il testo della Roma instaurata sulla base della princeps; si rilevano anche note di Iacopo di Poggio Bracciolini. Possessore del codice fu Francesco Sassetti (1421-1490). Al f. 33r si segnala la confusione tra Roma instaurata e l'Italia illustrata." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-25> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q856419> ;
        :compiled_form         "Elena Vagnoni" ;
