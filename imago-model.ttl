<https://imagoarchive.it/ontology/resources/manuscript/sanktpaulimlavanttal/bibliothekdesbenediktinerstifts/81/3_(25.4.34)/1r341v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-494> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 431 ff. e misura 205x140 mm. Al f.1r si legge: Dominus Albertus Gros Canonicus hunc libellum pro liberaria huius collegii donavit cuius anima vivat 91. Il codice proviene dalla collegiata di Spital am Phyrn. Le note marginali si fondono con il capitolo \"De cibo et potu\" del IV libro e si interrompono nuovamente nel capitolo \"De ore\" del V libro. Dopo il loro nuovo inizio nel libro VIII, si mantengono fino al capitolo \"De monte\" del libro XIV; nel libro XVI sono presenti dal capitolo \"De gemma\" in poi, nei libri XVII-XIX ricorrono irregolarmente. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-494> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q123423410> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li><li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 107-108. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/sankt-paul-im-lavanttal-bibliothek-des-benediktine-manoscript/139379" ;
        :last_mod_form         "2023-04-01T20:36:07.24Z"^^xsd:dateTime .

