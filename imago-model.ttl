<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_2321/104r115r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1532> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 186 ff. e misura 155x105/110 mm. Il codice trasmette un trattato sulle indulgenze, ff. 1r-15v; un sermone e un trattato in medio-inglese, ff. 17r-63v; Menardo, Generalis et compendiosa librorum Bibliae notitia, ff. 65r-88v; Martin Polono, Chronicon, ff. 89r-97v; Stationes ecclesiarum urbis Romae, ff. 101v-104v; Indulgentiae ecclesiarum urbis Romae, ff. 104r-115r; Mirabilia urbis Romae, ff. 115r-118v; Gregorio Magno, De cura pastoralis, ff. 123v-130v; una raccolta di trattati latini, uno sulla posizione dei santi, descrizioni di Cristo e della Vergine Maria, la genealogia di sant'Anna, Mirabilia Anglie, Hibernie et Orientalis, John de Foxton, Liber Cosmographiae, ff. 139r-144v, poesie latine, Speculum Monachorum, ff. 175r-183r. Il manoscritto fu redatto da uno scriba inglese con il nome che iniziava per \"G\", come si legge al f. 84v: \"Deo gracias quod G\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1532> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 47. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002048152&indx=1&recIds=IAMS040-002048152&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Harley%202321&dum=true&dstmp=1678910115129" ;
        :last_mod_form         "2024-04-05T15:15:27.866Z"^^xsd:dateTime .

