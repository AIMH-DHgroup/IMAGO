<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/royal_13_c_xii/110143>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-318> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 146 ff. Il codice trasmette l'Historia Troiana di Guido delle Colonne, l'Historia de Preliis e il Flos Historiarum. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-318> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
