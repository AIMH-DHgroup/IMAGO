<https://imagoarchive.it/ontology/resources/manuscript/roma/bibliotecavallicelliana/b_51/97r116r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1624> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice è formato da II, 155 ff. ed è composto da tre diverse unità codicologiche. La prima unità, risalente al XIV secolo, trasmette i Notabilia extracta de libro moralium beati Gregorii, ff. 1r-43v. La seconda unità,  del XIV secolo, trasmette le Confessioni di Agostino, ff. 44r-96v. La terza unità, ff. 97r-155r, trasmette la Descriptio Lateranensis ecclesiae nella terza redazione, ff. 97r-116r; Primo ordus Romanus, ff. 117r-121v; De haeresibus ad Quovultdeum, ff. 122r-138v; Libri ad Constantium imperatorem, ff. 138v-143r; Contra Arianos, vel Auxentium Mediolanensem, ff. 143r-145v; Contra Constantium imperatorem liber unus, ff. 145v-151v. Ai ff. 1r e 44r doppio bollo che attesta l'appartenenza del codice all'originario fondo manoscritto vallicelliano. Sicuramente il codice era presente in biblioteca nei primi anni del sec. XVII essendo censito nel più antico catalogo dei manoscritti vallicelliani, elaborato probabilmente da Fabiano Giustiniani nel periodo in cui fu preposito della biblioteca (1605-1617) e trascritto in redazione originale nel ms. P 185." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1624> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2901320> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 43v disegno a penna di un personaggio intento a copiare, forse Gregorio Magno. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#vogel-la-descriptio-ecclesiae-lateranensis-du-diacre-jean'>VOGEL 1956</a>, pp. 193-203. </li><li><a href='https://imagoarchive.it/bibliografia.html#codice-topografico-della-citta-di-roma'>VALENTINI-ZUCCHETTI 1940-1953</a>, III, pp. 319-325. </li><li><a href='https://imagoarchive.it/bibliografia.html#oftestad-the-lateran-church'>OFTESTAD 2019</a>, pp. 193-203. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/cnmd/0000016464" ;
        :last_mod_form         "2024-02-22T21:31:40.305Z"^^xsd:dateTime .

