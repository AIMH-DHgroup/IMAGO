<https://imagoarchive.it/ontology/resources/print_edition/pe-105>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Descriptio insule Crete" ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "La \"Περιγραφή της νήσου Kρήτης\" è la traduzione in greco moderno della \"Descriptio insule Crete\" a opera di Martha Aposkìte con un’introduzione di Stylianos Alexìou, pubblicata a Candia nel 1983 dalla stessa casa editrice che due anni prima pubblicò il volume di Van Spitael, la Σύλλογος Πολιτιστικής Ανάπτυξης Ηρακλείου (Association for the Cultural Development of Heraklion). La traduzione, inserita all’interno del volume dal titolo Ἓνας γῦρος τῆς Κρήτης στά 1415, segue il testo stabilito da Van Spitael. Il frontespizio riporta il nome dell'autore traslitterato nell'alfabeto greco, in caso genitivo: Xριστόφορου Mπουοντελμόντι." ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/descriptio-insulae-cretae-title/4834> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-105> ;
        :compiled_form              "Alessio Luca Bartelloni" ;
        :has_ecdotic_type           <https://imagoarchive.it/ontology/resources/print_edition/edition/edizione_commentata_con_traduzione> ;
        :has_figure_note            "Contiene mappe geografiche." ;
        :has_introduction_note      "" ;
        :has_other_contents         "" ;
        :has_primary_source         "CRISTOFORO BUONDELMONTI, Descriptio 1981" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#buondelmonti-descriptio-1983'>BUONDELMONTI, Descriptio 1983</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#bartelloni-al-descriptio-insule-crete'>BUONDELMONTI, Descriptio (tesi di laurea) 2022</a>, p. 48 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Cristoforo Buondelmonti" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-105> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-105> ;
        :last_mod_form              "2024-01-28T18:25:44.96Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/leipzig/universittsbibliothek/ms._1570/1r24v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2135> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 24, II ff. e misura 260x210 mm. Il codice trasmette il libro I, 1 e il libro III. Il codice riporta inoltre il De statu interioris di Riccardo da San Vittore, f. 24v. Al f. 24v sul margine inferiore con mano del XVI secolo si legge: \"scriptum per me Henricum Baninganno MCLIII et completum est in vigilia s. Martini\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2135> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q872896> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali istoriate: al f. 1r iniziale S con animale su campo blu, colori opachi con oro; f. 24v iniziale O su campo blu e rosso. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "https://digital.ub.uni-leipzig.de/mirador/index.php" ;
        :has_url_manuscript_description
                "http://www.manuscripta-mediaevalia.de/dokumente/html/obj31569421" ;
        :last_mod_form         "2024-04-02T09:02:03.122Z"^^xsd:dateTime .

