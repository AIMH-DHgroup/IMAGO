                <https://imagoarchive.it/ontology/resources/signature/ms-1451> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 202 ff. e misura 290x200 mm. Il codice trasmette inoltre: Eusebio di Cesarea, Chronicon, ff. 1r-75r; Grammatica hebraica, ff. 84r-89r; Mirabilia urbis Romae, ff. 90v-98v; Notabile historicum de imperatoribus Romanis usque ad Sigismundum, f. 98v; Matthäus Hagen, Chronicon Austriae, ff. 99r-103r; Notabilia et excerpta ex Historia potissimum Romana et Graeca, ff. 105r-109v; De abbreviaturis, ff. 11r-113v; Buonaccorsi de Monte Magno, Ad principem Guidantonium, ff. 114r-119v; Darete Frigio, Historia Troiana, ff. 120r-132v; Iohannes, Dictamen epistolare, ff. 133r-150v; Vaticinium Sibyllae Erythreae et Babylonicae, ff. 151r-153v; Versus ex Ovidii libris Metamorphoseon, f. 153v; Liber poeticae, ff. 154r-181r; Girolamo Valli, Iesuida, ff. 181v-191v, Almadel, Liber intelligentiarum, ff. 192r-202r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1451> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 90. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-04-08T09:05:57.379Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._16331/163v170v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
