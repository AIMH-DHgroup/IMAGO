<https://imagoarchive.it/ontology/resources/manuscript/anversantwerpen/museumplantinmoretusbibliotheek/m_49/2r42v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Mafeii Vegii Laudensis. De rebus antiquis memorabilibus S. Petri Romae" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1467> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da IV, 43, III ff. e misura 320x220 mm. Il codice, esemplato a Roma, è vergato in corsiva con tratti goticheggianti. Al f. 1r, carta di guardia di colore blu, si legge il titolo dell'opera: \"Mafeii Vegii Laudensis. De rebus antiquis memorabilibus S. Petri Romae\" e la nota di possesso \"Est Henrici Ziberti Dunghen canonici Anteverpiensis protonotarii d.n. papae ex Roma allatum hoc opus\", che individua come possessore il canonico della cattedrale di Anversa Hendrik Sebert van Den Dungen (1511-1596), committente del codice. Allo stesso Sebert è probabile che si debba attribuire la serie di annotazioni depositate ai margini del testo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1467> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q106557286> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#della-schiava-il-de-rebus-antiquis-memorabilibus'>DELLA SCHIAVA 2011</a>, p. 172. </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, III, p. 77. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rebus-antiquis-memorabilibus-basilicae-sancti-p-title/9870 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/antwerpen-anvers-musaeum-plantin-moretus-m-49-(den-manoscript/182468" ;
        :last_mod_form         "2024-01-29T10:49:06.944Z"^^xsd:dateTime .

