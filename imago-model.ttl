                "https://manus.iccu.sbn.it/risultati-ricerca-manoscritti/-/manus-search/detail/599687?struct%3A5003=ricerca.parole_tutte%3A4%3D6&struct%3A5005=ricerca.parole_tutte%3A4%3D6&struct%3A5004=ricerca.parole_tutte%3A4%3D6&struct%3A5091=ricerca.parole_tutte%3A4%3D6&struct%3A1016=ricerca.parole_tutte%3A4%3D6&fieldstruct%5B0%5D=ricerca.parole_tutte%3A4%3D6&fieldaccess%5B0%5D=nome_t%3A1003&struct%3A4=ricerca.parole_tutte%3A4%3D6&struct%3A4091=ricerca.parole_tutte%3A4%3D6&struct%3A9041=ricerca.parole_tutte%3A4%3D6&struct%3A3041=ricerca.parole_tutte%3A4%3D6&struct%3A5041=ricerca.parole_tutte%3A4%3D6&&item:3091:segnature=110&struct:3091=ricerca.frase:4=1&item%3A4088%3Afondi%5B%5D=Biblioteca+regionale+universitaria+Giacomo+Longo%7C%7C%7CIT-ME0050%7C%7C%7CMessina%7C%7C%7CFondo+Vecchio&struct:4088=ricerca.frase:4=1" ;
