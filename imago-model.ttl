<https://imagoarchive.it/ontology/resources/manuscript/rouen/bibliothquejacquesvillon/u._102_(1393)/178rv195r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1072> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 203 ff. e misura 290x204 mm con il testo disposto su due colonne. Il codice è una raccolta di testi agiografici. L'ex libris del monastero di Saint-Pierre a Jumièges si legge al f. 2r: \"Ex monasterio Gemmeticensis Congregationis S.Mauri\". I contenuti hanno una caratterizzazione geografica nettamente anglonormanna, celebrando le figure di Anselmo di Canterbury e Erluino, fondatore dell'abbazia di Bec. Il testo della Navigatio è accompagnato da un ricco paratesto con sommari a margine e titoli rubricati che segnano l'inizio dei capitoli. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1072> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q18573998> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il manoscritto è decorato e alcuni fogli sono consultabili al link: https://bvmm.irht.cnrs.fr//resultRecherche/resultRecherche.php?COMPOSITION_ID=9758" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 93-94. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/rouen-bibliothèque-jacques-villon-(olim-bibliothèq-manoscript/17017" ;
        :last_mod_form         "2024-02-02T17:41:53.149Z"^^xsd:dateTime .

