<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/add._15219/3r11r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-703> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto, in pergamena, consta di 93 ff. e misura 230x 155 mm. Proveniente dall'abbazia benedettina di San Martino a Tournai, come riportato ai ff. 2r e 93v, è rimasto lì fino allo scioglimento dell'abbazia nel 1796 da parte delle Forze Rivoluzionarie francesi. Il codice trasmette: Itinerarium Antonini Placentini, nella recensio altera, ff. 3r-11r; Beda il Venerabile, De locis sanctis, ff. 12v-19v; Glosse a testi biblici, ff. 20r-54v; Interpretatio Nominum Graecorum, ff. 55r-74r; Interpretatio Nominum Hebraeorum, ff. 72r-92r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-703> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 11v disegno di un gruppo di uomini e donne a cavallo, al f. 12 r disegno di San Martino di Tours che taglia il mantello per un mendicante, f. 14r raffigurazione della colonna su cui fu flagellato Cristo. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/itinerarium-antonini-placentini-title/173200 </li><li><a href='https://imagoarchive.it/bibliografia.html#milani-1974'>MILANI 1974</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#httpswwwbedadlsgwiuni-muenchendeabout'>BEDA VENERABILIS, De locis sanctis </a>,  </li>" ;
        :has_url_manuscript    "https://www.bl.uk/manuscripts/FullDisplay.aspx?ref=Add_MS_15219" ;
        :has_url_manuscript_description
                "https://www.bl.uk/manuscripts/FullDisplay.aspx?ref=Add_MS_15219" ;
        :last_mod_form         "2024-04-09T08:17:29.587Z"^^xsd:dateTime .

