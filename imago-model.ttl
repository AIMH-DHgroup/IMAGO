<https://imagoarchive.it/ontology/resources/manuscript/madrid/bibliotecanacionaldeespaa/res._36/48r63v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1296> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da IV, 168 ff. e misura 290x200 mm. Il codice è una raccolta di testi geografici e topografici ed è una copia di Oxford, Bodleian Library, MS Canon. Miscell. 378, a sua volta discendente dall'antico codice della Cattedrale di Spira andato perduto. Il codice trasmette: la Cosmographia di Aethicus Ister, ff. 2r-15r, l'Itinerarium Antonini, ff. 15r-48r; l'Annunciationes provinciarum, ff. 63v-66r; De montibus, portis et viis urbis Romae, ff. 66r-67r;  il De rebus bellicis, ff. 68r-78v; Disputatio Hadriani Augusti et Epicteti philosophi, ff. 79r-80v; la Notitia urbis Romae, ff. 81r-84r; Notitia urbis Constantinopolitanae, ff. 84v-87r;  il De gradibus cognationum, ff. 87r-88r; la Notitia dignitatum tam civilium quam militarium, ff. 88v-165v; il De mensuratione provinciarum, ff. 166r-168r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1296> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q750403> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il manoscritto presenta numerose illustrazioni che rappresentano personaggi antichi, armi da guerra, personificazioni di regioni geografiche, elementi simbolici, navi, schemi cartografici a colori e con rifiniture in oro. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#httpswwwgeschichtsquellendestart'>GESCHICHTSQUELLEN</a>, http://www.geschichtsquellen.de/werk/2021 </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/manuscript/madrid-biblioteca-nacional-de-españa-res-36-manoscript/188708 </li><li><a href='https://imagoarchive.it/bibliografia.html#bieler-the-text-tradition'>BIELER 1965</a>,  </li>" ;
        :has_url_manuscript    "http://bdh-rd.bne.es/viewer.vm?id=0000051093" ;
        :has_url_manuscript_description
                "http://bdh.bne.es/bnesearch/detalle/bdh0000051093" ;
        :last_mod_form         "2024-02-14T13:40:53.826Z"^^xsd:dateTime .

