<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._2287/168r170v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1630> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 172 ff. e misura 360x217 mm. Il codice è rilegato in legno coperto da pelle di maiale. Il manoscritto faceva parte della biblioteca di Saint-Amand e fu utilizzato dal maestro Jean, dottore in teologia, come testimoniato dall'ex libris del XIII secolo apposto sulla controguardia inferiore \"Iste liber est magistri Iohannis de sancto Amando Tornacensis dyocesis doctoris sacre theologie\"; successivamente il codice appartenne all'arcivescovo di Reims Charles-Maurice Le Tellier, i cui volumi furono consegnati alla Biblioteca Reale nel 1700. Il manoscritto trasmette: Pseudo-Gregorio Magno, Oratio de mortalitate, f. 1r; Symbolum, f. 1r; Gregorio Magno, Registrum epistolarum, ff. 3r-167v; Descriptio Lateranensis ecclesiae, nella prima redazione, ff. 168r-170v; De remediis fortuitorum, ff. 170v-172r; De septem miraculis mundi, f. 172r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1630> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1v miniatura incorniciata a tutta pagina, raffigurante San Gregorio seduto, con un libro aperto sulla mano sinistra, vestito di rosso, blu e verde, su fondo oro. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#vogel-la-descriptio-ecclesiae-lateranensis-du-diacre-jean'>VOGEL 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#codice-topografico-della-citta-di-roma'>VALENTINI-ZUCCHETTI 1940-1953</a>, III, pp. 319-325. </li><li><a href='https://imagoarchive.it/bibliografia.html#oftestad-the-lateran-church'>OFTESTAD 2019</a>, pp. 193-203. </li>" ;
        :has_url_manuscript    "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc1044606" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc1044606" ;
        :last_mod_form         "2024-04-04T11:14:28.113Z"^^xsd:dateTime .

