        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 42. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/indulgentiae-ecclesiarum-urbis-romae-title/172555 </li>" ;
        :has_url_manuscript    "https://diglib.uibk.ac.at/urn:nbn:at:at-ubi:5-609" ;
        :has_url_manuscript_description
                "https://manuscripta.at/hs_detail.php?ID=29435" ;
        :last_mod_form         "2024-04-05T15:08:49.455Z"^^xsd:dateTime .

