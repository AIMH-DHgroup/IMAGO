<https://imagoarchive.it/ontology/resources/manuscript/firenze/bibliotecamedicealaurenziana/plut._30.4/3r133r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1832> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 132, I' ff. e misura 420x285 mm. Il testo è vergato in littera antiqua da una sola mano su due colonne, mentre i toponimi delle tavole sono vergati da due differenti mani e un'ulteriore mano interviene per correzioni e annotazioni in margine alle tavole. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1832> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q856419> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 2r fregio a bianchi girari su tre lati, intrecciato su un'asta dorata, tondo raffigurante Tolomeo con in mano un libro e un compasso, nel margine inferiore preparazione per lo stemma lasciato in bianco, nel margine superiore una cornice colorata in rosa che doveva accogliere l'indirizzo della dedica. Al f. 3v iniziale dorata e miniata che raffigura Tolomeo che regge una sfera e un compasso. Iniziali maggiori dorate e decorate a bianchi girari a inizio di ogni libro. Sono presenti 32 tavole che comprendono il mappamondo e le tavole regionali. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 95-96. </li>" ;
        :has_url_manuscript    "http://mss.bmlonline.it/s.aspx?Id=AWOHzU1cI1A4r7GxMCFz#/book" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/firenze-biblioteca-medicea-laurenziana-plut-30-4-manoscript/143384" ;
        :last_mod_form         "2024-02-05T15:03:13.053Z"^^xsd:dateTime .

