<https://imagoarchive.it/ontology/resources/manuscript/charlevillemzires/mdiathquevoyelles/275/226v228v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-757> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto è membranaceo, con il testo disposto su due colonne, composto da 228 fogli. Al primo foglio è presente l'annotazione settecentesca  «Cornelius Nepos historicus. Bene servandus liber Bellaevallis in Argona». Il codice risulta così composto: Dares Phrygius, Historia de excidio Troiae (ff. 1ra-9ra);  Ditti Cretese, Ephemeris belli Troiani (ff. 9ra-9vb); Excidium Troiae (ff. 9vb-23rb); Landolfo Sagace, Historia Romana (ff.23rb-158vb ); Historia Apollonii regis Tyri, (ff. 158vb-167va); Jaques de Vitry, Historia Hierosolymitana abbreviata (ff. 177ra-217va); Onorio di Autun, Imago mundi (ff. 219vb-226va). " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-757> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q19946540> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#httpswwwbedadlsgwiuni-muenchendeabout'>BEDA VENERABILIS, De locis sanctis </a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://ccfr.bnf.fr/portailccfr/jsp/index_view_direct_anonymous.jsp?record=eadcgm:EADC:D05030935" ;
        :last_mod_form         "2024-02-13T15:14:25.422Z"^^xsd:dateTime .

