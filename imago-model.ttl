        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdata5e80a6aebab5d9cf82d8a611c1656a359c1ff3ec" ;
        :last_mod_form         "2024-04-05T06:47:35.923Z"^^xsd:dateTime .

