<https://imagoarchive.it/ontology/resources/manuscript/philadelphiapa/universityofpennsylvanialibrary/rare_book_and_manuscript_library,_codex_60_(olim_lea_4)/1r42v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-186> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 58 ff. e misura 252x186 mm. Il testo è disposto su due colonne di 34 righe. Esemplato in Italia, forse a Bologna, il codice trasmette la Descriptio di Burcardo da Monte Sion nella redazione lunga, il De modo recuperationis terre sancte di Marino Sanudo, ff. 42v-49v,  In libro monachorum de temporibus contempnendis, f. 49v, e i Metra moralium philosophorum de virtutibus e l'Historia Beati Albani, f. 50v. I ff. 42v-49v sono stati esemplati da Peregrinus de Sancto Vito. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-186> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q18572874> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali in rosso con filigrana viola e blu, al f. 1r iniziale decorata in rosso, blu, giallo, verde, rosa e bianco, al f. 51r iniziale decorata in rosso, blu, rosa e bianco." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>, pp. 283-286. </li>" ;
        :has_url_manuscript    "https://franklin.library.upenn.edu/catalog/FRANKLIN_9914739373503681" ;
        :has_url_manuscript_description
                "https://franklin.library.upenn.edu/catalog/FRANKLIN_9914739373503681" ;
        :last_mod_form         "2024-04-19T07:24:16.784Z"^^xsd:dateTime .

