<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/pal._lat._1280/88r96v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-571> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 97, I ff. e misura 185x135 mm. Il codice trasmette: Isaac Israeli ben Solomon, Diaetae particulaes-excerpta, ff. 1r-52r; Tabula aegritudinum cum simplicibus eisdem conferentibus, ff. 52r-54v; Quid pro quo, ff. 55r-57r; De ponderibus, f. 57r; Ricette e antidoti, ff. 57r-58v; Ibn Gazla, Tacuinus de curis morborum-excerpta, ff. 58r-86r; estratti del XVIII libro del De proprietatibus rerum di Bartolomeo Anglico, ff. 88r-96v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-571> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li><li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 135. </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Pal.lat.1280" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdata5228a2fa21d8de10cfad008731562c0d552e8a49" ;
        :last_mod_form         "2024-03-26T15:59:13.114Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/date/mdm-50>
        rdf:type  <http://erlangen-crm.org/211015/E52_Time-Span> ;
        <http://erlangen-crm.org/211015/P170i_time_is_defined_by>
                "1447/1457" .

<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/bodl._565_/35r49r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-739> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 103 ff. e misura 238x175 mm. Il testo è disposto su una colonna di circa 30 righe. Al f. 1r elenco dei contenuti di due mani successive. Il codice trasmette: elenco dei beni di William Wey, ff. 2r-2v; tassi di conversione, ff. 3r-4v; raccomandazioni e consigli pratici per i pellegrini, ff. 4v-7v; versetti in inglese sui luoghi santi, ff. 8r-13v; luoghi santi, ff. 14r-16v; elenco di dieci motivi per compiere un pellegrinaggio, ff. 17r-34v; Itinerarium peregrinacionis ad sepulcrum sanctissimum, ff. 35r-49r; tabella delle città e delle distanze lungo il percorso, ff. 49v-50v; Itinerarium secundum ad Terram Sanctam, ff. 51r-64r; tabella del vocabolario inglese-greco, greco-latino e latino-ebraico, ff. 64r-76r; selezioni di posti visitati da Wey, ff. 76r-83v; lista di luoghi, ff. 83v-86r, 86r-89r; distanza tra i luoghi della Terra Santa, ff. 89r-90v; vocabolario latino-greco, ff. 91r-91v; Indulgenze a Roma, ff. 92r-98r; Itinerarium peregrinacionis ad sanctum Iacobum in Ispannya, ff. 98r-101v; canzone con musica, f. 101v; testi su Compostella, ff.102r-105r. Al f. 105v nota: \"Ex dono magistri Willelmi Wey quondam socii collegii regalis beatissime Marie Etone iuxta Windesoram huic sancto monasterio de Edyngton qui videlicet magister obijt Anno domini MCCCXXXVI XXX die mensis Novembris\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-739> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali blu con penna fiorita in rosso ai ff. 17r-34r, 35r-49r, 76r-78r, 92r." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/itinerarium-peregrinacionis-ad-sepulcrum-sanctissi-title/190511 </li><li><a href='https://imagoarchive.it/bibliografia.html#boyle-william-weys-itinerary'>BOYLE 2015</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#william-wey-itinerarium-peregrinacionis-1458'>WILLIAM WEY, Itinerarium peregrinacionis 2010</a>,  </li>" ;
        :has_url_manuscript    "https://digital.bodleian.ox.ac.uk/objects/b7258770-61c5-4ff9-b030-7f3fbc379a06/" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_1584" ;
        :last_mod_form         "2024-03-29T22:07:21.36Z"^^xsd:dateTime .

