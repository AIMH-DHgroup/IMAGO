<https://imagoarchive.it/ontology/resources/manuscript/sandanieledelfriuli/bibliotecacivicaguarneriana/106/1r74v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-48> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo, ff. I+94, luogo di copia: San Daniele del Friuli. Contiene anche: Cassio Dione, Consolatio Philisci in Ciceronem (ff. 75r-80r); Lorenzo Valla, De falso credita et ementita Contatini donatione, estratto di poche righe (ff. 80v); Componimenti di Ovidio o a lui attribuiti: De somnio (Am. III, 5), Pulex, Medicamina faciei feminae, De nuce, De philomela, seguito da Am. II, 6, 1-62, De cuculo (ff. 81r-92v). Il codice è stato commissionato da Guarnerio d'Artegna al copista Niccolino da Zuglio e i due si alternano nella trascrizione dei vari testi. Di mano di Niccolino sono i ff. 1r-61v, mentre di mano di Guarnerio sono i ff. 62r-82r e le correzioni ai ff. 1r-8v. Sembrano risalire invece a una terza mano i ff. 82v-91v. Il testo della Roma instaurata è incompleto." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-48> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q21236953> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#biondo-roma-instaurata-2020'>BIONDO, Roma instaurata 2020</a>, p. LXXXVIII-LXXXIX </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/san-daniele-del-friuli-(udine)-biblioteca-civica-g-manuscript/182711" ;
        :last_mod_form         "2024-02-25T20:51:25.121Z"^^xsd:dateTime .

