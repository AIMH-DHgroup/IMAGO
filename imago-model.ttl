<https://imagoarchive.it/ontology/resources/manuscript/cambridge/stjohnscollegelibrary/i._11_(219)/147v158r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1364> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 156, 2 ff. Il testo è disposto su due colonne. Proveniente dal monastero di Syon, il codice riporta in copertina l'etichetta \" Tractatus de mundi creacione usque ad Noe. Mappa mundi. Imago mundi. De mirab(i)libus mundi. Cronica fratris Martini penitenciarii pape. Cronica brevis de diversis bellis et gestis. 2 fo. duo fuerunt\". Il manoscritto sembra trasmettere un riarrangiamento degli Otia imperialia, con gli inizi di molti capitoli rifusi all'interno del testo. Il codice comprende anche il Chronicon di Martin Polono, un elenco di papi fino a Urbano V, i nomi dei re inglesi fino a Riccardo II, i Mirabilia urbis Romae e un testo francese sulle crociate." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1364> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q609646> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 32. </li><li><a href='https://imagoarchive.it/bibliografia.html#caldwell-manuscripts-of-gervase-of-tilburys-otia-imperialia'>CALDWELL 1962</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.joh.cam.ac.uk/library/special_collections/manuscripts/medieval_manuscripts/medman/I_11.htm" ;
        :last_mod_form         "2024-04-06T21:20:32.683Z"^^xsd:dateTime .

