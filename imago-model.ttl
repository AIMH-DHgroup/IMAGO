        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 28. </li>" ;
        :has_url_manuscript    "http://www.manuscripta-mediaevalia.de/dokumente/html/obj31275308" ;
        :has_url_manuscript_description
                "https://resolver.staatsbibliothek-berlin.de/HSP0006B08400000000" ;
        :last_mod_form         "2024-04-06T21:09:16.668Z"^^xsd:dateTime .

