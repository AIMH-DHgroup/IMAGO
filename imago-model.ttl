        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-marci-pauli-de-veneciis-de-consuetudinibus-e-title/8347 </li><li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 929-933. </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Vat.lat.3153" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/160591" ;
        :last_mod_form         "2024-02-02T09:29:54.8Z"^^xsd:dateTime .

