<https://imagoarchive.it/ontology/resources/manuscript/klosterneuburg/bibliothekdesaugustinerchorherrenstiftes/722_a/1r40v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "M: & C: Terrae sanctae descriptio" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-151> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo e cartaceo è formato da 248 ff. e misura 303x215 mm, con il testo disposto su due colonne. Esemplato a Bayern, il codice si compone di quattro diverse parti e trasmette prevalentemente testi geografici: Rorgo Fretello, Descriptio Terrae Sanctae, ff. 41r-50v; Onorio di Autun, Imago mundi, ff. 51r-81v; Francesco Pipino, Liber Marci Pauli de Venetiis, ff. 84r-156v; Odorico da Pordenone, Itinerarium de mirabilibus orientalium Tartarorum, ff. 156v-178v; Alessio I Comneno, Epistola ad Robertum I comitem Flandrensium, ff. 180r-181v; Roberto di Reims, Historia Hierosolymitana, ff. 181v-235r; Epistola patriarchae Hierosolymitani, ff. 235r-235v; Catalogus cardinalium, archiepiscoporum et episcoporum totius Romanae ecclesiae cum annotationibus, ff. 235v-242v; Catalogus archiepiscoporum et episcoporum Pataviensium ab anno 250-1251, ff. 242v-243v; Catalogus ducum Bavariae ab anno 508-1260, ff. 244r-245r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-151> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/klosterneuburg-bibliothek-des-augustiner-chorherrenstiftes> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali ornate e fiorite. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, p. 23. </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>, pp. 51-52. </li><li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>, pp. 283-286. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manuscripta.at/hs_detail.php?ID=931" ;
        :last_mod_form         "2024-04-19T07:35:29.968Z"^^xsd:dateTime .

