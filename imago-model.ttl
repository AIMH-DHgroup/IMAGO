<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/reg._lat._1007/1r59r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-572> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 99 ff. e misura 223x165 mm. Il codice è composto da cinque parti: ff.1-59 del XII-XIII secolo, ff. 60-67 del XIII-XIV secolo, f. 68 del XII secolo, ff. 69-70 del XV-XVI secolo, ff. 71-99 del XIII secolo. Al f. 1v tavola dei contenuti a cura di Anselme Le Michel. Il codice trasmette inoltre: Giulio Valerio, Res gestae Alexandri Magni; Solino, Collectanea rerum memorabilium; Giustino, Epitoma historiarum Philippicarum Pompei Trogi; Alexandri Magni iter ad Paradisum; Vitruvio, De architectura; Valerio Massimo, Facta et dicta memorabilia. Il manoscritto contiene il libro XIX completo del De proprietatibus rerum di Bartolomeo Anglico. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-572> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 135. </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Reg.lat.1007" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdatac3e3ebc9a8e823441611c95" ;
        :last_mod_form         "2024-03-26T16:00:20.732Z"^^xsd:dateTime .

