        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/historia-mongalorum-iohannes-de-plano-carpini-n-11-title/6155 </li><li><a href='https://imagoarchive.it/bibliografia.html#giovanni-di-pian-del-carpine-storia-dei-mongoli'>GIOVANNI DI PIAN DEL CARPINE, Storia dei Mongoli 1989</a>, pp. 101-102, 152-156. </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b105571369" ;
        :has_url_manuscript_description
