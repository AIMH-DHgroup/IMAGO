<https://imagoarchive.it/ontology/resources/manuscript/heiligenkreuz/zisterzienserstift/50/irviv1r283r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-385> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da VI, 283 ff. e misura 320x230 mm. L'ordine dei libri si discosta in parte da quello abituale: il libro IV inizia già a metà del libro III e alla fine del testo ci sono incongruenze e correzioni nella numerazione dei libri e nelle formule degli incipit. Il codice è stato realizzato nell'abbazia cistercense di Heiligenkreuz per essere utilizzato dai monaci cistercensi. All'interno del testo di Bartolomeo Anglico il commento allegorico, solitamente indicato nelle note a margine, è inserito nelle colonne, dove la seconda metà di riga o un terzo di riga è riservato alle interpretazioni. Questa procedura comporta alcune modifiche del contenuto. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-385> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/heiligenkreuz-bibliothek-des-zisterzienserstifts> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li><li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 62-63. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/heiligenkreuz-bibliothek-des-zisterzienserstifts-5-manoscript/16880" ;
