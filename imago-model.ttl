<https://imagoarchive.it/ontology/resources/manuscript/madrid/bibliotecanacionaldeespaa/_8918/100r111v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2180> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto trasmette solo alcuni estratti del testo dell'Imago mundi, corrispondenti ai libri I, 1-11, 147, libro II, 1-24, 26-61, 75-76, 73-74, 77-80, 120. Il codice riporta inoltre Giovanni di Sacro Bosco, Trattato astronomico, ff. 1r-9r; Trattato sugli algoritmi, gg. 9v-14r; Trattato matematico, ff. 14r-27r; Calendario, ff. 28r-30v; John Peckham, Theorica planetarum, ff. 31r-36v; Arithmetica, ff. 36v-49r; Pedro Gallengo, Trattato astronomico, ff. 49r-56v; Phylosophia, ff. 57r-92v; Tommaso d'Aquino, Tractatus, ff. 92v-100r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2180> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q750403> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Mappa al f. 101r." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "http://bdh-rd.bne.es/viewer.vm?id=0000077592&page=1" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-04-02T09:45:07.033Z"^^xsd:dateTime .

