<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._4126/26v27r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-75> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 296 ff. e misura 319x185 mm. Il codice è stato compilato a York sotto la direzione di Robert de Populton, che ha vergato i ff. 10-32, 246-252, 282-295 e i ff. 133v-134 e a cui si devono i numeri delle rubriche e le annotazioni. Il codice trasmette testi di vario genere: Gerald of Wales, Topographia Cambriae; Decretale di Innocenzo VI, ff. 3r-4r; decretale di Benedetto XI, ff. 4v-6v; decretale di Bonifacio VIII, ff. 7r-8r; Versus de praestantia regni Scotorum, ff. 9v-9v; decretale di Giovanni XXII, ff. 10r-10v; Tractatus de quodam prodigio, ff. 11r-12r; De mirabilibus Hibernie, f. 12r-13v; Aethicus Ister, Cosmographia, ff. 14r-19r; Itinerarium Antonini, f. 19r; Versus de tribus mundi partibus et de distributione totius orbis, montium et fluminum, f. 20r; Mensura totius Terrae secundum Romanos doctissimos, ff. 21r-22v; estratti da Orosio, Historiae adversus paganos, ff. 22v-26v; De situ Albaniae, ff. 26v-27r; Chronica de origine antiquorum Pictorum, ff. 27r-27v; Lista dei re dei Pitti, ff. 27v-28v; Cronaca di re, ff. 28v-29v; Chronica Regum Scotorum annos trecentos et quatuordecim complectentia, ff. 29v-30v; Albero genealogico di Guglielmo, re di Scozia, ff. 30v-31r; Leggende della fondazione di St. Andrews, ff. 31r-32r; Pietro Alfonsi, Disciplina clericalis, ff. 33r-45r; Pseudo-Metodio, Liber de initio et fine seculi, ff. 45r-48r; Gerald of Wales, Topographia Hiberniae, ff. 49r-96v; Epistola Alexandri ad Aristotelem, ff. 97r-106v; ; Metrum in destructionem Troianorum, ff. 106v-108r; Darete Frigio, Historia Troiana, ff. 108r-111r; Ranulph Higden, Polychronicon, ff. 120v-132v e 252r-281v;  Goffredo di Monmouth, Historia Britonum, ff. 134v-211v; Prophetia Merlini, ff. 172r-173v; Enrico di Huntingon, Historia Anglorum, ff. 213r-240r; Annales di Alfred di Beverley, ff. 242r-252r; Oraculum Cyrilli, ff. 282r-295r; lettera di Ildegarda al clero di Colonia, ff. 295v-296r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-75> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Ai ff. 33-105 e 134v-211 sono presenti lettere filigranate. La B al f. 1v rappresenta una carta terrestre e celeste con al centro Gerusalemme." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#avril-stirnemann-manuscrits-enlumines'>AVRIL-STIRNEMANN 1987</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>,  </li>" ;
        :has_url_manuscript    "https://codecs.vanhamel.nl/Paris,_Biblioth%C3%A8que_nationale_de_France,_MS_lat._4126" ;
        :has_url_manuscript_description
                "https://codecs.vanhamel.nl/Paris,_Biblioth%C3%A8que_nationale_de_France,_MS_lat._4126" ;
        :last_mod_form         "2024-04-04T20:13:00.999Z"^^xsd:dateTime .

