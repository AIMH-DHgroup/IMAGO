<https://imagoarchive.it/ontology/resources/manuscript/milano/bibliotecaambrosiana/trotti_373/101124>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-685> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto (208 x 147) si presenta come un esemplare composito, realizzato con fogli membranacei e cartacei. Si tratta di una miscellanea umanistica predisposta da Leonardo Botta (ff. 1-6) con sue lettere, databili fra il 1470 e il 1471, scritte tra Milano e Pesaro, indirizzate a personaggi come Francesco Filelfo, Vincenzo Amidano e Fabrizio Elfiteo.  Seguono poi testi didattici in lingua greca e latina di Guarino, componimenti poetici (sempre in greco e in latino), molteplici epitaffi latini e trascrizioni di iscrizioni greche, di dieci mani differenti, una delle quali è stata riconosciuta come quella di Pandolfo Collenuccio. I ff. 101-124 raccolgono l'Itinerarium di Ciriaco, di mano autografa, corredati di disegni.  Nel codice sono tramandate anche le seguenti opere: il Carmen in Danielem adulescentulum primarium di Porcellio Pandoni (ff. 47v-48r); i Carmina di Antonio Roselli; l'Epigramma ad Franciscum Philelphum (f. 48r) e l'Epitaphium a se ipso conditum (f. 48v), entrambi di Enrico da Prato.\r\n" ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-685> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q815611> ;
        :compiled_form         "Martina Piccolo" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, I, p. 350 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, II, p. 536 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, VI, p. 75 </li><li><a href='https://imagoarchive.it/bibliografia.html#zaggia-codici-milanesi'>ZAGGIA 2007</a>, p. 351 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/milano-biblioteca-ambrosiana-trotti-373-manuscript/86535" ;
        :last_mod_form         "2024-01-19T12:39:09.137Z"^^xsd:dateTime .

