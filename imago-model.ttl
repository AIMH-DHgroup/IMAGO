        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_7499" ;
        :last_mod_form         "2024-04-10T14:11:46.213Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/digby_73/61r95r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-542> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 95 ff. Nel 1557 il codice era posseduto da Ricardus Ledes, un mercante di Londra. Il manoscritto trasmette testi di argomento medico e un estratto del VII libro di Bartolomeo Anglico relativo alle malattie. In particolare, il codice contiene: Descriptio et virtutes herbarum aliorumque medicinalium, ff. 1-56; Unguenta Avicenne, f. 15v; Unguenta ex Antidotario Serapionis, f. 16v; Descriptio ponderum et mensurarum, f. 51v; Notae, ff. 56v-60r, 64v, 69r; Estratti di testi medici, ff. 61-95. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-542> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 130. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/images/ms/abw/abw0049.gif" ;
        :last_mod_form         "2023-04-03T09:54:33.045Z"^^xsd:dateTime .

