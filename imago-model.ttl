<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/reg._lat._498/142v150v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1664> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 153 ff. e misura 237x173 mm. Il codice trasmette inoltre: Vitae Sanctorum, ff. 1r-70v; Cesario di Arles, Sermones, ff. 71v-76r; Miracula, obitu et translatio S. Nicolai, ff. 76r-90v; Agostino, Sermo 46, ff. 91r-95v; Gerolamo, Tractatus de oboedentia, ff. 95v-96v; Pascascio Radberto, De corpore et sanguine Domini, ff. 96v-97r; Vitae Patrum, ff. 97r-97v; Agostino, Sermones, ff. 99r-101r; Miracula de S. Servatio episcopo, ff. 101r-103v; Sententiae morales, ff. 103v-104r; Burcardo di Worms, Decretum, f. 104r; Vitae Sanctorum, ff. 114r-142v; Alexandri magni iter ad Paradisum, ff. 150v-153r; Sequentia de S. Maria, f. 153v. Il codice fu esemplato in Germania. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1664> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li>" ;
