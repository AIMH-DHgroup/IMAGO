<https://imagoarchive.it/ontology/resources/manuscript/subiaco/bibliotecadelmonumentonazionaledelmonasterodisantascolastica/223,_ccxx/114r119r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1347> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto è composito, formato da tre elementi e composto in totale da I, 119, I ff. La prima unità riporta al f. 69r un riquadro di datazione e nome del copista \"Et est finis, Amen. Et sic, per Nicolaum Haerlem sum scriptus, orate pro eo fideli corde, anno Domini MCCCCLXX, Amen\". La seconda unità, esemplata nel 1467, riporta al f. 109v la nota \"Finitus est per me Fi... b. ad... in Christo. Eremus Casinensi, anno dominice incarnacionis 1467\". La terza unità è invece formata dai ff. 110-119. La prima unità trasmette: Tractatus de restitutione, ff. 1r-16v; sant'Antonio, Confessionale Defecerunt, ff. 17r-69r; Speculum peccatorum, ff. 73r-77v; Eberhard Mardach, De arte moriendi, ff. 78r-90r. La seconda unità trasmette: Trattato sulla penitenza, ff. 91r-109v. La terza unità trasmette: De virtutibus herbarum et florum, ff. 110r-114r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1347> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q19843960> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/mirabilia-urbis-romae-title/172558 </li><li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 84. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/cnmd/0000049136" ;
        :last_mod_form         "2024-04-06T12:44:42.781Z"^^xsd:dateTime .

