<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._14702/1r312r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-462> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 313 ff. e misura 320x205 mm. La struttura del testo è stata modificata: i libri X e XI sono combinati come X, in modo che i libri XII-XVII vengano contanti come XI-XVI; il numero XVII non è assegnato. Il codice proviene da San Vittore a Parigi, come si legge al f. 1r: Iste liber est Sancti Victoris. quicunque eum furatus fuerit vel celaverit vel titulum istum deleverit anathema sit. Amen. Al f. 308v si legge: De dono magistri Iohannis de Crepone per manum domini Gaufredi abbatis eiusdem ecclesie Sancti Victoris, e al f. 313v: Iohannes de Crepone decretarum doctor. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-462> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li><li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 94-95. </li>" ;
        :has_url_manuscript    "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc754497" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc754497" ;
        :last_mod_form         "2023-04-01T09:12:30.68Z"^^xsd:dateTime .

