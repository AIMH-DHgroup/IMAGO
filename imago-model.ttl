<https://imagoarchive.it/ontology/resources/print_edition/pe-110>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "De bello Hispaniensi. De claris Genuensibus. Orae Ligusticae descriptio" ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "L’edizione del 1573 curata da Bartolomeo Gorla e affidata alla tipografia degli eredi di Antonio Blado, costituisce una ristampa dell’Ascensius. Il curatore apporta al testo 18 correzioni, non presenti né nei manoscritti né nelle restanti stampe e riportate in una tabella alla carta 73v. Analogamente alla stampa del 1520, il “De bello Hispaniensi” viene pubblicato insieme ai restanti due scritti del Bracelli, ma in carattere corsivo con l’incipit e le titolazioni in tondo, l’unione della prefazione con il Libro I, la correzione dell’errore di stampa dell’Ascensius al f. IX “LIBER I” per “LIBER II” e una notevole riduzione delle abbreviazioni. La ristampa viene effettuata su volere di Giambattista Bracelli, vescovo di Sarzana e pronipote dell’autore, il quale si rammarica del fatto che un’opera di tale spessore sia poco conosciuta per la scarsità di copie, «cum [...] exemplaria illa, quibus primo commendata fuerat atque impressa, vel legentium assiduitate contrita, vel vetustate consumpta iam pene omnia defecissent, et quasi evanuissent» e, quindi, necessiti di un uomo di grande cultura che si prodighi affinchè non perisca interamente e possa esser consegnata ai posteri. Infatti «temporum iniuria pene iam factum erat, ut brevi imminckte horum librorum interitu, res aliter eventura, atque homo sane doctus et patria suae amantissumus animo conceperat et genuensis respublica non mediocrem splendoris sui iacturam factura videretur, cum ecce tu, praesul clarissime, collabentem prope iam huius historiae memoriam ad familiae tuae decus immmortale genuensisque hominis amplificationem restituisti»." ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/descriptio-orae-ligusticae-title/8506> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-110> ;
        :compiled_form              "Alessio Luca Bartelloni" ;
        :has_figure_note            "" ;
        :has_introduction_note      "" ;
        :has_other_contents         "\"De bello Hispaniensi\", \"De claris Genuensibus\"." ;
        :has_primary_source         "" ;
        :has_reprint_date           "1520" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#galletti-2023'>BRACELLI, Descriptio (tesi di laurea) 2023</a>, pp. 45-46 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Giacomo Bracelli" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-110> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-110> ;
        :last_mod_form              "2024-03-13T23:57:36.64Z"^^xsd:dateTime .

