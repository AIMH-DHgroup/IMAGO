<https://imagoarchive.it/ontology/resources/manuscript/napoli/bibliotecanazionalevittorioemanueleiii/vindobonense_latino_48/14r41v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1313> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da IV, 89, I' ff. e misura 228x162 ff. Rigato a secco e con legatura moderna, il codice fu esemplato in Italia. Appartenuto all'umanista Aulo Giano Parrasio, giunse alla Biblioteca imperiale di Vienna nel XVIII secolo e fu restituito all'Italia dopo la Prima Guerra Mondiale. Il codice contiene: Vibio Sequestre, De fluminibus, fontibus, lacubus, nemoribus, paludibus, montibus, gentibus per litteras liber, ff. 1r-12v; Polemio Silvio, Laterculus, ff. 12v-14r; Liber provinciarum Italie, ff. 15r-18v; Liber de origine situque et qualitate urbis Rome, ff. 18v-23r; Liber de variis historiis, ff. 23v-41v; Gregorius Tiphernius, De astrologia oratio, ff. 41r-50r, De studiis litterarum oratio, ff. 50v-60v, Carmina, ff. 60v-68v; Seneca, Ad Gallionem de remediis fortuitorum liber, ff. 69r-73r; Xenophons, De tyranno, ff. 73v-88v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1313> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2256644> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-compositus-de-variis-historiis-pro-diversis--title/9491 </li><li><a href='https://imagoarchive.it/bibliografia.html#campopiano-liber-guidonis'>Liber Guidonis 2008</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/napoli-biblioteca-nazionale-vittorio-emanuele-iii--manoscript/118291" ;
        :last_mod_form         "2024-02-07T12:50:09.278Z"^^xsd:dateTime .

