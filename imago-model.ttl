<https://imagoarchive.it/ontology/resources/manuscript/cambridge/universitylibrary/ii.2.24/1163>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2214> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 163 ff. Il testo è disposto su due colonne. Il codice proviene da Canterbury. Al f. 153r nota marginale del XV-XVI secolo: \"alius liber scriptus habet hec in margine: Hucusque Randulphus\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2214> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
