<https://imagoarchive.it/ontology/resources/print_edition/pe-284>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Descriptio Helvetiae " ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "L'edizione fa parte della rivista \"Mitteilungen der antiquarischen Gesellschaft in Zürich 3\", consultabile al link:\r\nhttps://www.e-periodica.ch/digbib/view?pid=mag-001%3A1846%3A3#5" ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/superioris-germaniae-confoederationis-descriptio-title/11260> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-284> ;
        :compiled_form              "Sara Crea" ;
        :has_ecdotic_type           <https://imagoarchive.it/ontology/resources/print_edition/edition/edizione_semidiplomatica_o_interpretativa> ;
        :has_figure_note            "A p. 95 è presente la raffigurazione di un uomo, simbolo della Terra, che si trova al centro del mondo, rappresentato da due cerchi concentrici. A p. 96 sono presenti due mappamondi di tipo OT, il primo diviso in tre parti da una T, che divide Asia e Europa e in alto l'Africa, e un secondo in cui nel settore europeo è presente una catena montuosa, che divide l'Italia dall'Alamannia. A p. 97 è raffigurato un mappamondo con al centro il Regina mons e l'indicazione della Zwitia e di Lucerna. " ;
        :has_introduction_note      "" ;
        :has_other_contents         "" ;
        :has_primary_source         "" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#fonti-storiche-del-medioevo-tedesco'>GESCHICHTSQUELLEN</a>, http://www.geschichtsquellen.de/werk/693 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Albert von Bonstetten" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-284> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-284> ;
        :last_mod_form              "2024-03-21T14:57:04.512Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/cambridge/fitzwilliammuseum/15/1r347r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-358> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da IV, 360 ff. e misura 330x220 mm. Il testo è disposto su due colonne di 42 linee. Il codice trasmette anche Arnaldo da Villanova, Regimentum sanitatis ad regem Aragonarum, ff. 348r-359r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-358> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1421440> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali istoriate: f. 1r Iniziale C creature ed edifici in una scenografia, f. 1v iniziale D Trinità, f. 4v iniziale D angelo e diavolo, f. 11v iniziale A un angelo porta un'anima, f. 21v iniziale D fuoco, aria, terra e acqua, f. 31r iniziale D monaco insegnante che indica una figura umana nuda, f. 68v iniziale D persona giovane e persona anziana, f. 83r iniziale P due persone malate, f. 111v iniziale P cielo sopra un paesaggio con edificio, f. 132r iniziale P strumenti come martello e compasso, f. 141v iniziale C vasaio con ruota e brocca, f. 145r iniziale A cielo con fenomeni meteorologici su un paesaggio, f. 152v iniziale E con vari uccelli, f. 164v iniziale D con acqua, f. 174v iniziale P uomo che scava con una vanga, f. 184v iniziale O edificio, f. 200v iniziale P piante, f. 270r iniziale C con animali vari, f. 312r iniziale D monaco con brocca nella mano sinistra. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#bartholomaeus-anglicus-de-proprietatibus-rerum'>BARTHOLOMAEUS ANGLICUS, De proprietatibus 2007</a>, pp. 27-29. </li><li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 51-52. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/cambridge-fitzwilliam-museum-15-manoscript/23430" ;
        :last_mod_form         "2024-03-26T14:31:15.087Z"^^xsd:dateTime .

