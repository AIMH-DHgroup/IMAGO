<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/add._10104/9r154v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2234> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 177 ff. e misura 365x250 mm. Il testo è disposto su una colonna di 53 righe. La rilegatura è successiva al 1600 in pelle marrone scuro a scacchi. Il testo del Polychronicon è attestato con la continuazione fino al 1377. Il codice riporta inoltre: Note e copia di una lettera a Lewis de St. Melans, tesoriere della cattedrale di Llandaff, ff. 154v-155r; la continuazione del Polychronicon a opera di Adam Usk, ff. 155r-176v; note sulla successione al trono inglese nell'XI secolo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2234> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 8r mappamondo. Al f. 9r grande iniziale in rosa e blu su fondo oro e con bordo decorato in rosa e blu con oro; scudo aggiunto nel margine inferiore. Al f. 35v due diagrammi dell'arca di Noè in rosso e marrone. Al f. 52v diagramma della teoria musicale pitagorica in marrone e rosso. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/polychronicon-ranulphus-higden-m-12-3-1364-ca--title/4071 </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS032-002107887&indx=1&recIds=IAMS032-002107887&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Add.%2010104&dum=true&dstmp=1685348748485" ;
        :last_mod_form         "2024-04-15T16:21:22.523Z"^^xsd:dateTime .

