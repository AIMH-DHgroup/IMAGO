<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._2052/1r207v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1813> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 208, I' ff. e misura 231x154 mm; il codice è mutilo dell'ultimo foglio. Esemplato in littera textualis altamente formalizzata e chiaroscurata, il manoscritto presenta le coordinate geografiche incasellate in una elegante e nitida tabella con le prime due colonne in nero e all'interno i numeri in rosso e le altre due colonne in rosso con i numeri in nero. La legatura del XIX secolo presenta gli stemmi di Pio IX e di Angelo Mai, il cardinale bibliotecario. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1813> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali ornate su fondo oro, rubricato in due colori, rosso e blu. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 80-81. </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Vat.lat.2052/0001" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/224854" ;
        :last_mod_form         "2024-02-05T14:31:21.296Z"^^xsd:dateTime .

