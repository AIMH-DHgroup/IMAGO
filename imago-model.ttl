<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_5373/53v59v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-906> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 59 ff. e misura 210x135 mm. Esemplato in Francia o Inghilterra, il codice è composto da due parti: la prima, ff. 1-53, fu scritta nel XII secolo e trasmette i Memorabilium Collectanea rerum di Solino; la seconda, ff. 53-59, fu esemplata durante il XIII e trasmette la seconda redazione del Liber di Rorgo Fretellus, alcune poesie e un'iscrizione in greco, del XVII secolo. Ai ff. 55r-55v si contano quattro indici che segnalano dei passi di interesse per il lettore: la vendita di Giuseppe da parte dei fratelli, l’incontro tra Abramo e Melchisedech presso il monte Tabor, la sepoltura di Giovanni Battista e la translatio delle sue reliquie. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-906> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Piccole iniziali in rosso, al f.1r decorazione a penna in inchiostro marrone e alcune con motivi arabeggianti. Ai ff. 55r, 57r e 57v si trovano disegni marginali stilizzati di personaggi citati in quel punto del testo, rispettivamente Maria Maddalena, Giacomo, primo patriarca di Gerusalemme, e Lazzaro. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#trovato-sulla-genealogia-e-la-cronologia'>TROVATO 2012</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#yolles-latin-literature-and-frankish-culture'>YOLLES (PhD thesis) 2015</a>, p. 135. </li><li><a href='https://imagoarchive.it/bibliografia.html#boeren-rorgo-fretellus-de-nazareth'>RORGO FRETELLO, Descriptio 1980</a>, p. 49. </li><li><a href='https://imagoarchive.it/bibliografia.html#greco-2021-2022'>GRECO (tesi di dottorato) 2022</a>, pp. 62-63. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002051219&indx=1&recIds=IAMS040-002051219&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=harley%205373&dum=true&dstmp=1676476755348" ;
        :last_mod_form         "2024-02-05T11:32:34.871Z"^^xsd:dateTime .

