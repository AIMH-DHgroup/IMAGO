<https://imagoarchive.it/ontology/resources/manuscript/cambridge/magdalencollegelibrary/f.4.14_(14)/116v128r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-965> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto composito e membranaceo è composto da 129 ff. e misura 249x178 mm. Composito, il codice è formato da quattro unità codicologiche: la prima, ff. 1-40, di origine inglese trasmette le regole per laici, ff. 1r-2v; Bernardo di Chiaravalle, Meditationes, ff. 3v-14r; Richard Rolle, Stimulus conscientiae, ff. 14r-31v; Visio de spiritu Guidonis, ff. 32r-40v; la seconda, ff. 41-55, riporta Edmondo di Canterbury, Speculum ecclesiae, ff. 41r-55v; la terza, ff. 56-81, di origine italiana trasmette Massimino da Salerno, Vita s. Catharinae Senensis, ff. 56r-81r; la quarta, di probabile origine fiamminga, riporta la Passio s. Dorotheae, ff. 82r-83v, la Passio s. Barbarae, ff. 83v-94r, Visiones s. Elizabeth Schonaugiensis, ff. 94r-100v; Willelmus Cartusianus, Vita s. Anthelmi ep. Bellicensis, ff. 100v-116r e la Vita s. Brendani. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-965> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/magdalene-college> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, p. 131. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/cambridge-magdalene-college-f-4-14-(14)-manoscript/219305" ;
        :last_mod_form         "2024-01-29T17:06:47.044Z"^^xsd:dateTime .

