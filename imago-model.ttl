<https://imagoarchive.it/ontology/resources/manuscript/newhaven/beineckerarebookandmanuscriptlibrary/marston_35/1r149r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-678> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo, mm 310-225, ff. II, 149, II. Testo scritto a piena pagina, scrittura umanistica libraria di un singolo copista, identificabile con il 'copista del Virgilio Maffei'. Il codice fu scritto a Ferrara all'incirca negli anni 1460-75, probabilmente dietro committenza della famiglia d'Este. Il manoscritto tramanda il testo dell'Italia illustrata con dedica a Niccolò V (II fase redazione dell'opera). " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-678> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q814779> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "Al f. 1r frontespizio decorato: capitale C in foglia d'oro abitata, con un ritratto di Biondo, raffigurato seduto, con un libro in mano e alle spalle un paesaggio campestre; fregio a bianchi girari su fondo blu, verde, rosso e oro, esteso al mg. sin.; in basso al centro stemma estense, di rosso all'aquila imperiale di ero, bicipite, coronata e al volo abbassato, circondato da un ghirlanda di foglie sorrette da due putti alati che indossano due collane rosse." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 3069-308 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/new-haven-ct-yale-university-beinecke-rare-book-an-manuscript/168190" ;
        :last_mod_form         "2024-03-14T09:40:08.727Z"^^xsd:dateTime .

