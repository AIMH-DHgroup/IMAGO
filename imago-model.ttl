        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/topographia-hiberniae-title/4005 </li><li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>, pp. 319-320. </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#giovanni-di-pian-del-carpine-storia-dei-mongoli'>GIOVANNI DI PIAN DEL CARPINE, Storia dei Mongoli 1989</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.bl.uk/catalogues/illuminatedmanuscripts/record.asp?MSID=7442&CollID=16&NStart=130114" ;
