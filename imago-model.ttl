<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_3877/9r217v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2252> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 217 ff. e misura 375x270 mm. Copiato in Inghilterra in scrittura gotica, il codice trasmette il testo del Polychronicon con la continuazione fino al 1377. Brevi note a margine sono state aggiunte successivamente da più mani e identificano nomi e argomenti importanti. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2252> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Grande iniziale in oro e colori con foglie d'acanto combinate con un bordo pieno con decorazione fogliata, foglie d'acanto e fiori all'inizio del prologo (f. 9r). 6 grandi iniziali in oro e colori con piume fogliate, foglie d'acanto e fiori che si estendono nel margine o nello spazio intercolonnare all'inizio di ogni libro (ff. 39v, 61r, 92r, 117r, 147r, 170v). Spazio per lo spazio iniziale lasciato vuoto (f. 66r). Numerose iniziali grandi e più piccole in blu con penna rossa fiorente tra cui decorazione foliata e pesce. Maiuscole contrassegnate in giallo o in rosso. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002049713&indx=1&recIds=IAMS040-002049713&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Harley%203877%2B&dum=true&dstmp=1685358145003" ;
        :last_mod_form         "2023-05-29T11:19:07.25Z"^^xsd:dateTime .

