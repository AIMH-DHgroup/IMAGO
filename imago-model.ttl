        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 317 ff. e misura 310x220 mm. Il codice trasmette il capitolo 49 del libro V del De proprietatibus rerum di Bartolomeo Anglico. Il manoscritto trasmette inoltre: Lattanzio, Divinae institutiones, ff. 1r-165r; Lattanzio, De ira Dei, ff. 165v-180r; Lattanzio, De opificio Dei, ff. 180v-194v; Cicerone, De officiis, ff. 197r-238r; Gerolamo, Epistolae, ff. 239r-272r; Auctoritates libri Platonis in Timeo, ff. 237r-237v; Auctoritates Apuleii de Deo Socratis, f. 273r; Lattanzio, Divinae institutiones, ff. 274r-279r; Francesco Petrarca, De vita solitaria, ff. 279v-281r; Francesco Petrarca, De remediis utriusque fortunae, ff. 281r-298r; Cassiodoro, Variarium ibri I-V, ff. 298v-301v; Thomas de Hibernia, Manipulus Florum doctorum, ff. 302r-307r; Registro, ff. 308r-317v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-534> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q170109> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 129. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://bilder.manuscripta-mediaevalia.de/hs/katalogseiten/HSK0010_a165_jpg.htm" ;
        :last_mod_form         "2024-03-26T15:31:14.501Z"^^xsd:dateTime .

