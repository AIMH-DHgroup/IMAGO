<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/150/112v122v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1761> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 137 ff. e misura 270x180 mm. La rilegatura è in pelle bruno-rossastra su coperchi in legno di faggio. Sul f. 2v nota di possesso di uno Stephanus plebanus di Falkenstein, che ricevette il manoscritto da un prevosto di Newburg ( Klosterneuburg): «Hic liber videlicet Seneca epistolarum est michi Stephano plebano in Valkenstain comprestitus per reverendissimum patrem dominum praepositum Newburgensem». Ai ff. 122v,130r, 130v e 131r note dell'umanista Alexander Brassicanus, morto a Vienna nel 1539. Il codice trasmette: Gerolamo, De Seneca testimonium, f. 1r; Seneca, Epistolae ad Paulum et Pauli ad Senecam, ff. 1v-2r; Seneca, Epistolarum ad Lucilium, ff. 2v-108r; Epistola Brachmanorum ad Alexandrum magnum, ff. 108v-112v; Epistola Alexandri ad Aristotelem, ff. 112v-122v; Liber de proeliis, ff. 122r-137r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1761> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Foglie e fiori neri sagomati, f. 108r. Iniziali floreali. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li><li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://data.onb.ac.at/rec/AC13957981" ;
        :last_mod_form         "2024-04-05T09:50:14.707Z"^^xsd:dateTime .

