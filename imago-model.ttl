        :has_url_manuscript_description
                "https://diglib.hab.de/?db=mss&list=ms&id=8-8-aug-4f&catalog=Heinemann" ;
        :last_mod_form         "2024-03-26T16:06:00.716Z"^^xsd:dateTime .

