<https://imagoarchive.it/ontology/resources/manuscript/bamberg/staatsbibliothek/hist._3_(e.iii.14)/228ra235vb>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1641> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 351 ff. e misura 380x300 mm. Esemplato presso la cattedrale di Halberstadt, questo codice raccoglie varie opere storiche. Ci sono quattro sezioni principali: la prima trasmette l'Epitome di Sesto Aurelio Vittore, la seconda opere varie, la terza testi legati alla storia di Alessandro Magno, la quarta opere di Beda. Sono presenti numerose glosse al testo. La seconda parte, che è separata dalle altre da un proprio sommario nella parte anteriore e da un foglio bianco con un disegno nella parte posteriore, trasmette inoltre l'Historia Longobardorum di Paolo Diacono e le Gesta Francorum di Gregorio di Tours. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1641> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q324689> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li>" ;
        :has_url_manuscript    "https://www.digitale-sammlungen.de/en/view/bsb00140766?page=,1" ;
        :has_url_manuscript_description
                "http://www.manuscripta-mediaevalia.de/dokumente/html/obj40119288,T" ;
        :last_mod_form         "2024-04-04T20:52:04.19Z"^^xsd:dateTime .

