<https://imagoarchive.it/ontology/resources/manuscript/palermo/bibliotecacomunale/2_qq_d_121/6r50r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-324> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 64 ff. e misura 248x172 mm. I fogli 1r e 64r sono bianchi. Il testo è disposto su due colonne di 32 righe (ff. 6-50) e 20 righe (ff. 50v-56v), il resto in righe lunghe. Il codice è stato esemplato da diverse mani del XIV secolo. La legatura è ottocentesca. Di origine italiana, il codice trasmette inoltre: operazioni aritmetiche, f. 1r;  Canciones in Hermenico, f. 50r; De bona et sapiente uxore, ff. 50v-56v; Epistola fratrum Sincerorum in cosmographia, ff. 57r-64r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-324> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q81174731> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Carta sulle zone della terra, f. 1v; mappa mundi con i nomi dei continenti, f. 2r; rosa dei venti, f. 2v, rosa dei venti, f. 3r; schema cartografico, ff. 3v-4r. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#bueno-dalla-guerra-alle-meraviglie-orientali'>BUENO 2018</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#concina-2020'>CONCINA 2020</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#gautier-dalche-1989'>GAUTIER DALCHÉ 1989</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-04-01T08:33:28.358Z"^^xsd:dateTime .

