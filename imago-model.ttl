<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/arundel_13/1r38r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1253> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo consta di 51 ff. e misura 265x190 mm. Vergato in Inghilterra, è scritto in corsiva anglicana. Il manoscritto probabilmente appartenne a Thomas Howard (1592-1646) e passò poi alla Royal Society, che lo vendette al British Museum nel 1831. Il testo di Pipino presenta 3 capitoli (I, 23, II, 41 e 64) che si trovano in un'altra posizione, rispettivamente al quinto, quarto e terzo capitolo del libro III, mentre i capitoli 42-43 del III libro sono stati omessi. Sono presenti annotazioni di almeno 2 o 3 diverse mani. Il manoscritto trasmette inoltre la Relatio di Odorico da Pordenone. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1253> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 690-698. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/author/franciscus-pipinus-n-1270-ca-m-1327-1328-author/20207 </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>, pp. 131-132. </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, pp. 24-25. </li><li><a href='https://imagoarchive.it/bibliografia.html#odoherty-the-viaggio-in-inghilterra'>O'DOHERTY 2009</a>, pp. 211-215. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-02-02T12:48:20.304Z"^^xsd:dateTime .

