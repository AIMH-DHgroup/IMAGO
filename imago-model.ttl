<https://imagoarchive.it/ontology/resources/manuscript/elescorial/realbibliotecadelmonasteriodesanlorenzodeelescorial/f.i.12/1764>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1915> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 764 coll., 14 ff. e misura 340x220 mm. Il testo è disposto su due colonne. Il codice riporta i libri I-XXII del De rerum naturis, ma con una importante lacuna che comprende la fine del capitolo 5 e i capitoli 6, 7 del libro VIII e i primi diciannove capitoli del libro IX e un'altra lacuna che si estende per parte del capitolo 2 del libro XIV fino a parte del capitolo 4 del XV libro. Il libro XXII s'interrompe al capitolo 15 alla frase \"et conteratur ydria super\". Il codice è composto da una seconda unità codicologica, del secolo XII, che tramanda in 14 ff. la Descriptio Mappe mundi di Ugo di San Vittore. Il manoscritto appartenne al giurista, bibliofilo e umanista Antonio Agustin (1517-1586), arcivescovo di Tarragona, dal cui catalogo si evince che già nel XVI secolo le due unità codicologiche erano riunite e il manoscritto di Rabano era privo degli ultimi fogli. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1915> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q3848863> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali e maiuscole in blu e rosso. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#kottje-ziegler-verzeichnis-der-handschriften'>KOTTJE-ZIEGLER 2012</a>, p. 50, n. 282. </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://rbmecat.patrimonionacional.es/cgi-bin/koha/opac-detail.pl?biblionumber=715" ;
        :last_mod_form         "2024-01-26T07:08:35.907Z"^^xsd:dateTime .

