<https://imagoarchive.it/ontology/resources/lemma/l2227>
        rdf:type       <http://imagoarchive.it/ilrmoo/F28_Expression_Creation> ;
        <http://erlangen-crm.org/211015/P14_carried_out_by>
                <http://www.mirabileweb.it/author/henricus-de-gundelfingen-n-1442-ca-m-29-8-1490-author/37257> ;
        <http://imagoarchive.it/ilrmoo/R17_created>
                <http://www.mirabileweb.it/title/elogium-seu-descriptio-confoederationis-helveticae-title/194522> ;
        <http://imagoarchive.it/ilrmoo/R18_created>
                <https://imagoarchive.it/ontology/resources/manuscript/romont/bibliothekdeskapuzinerklosters/cod._gundelfingen/11r12v> ;
        :has_abstract  "Il testo è un elogio della confederazione svizzera composto da Heinrich von Gundelfingen, umanista e professore di retorica all'Università di Friburgo fino al 1486. L'Elogium fu probabilmente scritto nel 1479, con l'intento di raccontare ed elogiare il trattato di alleanza tra Sigismondo del Tirolo e i Confederati svizzeri stipulato nel 1474. " .

<https://imagoarchive.it/ontology/resources/manuscript/stuttgart/wrttembergischelandesbibliothek/hb_vii._41/143v148v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1112> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto, esemplato a Bodenseegebiet, è membranaceo, consta di 148 ff. e misura 255x175 mm. Posseduto dalla cattedrale di Costanza e poi dall'abbazia di San Martin di Weingarten, è passato poi a Stuttgart, dove è attualmente conservato. Il manoscritto trasmette le opere di Beda il Venerabile, Explanatio Apocalypsis, ff. 1r-84v; In Acta apostolorum expositio, ff. 85r-143v; Nomina regionum atque locorum de Actibus apostolorum, ff. 143v-148v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1112> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q317950> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/nomina-regionum-atque-locorum-de-actibus-apostolor-title/2289 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.manuscripta-mediaevalia.de/?xdbdtdn!%22obj%2031900159%22&dmode=doc#|4" ;
        :last_mod_form         "2024-03-02T17:41:13.662Z"^^xsd:dateTime .

