        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#wagner-die-epistola-presbiteri-johannis'>WAGNER 2000</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#brewer-prester-john'>BREWER 2015</a>, p. 305. </li>" ;
