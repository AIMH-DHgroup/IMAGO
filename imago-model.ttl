        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/manuscript/oxford-bodleian-library-laud-misc-44-(s-c-545)-manoscript/12336 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 67-68. </li>" ;
        :has_url_manuscript    "https://digital.bodleian.ox.ac.uk/objects/71eabf20-160e-410e-97b5-8c6e47c0d503/" ;
        :has_url_manuscript_description
