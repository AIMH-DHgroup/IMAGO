<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/digby_201/13r288v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2277> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 289 ff. Il testo è disposto su due colonne. Il testo del Polychronicon arriva fino al 1451; il codice riporta inoltre un diagramma genealogico da Adamo ed Eva a Sem, f. 229r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
