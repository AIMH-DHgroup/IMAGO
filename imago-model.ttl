<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/bodl._57_(s.c._2004)/103v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-271> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da III, 219 ff. Il codice è una miscellanea di testi teologici e morali. Al f. 213v iscrizione di possesso, quasi cancellata, di Henry Jackson del Corpus Christi College di Oxford, 21 maggio 1600. Il manoscritto trasmette: 'Le rule seint Austin', f. 2r; Tre poesie francesi, f. 4v; Preghiera, f. 6v; glosse latine sull'Antico Testamento, ff. 11r, 20v, 64r, 81r, 95r; Alano di Lilla, Rhythmus de incarnatione Christi et de septem artibus, f. 20r; Una descrizione degli uffici e dei doveri del Giovedì Santo in un monastero, f. 12r; L'inno 'Ave maris stella' con un commento, f. 21r; Verba cuiusdam Sapientis, f. 28r; brano ritmico, f. 66v; Sermone, f. 73r; Credo, f. 74r; Sermoni e appunti, f. 84r; Proverbia Wiponis, f. 90r; Roger de Wesham, Instituta, f. 91r; breve poesia in inglese, f. 102v; Ps.-Bernardo, Meditationes piissimae de cognitione humanae conditionis, f. 105r; Bonaventura, Incendium Amoris, f. 132r; inni, f. 139r; Ps.-Bernard, De caritate, f. 145r; estratti di cronaca inglese, f. 176r; Roberto Grossatesta, Serm. 84, f. 178r-180r; Ugo di Fouilloy, De claustro animae (estratto), f. 182v; Un poema metrico che ridicolizza le lamentele della gente di Stoughton contro l'abbazia di Leicester nel 1296 o poco dopo, f. 191v; Moralium dogma philosophorum, f. 192v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-271> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-sanctorum-locorum-hierusalem-title/195074 </li><li><a href='https://imagoarchive.it/bibliografia.html#descriptio-sanctorum-locorum-hierusalem-2011'>Descriptio sanctorum locorum Hierusalem 2011</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_1588" ;
        :last_mod_form         "2024-04-04T15:03:15.767Z"^^xsd:dateTime .

