        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 126-127. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/dublin-marsh-s-library-z-3-1-5-manoscript/16032" ;
        :last_mod_form         "2024-01-30T07:42:25.735Z"^^xsd:dateTime .

