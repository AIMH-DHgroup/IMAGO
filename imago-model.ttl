<https://imagoarchive.it/ontology/resources/manuscript/napoli/bibliotecanazionalevittorioemanueleiii/xiii.h.79/1r133v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2335> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo, mm 245x170, scrittura minuscola umanistica posata. Primo possessore del codice fu Antonio Motta, a cui forse appartiene lo stemma presente al f. 1r. Il codice è arrivato nella Biblioteca Nazionale di Napoli solo nel 1989, quando fu acquistato dal Ministero per i Beni Culturali e Ambientali nell'ambito di un'azione di recupero di testimonianze culturali dell'Umanesimo napoletano. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2335> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2256644> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "A f. 1r è visibile uno stemma azzurro con tre stelle in oro. Rubrica maiuscola per la lettera D iniziale della Praefatio, in oro con motivi a girari bianchi su fondo azzurro, verde e rosa. Dalla rubrica si snoda un fregio breve, sovrastato nella parte superiore da un pappagallo che regge nel becco un filo con tre piccoli globi d'oro." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#manetti-de-terremotu-2012'>MANETTI, De terremotu 2012</a>, pp. 60-61 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/napoli-biblioteca-nazionale-vittorio-emanuele-iii--manuscript/176475" ;
        :last_mod_form         "2024-02-26T17:49:39.694Z"^^xsd:dateTime .

