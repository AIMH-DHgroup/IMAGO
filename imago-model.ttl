<https://imagoarchive.it/ontology/resources/manuscript/augsburg/universittsbibliothek/ii.1.2°_105/73r85r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-124> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da I, 188 ff. e misura 305x205 mm. Il codice presenta note marginali ascrivibili a più mani del XV secolo. Esemplato probabilmente intorno al 1463 nel monastero benedettino di St. Mang a Füssen e rilegato nello stesso monastero, al f. 1r ex libris: \"Iste liber est monasterii sancti Magni in Faucibus Alpium\". Il manoscritto trasmette: Walter Burley, Liber de vita et moribus philosophorum, ff. 1r-72v; la Descriptio Terrae Sanctae nella versione breve, ff. 73r-85r; Gerolamo, De situ et nominibus locorum Hebraicorum liber, ff. 85v-116v; Beda, Nomina regionum atque locorum de actibus apostolorum, ff. 116v-120v; Provinciale Romanum, ff. 121r-127r; estratti dei Mirabilia urbis Romae, ff. 127r-127v; Giovanni del Galles, Breviloquium de virtutibus antiquorum principum et philosophorum, ff. 127v-152v; Vita Aristotelis, ff. 169r-171r; Historia Alexandri Magni, ff. 176r-187r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-124> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2496283> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-burchardus-de-monte-sion-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://handschriftenportal.de/workspace" ;
        :last_mod_form         "2024-03-25T17:55:02.491Z"^^xsd:dateTime .

