<https://imagoarchive.it/ontology/resources/manuscript/padova/seminariomaggiorevescovile/74/1r27v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-182> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da III, 34, I' ff. e misura 253x192 mm. Il testo è disposto su due colonne di 36 righe. La legatura è del XVII secolo, con assi in cartone. Il codice proviene dalla biblioteca del conte Alfonso Alvarotti. Il manoscritto trasmette la redazione lunga della Descriptio di Burcardo da Monte Sion. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-182> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q3955046> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali filigranate, due ornate (ff. 1r, 14r), titoli in inchiostro rosso, stemmi ai ff. 1r, 13v. Al f.13v rappresentazione della città di Gerusalemme assediata dai crociati, su lamina d'oro. Ai ff.1r-14r iniziali figurate su fondo oro. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>, pp. 283-286. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.nuovabibliotecamanoscritta.it/Generale/ricerca/AnteprimaManoscritto.html?codiceMan=17819&tipoRicerca=S&urlSearch=pagCorrente%3D10.0%26codBiblioteca%3D19%26tipoRicerca%3DS%26area1%3D%26area2%3D%26area3%3D%26area4%3D%26language%3Dit%26ordinaDatazione%3Dfalse%26ordineInverso%3Dfalse&codice=&codiceDigital=" ;
        :last_mod_form         "2024-04-19T07:24:57.325Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/olomouc/kapitulnknihovna/m.ii.128/288r315v>
