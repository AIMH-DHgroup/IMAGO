        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 119 ff. Il manoscritto, che trasmette solo gli Otia imperialia, presenta due sostanziali lacune: al f. 26v la maggior parte di I, 24 e dei capitoli successivi fino all'inizio di II, 10 mancano, al f. 88v non presenta la maggior parte di III, 27 e tre quarti di III, 32. Sono presenti numerosi marginalia e correzioni.  " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1788> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#caldwell-manuscripts-of-gervase-of-tilburys-otia-imperialia'>CALDWELL 1962</a>,  </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b9068005h/f1.item.zoom" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-01-24T13:31:03.411Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/338/70r77v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1322> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 80 ff. e misura 425x295 mm. La copertina è in pelle scura su coperchi di legno, decorata con linee di corda e timbri. Il codice trasmette documenti dell'imperatore Carlo IV e le Civitates et castra, quae sunt in liga et societate in Tuscia contra dominum nostrum. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1322> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il manoscritto è decorato con miniature di Cristo giudice del mondo, emblemi del re Venceslao, raffigurazioni di imperatore ed elettori, illustrazioni di atti giuridici. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#httpswwwgeschichtsquellendestart'>GESCHICHTSQUELLEN</a>, https://www.geschichtsquellen.de/werk/3786 </li>" ;
