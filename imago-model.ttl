<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_3673/1r73v82r83r85r104v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2251> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 194 ff. e misura 295x190/200 mm. Esemplato in Inghilterra in scrittura gotica, al f. 193v nota: \"liber domini Iohannis lowe capelli & custodis cantarie sancti trinitatis in ecclesia sancti Nicholai anno domini 1466\", che data il manoscritto al 1466 o poco prima. Il codice riporta solo alcuni estratti del Polychronicon insieme a una concessione di proprietà, f. 4v; frammenti pseudo-patristici, f. 4v; profezie politiche e un elenco dei pianeti, f. 73v; estratti dalla Historia Scholastica di Pietro Comestore, ff. 74r-81v; brevi testi dell'esegesi scritturale e delle stelle, f. 83v; vari estratti teologici sulla natura delle cose, ff. 105r-117r; nota genealogica su Riccardo, duca di York, f. 117, e su Edoardo III, f. 117v; altri estratti sulla natura delle cose, ff. 118r-130v; testo sul clero, ff. 131r-132v; testo sul matrimonio, ff. 132v-134v; testo sulla consacrazione della chiesa, ff. 134v-136v; testo sul testamento, ff. 139r-142v; Brevi cenni sul vizio, ff. 142v-143v; estratto sulla vita di san Cutberto, ff. 144r-151v; brevi cenni sulla natura delle cose, ff. 151r-152r; brevi note su re e imperatori, ff. 152r-152v; vari testi sulla Chiesa, ff. 153r-164v; testo sul Purgatorio, ff. 165r-168v; testo sulla creazione, ff. 169r-171r; Testi storici, ff. 171r-177v; cronaca di Inghilterra fino al regno di Edoardo III, ff. 179r-193v; breve testo sui re d'Israele, ff. 194r-194v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2251> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 84r mappamondo. Al f. 48r schema disegnato a linee dell'arca di Noè, in inchiostro rosso. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/polychronicon-ranulphus-higden-m-12-3-1364-ca--title/4071 </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/dlDisplay.do?vid=IAMS_VU2&search_scope=default_scope&docId=IAMS040-002049505&fn=permalink" ;
        :last_mod_form         "2024-04-15T16:47:36.966Z"^^xsd:dateTime .

