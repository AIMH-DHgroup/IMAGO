        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/london-british-library-add-19513-manoscript/19087" ;
        :last_mod_form         "2024-04-15T11:50:07.379Z"^^xsd:dateTime .

