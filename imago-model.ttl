<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._6800/88r95r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1674> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da II, 96 ff. e misura 290x212 mm. Esemplato in Italia in scrittura umanistica corsiva, al f. 1 il codice riporta: \"Liber Iacobi de Cruce Bononiensis\", forse con riferimento a Iacopo Croce, professore di retorica e poesia all'Università di Bologna, morto nel 1525, mentre al f. 98 il nome inciso sotto l'epitaffio \"Hieronymus Vicecomes Juris Professa\" è forse quello di Girolamo Visconti, dedicatario dell'Opusculum annotationum di Iacopo Croce negli inni Callimachi. Il codice trasmette inoltre: Svetonio, Vitae Cesarum, ff. 1r-71r; Ausonio, Monosticha de XII Caesaribus, f. 71v; Libellus de vita et moribus imperatorum breviatus ex libris Sexti Aurelii Victoris a Cesare Augusto usque ad Theodosium, ff. 73r-87v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1674> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Vat.lat.6800/0001" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdatae21c6db49400639e29d4d5895174231623c97ab9" ;
        :last_mod_form         "2024-04-05T07:07:05.854Z"^^xsd:dateTime .

