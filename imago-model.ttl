<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/arundel_123/24r33r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1979> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato 96 ff. Il codice riporta solo il I libro dell'Imago Mundi, senza però il capitolo \"De coelo et de signis\". Il manoscritto trasmette inoltre: Isidoro di Siviglia, Etymologiae, ff. 5r-22r; Prisciano, Quaedam de orbis dimensione, ff. 22v-24r; Esopo, De vita et morte Alexandri Magni liber fabulosus, ff. 43r-71r; Epistola Aristotelis ad Alexandrum, ff. 71v-73r; Responsa ad quaestiuncula imperatoris Hadriani, f. 95r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1979> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002039406&indx=1&recIds=IAMS040-002039406&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=arundel%20123&dum=true&dstmp=1681979986885" ;
