<https://imagoarchive.it/ontology/resources/print_edition/pe-24>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Roma instaurata. De origine et gestis Venetorum. Italia illustrata." ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Nuova edizione della Roma instaurata allestita a Verona tra la fine del 1481 e l'inizio del 1482: dalla tipografia di Bonino de' Bonini fuoriuscirono due volumi, curati dall'intellettuale veronese Giovanni Antonio Panteo, contenenti, il primo, la Roma instaurata e il De origine et gestis Venetorum, mentre il secondo l'Italia illustrata. BIONDO, Italia illustrata 2011, pp. 489-490: \"dalla prefazione del Panteo all'edizione veronese apprendiamo che l'umanista fu incaricato dalla tipografia del de' Bonini di vagliare accuratamente la correttezza testuale di un manoscritto della Roma instaurata e dell'Italia illustrata procurato per l'edizione delle opere di Biondo, affinché dal testo di questo codice si potesse ricavare una stampa da immettere sul mercato in numerose copie [...]. L'edizione del Panteo, con le tre opere di Biondo, ebbe certamente parecchia fortuna, come dimostra la riedizione delle medesime tre opere che fu stampata il 28 febbraio 1503 per i tipi di Bernardino de' Vitali e l'immediata ristampa nella tipografia di Gregorio de' Gregori il 1° luglio 1510, due edizioni veneziane pubblicate sotto gli auspici del doge di Loredano Loredan. Le due cinquecentine veneziane, infatti, non solo riproducono la medesima scelta editoriale dell'incunabolo veronese, ma, per quanto riguarda l'Italia illustrata, riproducono esattamente il testo curato dal Panteo [...]\". Per quanto riguarda la Roma instaurata, secondo l'ultimo editore Fabio della Schiava, il codice sul quale il Panteo allestì il testo della stampa è il ms. Ashb. 291. La stampa veronese costituisce quindi l'archetipo della tradizione a stampa e, esclusa l'editio princeps curata da Gaspare Biondo, \"le stampe della Roma instaurata discendono dunque tutte da F1 [= Ashb. 291] e si possono dire descriptae\" (BIONDO, Roma instaurata, 2020, p. CXXVI)." ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/roma-instaurata-blondus-flavius-n-1392-m-4-6-1463-title/3295> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-24> ;
        :compiled_form              "Elena Vagnoni" ;
        :has_figure_note            "" ;
        :has_introduction_note      "" ;
        :has_other_contents         "Italia illustrata; De origine et gestis Venetorum" ;
        :has_primary_source         "ms. Ashb. 291" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 326-328 </li><li><a href='https://imagoarchive.it/bibliografia.html#biondo-roma-instaurata-2020'>BIONDO, Roma instaurata 2020</a>, p. LXXIII </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Biondo Flavio" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-24> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-24> ;
        :last_mod_form              "2024-02-26T10:07:12.896Z"^^xsd:dateTime .

