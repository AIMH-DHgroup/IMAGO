<https://imagoarchive.it/ontology/resources/manuscript/milano/bibliotecaambrosiana/f_129_sup._/189r194r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
