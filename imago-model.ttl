        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/madrid-biblioteca-nacional-de-españa-ms-12739-manoscript/33599" ;
        :last_mod_form         "2024-03-26T14:53:30.462Z"^^xsd:dateTime .

