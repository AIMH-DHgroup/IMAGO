<https://imagoarchive.it/ontology/resources/print_edition/pe-170>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Italia illustrata" ] ;
        <http://erlangen-crm.org/211015/P2_has_type>
                <https://imagoarchive.it/ontology/resources/print_edition/edition/prima_edizione_/_editio_princeps> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "" ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/italia-illustrata-title/5381> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-170> ;
        :compiled_form              "Elena Vagnoni" ;
        :has_figure_note            "" ;
        :has_introduction_note      "[a] Reverendo in Christo patri: domino Dominico Episcopo Brixiensi: Gaspar Blondus: Salutem dicit. [...] Vale. Quarto Idus Decembris. MCCCCLXXIIII. Romae. [b] Iohannes Philippi de Lignamine Siculus Messanensis. Ad sanctissimum dominum nostrum Dominum Sixtum quartum Pontificem maximum. [...] Vale." ;
        :has_other_contents         "Editio princeps dell'Italia illustrata curata da Gaspare Biondo, primogenito dell'umanista, che si rivolge al tipografo-umanista messinese Giovanni Filippo De Lignamine, stabilitosi a Roma dopo la sua formazione avvenuta alla corte aragonese di Alfonso. Si rilevano due diversi strati bibliologici: alcuni esemplari dell'editio princeps presentano la dedica del tipografo al pontefice Sisto IV, altri, invece, la lettera di dedica di Gaspare al vescovo bresciano Domenico Domenichi, amico di Biondo. Nella lettera si apprende la volontà di Gaspare di divulgare l'opera \"per librorum impressores\" per evitare che \"cum vitio multiplicaretur\". Gaspare dichiara di essersi servito di alcuni esemplari manoscritti ricevuti in eredità dal padre e di essere intervenuto per sanare corruttele causate dai copisti: \"in realtà l'intervento di Gaspare di normalizzazione e di revisione stilistica si rivela essere molto più forte di quanto il curatore dichiari nella lettera di dedica: l'edizione di Gaspare infatti fu rivista in molti punti dallo stesso curatore e, probabilmente, in collaborazione con l'erudito tipografo. [...] il testo dell'Italia  illustrata pubblicato da Gaspare sia in realtà completamente differente da qualsiasi altro testimone manoscritto superstite dell'opera, e diverso anche da tutte le successive edizioni del testo di Biondo. In particolare, la revisione stilistica di Gaspare si concentrò soprattutto nel tentativo di rendere più fluido ed elegante il latino del padre, molto spesso caratterizzato da una sintassi monotona e serrata\" (BIONDO, Italia illustrata 2011, p. 325). " ;
        :has_primary_source         "" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 321-326 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Biondo Flavio" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-170> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-170> ;
        :last_mod_form              "2024-02-26T09:58:28.608Z"^^xsd:dateTime .

