<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_3600/2r237r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2249> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 4, 242 ff. e misura 270x175 mm. Il testo è disposto su due colonne. Il Polychronicon è riportato con la continuazione dell'incoronazione di Enrico VI nel 1422. Sono presenti brevi note latine a margine." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2249> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Disegni a inchiostro dell'Arca di Noè (f. 63r). Iniziale del puzzle in blu e rosso che racchiude una foglia di quercia (f. 2r). Grande puzzle iniziale in rosso e marrone con decorazione foliata in inchiostro marrone (ff. 87r, 138r, decorazione che si estende nel margine su f. 87r). Iniziali del puzzle senza fioritura della penna (ff. 42r, 58r). Grande iniziale rossa (f. 114v). Iniziali più piccole in blu con penna rossa fiorente. Iniziali colorate in rosso o blu (solo in rosso da f. 86r). Riempitivi di linea in rosso e blu (ff. 2r-85v)." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/polychronicon-ranulphus-higden-m-12-3-1364-ca--title/4071 </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002049432&indx=1&recIds=IAMS040-002049432&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Harley%203600&dum=true&dstmp=1685356959298" ;
        :last_mod_form         "2024-04-15T16:46:17.607Z"^^xsd:dateTime .

