<https://imagoarchive.it/ontology/resources/manuscript/chicagoil/thenewberrylibrary/ayer_collection_740/5r116v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1808> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da I, 159, I' ff. e misura 300x315 mm, mutilo dei ff. 251-253, sono bianchi i ff. 1-4v, 117-120v, 124r-128v, 131r-134v; 142r-142v, 143v-144v; 148r-149v; 156v-159v. Esemplato in Italia da copisti diversi, il testo tolemaico presenta note marginali e maniculae di foggia umanistica. Il manoscritto trasmette inoltre una tavola astronomica, f. 121r; Iohannes de Lineriis, Canon on primum mobile, ff. 122-123r; Canones horoscopi instrumenti, ff. 129r-130v; Gerardo da Cremona, Theoria planetarum, ff. 135r-141r; Tavola astronomica delle eclissi di sole e luna, f. 141v; Tavola astronomica, f. 143r; Iacopo Dondi dall'Orologio, De fluxu et refluxu maris, ff. 150r-155v; Tavola delle maree, ff. 155v-156r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1808> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q616527> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 78-79. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-02-05T14:23:52.205Z"^^xsd:dateTime .

