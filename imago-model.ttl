        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b100732961" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/paris-bibliothèque-nationale-de-france-lat-2333-a-manoscript/123366" ;
