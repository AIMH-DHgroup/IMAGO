<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/royal_13_a_i/51v78r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1704> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da IV, 98, IV' ff. e misura 170x110 mm. Il codice è esemplato in carolina minuscola da due mani, che scrivono i ff. 2r-78r e 78v-98v. La rilegatura è successiva al 1600. Esemplato in Inghilterra, il codice comprende quattro opere che formano un compendio delle leggende di Alessandro Magno in latino: Pseudo-Callistene, Historia Alexandri Magni, ff. 2r-51v; Epistola Alexandri ad Aristotelem, ff. 51v-78r; Alexandri et Dindimi collatio, ff. 78v-94v; raccolta di testi latini dell'XI secolo che registrano la nascita di Alessandro Magno, la sua visita a Gerusalemme e gli eventi successivi alla sua morte. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1704> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Un disegno a inchiostro a tutta pagina che precede il testo al f. 1v, raffigurante un re, verosimilmente Alessandro Magno, seduto con corona, scettro e globo, e una donna, forse la personificazione della filosofia, con in mano un pennello. Iniziali in verde e alcune con decorazione in rosso, blu o viola. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li>" ;
        :has_url_manuscript    "https://www.bl.uk/manuscripts/FullDisplay.aspx?ref=Royal_MS_13_A_I&index=0" ;
        :has_url_manuscript_description
                "https://www.bl.uk/manuscripts/FullDisplay.aspx?ref=Royal_MS_13_A_I&index=0" ;
        :last_mod_form         "2023-03-20T20:42:08.362Z"^^xsd:dateTime .

