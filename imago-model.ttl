<https://imagoarchive.it/ontology/resources/manuscript/dubrovnik/bibliotekasamostanamalebrace/87/1r87v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
