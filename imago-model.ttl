<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/1180/50r56v204r220r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2050> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 223 ff. e misura 452x298 mm. Il codice trasmette il I e il II libro dell'Imago mundi e solo alcuni estratti del III e contiene inoltre: Biblia Sacra latina et Paralipomena II, ff. 1r-2r; Biblia Sacra latina: Proverbia, Ecclesiastes, Canticum canticorum, Sapientia, Jesus Sirach, ff. 2r-49v; Chronicon a mundo creato usque ad annum 1355, ff. 56r-73v; Catalogus paparum usque ad Gelasium II, ff. 74r-76v; Catalogus imperatorum et paparum incipiens ab Italo, Jano, Saturno et regibus Romanis et contiuaturs usque ad Fridericum II et Honorium III, ff. 77r-78v; Biblia Sacra latina: Tobias, Judith, Esther, Esdras, Machabaei, ff. 79r-146v; De civitatibus et vicis transmarinis cum catalogo patriarcharum Hierosolymitanorum usque ad Fulcherim, ff. 146v-151v; Collectio decretorum conciliorum, decisionum paparum et de statibus mundi, ff. 152r-157v;  Non habemus regem nisi Caesarem, f. 158r; Passio Domini secundum Necodemum, adiecta Pilati ad Claudium epistola, ff. 158r-167r; Tractatus de coniugio, fundatus super conciliorum decretis, paparum decisionibus et patrum sententiis, ff. 167r-177v; Tractatus de sacrilegiis, ff. 177v-181v; De Missa, ff. 181v-184v; Varia: Symbolum, Epistola Clementis papae ad Jacobum, De libero arbitrio, De tribus vocationibus, ff. 184v-199v; Tractatus de antiquis aedificiis et mirabilibus urbis Romae, ff. 199v-204r; Tractatus de computo ff. 220r-223v." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2050> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "https://digital.onb.ac.at/RepViewer/viewer.faces?doc=DTL_9553678&order=1&view=SINGLE" ;
        :has_url_manuscript_description
                "https://manuscripta.at/hs_detail.php?ID=5133" ;
        :last_mod_form         "2024-04-02T06:16:11.322Z"^^xsd:dateTime .

