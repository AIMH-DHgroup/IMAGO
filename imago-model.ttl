<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/lat._hist._e._1/1v31v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
