<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._2053/1r207v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1814> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 177 ff. e misura 273x 182 mm. Il codice è copiato in littera antiqua da una sola mano. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1814> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali in oro decorate a «bianchi girari» all' inizio di ciascun libro; iniziali minori in blu e titoli dei paragrafi in rosso. Al f. 1r iniziale in oro ornata a «bianchi girari»; nel margine inferiore stemma di Giulio II contornato di motivi floreali e festoni; sotto le insegne compare un altro stemma, abraso ma ancora parzialmente visibile. Al f. 3r nel margine inferiore medaglione, di età successiva, con ritratto di Giulio II. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 81-82. </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Vat.lat.2053/0001" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/224855" ;
        :last_mod_form         "2024-02-05T14:32:52.701Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/wrocaw/bibliotekauniwersytecka/262/58v63v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-911> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da I, 78, I ff. Il codice è una miscellanea di vari testi, tra cui: Aitone da Corico, Flos historiarum terre Orientis, ff. 1r-33r; Epistola presbiteri Iohannis, ff. 66r-68r; epistole, estratti di testi di vario genere. L’interesse del compilatore del codice è per la maggior parte rivolto all’Oriente, a cui sono dedicate in questo contesto opere di diverso genere.  Il testo di Fretello, trasmesso nella seconda redazione, è mutilo a causa della caduta di alcuni fogli. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-911> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1720553> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#trovato-sulla-genealogia-e-la-cronologia'>TROVATO 2012</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#yolles-latin-literature-and-frankish-culture'>YOLLES (PhD thesis) 2015</a>, p. 135. </li><li><a href='https://imagoarchive.it/bibliografia.html#boeren-rorgo-fretellus-de-nazareth'>RORGO FRETELLO, Descriptio 1980</a>, p. 49. </li><li><a href='https://imagoarchive.it/bibliografia.html#greco-2021-2022'>GRECO (tesi di dottorato) 2022</a>, pp. 80-81. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-02-01T13:55:19.396Z"^^xsd:dateTime .

