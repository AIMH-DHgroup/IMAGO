        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/imago-mundi-honorius-augustodunensis-presbyter-et--title/3444 </li><li><a href='https://imagoarchive.it/bibliografia.html#brewer-prester-john'>BREWER 2015</a>, p. 306. </li><li><a href='https://imagoarchive.it/bibliografia.html#wagner-die-epistola-presbiteri-johannis'>WAGNER 2000</a>,  </li>" ;
        :has_url_manuscript    "" ;
