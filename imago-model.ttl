<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/royal_13.e.ix/5r22r25v26v28r40r72r77v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1777> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                " Il manoscritto membranaceo è formato da III, 326, I' ff. e misura 350x315 mm. Esemplato nell'abbazia di St. Alban, il codice potrebbe essere stato supervisionato da Thomas Walsingham, monaco e cantore (1360-1425 ca.). Il manoscritto fu presentato al British Museum da Giorgio II nel 1757 come parte della Old Royal Library. Trasmette inoltre  le Profezie di Merlino, le Visioni di Thomas Becket, la Vita di Maometto, la Cronaca di Martin Polono, l'Historia Aurea di Giovanni di Tynemouth e l'Itinerarium di Mandeville.  " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1777> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali di puzzle di grandi dimensioni in rosso e blu con penna rossa (ff. 5, 28, 40, 78, 102, 116, 177, 203). Numerose iniziali più piccole in rosso o blu con penna fiorente nell'altro colore. Rubriche in rosso. Alcune prime lettere di rubriche evidenziate in giallo." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/otia-imperialia-gervasius-tilberiensis-n-1152-ca-m-title/4608 </li><li><a href='https://imagoarchive.it/bibliografia.html#caldwell-manuscripts-of-gervase-of-tilburys-otia-imperialia'>CALDWELL 1962</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#tzanaki-mandevilles-medieval-audiences'>TZANAKI 2003</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002106890&indx=10&recIds=IAMS040-002106890&recIdxs=9&elementId=9&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Royal%2013%20E&dum=true&dstmp=1679779383336" ;
        :last_mod_form         "2024-01-23T16:45:58.816Z"^^xsd:dateTime .

