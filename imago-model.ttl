        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-132> ;
        :compiled_form              "Sara Crea" ;
        :has_figure_note            "L'edizione è decorata con quattro xilografie che rappresentano l'arrivo di Colombo sull'isola di Hispania e l'accoglienza che gli riservarono gli indigeni; una delle caravelle in primo piano che solca il mare dove si trovano le isole nominate Ferranda, Ysabella, Hispania, Conceptionis Marie e Salvatorie; un primo piano della nave denominata \"Oceanica classis\"; la rappresentazione dell'isola Hispania. " ;
        :has_introduction_note      "" ;
        :has_other_contents         "" ;
        :has_primary_source         "" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#gesamtkatalog-der-wiegendrucke'>Gesamtkatalog der Wiegendrucke</a>, https://www.gesamtkatalogderwiegendrucke.de/docs/GW07177.htm </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Christophorus Columbus " ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-132> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-132> ;
        :last_mod_form              "2024-03-23T09:00:12.672Z"^^xsd:dateTime .

