        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/paris-bibliothèque-nationale-de-france-lat-4977-manoscript/19396" ;
        :last_mod_form         "2024-03-26T22:21:22.735Z"^^xsd:dateTime .

