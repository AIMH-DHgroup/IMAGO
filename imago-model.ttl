        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 282-283 </li><li><a href='https://imagoarchive.it/bibliografia.html#biondo-roma-instaurata-2020'>BIONDO, Roma instaurata 2020</a>, p. LXXXI </li>" ;
