<https://imagoarchive.it/ontology/resources/manuscript/cambridge/universitylibrary/ff._vi._51/61r79r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2064> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 3, 60, 294 ff. Questo codice composito è composto da due parti distinte che furono scritte verso la fine del XIV secolo in Inghilterra (ff. 4r-63v e ff. 64r-92v). Contiene opere teologiche di Bernardo di Chiaravalle, il primo libro dell'Imago mundi di Onorio di Autun e una raccolta inedita di estratti dal Breviloquium di Bonaventura. Il manoscritto presenta anche diverse ricette cosmetiche e mediche dell'inglese medio che furono aggiunte alla fine del XV o all'inizio del XVI secolo (ff. 2r, 83v, 92v-93v). Rilegatura 'Cambridge' dell'inizio del XVIII secolo in pelle di vitello marrone tinta con due pannelli a cieco costituiti da una grande cornice rettangolare di 2 linee attorno ai bordi della copertina con una cornice rettangolare più piccola con motivi floreali impressi alla cieca negli angoli al centro. Il codice è uno dei manoscritti di Richard Holdsworth (1590-1649), maestro dell'Emmanuel College. Acquisito dalla Biblioteca Universitaria nel luglio 1664.\r\n\r\n\r\n\r\n" ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2064> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1028334> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-04-02T06:39:23.635Z"^^xsd:dateTime .

