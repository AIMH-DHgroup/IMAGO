<https://imagoarchive.it/ontology/resources/manuscript/milano/bibliotecaambrosiana/o_83_sup./14r29r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1461> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da I, 83 ff. e misura 218x150 mm. Esemplato in Italia Settentrionale, probabilmente a Milano, in scrittura umanistica semicorsiva. La legatura è in cartone e pergamena del XVIII secolo. Il codice entrò in Ambrosiana nel 1603, come si legge al f. Ia: \"Felicibus auspiciis illustrissimi card. Federici Borrhomaei Olgiatus vidit 1603\". Il codice trasmette anche l'Isagocicon morabilis disciplinae di Leonardo Bruni, ff. 1r-13v, il De vita ignorantia di Pier Candido Decembrio, ff. 29v-37r, e le Divinae institutiones di Lattanzio Firmiano, ff. 38r-81r. Il codice trasmette solo il capitolo su Milano del Chronicon di Benzo d'Alessandria." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1461> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q815611> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/chronica-a-mundi-principio-usque-ad-tempora-henric-title/5466 </li><li><a href='https://imagoarchive.it/bibliografia.html#petoletti-il-chronicon-di-benzo-dalessandria'>PETOLETTI 2000</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://ambrosiana.comperio.it/opac/detail/view/ambro:catalog:81774" ;
        :last_mod_form         "2024-03-22T18:23:00.26Z"^^xsd:dateTime .

