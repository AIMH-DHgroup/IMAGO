<https://imagoarchive.it/ontology/resources/manuscript/elescorial/realbibliotecadelmonasteriodesanlorenzodeelescorial/f._i._12/765r773v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-236> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 764 coll., 14 ff. e misura 340x220 mm. Il testo è disposto su due colonne. Il codice trasmette anche i libri I-XXII del De rerum naturis di Rabano Mauro, ff. 1-764, e, nella seconda unità codicologica riporta inoltre la Descriptio mappe mundi. Il manoscritto appartenne al giurista, bibliofilo e umanista Antonio Agustin (1517-1586), arcivescovo di Tarragona, dal cui catalogo si evince che già nel XVI secolo le due unità codicologiche erano state riunite.\r\nPosseduto dall'arcivescovo Antonio Agustín (1517-1586).\r\n" ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-236> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q3848863> ;
        :compiled_form         "Rita Nicoli" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#gautier-dalche-descriptio-mappae-mundi-de-hugo-de-saint-victor'>UGO DI SAN VITTORE, Descriptio 1988</a>, p. 1 ss </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, https://www.mirabileweb.it/manuscript/el-escorial-real-biblioteca-de-san-lorenzo-de-el-e-manuscript/ </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
