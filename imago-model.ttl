<https://imagoarchive.it/ontology/resources/manuscript/brugesbrugge/bibliotheekvanhetgrootseminarie/127/5_«codex_aldenburgensis»/9r198v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2194> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto composito è membranaceo ed è formato da 237 ff. Al f. 1r ex libris \"Hic liber pertinet ad abbatiam Aldenbrinxgensenii\", con riferimento all'abbazia dei benedettini di Bruges. Il codice trasmette in modo incompleto il Liber Floridus e riporta estratti di varie opere, soprattutto di carattere storiografico: estratto dal De natura rerum di Isidoro di Siviglia, f. 1v; estratto dal De natura rerum di Beda, ff. 1v-2r; estratto da Teofilo di Antiochia, Ad Autolycum, f. 2v; Adam et Evae, ff. 3r-6r; Mirabilia urbis Romae, ff. 6r-11v; estratti dalla Historia Machabeorum e Historia Scholastica, ff. 12r-13v; descrizione dell'isola di Creta, ff. 14r-16v; estratto da Giovanni di Hildesheim, Historia trium regum, ff. 17v-19v; estratto da Nennio, Historia Brittonum, ff. 16v-17v; racconto dei primi miracoli di Cristo, f. 19v; descrizione di Gerusalemme, ff. 20v-21v; Epistola del Prete Gianni, ff. 21v-23v; Chronicon Aldenburgensis, f. 24r. La seconda unità trasmette: Calendario, ff. 1r-7v; il Liber Floridus, ff. 9r-198v e Chronicon Aldenburgensis monasterii maius, ff. 199r-205v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2194> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2525656> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1r miniatura con la mappa dello zodiaco, f. 1v miniatura con orologio, f. 2r miniatura con la mappa dei venti, al f. 2v miniatura con la Genesi, f. 14r miniatura con il labirinto, f. 14v miniatura con la mappa TO e il ciclo delle stelle, f. 18v miniatura con la mappa di Gerusalemme durante le crociate. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-floridus-lambertus-audomarensis-canonicus-fl-title/5759 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://mmfc.be/ms/mmfc-18818" ;
        :last_mod_form         "2024-04-02T15:36:16.914Z"^^xsd:dateTime .

