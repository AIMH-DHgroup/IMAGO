<https://imagoarchive.it/ontology/resources/manuscript/holkham/holkhamhall/475/839>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-839> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo e monografico; fogli non numerati. Il codice è stato esemplato nel porto di Chio nell'agosto del 1429 da Nicolò Scanavino di Monterosso, secondo quanto attestato dalla subscriptio a f. 147v: «Nicolaus Scanavinus de Monte rubeo scripsit in portu Chij. sub anno domini .M°.cccc°.xx°viiij. die xvij. augusti. in Nave de Auria.». Il manoscritto, dopo essere migrato in Inghilterra, passò in Francia, dove appartenne ad Armand Dubourdin, dottore di medicina di Montpellier. Fa attualmente parte del patrimonio librario del conte di Leicester, nella biblioteca della country house di Holkham Hall. È il codice datato più antico del \"Liber insularum archipelagi\"." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-839> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1624722> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "A f. 2r la 'C' iniziale include una raffigurazione maniaturistica di Buondelmonti in abito monastico con il suo \"Liber\", in stile tipicamente inglese, probabilmente aggiunta dopo la realizzazione del codice a Chio ma prima della sua migrazione in Francia. Mappe del \"Liber insularum\"." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ragone-g-liber-insularum'>RAGONE 2002</a>, p. 181, n. 12 </li><li><a href='https://imagoarchive.it/bibliografia.html#hassal-1970'>HASSAL 1970</a>, p. 13, tavv. 137-138 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. IV, p. 45 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-03T17:04:05.004Z"^^xsd:dateTime .

