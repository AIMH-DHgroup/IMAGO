<https://imagoarchive.it/ontology/resources/manuscript/padova/bibliotecacivica/b.p._1223/xiirxiiivpp5356>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Miscell. Opuscolo. padovano. MSS" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-91> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da II, 200, I ff. e misura 306x208 mm; foliazione a numeri romani e una paginazione più recente in numeri arabi. Legatura in pelle ricoperta di carta marmorizzata nei toni blu, bianco e nero. Nella controguardia interna \"ex libris\" di Antonio Piazza. Il codice è una miscellanea di testi umanistici che raccoglie soprattutto scritti di Vergerio e le epistole di Sicco Polenton (pp. 171-173 e 181-200). I testi di Vergerio e Polenton sono intervallati da lettere, orazioni ed excerpta di altri autori, tra cui: Lattanzio, Petrarca, Leonardo Della Seta, Coluccio Salutati, Leonardo e Bernardo Giustinian, Francesco Barbaro, Giovanni da Spilimbergo, Pio II, Guarino Veronese, Antonio Panormita. Il De situ urbis Iustinopolitane ha nel codice il titolo di De situ et conditione urbis Iustinopolitanae e riporta in appendice il Textus Iustini, p. 56; a margine, come nel cod. B. 62 della Biblioteca Capitolare di Padova, il manoscritto riporta le postille al presunto De origine provinciarium di Lorenzo Valle, ma in realtà del De origine urbium Italiae. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-91> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q21328933> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#vergerio-2023'>VERGERIO, De situ Iustinopolitane 2023</a>, pp. 17-18. </li><li><a href='https://imagoarchive.it/bibliografia.html#reserch-aids-pierpaolo-vergerio-the-elder'>McMANAMON 2016</a>, pp. 23-27. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, https://www.mirabileweb.it/manuscript/padova-biblioteca-civica-b-p-1223-manuscript/82858 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, II, p. 23ab. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/padova-biblioteca-civica-b-p-1223-manuscript/82858" ;
        :last_mod_form         "2024-03-06T15:07:32.386Z"^^xsd:dateTime .

