<https://imagoarchive.it/ontology/resources/print_edition/pe-254>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Descriptio insule Crete et Liber insularum, cap. XI: Creta" ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Edizione critica parziale del \"Liber insularum\", dedicata solo all'isola di Creta (cap. XI)." ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/liber-insularum-archipelagi-title/4379> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-254> ;
        :compiled_form              "Alessio Luca Bartelloni" ;
        :has_ecdotic_type           <https://imagoarchive.it/ontology/resources/print_edition/edition/edizione_critica_commentata_con_traduzione> ;
        :has_figure_note            "Tra le pp. 224 e 225 del volume è presente un foglio ripiegabile che riproduce efficacemente l'itinerario di Buondelmonti a Creta, su una mappa stilizzata dell'isola completa di didascalie." ;
        :has_introduction_note      "" ;
        :has_other_contents         "Il volume è composto da tre parti: nella prima (pp. 7-73), l’autrice offre una panoramica storica di Creta agli inizi del XV secolo con uno sguardo alle strutture amministrative, sociali, economiche e alla situazione religiosa dell’isola, seguita da una sezione sulla vita e i viaggi di Buondelmonti (con particolare attenzione all’itinerario cretese descritto nell’opera), per poi concludere con un capitolo dedicato alla scrittura dell’autore; la seconda parte (pp. 75-215) presenta la Nota al testo e le edizioni critiche della Descriptio (pp. 97-196) e del cap. XI del Liber insularum, dedicato a Creta (pubblicato in due differenti versioni una di seguito all’altra: pp. 199-203, 204-215), entrambe corredate da apparati critici e da traduzione in francese; la terza parte (pp. 217-320) fornisce un articolato commento ai testi e una conclusione incentrata sulla fortuna e l’influenza di Buondelmonti nelle generazioni successive. Completano il volume una ragionata bibliografia ripartita in nove sezioni, l’indice dei nomi e diverse tavole illustrate." ;
        :has_primary_source         "Descriptio insule Crete: Biblioteca Apostolica Vaticana, ms. Chigiano F. IV. 74, ff. 25r-50v; Firenze, Biblioteca Medica Laurenziana, ms. Pluteo 29.42, ff. 1v-28r; Biblioteca Apostolica Vaticana, ms. Rossiano 703, ff. 1r-25r; ms. ex-Baden; Venezia, Biblioteca Nazionale Marciana, ms. lat. X, 124 (=3177), ff. 355r-362r.\r\n\r\nLiber insularum archipelagi (Creta, cap. XI): Biblioteca Apostolica Vaticana, ms. Chigiano F. IV. 74; ms. ex-Baden; Milano, Biblioteca Ambrosiana, ms. A 219 inf.; Holkham, Holkham Hall, ms. 475; Paris, Bibliothèque Nationale, mss. latt. 4823, 4824, 4825, ms. lat. nouv. acq. 2383, ms. Cartes et Plans, Rés. Ge. FF 9351; Istanbul, Topkapı Sarāyı Kütüphanesi, ms. Seragliensis gr. 24 (ex Biblioteca del Serraglio di Costantinopoli); Venezia, Biblioteca Nazionale Marciana, mss. latt. XIV, 45 (=4595) e X, 124 (=3177); Firenze, Biblioteca Medicea Laurenziana, ms. Plut. 29.25, Biblioteca Nazionale Centrale di Firenze, ms. II, II, 312; Biblioteca Riccardiana, ms. 673." ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#van-spitael-m-a-descriptio'>BUONDELMONTI, Descriptio 1981</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#bartelloni-al-descriptio-insule-crete'>BUONDELMONTI, Descriptio (tesi di laurea) 2022</a>, pp. 46-48 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Cristoforo Buondelmonti" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-254> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-254> ;
        :last_mod_form              "2024-03-12T13:52:53.248Z"^^xsd:dateTime .

