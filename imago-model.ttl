<https://imagoarchive.it/ontology/resources/manuscript/dublin/trinitycollege/574/124r208v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1142> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto risale all'inizio del XV secolo e fu esemplato presso l'abbazia cistercense di Santa Maria a Dublino. Il codice riporta una miscellanea di testi, prevalentemente legati alla storia inglese e irlandese come l'Historia regum Britannie e le Prophetiae Merlini di Goffredo di Monmouth, canzoni sul re di Scozia, l'Expugnatio Hibernica e la Topographia Hibernica nella prima versione. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1142> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q81165027> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/topographia-hiberniae-title/4005 </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li>" ;
        :has_url_manuscript    "https://digitalcollections.tcd.ie/concern/works/ft848s23x?locale=zh" ;
        :has_url_manuscript_description
                "https://digitalcollections.tcd.ie/concern/works/ft848s23x?locale=zh" ;
        :last_mod_form         "2024-03-28T14:35:44.574Z"^^xsd:dateTime .

