<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._4126/2303>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2303> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 296 ff. e misura 319x185 mm. Il codice è stato compilato a York sotto la direzione di Robert de Populton, che ha vergato i ff. 10-32, 246-252, 282-295 e i ff. 133v-134 e a cui si devono i numeri delle rubriche e le annotazioni. Il codice trasmette testi di vario genere: Decretale di Innocenzo VI; decretale di Benedetto XI; decretale di Bonifacio VIII; Versus de praestantia regni Scotorum; decretale di Giovanni XXII; Tractatus de quodam prodigio; Versus de diversis signis et prodigiis mundi; Prisciano, Cosmographia; Itinerarium Antonini; Versus de tribus mundi partibus et de distributione totius orbis, montium et fluminum; Mensura totius Terrae secundum Romanos doctissimos; estratti da Orosio; Chronica de origine antiquorum Pictorum; Chronica Regum Scotorum annos trecentos et quatuordecim complectentia; Narratio, qualiter acciderit quod memoria sancti Andreae, Apostoli, amplius in regione Pictorum; Pietro Alfonsi, Doctrina clericalis; Epistola Alexandri ad Aristotelem; Metrum in destructionem Troianorum; Darete Frigio, Historia Troiana; Goffredo di Monmouth, Historia Britonum; Prophetia Cyrilli, Eremitae de Monte Carmelo; Sanctae Hildegardis epistola ad Colonienses, de futura tribulatione Clericorum; Topographia Hibernie di Giraldo Cambrense. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2303> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Ai ff. 33-105 e 134v-211 sono presenti lettere filigranate. La B al f. 1v rappresenta una carta terrestre e celeste con al centro Gerusalemme." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/polychronicon-ranulphus-higden-m-12-3-1364-ca--title/4071 </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#avril-stirnemann-manuscrits-enlumines'>AVRIL-STIRNEMANN 1987</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc62872b" ;
        :last_mod_form         "2024-04-17T10:36:33.853Z"^^xsd:dateTime .

