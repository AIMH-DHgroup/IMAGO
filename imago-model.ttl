<https://imagoarchive.it/ontology/resources/manuscript/rouen/bibliothquejacquesvillon/1334_(u_96)/2r167v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-669> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo, mutilo, mm. 273-184, ff. 168 (bianco il f. 168). Testo scritto da una mano umanistica a piena pagina, in inchiostro scuro; marginalia rossi della mano del copista; osservazioni marginali in rosso di un colto viaggiatore, forse del XVI secolo. Al f. 2r, nel margine inferiore, dentro un medaglione, si legge: \"Ex dono D. Mallet, canonici Rotomagensis, a. MDCXXXVI\". Il codice, infatti, appartenne al teologo Charles Mallet, arcidiacono e canonico di Rouen, il cui patrimonio confluì poi nella Biblioteca municipale di Rouen. Il manoscritto, che tramanda la III redazione testuale dell'Italia illustrata, è privo di parte della regio Campania e di tutta la regio Apulia. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-669> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q18573998> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 289-290 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/rouen-biblioth%C3%A8que-jacques-villon-(olim-biblioth%C3%A8q-manuscript/168188" ;
        :last_mod_form         "2023-12-28T21:14:45.416Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/date/mdm-1314>
        rdf:type  <http://erlangen-crm.org/211015/E52_Time-Span> ;
