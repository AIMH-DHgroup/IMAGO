        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/oxford-corpus-christi-college-249-manoscript/180426" ;
        :last_mod_form         "2024-03-26T15:10:10.57Z"^^xsd:dateTime .

