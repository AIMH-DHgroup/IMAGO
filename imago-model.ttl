<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._1869/186r190r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1669> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 210 ff. e misura 328x234 mm. Esemplato in Francia, il codice trasmette inoltre: Pseudo-Curzio Rufo, Historiae Alexandri Magni, ff. 1r-4v; Freculfo di Lisieux, Historia, ff. 5r-90r; Gerolamo, Chronicon Eusebii, f. 90v; estratti di Paolo Orosio e Isidoro; Eclogae, ff. 93v-94r; Cecilio Balbo, De nugis philosophorum, ff. 94r-95r; Haito, Visio Wettini, ff. 95r-98r; Translatio capitis Iohanni Baptistae Angeriacum, ff. 99v-101v; Curzio Rufo, Historiae Alexandri Magni, ff. 103r-177v; Giulio Valerio, Res gestae Alexandri Magni, ff. 177v-186r; Alexandri et Dindimi Collatio, ff. 190r-193v; Palladio, Commonitorum, ff. 193v-199v; Historia Apollonii regis Tyri, ff. 199v-208r; Pseudo-Curzio Rufo, Historiae Alexandri Magni, ff. 209r-210v; Giovenale, estratti dalle Saturae, f. 210v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1669> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 5 grandi iniziali dipinte in una cornice su fondo oro con grande intreccio di steli colorati, fogliame, palmette a volte decorate con personaggi, animali fantastici, serpenti. Altre iniziali in blu, rosso, verde o nero. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li>" ;
        :has_url_manuscript    "https://opac.vatlib.it/mss/detail/Vat.lat.1869" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdata0af55d46ed71c52faae8b538b21ec7be37c9000b" ;
        :last_mod_form         "2024-04-05T07:01:46.455Z"^^xsd:dateTime .

