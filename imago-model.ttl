<https://imagoarchive.it/ontology/resources/manuscript/napoli/bibliotecastataleoratorianadeigirolamini/pil._ix,_2/1r103v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
