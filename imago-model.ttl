<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._18108/107r109v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-904> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 196 ff. e misura 150-205x110/140 mm. La rilegatura è moderna in pelle marrone. Una parte del manoscritto proviene dal monastero di Saint-Denis di Reims, come riportato al f.1r: \"Iste liber est de conventu S. Dyonisii Remensis qui fuit Domini I. generalis abbatis nostri\" e passò poi nelle collezioni del priorato di Saint-Martin-des-Champs (Parigi). Il codice trasmette sententiae e quaestiones teologiche e riporta il Liber di Rorgo Fretellus nella seconda redazione. Il codice è costituito da 21 fascicoli di varia lunghezza, vergati da mani diverse. Si individuano, tra i contenuti, tre gruppi di quaestiones attribuite a Pietro Comestore (ff. 83r-107r) e le sententiae della scuola di Pietro Abelardo. Il testo di Fretello è vergato su due colonne in una bastarda irregolare. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-904> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#trovato-sulla-genealogia-e-la-cronologia'>TROVATO 2012</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#yolles-latin-literature-and-frankish-culture'>YOLLES (PhD thesis) 2015</a>, p. 135. </li><li><a href='https://imagoarchive.it/bibliografia.html#boeren-rorgo-fretellus-de-nazareth'>RORGO FRETELLO, Descriptio 1980</a>, p. 48. </li><li><a href='https://imagoarchive.it/bibliografia.html#greco-2021-2022'>GRECO (tesi di dottorato) 2022</a>, pp. 68-69. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc8799b" ;
        :last_mod_form         "2024-02-01T11:01:16.942Z"^^xsd:dateTime .

