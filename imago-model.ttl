<https://imagoarchive.it/ontology/resources/manuscript/berlin/staatsbibliothekpreuischerkulturbesitz/hamilton_637/4352>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1316> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo e cartaceo è formato da I, 52 ff. e misura 200x135 mm con legatura moderna con piatti in legno e dorso in pelle. Al f. 1r nota di possesso del XVI secolo: \"Ad usum D. Honorati Cesenatis canonici regularis lateranensis\". Esemplato in Italia, il codice appartenne nella prima metà del XVIII secolo alla biblioteca di Apostolo Zeno (1668-1750), poi ai Domenicani di S. Maria del Rosario a Venezia, ad Alexander Douglas, duca di Hamilton (1767-1852) e infine, dal 1883, alla Biblioteca di Stato di Berlino. La sezione di Guido è tradita nella seconda unità codicologica, ff. 43-52, che trasmette: Vibio Sequestre,  De fluminibus, fontibus, lacubus, nemoribus, paludibus, montibus, gentibus per litteras liber, ff. 43r-44v; Polemio Silvio, Laterculus, ff. 44r-45r; Liber provinciarum Italie, ff. 45r-48v; De provinciis Italie secundum quosdam philosophos, ff. 48v-49v; Liber de origine situque et qualitate Romane urbis, ff. 49v-52v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1316> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q170109> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-compositus-de-variis-historiis-pro-diversis--title/9491 </li><li><a href='https://imagoarchive.it/bibliografia.html#campopiano-liber-guidonis'>Liber Guidonis 2008</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/berlin-staatsbibliothek-zu-berlin-preußischer-kult-manoscript/155941" ;
        :last_mod_form         "2024-02-07T12:50:34.055Z"^^xsd:dateTime .

