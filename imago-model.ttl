<https://imagoarchive.it/ontology/resources/manuscript/venezia/bibliotecanazionalemarciana/lat._x._73_(3445)/1v74r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Marcus Paulus De regionibus Orientalibus" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1279> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da I-IV, 76, I ff. con numerazione antica in cifre arabe rosse e moderna a matita, fascicolazione: I (4), II-VII (10), VIII (10-4), misura 295x215 mm.  La rilegatura è in pelle su piatti di cartone pressato; guardia in carta marmorizzata blu e bianca, in una cornice dorata si legge a lettere d'oro: \"Marcus Paulus de regionibus Orientalibus\". Il manoscritto fu realizzato da Felice Feliciano per Giovanni Marcanova, come si legge al f. 74r: \"Opus absolutum ad petitionem Iohannis Marchanovae artium et medicinae doctoris Patavini anno gratiae 1465. Bononiae\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1279> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q578460> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1r L decorata in blu con rami intrecciati in rosa e giallo, f. 55r capitale rubricata P con decoro a penna porpora, maiuscole in rosso con filigrane porpora/blu scuro e blu con filigrane rosso chiaro. Rubriche in rosso. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 956-963. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-marci-pauli-de-veneciis-de-consuetudinibus-e-title/8347 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/venezia-biblioteca-nazionale-marciana-lat-x-73-(34-manoscript/133564" ;
        :last_mod_form         "2024-02-05T06:55:21.089Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/print_edition/pe-272>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Peregrinatio sancti Brandani abbatis" ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Carl Schröder affianca il testo latino della Navigatio, tratto dal manoscritto Leipzig, Universitätsbibliothek, 844, alla sua edizione di tre versioni tedesche della leggenda, cosiddette Reis o Reise, una libera rielaborazione della storia che ebbe grande fortuna in area nederlandese e tedesca. L'edizione si trova all'interno del volume \"Sanct Brandani\", consultabile al link: https://archive.org/details/sanctbrandaneinl00bren/page/n3/mode/2up" ;
