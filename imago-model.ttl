<https://imagoarchive.it/ontology/resources/manuscript/date/mdm-1475>
        rdf:type  <http://erlangen-crm.org/211015/E52_Time-Span> ;
        <http://erlangen-crm.org/211015/P170i_time_is_defined_by>
