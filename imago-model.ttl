        :has_decoration        "Il codice presenta sette iniziali ornate, al f. 63r una carta d'Inghilterra e di Irlanda . " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/topographia-hiberniae-title/4005 </li><li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>, p. 303. </li><li><a href='https://imagoarchive.it/bibliografia.html#avril-stirnemann-manuscrits-enlumines'>AVRIL-STIRNEMANN 1987</a>, p. 43. </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b8438621m" ;
