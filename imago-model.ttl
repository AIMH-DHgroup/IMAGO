<https://imagoarchive.it/ontology/resources/manifestation/manuscript/mm-54>
        rdf:type  <http://imagoarchive.it/ilrmoo/F3_Manifestation> ;
        <http://imagoarchive.it/ilrmoo/R7i_is_materialized_in>
                <https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/ott._lat._1279/1r57r> .

<https://imagoarchive.it/ontology/resources/manuscript/mnchen/bayerischestaatsbibliothek/10691/207234>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1856> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo e cartaceo è formato da 313 ff. e misura 125x63 mm. Il codice trasmette inoltre: Calendarium (ff. 1-7);  Computus astronomicus et ecclesiasticus (ff. 8-12); Eclipses ab a 1516-1570 (f. 13); Figurae astronomicae (ff. 14-21); De arithmetica (ff. 22-36); De geometria (ff. 37-48); De astronomia (ff. 49-80); De\r\ngeographia (ff. 81-96); Compositio astrolabii, horologii ad murum, quadrantis, instrumenti distantiarum (ff. 97-113); Proiectio terrae habitabilis secundum\r\nPtolomaeum (ff. 114-115); Canones motuum corporum celestium (ff. 116-133);\r\nCompositio variorum instrumentorum (ff. 134-140); Tabulae astronomicae (ff.\r\n141-195); Verificatio stellarum fixarum ad annum 1500 (ff. 196-204); Descriptio utriusque hemispherae (in altera est “terra ista inuenta est per mandatum regis\r\nCastelle”) (ff. 205-206); Phisionomia (ff. 241-248); De flebotomia (ff. 249-255); Advertenda in meditatione (ff. 256-257); Astrologia iudiciaria (ff. 258-288); Cronica insignorum et famosiorum hominum usque ad Clemens papa a 1524 (ff.\r\n289-310); Compositio monochordi (f. 311); Tabulae Germaniae, Poloniae, Europae (ff. 312-313)." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1856> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q256507> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il manoscritto contiene 25 mappe. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, p. 113. </li>" ;
        :has_url_manuscript    "https://opacplus.bsb-muenchen.de/title/BV037453299" ;
        :has_url_manuscript_description
                "https://opacplus.bsb-muenchen.de/title/BV037453299" ;
        :last_mod_form         "2024-02-05T15:43:08.171Z"^^xsd:dateTime .

