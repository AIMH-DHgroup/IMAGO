<https://imagoarchive.it/ontology/resources/manuscript/cambridge/gonvilleandcaiuscollegelibrary/ms_162/183/26r86v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1231> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto mebranaceo è formato da 213 ff. e misura 220x160 mm. Esemplato in Inghiterra, la prima parte fu vergata durante la seconda metà del XIV secolo e la seconda (ff. 141r-213v) fu copiata alla fine del XIII secolo. Il manoscritto fu donato al Gonville e Caius College da William Moore (1590-1659). Probabilmente la prima parte del codice fu copiata come completamento della seconda. \r\nIl testo di Pipino si conclude al libro III, capitolo 49.Il manoscritto trasmette inoltre: il Tractatus de ortu et processu et actibus Machometi, ff. 1r-11v; Guglielmo da Tripoli, De statu Saracenorum et de Machometo pseudopropheta et eorum lege et fide, ff. 12r-25v; Odorico da Pordenone, Relatio de mirabilus orientalium Tatarorum, ff. 87r-105v; De ortu Tartarorum secundum Petrum Archiepiscopum de Ruffia, ff. 106r-108v; Gesta Francorum et aliorum Hierosolymitanorum, ff. 111r-140r; Historia Hierosolymitana abbreviata, ff. 141r-213v.  " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1231> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q863940> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 510-520. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-marci-pauli-de-veneciis-de-consuetudinibus-e-title/8347 </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, p. 20. </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>, pp. 108-109. </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-per-un-riordino'>CHIESA 1999-2000</a>, p. 321. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/cambridge-gonville-and-caius-college-162-83-manoscript/17623" ;
        :last_mod_form         "2024-01-24T09:37:56.126Z"^^xsd:dateTime .

