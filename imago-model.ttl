        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1122> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Manoscritto cartaceo, miscellaneo di 123ff +79 pagine. Il codice, oltre a contenere la Descriptio Ragusina (ff.1r-87v), raccoglie pure: Nicolò da Lazina, poesia in lode dell'opera successiva (ff. Ir-Iv; 88r-88v); Filippo Diversi, orazione per Sigismondo imperatore (ff. 88r-98v); Id., orazione ad Alberto re, 1438 (ff. 98v-111v); Id., orazione ad Alberto re, 1439 (ff. 112r-122v)." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1122> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/biblioteka-samostana-male-brace> ;
        :compiled_form         "Martina Piccolo" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. V </li>" ;
