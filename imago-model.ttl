        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdatab3aaa238e96d0bcd560" ;
        :last_mod_form         "2024-04-15T13:23:01.707Z"^^xsd:dateTime .

