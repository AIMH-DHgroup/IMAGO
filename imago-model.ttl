        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/paris-bibliothèque-nationale-de-france-lat-2845-manoscript/17876" ;
        :last_mod_form         "2024-01-31T07:11:53.151Z"^^xsd:dateTime .

