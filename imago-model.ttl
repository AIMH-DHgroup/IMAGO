<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/add_ms_15219/12v19v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          " " ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-765> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto, in pergamena, consta di 93 ff. e misura  230x 155 mm. Proveniente dall'abbazia benedettina di San Martino a Tournai, come riportato nei ff. 2r e 93v, è rimasto lì fino allo scioglimento dell'abbazia nel 1796 da parte delle Forze Rivoluzionarie francesi. Il codice trasmette inoltre: Itinerarium Antonini Placentini, ff. 3r-11r; Glosse a testi biblici, ff. 20r-54v; Interpretatio Nominum Graecorum, ff. 55r-74r; Interpretatio Nominum Hebraeorum, ff. 72r-92r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-765> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
