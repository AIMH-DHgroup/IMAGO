        :has_decoration        "Iniziali grandi in rosso o verde (ff. 13-22v). Paragrafi in rosso o verde. Piccole iniziali in rosso. Paragrafi in rosso. Diagrammi in rosso e marrone (f. 44)." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
