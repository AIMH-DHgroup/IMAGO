        <http://erlangen-crm.org/211015/P3_has_note>
                "Riproduzione digitale e trascrizione semidiplomatica del ms. di Atene, Biblioteca Gennadios, 71, con traduzione in inglese. Edizione nata in seno al progetto triennale (2020-2023) \"Mapping the Aegean: Cristoforo Buondelmonti's Liber insularum (15th century) and the Origins of Classical Archaeology\" finanziato dal programma Marie Curie Fellowship della Comunità Europea (https://cordis.europa.eu/project/id/894231/it)." ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/liber-insularum-archipelagi-title/4379> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-257> ;
        :compiled_form              "Alessio Luca Bartelloni" ;
        :has_ecdotic_type           <https://imagoarchive.it/ontology/resources/print_edition/edition/edizione_con_traduzione> ;
        :has_figure_note            "Mappe animate." ;
        :has_introduction_note      "" ;
        :has_other_contents         "Al momento la trascrizione e le schede a commento storico-geografico e archeologico sono pubblicate solo per l'isola di Corfù, mentre è disponibile la traduzione integrale del \"Liber insularum\" basata sul ms. 71 della Biblioteca Gennadios, consultabile al link https://mapaeg.websoupcloud.it/" ;
        :has_primary_source         "Atene, Biblioteca Gennadios, ms. 71" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Cristoforo Buondelmonti" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-257> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-257> ;
        :last_mod_form              "2024-03-12T14:27:50.4Z"^^xsd:dateTime .

