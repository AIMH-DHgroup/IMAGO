<https://imagoarchive.it/ontology/resources/manuscript/cambridge/universitylibrary/mm.2.18/144v146v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1138> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 334 ff. e misura 365x248 mm. Il codice fu commissionato da Goffredo di Wighton, frate francescano del convento di Oxford (f.1v: Iste liber est fratris Galfridi de Wyghtone quem fecit scribi de elemosinis amicorum suorum). Il codice trasmette anche: Gerardo da Cremona, Liber Jeber de Astrogogia habens tractatus novem optimos; Liber de Numeris et lineis Rationibu; pulcher et magnus; Mohammed Ben Musa Khayrezmita, De Algebra et Almuchabala; Liber in quo terrarum et corporum continentur mensurationes Ababuchri qui dicebatur Heus, translatus a Magistro Girardo Cremonensi in Toleto:abreviatus; Liber Saydi Abuohtim, De Mensurationes Figurarum superficialium et corporearum; Liber Ademea de Mensuratione; Liber Augmenti et Dimunucionis; Solino, Collectanae rerum memorabilium; Frontino, Stratagemata; Clemens Lantoniensis, Super Evangelia; estratti di Macrobio, Saturnalia; De Vita sancti Zozime; Marziale, Epigrammata; Giovanni di Salisbury, Methalogicon e De dogmate philosophorum; Ovidio, Metamorfosi; Valerio Massimo, Factorum ac dictorum memorabilium; Boezio, De consolatione philosophie. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1138> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1028334> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali dipinte e decorate." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>, pp. 311-312. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-28T14:07:47.565Z"^^xsd:dateTime .

