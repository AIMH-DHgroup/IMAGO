<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/add._19952/2r84v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1252> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 111 ff. e misura 210x145 mm. Il testo di Pipino è annotato da tre diverse mani, due del XV secolo, che commentano le notizie, e una del XVI, che corregge alcuni passi, probabilmente da un'altra copia. La prima mano è quella di Nicola Cusano (1401-1464), che interviene soprattutto sui nomi delle città orientali, offrendo dei toponimi alternativi dei luoghi citati, la seconda mano è forse quella di Henricus de Dissen (1415-1484). Trasmette inoltre: Guglielmo da Tripoli, Notitia de Machometo et de libro legis qui dicitur Alcorani, ff. 85r-98v; Excerptum de Talmud, ff. 99r-111r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1252> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 674-690. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/author/franciscus-pipinus-n-1270-ca-m-1327-1328-author/20207 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/london-british-library-add-19952-manoscript/13413" ;
        :last_mod_form         "2024-02-02T12:47:11.13Z"^^xsd:dateTime .

