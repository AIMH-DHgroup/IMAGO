<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_1320/1203>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2244> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 203 ff. e misura 285x210 mm. Copiato in gotico in Inghilterra, il codice trasmette il testo del Polychronicon con la continuazione fino al 1377. Sono presenti molte note marginali di varie mani, per la maggior parte in latino e alcune in inglese. Lacuna ai ff. 201v e 202r, presumibilmente a causa della perdita di fogli. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2244> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziale grande in oro e colori combinata con un bordo a barra foliata (f. 1r). 5 grandi iniziali di puzzle in rosso e blu con penna fiorita in viola, blu e rosso che si estende ai margini (ff. 37v, 63v, 104r, 130v, 154v, 176v)." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
