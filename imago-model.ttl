<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/bodl._316/8r155r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2273> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 185 ff. e misura 363x247 mm. Il testo è disposto su due colonne di 55 righe. Al f. 2r nota: \"Orate pro Thoma duce Glouc' qui me dedit huic Cantarie siue Collegie Sancte Trinitatis infra Castrum de Plecy\". Il codice fu copiato a Norwich e fu posseduto da Thomas, duca di Gloucester e da lui donato alla collegiata della Santissima Trinità di Pleshey. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2273> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 8r miniatura della Trinità e di un monaco inginocchiato. Bordo illuminato con iniziale istoriata e stemma. Iniziali miniate. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/polychronicon-ranulphus-higden-m-12-3-1364-ca--title/4071 </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_1362" ;
        :last_mod_form         "2024-04-16T06:00:21.054Z"^^xsd:dateTime .

