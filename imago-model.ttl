<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/stowe_56/99v106v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1709> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 185 ff. e misura 280x210 mm. Il codice, esemplato nel Nord della Francia o in Inghilterra, è scritto in gotico. La rilegatura è successiva al 1600, in pelle marrone, lavorata in oro. Il codice trasmette: Balderico di Bourgueil, Historia Hierosolymitana, ff. 2r-59r; Historia Danica, ff. 55r-63v; De excidio Troiae Historia, ff. 64r-75r; Historia Apollonii Regis Tyri, ff. 75r-87v; Historia Alexandri Magni, ff. 87v-99v; Epistola Alexandri ad Aristotelem, ff. 99v-106v; Collatio Alexandri et Dindimi, ff. 106v-112r; Goffredo di Monmouth, Historia Regum Britanniae, ff. 112r-185v. Il manoscritto contiene anche una serie di aggiunte e note marginali al testo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1709> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Numerose grandi iniziali in verde o blu con decorazione a penna rossa o in rosso con decorazione a penna verde. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li>" ;
        :has_url_manuscript    "https://www.bl.uk/manuscripts/FullDisplay.aspx?ref=Stowe_MS_56" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/dlDisplay.do?vid=IAMS_VU2&search_scope=default_scope&docId=IAMS040-001952837&fn=permalink" ;
        :last_mod_form         "2024-04-05T08:07:09.751Z"^^xsd:dateTime .

