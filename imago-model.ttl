<https://imagoarchive.it/ontology/resources/manuscript/zwettl/bibliothekdeszisterzienserstifts/76/221v256r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-217> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 272 ff. e misura 315x232x235 mm. Il testo è disposto su due colonne. Esemplato nell'Abbazia di Zwettl, il codice la Descriptio di Burcardo da Monte Sion nella redazione lunga e inoltre: Tommaso d'Aquino, Expositio super Iob ad litteram, ff. 3r-108v; Bonaventura da Bagnoregio, Breviloquium, ff. 109r-158v; Ugo di San Vittore, Soliloquium de arrha animae, ff. 159r-166v; Riccardo da San Vittore, De praeparatione animi ad contemplatonem, ff. 168r-194r; Vita Mystica, ff. 194r-206r; Liber de ordine creaturarum, ff. 258v-292r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-217> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/zwettl-bibliothek-des-zisterzienserstifts> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>, pp. 283-286. </li>" ;
        :has_url_manuscript    "" ;
