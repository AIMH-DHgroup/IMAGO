                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2120> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 125 ff. e misura 210x150 mm. Esemplato in Germania, la rilegatura è a mezza pelle con etichetta che riporta il vecchio codice \"L 74\". Il codice trasmette per intero l'Imago mundi e riporta inoltre: Johannes Tortsch, Onus mundi, ff. 1r-18r; Francesco Petrarca, Epistola ad fratrem suum Gerhardum Petrarcham, ff. 19r-28v; Jean Rigaud, Formula confidendi, ff. 78r-89v; Pratica bona reformationis monialium, ff. 91r-99r; Bertramus de Ahlen, De laude Domini novi saeculi, ff. 102r-119r; Quaestio \"Utrum homo in vita ista possit Deum cognoscere\", ff. 119v-125r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2120> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b10721474r" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc724374" ;
        :last_mod_form         "2023-04-25T08:07:59.112Z"^^xsd:dateTime .

