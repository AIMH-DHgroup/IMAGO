<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/3400/90v98v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
