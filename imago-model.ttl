<https://imagoarchive.it/ontology/resources/manuscript/oxford/corpuschristicollegelibrary/400/46r84r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-111> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice cartaceo e membranaceo è formato da 5+47+42+61+4 ff. e misura 223x149 mm. Il codice è formato da almeno quattro manoscritti, i primi tre dei quali contengono le opere di Gerald of Wales. In particolare, il codice trasmette la Topographia Hibernica nella seconda versione, una copia cinquecentesca della Descriptio Kambriae e copie dell'inizio del XIII secolo delle Retractationes, Catalogus Brevior librorum suorum, De iure et statu Menevensis ecclesiae e Versi. I ff. 150r-153r sono invece occupati da versi dalle finestre nel coro della cattedrale di Canterbury." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-111> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1135137> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 2v mappa in marrone e verde delle isole britanniche. Al f. 5r iniziale grande con Giraldus in abito viola che offre un libro d'oro a Enrico III e piccoli medaglioni che rappresentano un pesce, un uccello e due animali." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-kambriae-title/12964 </li>" ;
        :has_url_manuscript    "https://parker.stanford.edu/parker/catalog/qm817bv7839" ;
        :has_url_manuscript_description
                "https://parker.stanford.edu/parker/catalog/qm817bv7839" ;
        :last_mod_form         "2024-03-29T10:49:45.18Z"^^xsd:dateTime .

