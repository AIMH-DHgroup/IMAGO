                "https://www.mirabileweb.it/manuscript/citt%C3%A0-del-vaticano-biblioteca-apostolica-vaticana--manuscript/168193" ;
        :last_mod_form         "2024-03-14T09:39:37.619Z"^^xsd:dateTime .

