<https://imagoarchive.it/ontology/resources/manuscript/stuttgart/wrttembergischelandesbibliothek/cod._med._et_phys._2_24/1r123r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
