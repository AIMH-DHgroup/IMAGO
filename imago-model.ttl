<https://imagoarchive.it/ontology/resources/manuscript/porto/bibliotecapblicamunicipal/santa_cruz_de_coimbra_8_(30)/177r178v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
