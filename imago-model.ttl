<https://imagoarchive.it/ontology/resources/manuscript/firenze/bibliotecanazionalecentrale/conv._soppr._i.2.37/92v156v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-980> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da III, 156, IV' ff. e misura 177x106 mm. Esemplato in Toscana, probabilmente a Pisa, fu posseduto da Niccolò Niccoli e dal convento di S. Marco a Firenze. Trasmette inoltre: Calendario, ff. 1r-7v; Passio s. Herenis, ff. 8r-25r; Passio s. Margaretae, ff. 25r-43r; Passio s. Alexii, ff. 43r-54v; Passio s. Georgii, ff. 54v-60v; Visio Pauli, ff. 60v-66v; Pseudo-Clemente, De duodecim diebus Veneris, ff. 66v-67v; Oratio communis, ff. 67v-71v; Oratio s. Brendani, ff. 72r-92v. Sul verso della guardia pergamenacea si legge l'ex libris del XV secolo: \"Conventus s. Marci de Florentia ordinis predicatorum. De hereditate Nicolai Nicoli viri doctissimi florentini\". Il calendario iniziale fu forse aggregato in un secondo momento. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-980> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q460907> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 26-27. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/firenze-biblioteca-nazionale-centrale-conv-soppr-i-manoscript/123326" ;
        :last_mod_form         "2024-01-30T09:23:37.151Z"^^xsd:dateTime .

