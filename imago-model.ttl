<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/canon._misc._378_(s.c._19854)/47r62v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1300> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 173 ff. e misura 273x195 mm. Esemplato a Basilea da uno scriba italiano, probabilmente di Padova, il codice fu copiato per Pietro Donato al concilio di Basilea del 1436 dal Codex Spirensis, come si legge al f. 170 \"Exemplata est hec Cosmographia que Scoti dicitur cum picturis et vetustissimo Codice, quem habui ex Spirensi bibliotheca anno Domini MCCCCXXXVI, mense Ianuario. Dum ego Petrus Donatus Dei pacientia episcopus Paduanus vice sanctissimi domini Eugenii paper III generali Basiliensi concilio presiderem\". Il manoscritto riporta: Cosmographia, ff. 3r-15v; Itinerarium prouinciarum Antonini Augusti, ff. 15v-47v; Elenchi dei colli e degli acquedotti del Comune di Roma, f. 47r; Notitia Galliarum, ff. 62v-64r; Laterculus Polemii Silvii, ff. 64r-65r; De montibus, portis et viis urbis Romae, ff. 65r-66r; De rebus bellicis, ff. 67r-77v; Disputatio siue Altercatio Hadriani Augusti et Epicteti Philosophi, ff. 78r-80r; Notitia, siue Libellus de regionibus, urbis Romae, ff. 80v-84r; De gradibus cognationum, ff. 87r-88r; Notitia dignitatum omnium tam civilium quam militarium, ff. 88v-170r; Demensuratio sive de mensuratione provinciarum, ff. 170v-172r; Gregorio Nazianzeno, De VII mundi spectaculis, ff. 172v-173r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1300> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice è riccamente decorato con miniature. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#httpswwwgeschichtsquellendestart'>GESCHICHTSQUELLEN</a>, http://www.geschichtsquellen.de/werk/2021 </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-de-mensura-orbis-terrarum-dicuil-hibernicus--title/4066 </li><li><a href='https://imagoarchive.it/bibliografia.html#bieler-the-text-tradition'>BIELER 1965</a>,  </li>" ;
        :has_url_manuscript    "https://digital.bodleian.ox.ac.uk/objects/3eb32a9c-616b-4ce6-ae15-411881ee1625/" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_3405" ;
        :last_mod_form         "2024-02-14T14:12:06.543Z"^^xsd:dateTime .

