<https://imagoarchive.it/ontology/resources/manuscript/klosterneuburg/bibliothekdesaugustinerchorherrenstiftes/209/128v132v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1094> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto fu esemplato a Klosterneuburg nella seconda metà del XII secolo; membranaceo, è composto da 188 ff. con il testo disposto su due colonne e misura 220x220 mm. Trasmette i seguenti testi: Gerolamo, Liber hebraicarum quaestionum in Genesim, ff. 1r-27r; Explanationes decem temptationum populi Israel in deserto, ff. 27r-29r; Succincta commemoratio tempationum, f. 29r; Explanatio cantici Deborae et Barach de libro Judicum, ff. 29r-32v; Questiones hebraicae de libris Malachim, id est Regum, ff. 32r-49v; Quaestiones hebraicae prioris et secundae partis Debriamin, ff. 49v-66r; Quaestiones hebraicae in Abacuch, ff. 66r-68r; Chronica succinte scripta de regno Hebraeorum, ff. 68r-69r; Isidoro di Siviglia, Liber proemiorum de librorum Novi ac Veteris Testamenti, ff. 69r-74r; De formis hebraicarum litterarum, f. 75v; Gerolamo, Praefatio in libri interpretationis hebraicorum nominum, ff. 75v-101v; Praefatio in libro locorum ad Eusebio Pamphili Caesariensi episcopo, ff. 101v-128v; Nomina regionum atque locorum de Actibus Apostolorum, ff. 128v-132v; De epistola cuiusdam Symeonis, f. 132v; Secundum Esdram veri characteres hebraeorum nominum, f. 132v; Eucherio, Liber formularum spiritalis intelligentiae ad Veranum filum, ff. 133r-168v; Isidoro di Siviglia, De vita et obitu sanctorum patrum, ff. 168v-178v; Defloratio in nominatissimis nominibus legis et evangeliorum, ff. 178v-187v; De quatuor temporibus, ff. 187v-188r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1094> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/klosterneuburg-bibliothek-des-augustiner-chorherrenstiftes> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/nomina-regionum-atque-locorum-de-actibus-apostolor-title/2289 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manuscripta.at/hs_detail.php?ID=382" ;
        :last_mod_form         "2024-03-02T13:33:01.288Z"^^xsd:dateTime .

