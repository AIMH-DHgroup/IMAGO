<https://imagoarchive.it/ontology/resources/manuscript/lucca/bibliotecastatale/1398/87r92v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1930> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 96, I' ff. e misura 276x106 mm. Il manoscritto è stato oggetto di un recente restauro. Il codice è formato da tre diverse unità codicologiche: la prima, ff. 56, trasmette: Alberto Magno, De generatione et corruptione, ff. 1r-27r, De somno et vigilia, ff. 27r-47v, De spiritu et respiratione, ff. 47v-56v. La seconda unità, ff. 25, trasmette: Alberto Magno, De unitate intellectus contra Averroem, ff. 57r-65v, De intellectu et intelligibili libri duo, ff. 66v-73v, De morte et vita, ff. 74r-78v, De iuventute et senectute, ff. 79r-81v. La terza unità, ff. 15, trasmette alcuni estratti del De rerum naturis di Rabano Mauro e il De interpretatione nominum, ff. 82r-86v e" ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1930> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q18596252> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/lucca-biblioteca-statale-(olim-biblioteca-governat-manoscript/213658" ;
        :last_mod_form         "2024-01-26T10:02:44.034Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/explicit_text/met-680>
