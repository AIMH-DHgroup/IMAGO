        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2224> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 192 ff. e misura 245x177 mm. Il codice è stato tagliato lungo il bordo superiore ed è rilegato con pelle di capra tinta nel XX secolo su cartoncini. Il codice è scritto da due mani e la foliazione è a matita moderna nell'angolo in alto a destra. Il testo è disposto su due colonne di 46 righe. L'ultimo foglio contiene alcuni versi scritti da una mano diversa da quella che verga il testo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2224> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q856559> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali blu con ornamenti a penna rossi e blu. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "https://cudl.lib.cam.ac.uk/view/MS-TRINITYHALL-00025/7" ;
        :has_url_manuscript_description
                "https://cudl.lib.cam.ac.uk/view/MS-TRINITYHALL-00025/7" ;
        :last_mod_form         "2024-04-15T15:27:36.163Z"^^xsd:dateTime .

