        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/itinerarium-antonini-placentini-title/173200 </li><li><a href='https://imagoarchive.it/bibliografia.html#milani-1974'>MILANI 1974</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#httpswwwbedadlsgwiuni-muenchendeabout'>BEDA VENERABILIS, De locis sanctis </a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#bisceglia-2023'>BISCEGLIA 2023</a>,  </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Vat.lat.636.pt.2" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/132970" ;
