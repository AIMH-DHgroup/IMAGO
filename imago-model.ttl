<https://imagoarchive.it/ontology/resources/manuscript/stuttgart/wrttembergischelandesbibliothek/hb_xi._1/2r293v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-496> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 294 ff, il f. 294 è separato, incollato al coperchio posteriore, mentre del f. 11 si conserva solo la metà superiore. Le dimensioni sono di 325x230 mm. Ha spessi coperchi in legno rivestiti in pelle marrone, avvolto in carta rossa e marrone chiaro, rilegatura decorata con linee cieche. Note di proprietà al f. 1r: \"Iste liber est sancti Martini in Wingartun\". Ai ff. 294r-294v glossario alfabetico delle piante in latino-tedesco. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-496> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q317950> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali riccamente decorate. Al f. 2r iniziale C raffigurante un monaco seduto, probabilmente lo stesso autore che tiene in mano il suo libro e lo indica. Sui ff. 88r e 124r creature mitiche rosse disegnate a penna. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li><li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 108-109. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://glossen.germ-ling.uni-bamberg.de/manuscripts/13131.html" ;
        :last_mod_form         "2023-04-01T20:51:23.643Z"^^xsd:dateTime .

