<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/reg._lat._712/72r84r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-900> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 98 ff. Proveniente dall'abbazia di Mont-Saint-Quentin, il codice trasmette il Liber di Rorgo Fretellus nella sua prima redazione, l'Historia Hierosolymitana di Roberto il Monaco, ff. 1r-37v; Fulcherio di Chartres, Gesta Francorum Hierusalem peregrinantium, ff. 37v-72r; Lamentatio de secunda via Hierosolimitana, ff. 85r-85v; Ildeberto, De brevi sussistentia homini, f. 85v; estratto di Beda, ff. 85v-86r; Descriptio sanctuarii sancte Lateranensis ecclesie, ff. 86r-89r; Epistola di Girolamo a papa Damaso e risposta di Damaso, f. 89r; catalogo dei papi da Pietro a Lucio III (1181-1185), proseguito da altre mani fino a Innocenzo VI (1352-1362), ff. 89r-90v; Genealogia Francorum regum, ff. 91r-91v; Descriptio sanctuarii quod in palatio imperatoris Constantinopoli habetur, ff. 91v-92r; catalogo dei vescovi di Vermandois, f. 92r; Lamentatio de morte Karoli comitis Flandrie, ff. 92r-93r; due poesie di Ambrogio, f. 93r; estratti da Ambrogio, Exameron, ff. 93r-98v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-900> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#trovato-sulla-genealogia-e-la-cronologia'>TROVATO 2012</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#boeren-rorgo-fretellus-de-nazareth'>RORGO FRETELLO, Descriptio 1980</a>, p. 3. </li><li><a href='https://imagoarchive.it/bibliografia.html#yolles-latin-literature-and-frankish-culture'>YOLLES (PhD thesis) 2015</a>, pp. 134-135. </li><li><a href='https://imagoarchive.it/bibliografia.html#greco-2021-2022'>GRECO (tesi di dottorato) 2022</a>, pp. 44-46. </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Reg.lat.712/0001" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-02-05T11:22:50.499Z"^^xsd:dateTime .

