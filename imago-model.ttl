        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/itinerarium-antonini-placentini-title/173200 </li><li><a href='https://imagoarchive.it/bibliografia.html#milani-1974'>MILANI 1974</a>,  </li>" ;
        :has_url_manuscript    "https://digital.library.ucla.edu/catalog/ark:/21198/zz0028rnww" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/zürich-zentralbibliothek-rh-73-(440)-manoscript/103227" ;
        :last_mod_form         "2024-04-09T08:36:24.948Z"^^xsd:dateTime .

