<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._3810/2r68v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1816> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 69, I' ff. e misura 425x280 mm. Il testo è disposto su due colonne; i fogli 1v e 69r sono bianchi. La legatura è in pella rossa del XIX secolo con stemmi di Pio IX e di Luigi Lambruschini, cardinale bibliotecario. Il testo si ferma al libro VIII, 2 e trova completamento nel Vat. lat. 3811. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1816> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1r grande cornice a bianchi girari predisposta per accogliere la dedica poi lasciata in bianco; iniziale decorata a bianchi girari, nel margine inferiore stemma lasciato in bianco. Iniziali in oro decorate a bianchi girari e iniziali miniate ai ff. 2v, 10r, 10v, 11r, 11v. Iniziali miniate ai ff. 2v (raffigurante Tolomeo con in mano libro e compasso),\r\n10r-10v, 11r-11v." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, p. 83. </li>" ;
        :has_url_manuscript    "https://opac.vatlib.it/mss/detail/Vat.lat.3810" ;
        :has_url_manuscript_description
                "https://opac.vatlib.it/mss/detail/Vat.lat.3810" ;
        :last_mod_form         "2024-02-05T14:37:46.904Z"^^xsd:dateTime .

