        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-680> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo, mm 220-150, ff. I, 239. Il codice contiene tre opere storiche di Leonardo Bruni (De temporibus suis, ff. 1r-44v; De bello Gothico, ff. 45r-162v; Commentaria rerum graecarum, ff. 163r-204v) e la I redazione dell'Etruria di Biondo, e fu verosimilmente confezionato per la biblioteca personale di Piero de' medici." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-680> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q856419> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "Decorato nello stile fiorentino, a f. 1r con una grande miniatura a bianchi girari e motivi floreali con capitale Q in foglia d'oro con fregio laterale esteso sul mg. sinistro e sui mg. sup. e inf., con stemma della famiglia Medici. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 316-318 </li>" ;
