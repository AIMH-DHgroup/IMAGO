<https://imagoarchive.it/ontology/resources/manuscript/london/lambethpalacelibrary/137/1r280v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-407> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 318 ff. e misura 305x220 mm. Al f. 280v segue una sezione dell'ultimo capitolo \"De tintinnabulo\" del libro XIX, che è stata tralasciata in 280r, ma aggiunta da mano posteriore sul margine inferiore. Il codice fu posseduto da John Lecche, cancelliere di Oxford, morto nel 1361, che lasciò in eredità il manoscritto con altri 56 libri al priorato agostiniano di Lanthony vicino a Gloucester. Si rileva la presenza di una compilazione a registro di 60 lemmi alla fine del manoscritto, f. 317v, che fa riferimento ai marginalia e costituisce una testimonianza dell'uso dell'apparato delle note marginali nel codice. Il codice trasmette anche il Tractatus moralis de oculo di Pietro di Limoges, ff. 280v-309v, e testi di sermoni, ff. 310r-317v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-407> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q30264838> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 72-73. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2023-03-30T11:39:52.131Z"^^xsd:dateTime .

