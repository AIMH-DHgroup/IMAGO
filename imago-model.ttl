<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/pal._lat._1358/1r36v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-136> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo e cartaceo è formato da 154, 66 ff. e misura 205x140 mm. Esemplato nei Paesi Bassi, il manoscritto riporta principalmente testi geografici: l'Itinerarius di John Mandaville, ff. 37r-90r; la traduzione latina del Milione di Marco Polo a opera di Francesco Pipino, ff. 91r-150v  e la redazione lunga della Descriptio di Burcardo da Monte Sion." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-136> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#tzanaki-mandevilles-medieval-audiences'>TZANAKI 2003</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 913-919. </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>, pp. 283-286. </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Pal.lat.1358" ;
