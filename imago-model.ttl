        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#valseriati-ubertino-posculo'>VALSERIATI 2012</a>, pp. 227-228. </li><li><a href='https://imagoarchive.it/bibliografia.html#valseriati-il-rapporto'>VALSERIATI 2011</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#valseriati-posculo-obertino'>VALSERIATI 2016</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/oratio-de-laudibus-brixiae-hubertinus-pusculus-bri-title/187741 </li>" ;
