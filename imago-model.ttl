<https://imagoarchive.it/ontology/resources/manuscript/wolfenbttel/herzogaugustbibliothek/cod._guelf._354_helmst./176r202v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2167> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 313 ff. e misura 290x215 mm. Esemplato nel monastero benedettino di Reichenbach am Regen, il codice è formato da quattro parti, scritte tra il 1425 e il 1440. Riporta principalmente testi geografici: la Descriptio di Burcardo da Monte Sion nella redazione lunga, la Cosmographia di Iacopo di Angelo de Scarperia, una Descriptio Terrae Sanctae, l'Imago Mundi di Onorio di Autun, la Descriptio Terrae Sanctae di Iohannes Poloner e testi legati alla storia della Terra Santa." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2167> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q663820> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1v Mappa Europae, un disegno a penna che mostra una griglia semicircolare di sette cerchi di latitudine e diciannove gradi di longitudine e doveva forse servire come base per una mappa dell'Europa centrale. Ai ff. 16v-17r schema a penna della seconda proiezione di Tolomeo. Al f. 18r mappa VII climatum mundi: mappa piatta semicircolare dell'emisfero settentrionale, abbozzata a penna. Sono indicati i nomi dei venti ." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://diglib.hab.de/?db=mss&list=ms&id=354-helmst&catalog=Lesser" ;
        :last_mod_form         "2024-04-02T09:33:40.692Z"^^xsd:dateTime .

