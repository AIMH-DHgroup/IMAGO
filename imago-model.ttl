<https://imagoarchive.it/ontology/resources/manuscript/london/sconosciuta/collezione_privata_(ex_baden)/89r142v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-891> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo e miscellaneo; mm 210 x 150; ff. 167(?). Copista italiano. Contiene inoltre: (ff. 1r-88v?) Itinerarium Antonini; (ff. 147r-167v) CRISTOFORO BUONDELMONTI, Descriptio insule Crete. Il testo del \"Liber insularum\" è vicino a quello trasmesso dal ms. Chig. F. IV. 74, stando alla Nota al testo dell'ed. critica della \"Descriptio insule Crete\" e del XI cap. (Creta) del \"Liber insularum\" a cura di Van Spitael, la quale poté collazionare il codice di Baden tramite delle fotoriproduzioni (cfr. BUONDELMONTI, Descriptio 1981, p. 4). Il codice appartenne a Jacopo Spinola, che si firmava nel colofone al termine della \"Descriptio\" a f. 167v «iuris utriusque doctor». Messo in vendita a Zurigo da Hoepli fra il 21 e il 22 maggio del 1931, fu verosimilmente acquistato dalla famiglia dell’ingegnere svizzero A. Morf (Baden, Argovia). Il codice venne in seguito battuto all’asta da Sotheby’s a Londra il 10 dicembre 1996 (lotto n° 62)." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-891> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/ontology/resources/library/notKnown/891> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Numerose illustrazioni, eseguite a calamo, riproducenti i luoghi visitati da Buondelmonti." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ragone-g-liber-insularum'>RAGONE 2002</a>, p. 193, n. 50; p. 196, n. 61; p. 204, n. 86; p. 206, n. 92 </li><li><a href='https://imagoarchive.it/bibliografia.html#van-spitael-m-a-descriptio'>BUONDELMONTI, Descriptio 1981</a>, pp. 80-81, 91-92 </li><li><a href='https://imagoarchive.it/bibliografia.html#librairie-hoepli-1931'>LIBRAIRIE HOEPLI 1931</a>, p. 24, n. 65 + tav. VIII </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-14T14:41:54.156Z"^^xsd:dateTime .

