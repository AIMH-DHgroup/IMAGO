<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/laud._misc._633/1r95r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2102> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, III, 134, I, II ff. e misura 332x220 mm. Foliazione: 1-80, 83-98, 100-110. Esemplato in gotica, probabilmente nel 1182, proviene dall'abbazia premostratense di Pöhlde, come si legge al f. 1r nel margine inferiore: \"Liber sancti Iohannis et Servasii in Polithe\". Il codice riporta inoltre annotazioni del secolo XVI di mano tedesca. Il manoscritto trasmette solo il libro III dell'Imago mundi, ma attribuito a Onorio e Gerolamo. Il codice riporta inoltre: Vita di Ponzio Pilato; Vita di Giuda il traditore; Teodoro, Narratio profectionis Godefridi ducis; Eccardo, Chronicon universale; Pseudo-Beda, Interpretatio Sibyllinorum verborum; Heito, Visio Wettini. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2102> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Alcune iniziali disegnate a penna in inchiostro rosso. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_7421" ;
        :last_mod_form         "2024-04-02T08:27:52.713Z"^^xsd:dateTime .

