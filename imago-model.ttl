        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#biondo-roma-instaurata-2020'>BIONDO, Roma instaurata 2020</a>, p. LXXXIV </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/padova-biblioteca-capitolare-della-curia-vescovile-manuscript/112011" ;
        :last_mod_form         "2024-02-24T09:04:52.308Z"^^xsd:dateTime .

