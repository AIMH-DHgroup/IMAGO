<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_512/3r88v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-608> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 89 ff. e misura 210x145 mm. Il testo di Bartolomeo Anglico è suddiviso in XX libri, ma molto abbreviato. Presenza note marginali in francese. Il codice riporta inoltre: François Villon, Ballade joyeuse des Taverniers, f. 1r; detti di Aristotele, ff. 1r-2v; un estratto dal Livre des histoires du miroer du monde, f. 81r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-608> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Grandi iniziali in rosso o blu e rosse con decorazioni a penna in inchiostro marrone. Il manoscritto contiene disegni in inchiostro marrone che sono stati aggiunti in una fase successiva: f. 81v contiene due disegni della Madonna e tre illustrazioni di un libro con due fermagli; f. 89r contiene un disegno dell'Annunciazione, apparentemente copiato da un Libro d'Ore come suggerisce la decorazione di bordo sotto la scena; f. 89v contiene un altro disegno dell'Annunciazione, con una donna inginocchiata sotto di esso." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 174-175. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002046341&indx=1&recIds=IAMS040-002046341&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=harley%20512&dum=true&dstmp=1681377654374" ;
        :last_mod_form         "2023-04-13T09:26:00.657Z"^^xsd:dateTime .

