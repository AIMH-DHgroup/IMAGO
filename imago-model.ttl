<https://imagoarchive.it/ontology/resources/manuscript/salzburg/benediktinererzabtaeisanktpeterstiftsbibliothek/stiftsbibliothek_a.v.34/1r15v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
