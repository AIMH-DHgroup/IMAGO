<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_3290/2r164r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1844> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo e cartaceo è formato da V, 189, IV' e misura 295x210 mm. Esemplato in Germania in gotica, al f. 189v è datato: \"Laus Deo 1448 aldegundis virginis\". Il codice appartenne al convento agostiniano di S. Croce, Helenenberg, nella diocesi di Treviri, come si legge al f. 1v: \"Liber Fratrum crucis sancte Montis sancte Diocesi prope Treverensis Helene Welschbilch\". Il manoscritto trasmette inoltre l'Imago mundi di Pierre d'Ailly, ff. 165r-189v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1844> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali principali in rosso e blu con decorazioni ad inchiostro rosso e marrone; iniziali maggiori in blu, con decorazione a inchiostro rosso o in rosso con decorazioni marroni; iniziali minori in rosso e blu alternate. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 103-104. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002049121&indx=1&recIds=IAMS040-002049121&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Harley%203290&dum=true&dstmp=1681821669453" ;
        :last_mod_form         "2024-02-05T15:22:24.181Z"^^xsd:dateTime .

