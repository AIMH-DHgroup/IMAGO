        :has_decoration        "Sono presenti iniziali in rosso e blu. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 732-747. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-marci-pauli-de-veneciis-de-consuetudinibus-e-title/8347 </li><li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 52. </li>" ;
        :has_url_manuscript    "https://www.digitale-sammlungen.de/de/view/bsb00120614?page=,1" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/münchen-bayerische-staatsbibliothek-clm-249-manoscript/6241" ;
