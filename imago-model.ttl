<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/royal_7.c.v./616>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-616> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 146 ff. Il codice apparteneva all'abbazia di Bury St. Edmunds: \"Hunc librum scribi fecit Willelmus de Dice servus et monachus sancti Edmundi ad honorem sancti Edmundi, cuius anima etc.\". Il manoscritto trasmette inoltre una raccolta a cui una mano del XVI secolo ha dato il titolo \"'Caelestium et terrestrium quorum in scripturis fit mentio moralizatio incerti\". Al f. 2r ci sono delle copie di lettere relative all'elezione di Riccardus Insula, abate di Burton, all'abate di Bury St. Edmunds." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-616> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali a colori. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 184. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002106228&indx=1&recIds=IAMS040-002106228&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=7%20C%20V&dum=true&dstmp=1681382164049" ;
        :last_mod_form         "2024-03-26T16:11:14.879Z"^^xsd:dateTime .

