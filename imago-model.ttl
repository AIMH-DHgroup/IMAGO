<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/reg._lat._481/28r42v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-969> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 113 ff. e misura 234x165 mm. Composito, il manoscritto trasmette inoltre Wolfer di Hildesheim, Vita s. Godehardi, ff. IIV-16v; Meinhard von Bamberg, Libellus de symbulo Nicaeno, ff. 16v-27r; Constitutum Constantini, f. 27r, Passio s. Miniatis, ff. 42v-45r; Ursinus Locogiacensis, Passio s. Leodegarii, ff. 45r-55r; Vita s. Aldegundis Malbodiensis, f. 55r; Lettera di un filius della chiesa di Laon a un abate de sancto Laurentio, mutila o interrotta, f. 55v; Passio s. Iulianae, ff. 56r-60r; Passio ss. Iuliani et Basilissae, ff. 60v-69v; Vita s. Pachomii, ff. 69v-95v; Eberwinus Treverensis, Vita s. Symeonis, ff. 96r-103v; Vita s. Germani Autissiodorensis, ff. 104v-108v, Smaragdo, Carmen de regula monachorum, ff. 109r-109v; Sybilla Tiburtina, ff. 109v-112v. Il codice è un aggregato di unità dell'XI e XII secolo e ai ff. II e 113 riporta l'ex libris \"Liber sanctorum apostolorum Petri et Pauli in Patherborn/Paderburn\". Nel XVII secolo al f. I una mano italiano stila il sommario. Accanto alla voce Vita sancti Brendani nel sommario di f. IIr una mano gotica corsiva scrive una lunga ammonizione contro le anomalie teologiche del testo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-969> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 100-102. </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Reg.lat.481" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/123378" ;
        :last_mod_form         "2024-02-05T07:01:29.679Z"^^xsd:dateTime .

