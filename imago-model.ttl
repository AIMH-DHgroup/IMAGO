<https://imagoarchive.it/ontology/resources/manuscript/augsburg/staatsundstadtbibliothek/2°_203/1r18ve19v21v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-945> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice composito è stato esemplato nell'abbazia dei Ss. Ulrich e Afra di Augusta, consta di XI, 144 ff. e misura 205x155 mm. Formato da sei U.C., la Navigatio s. Brendani si trova nella I insieme a Christopherus Liebius, De dignitate et magnificentia Ordinis s. Benedicti, f. 19r e Versi e note varie, f. 19v. I fogli 22r-57v e 111r-127v sono di mano di Georgius Somervelt, la cui nota di possesso di mano del XVIII secolo si legge al f.Ir. Il manoscritto ha subito la perdita di un foglio dopo l'attuale f. 9v e la lacuna, corrispondente a XII 64-XV 36 è integrata al termine della copia, ff. 19v-21v, da una mano diversa da quella del copista. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-945> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2324633> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 6-7. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/augsburg-staats-und-stadtbibliothek-2°-203-manoscript/3819" ;
        :last_mod_form         "2024-01-29T14:48:25.83Z"^^xsd:dateTime .

