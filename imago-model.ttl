        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Jacobi Bracellei Genuensis descriptio ore ligustice ad Blondun Flavium Forlivese" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-252> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo e miscellaneo; ff. 312-331; numerazione irregolare.\r\nContiene inoltre: (f. 317) prefazione alle epistole di Ippocrate tradotte dal greco in latino da Rinuccio Aretino per il papa Niccolò V (inc.: «Philippus mediolanensis»); (ff. 317v-324) epistole (inizio con la lettera di Artaserse a Peto, inc.: «Morbus quod nomine appellatur pestis»; termine con la lettera di Ippocrate a Crateone [sic], inc.: «Scio te in herbarum viribus»); (ff. 324-330) epistola di Ippocrate a Damageto (trad. Rinuccio Aretino; inc.: «Quod auspicati sumus»); (ff. 330-331) epistola di Democrito a Ippocrate (inc.: «Ut mihi tamquam»); (f. 331) epistola di Ippocrate a Democrito (inc.: «Artis medicine»; expl.: «Expliciunt epistole Hipocratis et Democriti. Valeas qui legis»)." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-252> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/joseph-kusailas-collection> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. V, p. 422 </li><li><a href='https://imagoarchive.it/bibliografia.html#galletti-2023'>BRACELLI, Descriptio (tesi di laurea) 2023</a>, pp. 42-43 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-13T23:33:48.238Z"^^xsd:dateTime .

