<https://imagoarchive.it/ontology/resources/manuscript/leiden/universiteitsbibliotheek/voss._lat._f_75/1r50v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1250> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è composto da 100 ff. e misura 295x200 mm. Trasmette anche: John Mandeville , Itinerarius, ff. 51r-100r. Composto in Inghilterra in due parti, la prima contiene la traduzione di Pipino del Milione di Marco Polo e fu vergata nella seconda metà del XV secolo, mentre la seconda, che riporta Mandeville, è databile alla fine del XIV secolo. Le due parti furono messe insieme alla fine del XVI secolo. Il manoscritto ppartenne a Isaac Vossius (1618-1689) e fu poi trasferito all'Università di Leida. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1250> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q638395> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 654-663. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/author/franciscus-pipinus-n-1270-ca-m-1327-1328-author/20207 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/leiden-bibliotheek-der-universiteit-voss-lat-2°-75-manoscript/36525" ;
        :last_mod_form         "2024-02-02T12:45:06.114Z"^^xsd:dateTime .

