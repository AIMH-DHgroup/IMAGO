<https://imagoarchive.it/ontology/resources/manuscript/oxford/mertoncollegelibrary/89/2r186r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2292> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 186, II ff. e misura 345x245 mm. Il testo è disposto su due colonne di 50 righe in scrittura gotica. La rilegatura è in pelle bianca danneggiata su tavole di legno smussate del XV secolo. Molte note di proprietà sono state cancellate, alcune presenti al f. 186v e risalenti al XVI secolo collegano il manoscritto con un istituto monastico del nord-est del Gloucestershire, probabilmente Hailes o Winchcombe. Al f. IIv nota di possesso di Samuel Burton: \"Liber ecclesiae Christi Oxon ex dono Samuelis Burtoni, in artibus Magistri, et eiusdem ecclesiae alumni anno D. 1595\". Il testo del Polychronicon continua fino al 1377. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2292> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q6820719> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali colorate in blu e fioritura rossa. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, http://www.mirabileweb.it/title/polychronicon-ranulphus-higden-m-12-3-1364-ca--title/4071 </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "https://digital.bodleian.ox.ac.uk/objects/dfa62826-c93d-41e8-baa1-9337a34ae434/" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_3963" ;
        :last_mod_form         "2024-04-16T06:27:50.074Z"^^xsd:dateTime .

