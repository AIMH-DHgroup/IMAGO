<https://imagoarchive.it/ontology/resources/manuscript/milano/archiviostoricocivicoebibliotecatrivulziana/964/81v85v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
