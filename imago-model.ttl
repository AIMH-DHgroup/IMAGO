<https://imagoarchive.it/ontology/resources/manuscript/firenze/bibliotecamedicealaurenziana/plut._30.1/1r117r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1829> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 117, I' ff. e misura 604x435 mm. Il testo è disposto su due colonne in littera antiqua da due copisti, Hugues Commineau e Pietro Strozzi, con l'aggiunta forse di una terza mano che avrebbe copiato i toponimi delle carte. Il codice comprende i primi VII libri della Cosmographia, preceduti da una dedica adespota e anepigrafa ad Alessandro V. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1829> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q856419> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice è miniato da Antonio di Nicolò e dai suoi collaboratori. Al f. 1r ricca cornice che inquadra la dedica, con numerosi spazi bianchi destinati a stemmi, imprese e motti. Iniziale dorata raffigurante Tolomeo che regge una sfera. Iniziali maggiori dorate con fregi eleborati, iniziali minori in oro e in rosso. Il codice presenta 31 mappe geografiche. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 92-93. </li>" ;
        :has_url_manuscript    "http://mss.bmlonline.it/s.aspx?Id=AWOS3OHaI1A4r7GxMdXr&c=Ptolemaei%20tabulae%20geographicae#/book" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/firenze-biblioteca-medicea-laurenziana-plut-30-1-manoscript/143381" ;
        :last_mod_form         "2024-02-05T15:00:00.23Z"^^xsd:dateTime .

