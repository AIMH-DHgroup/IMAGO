                "http://www.mirabileweb.it/manuscript/wroclaw-biblioteka-uniwersytecka-i-q-37-(850)-manoscript/175218" ;
        :last_mod_form         "2024-03-03T10:00:16.827Z"^^xsd:dateTime .

