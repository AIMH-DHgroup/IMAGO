<https://imagoarchive.it/ontology/resources/manuscript/napoli/bibliotecanazionalevittorioemanueleiii/v.c.46/1r227v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1938> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 231 ff. e misura 389x260 mm. Il testo è disposto su due colonne. Nel De rerum naturis mancano le lettere di dedica e la tavola dei capitoli va dal XIII al XXII libro a causa della caduta del primo foglio, avvenuta dopo il 10 ottobre 1788 perché in quella data il verbale di consegna dei manoscritti della Biblioteca Capitolare di Troia alla Biblioteca reale di Napoli menzionava il codice con il titolo \"De origine rerum\", che doveva trovarsi nel primo foglio. Fino al f. 16v mancano le prime righe della pagina e molti capitoli sono incompleti. Il codice trasmette anche la Disputatio vel Defensio Pachalis Papae e la datazione per la realizzazione del manoscritto può essere definita tra il 1112, anno di composizione della Disputatio, e il 1137, anno in cui il codice risulta donato alla chiesa di Troia dal vescovo Guglielmo II. Il passaggio da Troia a Napoli avvenne a seguito dell'ordine di Ferdinando IV di Borbone, eseguito nel 1788, che fece trasferire i codici alla Reale Biblioteca di Napoli. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1938> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2256644> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/napoli-biblioteca-nazionale-vittorio-emanuele-iii--manoscript/223628" ;
        :last_mod_form         "2024-01-26T11:00:25.159Z"^^xsd:dateTime .

