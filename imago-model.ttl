<https://imagoarchive.it/ontology/resources/manuscript/oxford/corpuschristicollegelibrary/86/5r11r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1771> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 242 ff. e misura 280x170 mm, con il testo disposto su due colonne. Posseduto dal Corpus Christi College a partire da 1600 ca, il codice trasmette: Epistola Alexandri ad Aristotelem, ff.5-11; Epistolae quinque mutuae inter Alexandrum Magnum et Dindymum, Bragmannorum regem, ff.11-16; Ugo di San Vittore, Tractatus, ff.61-70; Onorio di Autun, Imago mundi, ff. 70r-89r; Liber de mirabilibus mundi abbreviatus, ff.89v-91r; Epistola presbyteri Iohannis, ff.91v-94; Libellus de mirabilibus Angliae, ff.94v-96; Pietro Alfonsi, De clericali disciplinis liber, ff.96r-113r; Esopo, Fabulae quadraginta quatuor, anonymo interprete, ff.113v-118r; Liber qui vocatur Elucidarium, editus a magistro Anselmo, sive, ut alii volunt, Gulielmo Conventrensi, ff.118r-146; Guido Vicentini, Liber philosophiae moralis, ff.146r-163r; Adelardo di Bath, De causis naturalium, ff.163r-188r; Liber domini Gondislvi, ff.188r-219r; Presbyteri de Barbarismo liber, ff. 230r-238." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1771> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1135137> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li><li><a href='https://imagoarchive.it/bibliografia.html#wagner-die-epistola-presbiteri-johannis'>WAGNER 2000</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#brewer-prester-john'>BREWER 2015</a>, p. 306. </li><li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/oxford-corpus-christi-college-86-manoscript/19862" ;
        :last_mod_form         "2024-04-05T09:54:49.234Z"^^xsd:dateTime .

