        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da III, 238, II' ff. e misura 277x210 mm. Esemplato in Italia, il codice è composito, formato da due diverse unità codicologiche: la prima, datata al 1487, corrisponde ai ff. 2-221, la seconda, ff. 222-239, risale all'ultimo quarto del XV secolo. Il manoscritto trasmette unicamente le opere di Leon Battista Alberti: Canis, ff. 2r-8r; Apologi centum, ff. 8r-14v; Musca, ff. 14v-20v; De equo animante, ff. 20v-28v; Amator, ff. 29r-38r; De iure, ff. 38r-45r; Trivia senatoria, ff. 45r-48v; Intercoenales, ff. 50r-94v; Pontifex, ff. 94v-118v; Psalmi precationum, ff. 118v-120v; Momus, ff. 122r-212r; Leonis ad Cratem philosophum, f. 219r; Elementa picturae, ff. 222r-226r; De statua, ff. 226v-233v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-291> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Diagrammi ai ff. 221-238. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, https://www.mirabileweb.it/title/descriptio-urbis-romae-title/4143 </li><li><a href='https://imagoarchive.it/bibliografia.html#leon-battista-albert-la-biblioteca-di-un-umanista'>ALBERTI BIBLIOTECA 2005</a>, pp. 282-286. </li><li><a href='https://imagoarchive.it/bibliografia.html#leon-battista-alberti-descriptio-urbis-romae-2000'>LEON BATTISTA ALBERTI, Descriptio urbis Romae 2000</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_3189" ;
        :last_mod_form         "2024-03-25T15:59:37.668Z"^^xsd:dateTime .

