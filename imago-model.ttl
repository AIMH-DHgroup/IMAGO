        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-180> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 47 ff. e misura 220x160 mm. Il testo è disposto su due colonne per 38/39 righe. Esemplato in Austria o Germania, precedentemente era siglato Admont, Stiftsbibl., 401. Il codice trasmette la Descriptio di Burcardo di Monte Sion nella redazione lunga e l'Historia Damiatina di Oliviero Scolastico, ff. 32r-45r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-180> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1r disegno a inchiostro di Cristo in trono colorato con due tonalità di blu-grigio e precedentemente incollato. Al f. 1v figura simile senza colore. Puzzle iniziale in rosso e blu, iniziali più piccole in blu. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>, pp. 283-286. </li>" ;
        :has_url_manuscript    "https://digital.bodleian.ox.ac.uk/objects/f31903de-71b2-4030-bead-5df415a1aa51/" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_6433" ;
        :last_mod_form         "2024-04-19T07:25:17.891Z"^^xsd:dateTime .

