                <http://www.mirabileweb.it/title/liber-locorum-sanctorum-terrae-ierusalem-title/699> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-259> ;
