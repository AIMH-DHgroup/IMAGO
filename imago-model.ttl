<https://imagoarchive.it/ontology/resources/manuscript/graz/technischeuniversitt/290_(=_39/23_f°)/6v11v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1193> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da due diverse unità: la prima, risalente al XIV secolo, corrisponde ai ff. 1-113, la seconda, del XII secolo, corrisponde ai ff. 118-227. Esemplato presso la biblioteca benedettina di St. Lambrechter, il codice trasmette anche: Onorio di Autun, Imago mundi, ff. 1r-6v; De origine urbis Rome, ff. 12r-15v; Anonymus Leobiensis, Chronicon, ff. 15v-109r; Continuatio Novimontensis 1338-1350, ff. 110r-113r; Note Lambertinae, f. 117v; Gregorio Magno, Regulae pastoralis liber, ff. 118r-208v; Onorio III, Conferma della proprietà di St. Lambrecht dal 1126, ff. 208v-209v; Expositio in Cantica canticorum, ff. 210r-227r. Il Tractatus è riportato solo per alcune sezioni, con differente ordine e molte interpolazioni, alcune risalenti a dopo il 1312. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1193> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2496350> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#p-trovato-new-perspectives'>TROVATO-KEDAR 2018</a>,  </li>" ;
