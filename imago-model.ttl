<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._5702/1r61v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Maffeus Vegius. De rebus antiquis memorabilibus basilicae Sancti Petri" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1478> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da II, 117 ff. e misura 239x270 mm. Il codice è stato vergato a Roma da mani diverse. Al f. II si legge un sommario delle prime due opere tradite, a cui segue un ritaglio della costa della vecchia rilegatura con l'indicazione in lettere capitali \"45 Vegius de memorabilibus S.ti Petri 5702\".  La nota \"De Castello\", collocata nel margine superiore destro dello stesso foglio, indica che il codice è tra quelli trasportati nel 1614 alla Vaticana dalla biblioteca di Castel Sant'Angelo. Il testo di Maffeo Vegio riportato è apografo di Catania, Biblioteche Riunite Civica e Ursino-Recupero, Fondo Civico B 20, da cui furono trascritte le annotazioni marginali di Giacomo Ercolano, il De translatione di Demetrio Guazzelli e un inno per s. Andrea scritto da Agapito Rustici. Nella coperta è presente lo stemma di Pio IX. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1478> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rebus-antiquis-memorabilibus-basilicae-sancti-p-title/9870 </li><li><a href='https://imagoarchive.it/bibliografia.html#della-schiava-il-de-rebus-antiquis-memorabilibus'>DELLA SCHIAVA 2011</a>, p. 192. </li>" ;
        :has_url_manuscript    "https://opac.vatlib.it/mss/detail/Vat.lat.5702" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/84109" ;
        :last_mod_form         "2024-02-05T10:36:54.378Z"^^xsd:dateTime .

