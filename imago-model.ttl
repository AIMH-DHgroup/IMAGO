<https://imagoarchive.it/ontology/resources/manuscript/berlin/staatsbibliothekpreuischerkulturbesitz/gorres_111__/96v104r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
