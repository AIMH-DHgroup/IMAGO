        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li>" ;
