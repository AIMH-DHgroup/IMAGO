<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._6492a/2r31v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1784> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 36 ff. Ai ff. 32r-36r c'è una descrizione della città di Roma. Al f. 36r si legge: \"In Historia Gervasii Maerscalci Arelatensis Tilleberiensis, quam mittet Ottoni suo anno quarto Romanum imperator, ita dicitur ubi tractat de fontibus: \"Sunt vinum cribeum colando per pannos albescit et in littore maris fontes in ipso maris fundo aquam dulces reperiuntur. Sed et in urna grandi si capillos Veneris epaticam cithara epolitrichum herbasque in fontibus nascentes arena foncium superstraveris\". Ai ff. 36r-36v si legge, in altra mano: \"Historia de quodam mortuo qui apparuit post obitum\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1784> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/otia-imperialia-gervasius-tilberiensis-n-1152-ca-m-title/4608 </li><li><a href='https://imagoarchive.it/bibliografia.html#caldwell-manuscripts-of-gervase-of-tilburys-otia-imperialia'>CALDWELL 1962</a>,  </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b9066521q" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/paris-bibliothèque-nationale-de-france-lat-6492-a-manoscript/166841" ;
        :last_mod_form         "2024-01-24T09:06:18.018Z"^^xsd:dateTime .

