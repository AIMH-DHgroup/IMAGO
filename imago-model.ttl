<https://imagoarchive.it/ontology/resources/manuscript/besanon/bibliothquemunicipale/660/61r72v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Solinus, de mirabilibus mundi etc." ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1987> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 175 ff. e misura 276x197 mm. Il testo è disposto su due colonne. Il codice trasmette solo alcuni estratti del libro I di Onorio di Autun, corrispondenti ai capitoli I.1-3, 4-88, 93-96, 98-126, 142-147. Il manoscritto trasmette inoltre: Solino, Collectanea rerum memorabilium, ff. 1r-51v; Goffredo da Viterbo, Pantheon, ff. 51r-53r; Rodrigo Jiménez de Rada, Historia de rebus Hispaniae, ff. 53v-60v; Landolfo Sagace, Historia romana, ff. 73r-73v; Trattato su Roma, ff. 73v-77v; Rodrigo Jiménez de Rada, Historia de rebus Hispaniae, ff. 80r-173r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1987> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2901451> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://ccfr.bnf.fr/portailccfr/jsp/index_view_direct_anonymous.jsp?record=eadcgm:EADC:D35B10580" ;
        :last_mod_form         "2024-02-15T11:37:28.436Z"^^xsd:dateTime .

