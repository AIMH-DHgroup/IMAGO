        :has_decoration        "32 mappe finemente colorate." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#valentinelli-1873'>VALENTINELLI 1873</a>, vol. 6, p. 297 </li><li><a href='https://imagoarchive.it/bibliografia.html#ragone-g-liber-insularum'>RAGONE 2002</a>, p. 217, n. 136 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. II, p. 231 </li>" ;
