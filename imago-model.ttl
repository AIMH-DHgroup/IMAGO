<https://imagoarchive.it/ontology/resources/manuscript/roma/archiviocapitolarelateranense/a._70/158>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1621> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice membranaceo è composto da 58 ff, vergate da più mani. Al f. 2v si leggono due iscrizioni di papa Sergio III poste sui muri della basilica a ricordo dei restauri da lui eseguiti \"Augustus Caesar totum cum duceret orbem\" e \"Aula Dei haec similis Synai sacra iura ferenti\", entrambe oggi scomparse. All'interno del manoscritto sono trasmesse notizie relative alla consuetudine dell'altare di S. Salvatore per le competenze dei chierici e della chiesa, un atto di donazione del 1177, una convenzione del 1232 tra la chiesa Lateranense, il primicerio e la schola cantorum, versi e notizie di mano posteriore, l'epigrafe  \"Agnoscant cuncti sacro baptismate functi\". Seguono la prima redazione della descrizione della basilica, di mano del XII secolo, fino al f. 13, la seconda redazione, del XIII secolo, con una appendice sulle stazioni del pontefice nelle festività e nella quaresima, fino al f. 29, una terza redazione, del XIII secolo, con in fondo un catalogo di papi da san Pietro fino a Urbano IV, continuato da altre mani fino a Paolo IV. Seguono il testo della Descriptio l'atto di donazione alla chiesa di Costantino e un Provinciale. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1621> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q84090> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#oftestad-the-lateran-church'>OFTESTAD 2019</a>, pp. 193-203. </li><li><a href='https://imagoarchive.it/bibliografia.html#codice-topografico-della-citta-di-roma'>VALENTINI-ZUCCHETTI 1940-1953</a>, III, pp. 319-325. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-lateranensis-ecclesiae-title/216896 </li><li><a href='https://imagoarchive.it/bibliografia.html#vogel-la-descriptio-ecclesiae-lateranensis-du-diacre-jean'>VOGEL 1956</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-04-04T08:27:51.947Z"^^xsd:dateTime .

