<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/laud._misc._545/9r209v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2281> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 209 ff. Il testo è disposto su due colonne; manca un foglio tra 203 e 204. Il codice appartenne a Thomas Crofts di Westhall e fu da lui donato a Richard Mutford dell'abbazia cistercense di Santa Maria Vergine di Sibon, come si legge al f. 8r: \"Hunc librum Thomas Crofftis de Westhale armiger ob sinceram devocionem dedit deo et beate Marie virginis et monasterio de Sybeton ita quod dominus Ricardus Muttforde monachus dicti monasterii de Sybeton istum librum ad placitum habeat in usum et occupacionem tempore vite sue et tandem remancipetur monasterio beate Marie de Sybeton\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2281> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_7347" ;
        :last_mod_form         "2024-04-16T06:17:23.731Z"^^xsd:dateTime .

