<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/cotton_faustina_b_i/196r203v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-766> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice membranaceo e composito è formato da ff. II, 229 e misura 260 x 180 mm. Il suo antico possessore era  Robert Bruce Cotton (n. 1571, m. 1631). Il codice comprende principalmente testi e documenti legati alla storia inglese, su Thomas Becket, ff. 2r-11r,  sulla storia dell'abbazia di Winchcombe, ff. 12-29,  un cartulario sull'abbazia di Barlings, ff. 30-179,  la vita di sant'Edmondo, ff. 180-183, l'  Admonitio ad regem Edwardum III, ff. 184-191. Ai ff. 192-205 ci sono invece le opere di Bernardo il monaco, Itinerarium trium monachorum, ff. 192r-196r, e Beda, De locis sanctis, ff. 196r-2013v. Il codice prosegue poi con alcune lettere pontificie indirizzate al convento di Clairvaux, ff. 204v-205r, documenti riguardanti la città di Londra, ff. 206r-222r, e l'arcivescovo Thomas di Hereford, ff. 223r-228v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-766> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#httpswwwbedadlsgwiuni-muenchendeabout'>BEDA VENERABILIS, De locis sanctis </a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, https://www.mirabileweb.it/title/de-locis-sanctis-beda-venerabilis-n-672-673-ca-m-2-title/8029 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://searcharchives.bl.uk/IAMS_VU2:LSCOP_BL:IAMS040-001103861" ;
        :last_mod_form         "2024-02-14T08:01:27.423Z"^^xsd:dateTime .

