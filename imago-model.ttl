        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-128> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 65, IV' ff. e misura 216x145 mm, con il testo disposto su due colonne. Esemplato in Italia, il codice fu posseduto dal convento di Santa Maria Novella a Firenze. Formato da due diverse unità codicologiche, la prima esemplata a Santa Maria Novella a Firenze prima del 1320, la seconda vergata intorno alla prima metà del XIV secolo, il manoscritto trasmette il Liber peregrinationis di Ricoldo da Monte Croce, ff. 1r-23v, e la Descriptio Terrae Sanctae di Burcardo di Monte Sion nella redazione lunga. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-128> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q170109> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>, pp. 283-286. </li>" ;
        :has_url_manuscript    "https://digital.staatsbibliothek-berlin.de/werkansicht?PPN=PPN792518055&PHYSID=PHYS_0128&DMDID=DMDLOG_0008" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/berlin-staatsbibliothek-zu-berlin-preußischer-kult-manoscript/2560" ;
        :last_mod_form         "2024-04-19T07:39:36.873Z"^^xsd:dateTime .

