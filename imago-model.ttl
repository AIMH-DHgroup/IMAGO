        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/london-british-library-add-15106-manoscript/123331" ;
        :last_mod_form         "2024-01-30T11:38:27.497Z"^^xsd:dateTime .

