<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/cotton_vespasian_e_iii/154r170r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1980> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è composto da sei parti che sono tutte state copiate in Inghilterra. La prima parte, ff. 4-102, fu prodotta nell'abbazia di Burton all'inizio del XIII secolo e trasmette gli Annali dell'abbazia di Burton; la seconda parte, ff. 103-108, è un resoconto del Concilio di Oxford del 1222; la terza parte, ff. 109-116, contiene la Confessio di San Cipriano di Antiochia e fu esemplata nell'XI secolo; la quarta parte, ff. 117-170, contiene l'Admonitio ad filium spiritualem, i Synonyma di Isidoro di Siviglia, il De inizio et fine saeculi attribuito a Metodio, le Constitutiones di Alessandro di Stainsby, vescovo di Coventry, e l'Imago mundi di Onorio di Autun; la quinta parte, ff. 171-178, contiene l'Invectivum contra regem Iohannem scritto nella prima metà del XIII secolo; la sesta parte, ff. 179-213, conserva la Vita sancti Malchi di Reginaldo di Canterbury e fu scritta nel X secolo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1980> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-001103394&indx=2&recIds=IAMS040-001103394&recIdxs=1&elementId=1&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=cotton%20vespasian%20E%20III&dum=true&dstmp=1681982353618" ;
        :last_mod_form         "2023-04-20T09:27:26.583Z"^^xsd:dateTime .

