<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._3089/1r158v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
