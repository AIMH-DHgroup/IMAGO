<https://imagoarchive.it/ontology/resources/manuscript/mnchen/bayerischestaatsbibliothek/clm_16485/213v216r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1548> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 234 ff. e misura 310x215 mm. Il codice trasmette anche: Commentarius in summulam metricam Raymundi; Casus papae et diocesanis reservati; De clericis confitentibus; Sermones; De poenitentia; Satisfactiones poenitentiae secundum summam Iohannis; De sepultura neganda; Stationes ecclesiarum urbis Romae; Coniurationes diaboli. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1548> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q256507> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 57. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.digitale-sammlungen.de/en/view/bsb00008254?page=78,79" ;
        :last_mod_form         "2023-03-16T14:40:23.292Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manifestation/manuscript/mm-386>
        rdf:type  <http://imagoarchive.it/ilrmoo/F3_Manifestation> ;
        <http://imagoarchive.it/ilrmoo/R7i_is_materialized_in>
                <https://imagoarchive.it/ontology/resources/manuscript/hereford/cathedrallibrary/o.v.15/1r303v> .

<https://imagoarchive.it/ontology/resources/manuscript/firenze/bibliotecanazionalecentrale/conv._soppr._f.4.733/29r43r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-145> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 106, IV' ff. e misura 360x240 mm, con legatura di pergamena su cartone del XVIII secolo. Al f. 108v si legge la nota di possesso di Santa Maria Novella: \"Iste liber est fratrum predicatorum conventus sancte Marie Novelle de Florentia. Cronica fratris Martini, Postille super Job, Ecclesiasten\" e al f. 105v si legge: \"Fuit repertum anno MCCCCVI die XVI mensis Februarii quod postilla super Ecclesiasten fuit furata\".  Il codice si compone di tre unità codicologiche: la prima, corrispondente ai ff. 1-61, è scritta in littera textualis di una sola mano ai ff. 1-28, di altra mano ai ff. 29-30, e di diverse mani ai ff. 44-60; trasmette il Chronicon di Martin Polono, ff. 1r-26v; le Expositiones prologorum Bibliae di Guglielmo il Bretone, ff. 43v-52v; gli Annales florentini, ff. 58r-58v; l'Historia scolastica di Pietro Comestore, ff. 58v-60r; Consules et potestates Florentinae civitatis, f. 60r,  e la Descriptio di Burcardo di Monte Sion nella redazione lunga, ff. 29r-43r. La seconda unità codicologica, ff. 62-69, vergata in littera textualis di una sola mano, riporta al f. 62r una nota di possesso semitagliata relativa a Riccoldo da Monte Croce \"Iste liber est fratris Ricculdi ordinis predicatorum; al f. 69v: \"Iste liber est chonventus sancte Marie Novelle de Florentia\" e, di altra mano, \"Debet stare in armario .10. videlicet in lictera .k.\" L'unità riporta bolle e decreti di papa Clemente IV. La terza sezione, ff. 70-106, è vergata in littera textualis; trasmette Ugo di San Caro, Postillae in Bibliam, ff. 70r-105r. Ai ff. 107-108 è riportato un frammento redatto dopo il 1377 su un bifoglio, utilizzato per la scrittura di due ricordi storici del primo Trecento.  L'assemblaggio del codice non avvenne prima del terzo quarto del Trecento, forse ad opera di un bibliotecario di Santa Maria Novella. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-145> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q460907> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali figurate, al f. 29r lettera iniziale decorata con motivi vegetali; iniziali filigranate in rosso e blu. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>, pp. 283-286. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/manuscript/181447" ;
        :last_mod_form         "2024-04-19T07:36:29.618Z"^^xsd:dateTime .

