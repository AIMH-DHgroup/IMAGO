<https://imagoarchive.it/ontology/resources/manuscript/newhaven/beineckerarebookandmanuscriptlibrary/beinecke_rare_book_and_manuscript_library_406/93r134v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-694> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice membranaceo è formato da due sezioni, ff. 1-92 e ff. 93-141. Il manoscritto fu esemplato nel Nord-est della Francia intorno al 1400 e presenta note marginali in francese e latino. Il manoscritto trasmette inoltre: Guillaume de Deguilleville, Le Pelerinage de vie humaine, ff. 1r-85v; Guillaume de Deguilleville, tre poesie in latino, ff. 85v-92r;  Riassunto di Aethicus Ister, Cosmographia III. 31-39, ff. 134v-135r; Jean Chapuis, Les sept articoli de la foi, ff. 135v-141v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-694> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q814779> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Nella prima parte del codice sono presenti 79 miniature, semplici disegni a penna colorati in rosa, rosso, marrone, viola e blu in cornici a righe colorate di giallo. Tra i soggetti ci sono: un pellegrino, f. 1r, l'autore sogna Gerusalemme, f. 1r, la città di Gerusalemme, f. 1r, Ss. Benedetto e Francesco nella città di Gerusalemme, f. 1v, scene tratte dall'Antico Testamento e riguardanti principalmente Mosè. Nella seconda parte del codice sono presenti tre disegni colorati, la Natività, f. 136v, il Tormento dell'Inferno, f. 138v e l'Ascensione, f. 140r. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/itinerarium-title/5663 </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-guglielmo-di-rubruk'>GUGLIELMO DI RUBRUCK, Itinerarium 2011</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-testo-e-tradizione'>CHIESA 2008</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://pre1600ms.beinecke.library.yale.edu/docs/pre1600.ms406.HTM" ;
        :last_mod_form         "2024-02-15T07:44:08.791Z"^^xsd:dateTime .

