<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/679/127v140r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2099> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo trasmette per intero il testo di Honorius Augustodunensis e riporta inoltre: Domenico Gundisalvo, De divisione philosophiae; Trattato alchemico; Pierre de Blois, Speculum iuris canonici; Trattato di aritmetica; Giovanni di Sacro Bosco, Tractatus de sphaera; Roberto Grossatesta, Composto; Guglielmo di Conches, De philosophia mundi; Testi scientifici; Adelardo di Bath, Quaestiones naturales. Al f. 2v si legge la nota di possesso: \"Collectiones Iohannis de London de librario monasterii sancti Augustini Cantuarie. Clemens Cantyrbury\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2099> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
