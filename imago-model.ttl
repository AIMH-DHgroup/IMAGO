        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 177. </li><li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-26T16:10:46.137Z"^^xsd:dateTime .

<http://www.mirabileweb.it/author/belardus-de-esculo-fl-saec-xii-ante-med--author/24885/datazione>
        rdf:type  <http://erlangen-crm.org/211015/E52_Time-Span> ;
        <http://erlangen-crm.org/211015/P170i_time_is_defined_by>
                "fl. saec. XII prima metà" .

<https://imagoarchive.it/ontology/resources/manuscript/milano/bibliotecaambrosiana/a_275_inf._/31r60v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1321> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da VI, 258, IV' ff. e misura 410x290 mm. Il codice trasmette alcune opere di Galvano Fiamma: la Politia Novella, ff. 1r-30v; il Chronicon maius, ff. 61r-233v, e l'Opusculum de rebus gestis ab Azone, Luchino et Iohanne Vicecomitibus, ff. 234r-257v. Il manoscritto fu messo insieme prima della fine del XV secolo e giunse all'Ambrosiana per dono di Girolamo Bascapè, giureconsulto collegiato dal 1592, capitano di giustizia dal 1621al 1626 e senatore togato dal 1633 fino alla morte, come si legge in due note di possesso di mani seicentesche ai ff. IIr e IIIr. Molto probabilmente il codice è l'unione di due volumi diversi, allestiti per avere vita autonoma e poi fusi insieme: il primo doveva trasmette la Politia, l'Estravagante e l'Opuscolo, il secondo la Cronaca. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1321> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q815611> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 46v è presente una mappa di Milano con le mura romane e comunali. La mappa è una rappresentazione geometrica delle due cerchie di mura di Milano con i punti cardinali scritti in rosso. Al centro della mappa c'è il Broletto nuovo, sulla cerchia interna le sei porte di epoca romana, su quella esterna le sei porte di età comunale. All'interno della mura rientrano ed escono anche dei corsi d'acqua. Al f. 51v è invece rappresentata una carta dell'Italia, orientata con il Sud in alto, che riporta 1089 nomi di fiumi, monti, regioni e città. Al f. 93 è presente infine una mappa della Milano romana, orientata con il Sud in alto e i punti cardinali segnati in rosso. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#cengarle-parisi-david-la-cronaca-estravagante-di-galvano-fiamma'>GALVANO FIAMMA, La cronaca estravagante 2013</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/chronica-extravagans-galvanus-flamma-n-1283-m-post-title/5406 </li><li><a href='https://imagoarchive.it/bibliografia.html#tomea-galvano-fiamma'>TOMEA 1997</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/cnmd/0000030692" ;
        :last_mod_form         "2024-03-31T21:14:19.893Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/print_edition/pe-188>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Itinerarium  " ] ;
        <http://erlangen-crm.org/211015/P2_has_type>
                <https://imagoarchive.it/ontology/resources/print_edition/edition/prima_edizione_/_editio_princeps> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "" ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/itinerarium-cyriacus-anconitanus-n-1391-m-1453-145-title/5874> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-188> ;
        :compiled_form              "Martina Piccolo" ;
        :has_ecdotic_type           <https://imagoarchive.it/ontology/resources/print_edition/edition/edizione_commentata> ;
        :has_figure_note            "" ;
        :has_introduction_note      "Premessa di Paolo Giovannelli (pp. V-X); praefatio ad lectorem Laurentius Mehus (pp. XI-LXIII)" ;
        :has_other_contents         "L'edizione curata dal Mehus, oltre all'Itinerarium, contiene: Kiriaco Anconitano Joannes Cirignanus (pp. LIV- LXVIII); Karoli Arretini ad Kyriacum Anconitanum 'carmen elegiacum' (pp. LXVIII-LXXII); Epistola I, D. Joanni Ricinati, De Ricinesi conditore ac de utilitate veterum monumentorum (pp. 53-55); Epistola II (di Ciriaco) ad Georgium Begnum Jaderti num, De itinere suo ex Corcyra ad Dalmatiae promontorium (pp.56-57); Epistola III Kyriacus Francisco, De itinere suo ex Fadera usque ad Acarnaniam (pp. 58-65); Epistola IV, Kyriacus Georgio Ragnarolio Pisaurensi, De itinere suo ex Acarnania ad Astacora et de visis ibi monumentis (pp. 66-67); Epistola V, Karulo inclyto Epirotarum regi Kyriacus Anconitanus, De suo itinere ex Astacore ad Dodonaeum Orionatium (pp. 68-70); Epistola VI, Kyriacus Anconitanus S. D. Danieli sacerdoti optumo et amico dulcissimo suo, Memnon se vidisse scribit ac Lacedaemona esse profect(?) (pp. 71-72); Epistola VII ad Franciscum Scalamontium equitem clarissimum, Se bellorum historiam scripturum pollicetur studiisque sacris operam deinceps navaturm (pp. 73-76); Eistola VIII ad P. in Christo reverendissimum Ludovicum optimum Aquilejensium patriarcham Kyriacus Anconitanus, Ludovico Scarampo gratulatur quod ad patriarcham Aquilejensem evec(?) fuerit (pp. 77-80) " ;
        :has_primary_source         "" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Kyriacus Anconitanus" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-188> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-188> ;
        :last_mod_form              "2024-01-19T12:41:56.48Z"^^xsd:dateTime .

