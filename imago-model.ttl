<https://imagoarchive.it/ontology/resources/manuscript/augsburg/staatsundstadtbibliothek/2°_289/154v158v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-946> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è composto da 158 ff. e misura 275 x 205 mm, con il testo disposto su due colonne. Il codice propone una versione abbreviata della Navigatio, con l'omissione dei capitoli IV, dedicato alla costruzione della navicula, e XIV, in cui si racconta dei monaci che si lasciano trasportare in nave dal vento. Per l'edizione di questo manoscritto si rinvia a: http://ecodicibus.sismelfirenze.it/uploads/5/5/559/Nessi_Augsburg.pdf" ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-946> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2324633> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 139-140. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/augsburg-staats-und-stadtbibliothek-2°-289-manoscript/183301" ;
        :last_mod_form         "2024-02-02T15:21:50.032Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/bordeaux/bibliothquemunicipale/414/1r296v301v339v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-346> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 339 ff. e misura 270x220 mm. Al f. 339v si legge: \"Deo gratias. Christus laudetur, quia libri finis habetur. Iste liber est Johannis de Prucia scriptoris\". Sono presenti numerose annotazioni testuali, soprattutto sul margine inferiore, aggiunte per colmare le lacune del testo; quando la capienza dei margini è superata da queste correzioni, le aggiunte sono riportate alla fine del manoscritto. Il codice trasmette anche: Marbodo di Rennes, Liber lapidum seu de gemmis, ff. 297r-301r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-346> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q501869> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 46. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-26T14:27:44.049Z"^^xsd:dateTime .

