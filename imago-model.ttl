<https://imagoarchive.it/ontology/resources/manuscript/padova/bibliotecacivica/b.p._129/237241>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-89> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da I, 277, I pp. e misura 298x202 mm. La legatura è del XVIII secolo, la coperta in cuoio. Il codice, composto da fascicoli di varia lunghezza e dimensione, è una raccolta per gli Opera omnia di Vergerio, in larga parte estratti e soprattutto epistole, copiata a Padova da Gian Roberto Papafava (1722-1767). A p. 237, in corrispondenza dell'incipit del De situ, si legge la nota \"Cod. Reff. p. 28\", che segnala che il testo dell'opera sia stato copiato dal cod. B.P. 1287 della Biblioteca Civica. Il De situ urbis Iustinopolitane è preceduto, alle pp. 233-236, da excerpta tratti dall'Italia illustrata di Biondo Flavio, dalla Naturalis Historia di Plinio, dalla traduzione latina della Geographia di Strabone, dalla Chronica patriarcarum Aquilensis ecclesiae e dalla Chronica Sancti Nicolai, ed è seguito, alle pp. 241-253, dal De republica Venetorum. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-89> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q21328933> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#vergerio-2023'>VERGERIO, De situ Iustinopolitane 2023</a>, p. 16. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.culturaveneto.it/it/beni-culturali/manoscritti/5d137055656efb0a30dba188" ;
        :last_mod_form         "2024-03-04T15:49:15.07Z"^^xsd:dateTime .

