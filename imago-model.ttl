        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, https://www.mirabileweb.it/title/liber-de-quibusdam-ultramarinis-partibus-et-praeci-title/7772 </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/uz/wilhelm_von_boldensele.html </li>" ;
        :has_url_manuscript    "https://digital.onb.ac.at/RepViewer/viewer.faces?doc=DOD_50654&order=1&view=SINGLE" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/wien-österreichische-nationalbibliothek-3529-manoscript/1468" ;
