<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/ott._lat._1261/23r70r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1597> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 183 ff. e misura 304x212 mm. Esemplato in Italia, il codice è parzialmente datato al 1435 e trasmette testi di Cicerone, Stazio, Pompeo Festo. La sezione del manoscritto che trasmette la Polistoria è stata vergata per Niccolò di Pando, giureconsulto di Manfredonia, da un copista che si firma \"Frascatus\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1597> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#codice-topografico-della-citta-di-roma'>VALENTINI-ZUCCHETTI 1940-1953</a>, IV, pp. 18-19. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/author/iohannes-caballini-de-cerronibus-v-1325-1349-author/23044 </li><li><a href='https://imagoarchive.it/bibliografia.html#ioannes-caballini-de-cerronibus-polistoria-1995'>IOANNES CABALLINUS DE CERRONIBUS, Polistoria 1995</a>,  </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Ott.lat.1261/0001" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdataf7fd89a002d70986f14676731549cfa5cc3f0de2" ;
        :last_mod_form         "2024-02-22T22:02:13.184Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/3408/2r4r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1452> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 260 ff. e misura 282x207 mm. Il codice trasmette inoltre: Benvenuto da Imola, Liber augustalis, ff. 6r-120r; Historia Brittaniae minoris, ff. 133r-136r; Tabellae chronologicae, ff. 137r-140r; estratti dell'Historia di Goffredo di Monmouth, ff. 141r-145r; Epitaphium Romae super sepulcrum Catwaladri, f. 145v; Historia Angliae, ff. 145v-153r; Generatio regum Franciae, ff. 153r-155v; Successio imperatorum de sanguine Caroli Magni, ff. 156r-158r; Genus et successio regum Franciae in sanguine Hugonis Capeth, ff. 156r-158r; Successio regum Franciae qui cognominatur de Valoys, f. 158r; Notabilia historiae, ff. 158v-162v; Gesta regum Franciae, ff. 162v-170r \r\n 170r-176v; Legenda sancti Ivonis, ff. 177r-179r; Historia Bertrandi de Guesclin, ff. 179v-188r; Leonellus episcopus Concordiensis, Oratio, ff. 188v-195v; Genealogia regum Angliae, ff. 202r-204r; Flores temporum, ff. 215r-260r; Adnotata historiam Austriae concernentia, f. 260r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1452> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
