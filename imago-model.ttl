<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/1728/1102>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2246> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto, risalente alla prima metà del XV secolo, è formato da 102 ff. e misura 300x210 mm. Trasmette la prima parte del Polychronicon, che continua nel manoscritto Harley 1729. Al f. 1v elenco dei re da Guglielmo il Conquistatore fino ad Arturo, principe di Galles. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2246> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Disegni dell'Arca di Noè in inchiostro rosso (f. 47r). 4 iniziali a colori e oro con decorazione foliata comprendente acanto e foglie che si estendono ai margini all'inizio del prologo e di ogni libro (ff. 9r, 11r, 43r, 67v). Numerose iniziali più piccole in blu con penna rossa fiorente." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002047559&indx=1&recIds=IAMS040-002047559&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Harley%201728&dum=true&dstmp=1685355661410" ;
        :last_mod_form         "2023-05-29T10:25:30.78Z"^^xsd:dateTime .

