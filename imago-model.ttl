<https://imagoarchive.it/ontology/resources/manuscript/melk/stiftsbibliothek/46_(959;_h._17)/121r130r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-164> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto composito è formato da 167 ff. e misura 305x210 mm. Il codice è composto da due unità codicologiche, entrambe esemplate a Melk e costituite dai ff. 1-156 e 157-167. Il codice riporta: Flores temporum, ff. 1r-36v; Gesta Alexandri Magni, ff. 37r-60r; Jacques de Vitry, Historia orientalis, ff. 60r-121r; Burcardo da Monte Sion, Descriptio Terrae Sanctae, ff. 121r-130r; Innocenzo III, Constitutio \"Ad apostolicam audientiam\", f. 121r; Aimaro, De statu Terrae Sanctae, ff. 130r-130v; Filippo Busseri, Descriptio Terrae Sanctae, ff. 130v-135v; Rorgo Fretello, Liber locorum sanctorum terrae Ierusalem, ff. 135v-139r; Odorico da Pordenone, Itinerarium de mirabilibus orientalium Tartarorum, nella fase A, redazione H, ff. 139r-151r; Wolfgang de Stira, Itinerarium, ff. 157r-159r; Historia brevis reformationis monasterii Mellicensis anno 1418, ff. 159v-162r; Catalogus religiosorum Mellicensium 1418-1498, ff. 159v-162r; Nota quaedam occurentia difficultatis circa mobilitatem festorum 1446-1491, ff. 165v-166r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-164> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1589808> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, p. 26. </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-per-un-riordino'>CHIESA 1999-2000</a>, pp. 311-350 </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>, pp. 134-135. </li>" ;
        :has_url_manuscript    "https://manuscripta.at/diglit/AT6000-46/0009" ;
        :has_url_manuscript_description
                "https://manuscripta.at/hs_detail.php?ID=40086" ;
        :last_mod_form         "2024-04-19T07:31:17.069Z"^^xsd:dateTime .

