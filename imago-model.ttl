        :has_decoration        "Iniziali in rosso. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 47. </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, p. 25. </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>, pp. 132-133. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002046391&indx=1&recIds=IAMS040-002046391&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Harley%20562&dum=true&dstmp=1678909349902" ;
        :last_mod_form         "2023-03-15T19:54:41.694Z"^^xsd:dateTime .

