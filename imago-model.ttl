<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_5115/2r47v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1254> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è composto da 152 ff., con il testo disposto su due colonne, e misura 320x205 mm. Non sono presenti marginalia. Esemplato in Inghilterra, al f. 108r si legge: \"Iste liber constat Roberto Gray de kyngston Mawerwarde iuxta Stynysford in Com. dors. Armiger\". Il nome di Roberto Gray appare inoltre al f. 151r. Il manoscritto passò poi alla collezione di Robert e Edward Harley, che vendette i suoi codici allo stato inglese nel 1753. Trasmette inoltre: Aitone da Corico, Flos Historiarum, ff. 47v-86v; Goffredo di Monmouth, Historia Regum Britanniae, ff. 87r-150r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1254> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali in blu, rubriche in rosso. Al f. 150v è aggiunto uno schizzo a penna di uno stemma. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 698-704. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/author/franciscus-pipinus-n-1270-ca-m-1327-1328-author/20207 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.bl.uk/catalogues/illuminatedmanuscripts/record.asp?MSID=4770&CollID=8&NStart=5115" ;
        :last_mod_form         "2024-02-02T12:49:47.944Z"^^xsd:dateTime .

