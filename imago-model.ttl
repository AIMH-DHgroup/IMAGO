<https://imagoarchive.it/ontology/resources/manuscript/firenze/bibliotecanazionalecentrale/banco_rari_50_/123v124r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-11> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Codice delle dimensioni di mm. 315x235, appartenuto nel sec. XVII a Carlo di Tommaso Strozzi.\r\nNoto anche come Zibaldone Magliabechiano, contiene testi prevalentemente storici, di autori classici e medievali. Di Boccaccio, oltre al De Canaria, sono presenti le Epistole VIII e IX. Di mano dell'autore anche: postille in semigotica, tre disegni (ff. 53r, 56v, 59v) e diverse maniculae (ad es. f. 18r). Molto dubbia l’attribuzione al Boccaccio di altri tre disegni (ff. 46v, 63v e 180v)." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-11> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q460907> ;
        :compiled_form         "Rita Nicoli" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#pastore-stocchi-introduzione-a-de-canaria'>PASTORE STOCCHI 1992</a>, pp. 965-968 </li><li><a href='https://imagoarchive.it/bibliografia.html#pastore-stocchi-il-de-canaria'>PASTORE STOCCHI 1959</a>, pp. 143-155 </li><li><a href='https://imagoarchive.it/bibliografia.html#cursi-la-scrittura-e-i-libri-di-giovanni-boccaccio'>CURSI 2013</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#padoan-petrarca-boccaccio-e-le-canarie'>PADOAN 1964</a>, pp. 263-277 </li><li><a href='https://imagoarchive.it/bibliografia.html#bocchi-a-appunti-di-lettura-sul-de-canaria'>BOCCHI 2014</a>, pp. 189-198 </li><li><a href='https://imagoarchive.it/bibliografia.html#surdich-1977'>SURDICH 1977</a>, pp. 247-256 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-23T10:36:32.368Z"^^xsd:dateTime .

