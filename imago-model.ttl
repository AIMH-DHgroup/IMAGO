                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Fragmentum de regibus Francorum et Anglorum ex libro de mirabilibus mundi " ] ;
        <http://erlangen-crm.org/211015/P2_has_type>
                <https://imagoarchive.it/ontology/resources/print_edition/edition/prima_edizione_/_editio_princeps> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Nel testo sono editi solo alcuni estratti degli Otia imperialia riguardanti i re inglesi e francesi. L'edizione fa parte del volume \"Historiae Francorum scriptores coaetanei, III\", consultabile al link: https://archive.org/details/HistoriaeFrancorumScriptores3/page/n3/mode/2up" ;
