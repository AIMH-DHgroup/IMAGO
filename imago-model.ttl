<https://imagoarchive.it/ontology/resources/manuscript/greenwich/nationalmaritimemuseum/p_13/837>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-837> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo e monografico; ff. 38 (ai quali se ne aggiungo 4 di guardia cartacei del XIX sec.); numerazione moderna, a lapis, in cifre arabe sul recto del foglio nel mg. sup. destro. Scrittura di una sola mano, in inchiostro marrone, in umanistica corsiva posata. Legatura restaurata in pelle lavorata (XIX sec.). " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-837> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1199924> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Capilettera assenti (spazio bianco di 2/3 linee di testo). Le mappe del Liber insularum sono dettagliate e quasi tutte colorate ad acquarello (verde per il mare, marrone per i rilievi), presentano didascalie dello stesso inchiostro del testo e il nome dell'isola in inchiostro rosso." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. IV, p. 34 </li>" ;
