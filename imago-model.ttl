        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#kottje-ziegler-verzeichnis-der-handschriften'>KOTTJE-ZIEGLER 2012</a>, p. 213, n. 1223 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/venezia-biblioteca-nazionale-marciana-lat-ii-56-(2-manoscript/223800" ;
        :last_mod_form         "2024-01-29T08:53:18.154Z"^^xsd:dateTime .

