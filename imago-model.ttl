                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-419> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo e cartaceo è formato da 198 ff. e misura 400x280 mm. Al f. 195r si legge la nota: \"Anno Domini MCCCC55 prima die sabbati post Marci evangeliste\", e al f. 198v: \"Anno Domini MCCCC55 finita est hec tabula super librum de proprietatibus rerum. In vigilia Invencionis sancte crucis\". Il codice è una copia di un esemplare del monastero cistercense di Heiligenkreuz o Lilienfeld. Il commento allegorico al testo, di solito riservato alle note marginali, è qui attestato nelle colonne, dove mezza riga o un terzo di riga o più righe sono riservate all'interpretazione del testo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-419> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1589808> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li><li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 77-78. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://18.235.151.129/detail.php?msid=103" ;
        :last_mod_form         "2023-03-31T07:09:28.853Z"^^xsd:dateTime .

