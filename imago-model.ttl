<https://imagoarchive.it/ontology/resources/manuscript/arras/mdiathquedelabbayesaintvaast/76/1v54v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-580> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 54 ff. Il testo è disposto su due colonne. I primi due fogli, che sono scritti su pergamena raschiata, sono occupati da una tabella di capitoli. Il testo è diviso in XIII libri secondo quanto si legge nel prologo, f. 3r, ma poiché i libri nell'indice hanno una doppia numerazione continua dei capitoli, ci sono in tutto XVI libri. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-580> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q18599881> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziale del prologo che mostra un monaco con un libro. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 149. </li>" ;
