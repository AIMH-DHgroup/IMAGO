<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._5879/7r10r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-81> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Sono assenti, relativamente al De situ veteris, annotazioni marginali come glosse e notabilia; l'opera è trascritta da un'unica mano. Il manoscritto, miscellaneo, tramanda anche le seguenti opere: Petri Pauli Vergeri Justinopolitani Liber de politia Venetorum eorumque legibus ac moribus, urbis situ, naturaque regionis (ff. 2r-6v);  Anonymi chronica italica (ff.12r-30v), in verità, si tratta del De origine urbium Italiae attribuito a Riccobaldo da Ferrara; Historiae ecclesiasticae omnium temporum libri sex (ff- 31r-147v); Sexi Rufini Viri consularis historiae romanae breviarium (ff. 148r-155r); Benvenuti de Rambaldis Imolensis Liber augustalis de vitis Caesarum (ff. 155r-170r)." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-81> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Martina Piccolo" ;
        :has_decoration        "Il capolettera dell'opera presenta una decorazione a bianchi girari. " ;
        :has_secondary_source  "" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b9068286n/f14.item" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc64871c" ;
        :last_mod_form         "2023-03-06T09:43:08.593Z"^^xsd:dateTime .

