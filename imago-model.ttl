        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 137-138. </li><li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://data.onb.ac.at/rec/AC13957769" ;
        :last_mod_form         "2024-02-06T08:57:37.683Z"^^xsd:dateTime .

