<https://imagoarchive.it/ontology/resources/manuscript/cambridge/universitylibrary/dd.1.30/1245>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1911> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 245 ff. Il testo è disposto su due colonne di 41 righe. Il codice è privo della parte iniziale e finale: a causa della caduta delle prime tre carte, il testo inizia dal libro I, 1 e, per la perdita delle carte dopo la 256, termina al libro XXII,1, presentando molte lacune a causa delle condizioni del manoscritto, molto danneggiato, e dell'assenza, in alcune carte, della parte superiore dei fogli. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1911> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1028334> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali decorate: al f. 26r iniziale in rosso e blu, al f. 44r disegno a colori di Giobbe, dei compagni e della moglie, al f. 44v disegno del Giudizio di Salomone, al f. 91r due medaglioni, uno con il disegno di un cammello, al f. 164v iniziale con edificio, al f. 181r busto di filosofo barbuto con cappello a punta, al f. 232v guerriero incoronato, al f. 254v uomo a tavola con testa di cinghiale e altri piatti e con in mano una tazza. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#kottje-ziegler-verzeichnis-der-handschriften'>KOTTJE-ZIEGLER 2012</a>, p. 31, n. 182. </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://api.repository.cam.ac.uk/server/api/core/bitstreams/aa2440ea-3246-4f01-b9e8-d4421de2b87e/content" ;
