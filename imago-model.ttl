<https://imagoarchive.it/ontology/resources/manuscript/oxford/mertoncollegelibrary/121/1r168v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2290> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 194 ff. e misura 345x260 mm. Al f. 2r nota: \"Ex dono M. Iohannis Woode in theologia baccalarii quondam consocii collegii de Merton in Oxonia\". Il manoscritto trasmette anche il Chronicon di Martin Polono, ff. 169r-192v e riporta il testo del Polychronicon con la continuazione fino al 1401. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2290> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q6820719> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Ai ff. 1, 36, 39v, 58v, 77, 98, 113v e 169 grandi e belle iniziali rosse e blu. Schizzi a matita ai margini: f. 10v, una mano che tiene una moneta; f. 61v un fariseo a mezzo busto; f. 71 la testa di Costantino; f. 127v la testa di Thomas Becket." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
