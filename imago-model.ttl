                "https://www.mirabileweb.it/manuscript/citt%C3%A0-del-vaticano-biblioteca-apostolica-vaticana--manuscript/17400" ;
        :last_mod_form         "2024-02-25T17:58:26.542Z"^^xsd:dateTime .

