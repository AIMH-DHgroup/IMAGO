<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._5698/1r50r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1818> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 50, I' ff. e misura 270x420 mm. Bianchi i ff. 1r, 2v-3r, 4v-5r, 6v, 7v, 8v-9r, 10v-11r, 12v-13r, 14v,15r, 16v-17r, 18v-19r, 20v-21r, 22v, 23r, 24v-25r, 26v-27r, 28v-29r, 30v, 31r, 32v-33r, 34v-35r, 36v-37r, 38v-39r, 40v-41r, 42v, 43v, 44v-45r, 46v,48v, 49v. Il codice è il più antico atlante della Cosmographia nella traduzione latina: dopo la tabula con il planisfero, seguono le 26 mappe tolemaiche, ma con scarsa policromia e povertà dei contenuti informativi, è assente la cornice a tacche delle latitudini e longitudini e sommaria la descrizione dei paralleli e dei climi. I toponimi e le parti scritte sono aggiunte da un'unica mano in littera textualis con tracce di elementi corsivi. Al f. 50r nota di possesso: \"Die XXVIII Martii 1558 S.mus D.N. Paulus PP. III misit hunc librum nobis Custodibus Bibliothecae Apostolicae cum aliis custodiendum\". Nella legatura sono presenti gli stemmi in oro di Pio VI e del cardinale bibliotecario Francesco Saverio de Zelada. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1818> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice contiene 27 mappe geografiche. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 84-85. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Vat.lat.5698" ;
        :has_url_manuscript_description
                "https://opac.vatlib.it/mss/detail/Vat.lat.5698" ;
