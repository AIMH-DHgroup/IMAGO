<https://imagoarchive.it/ontology/resources/manuscript/cambridge/universitylibrary/ff.1.27/499567>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-717> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "ll codice è composito, formato da due unità codicologiche. La prima parte, risalente al XII-XIII secolo, è una miscellanea di testi che trasmette anche il De excidio Brinanniae di Gildas, la Historia Brittonum attribuita a Nennio, una vita di San Cuniperto, la raccolta di opere di Gille di Limerick. La seconda è una miscellanea del XIV e XV secolo, contenente testi geografici come la Topographia Hibernica, la Descriptio Kambriae e l'Itinerarium Kambriae nella prima versione. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-717> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1028334> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "La prima unità codicologica presenta iniziali con chiome e motivi arabeggianti. Al f. 238 rappresentazione di una chiesa di architettura gotica, con archi e vetrate e con l'illustrazione della gerarchia ecclesiastica epistolare e secolare. La seconda unità codicologica presenta iniziali istoriate, come quelle di Enrico II in trono, la predicazione di San Patrizio e Merlino. Numerose sono le decorazioni della Topographia Hibernica, come immagini religiose, f. 318, del mondo naturale, f. 299, e vernacolari, f. 308." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/itinerarium-kambriae-title/4725 </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>,  </li>" ;
        :has_url_manuscript    "https://cudl.lib.cam.ac.uk/view/MS-FF-00001-00027/1" ;
        :has_url_manuscript_description
                "https://cudl.lib.cam.ac.uk/view/MS-FF-00001-00027/1" ;
        :last_mod_form         "2024-03-29T08:46:22.759Z"^^xsd:dateTime .

