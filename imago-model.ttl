<https://imagoarchive.it/ontology/resources/manuscript/pavia/bibliotecauniversitaria/aldini_237/85r88r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-570> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da V, 90, II ff. e misura 274x212 mm. La cartulazione è antica vergata in inchiostro in cifre arabe nell'angolo superiore di ogni carta recti. Il testo è a piena pagina, su due colonne solo ai ff. 88r-89v. La scrittura è gotica corsiva di un'unica mano. La legatura è del XVI secolo con assi di legno e coperta in pelle. Nel 1840-1841 il manoscritto, insieme alla collezione privata di Pier Vittorio Aldini, venne venduto al governo di Lombardia e trasmesso alla Biblioteca Universitaria di Pavia. Il codice trasmette: Compendium librorum Aristotelis in naturali et morali philosophia et metaphisica, ff. 1r-85r; estratti del XII libro del De proprietatibus rerum di Bartolomeo Anglico, ff. 85r-88r; una Tabula totius operis secundum ordinem alphabeticum, ff. 88r-89v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-570> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q24937404> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 135. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/cnmd/0000307113" ;
        :last_mod_form         "2023-04-03T17:26:53.786Z"^^xsd:dateTime .

