<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/cotton_vespasian_a_xiii/1r41v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-844> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo e miscellaneo; mm 225 x 190; ff. III, 147, I'; numerazione antica, a calamo, in cifre arabe sul recto del foglio nel mg. sup. destro. Formato in-quarto. Scrittura in inchiostro marrone, in minuscola umanistica; rigatura a secco." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-844> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Capilettera e titolo in inchiostro rosso (altezza: 2 linee di testo); iniziale maggiore (9 linee di testo) in inchiostro rosso con decorazioni fitomorfe in inchiostro marrone. Carte del \"Liber insularum\" abbozzate (ma è notevole per dettagli la veduta aerea di Costantinopoli a f. 36v), colorate ad acquarello (marrone per la terra, verde per il mare e i corsi d'acqua), con didascalie e titoli." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. IV, p. 139 </li>" ;
