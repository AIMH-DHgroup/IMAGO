<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._16290/109r115v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Glose in Pen. e non. in Jose" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2121> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 126 ff. e misura 240x185 mm. Il codice è formato da quattro diverse unità codicologiche, corrispondenti ai ff. 3-46; 47-100; 101-116; 117-126. La rilegatura è in pergamena verde con piatti in rinforzo di cartone. Al f. 2v due menzioni bibliotecarie del collegio della Sorbona del XIV secolo. Il manoscritto riporta il libro I, 1-123 dell'Imago mundi e trasmette inoltre: Postille super Pentateucum, ff.3r-100v; Commentum in Prophetas, ff.101r-108v; De calculo, ff.116r-126." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2121> ;
