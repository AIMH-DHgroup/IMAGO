<https://imagoarchive.it/ontology/resources/manuscript/firenze/bibliotecamedicealaurenziana/plut._29.8/41r45r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1681> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è compito, formato da tre diverse unità codicologiche. La prima, corrispondente ai ff. 2-25, trasmette Andalo de Nigro, Tractatus spere materialis; la seconda, ff. 26-45, trasmette la Chronica de origine civitatis Florentiae, ff. 36v-39r; la Sibylla Tiburtina, ff. 39r-41r e l'Epistola Alexandri ad Aristotele. La terza unità è autografa di Giovanni Boccaccio, copista e possessore del codice, e trasmette Iohannes de Virgilio, Eclogae, ff. 46v-59r; Giovanni Boccaccio, Epistolae, ff. 50v-52r e 65r-66v; Quattuor versus de decem praeceptis, f. 60v; Versus beati Thome de AQUINI, F. 52r-52v; Walter Map, Epistola Valerii ad Rufinum ne ducat uxore, ff. 53r-54r; Cicerone, Orationes, Catilinariae, ff. 54r-55v; Giovanni Boccaccio, Carmina, ff. 56r, 57v-60v; Cecco Miletto, Eclogae ad Iohannem Boccaccium, ff. 56r-57v; Giovanni Boccaccio, Allegoria mitologica, ff. 61r-62r; Dante Alighieri, Epistolae, ff. 62v-63r; Giovanni del Virgilio, Eclogae, ff. 67v-68r; Ylarus de Corvo, Epistola, f. 67r; Dante Alighieri, Eclogae, ff. 68r-69r, 71r-72v; Giovanni Boccaccio, Notamentum laureationis Francisci Petrarca, f. 73r; Francesco Petrarca, Epystole, ff. 73r-74v; Giovanni del Virgilio, Versus, f. 75r; Giovanni del Virgilio, Responsio ad anonymum, f. 75v; Guido Vacchetta, Cui cognomen adest magna virtute Maronis, f. 76r; Giovanni del Virgilio, Responsio ad Guidonem Vacchettam, f. 76r; Francesco Petrarca, Bucolicum carmen, ff. 76v-77r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1681> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q856419> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-04-05T07:17:33.565Z"^^xsd:dateTime .

