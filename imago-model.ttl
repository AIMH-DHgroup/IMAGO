<https://imagoarchive.it/ontology/resources/manuscript/modena/bibliotecaestenseuniversitaria/campori_101_(gamma_d_1_20)/1v29v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-38> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo, mm. 327x241, ff. 105. Al manoscritto è unito un foglio piegato su cui si legge \"Illust. Michel Angelo Gualandi Bologna\". Il foglio registra il contenuto delle opere di Biondo nell'edizione Froben 1559 e una breve biografia dell'autore. Il manoscritto tramanda anche altre opere di Biondo Flavio: Roma triumphans, proemio e breve tratto del primo libro (ff. 1r-v); De gestis Venetorum (ff. 30r-39v); testo della III fase redazionale dell'Italia illustrata (ff. 40v-105v). Nei primi fogli si rileva la confusione tra Roma triumphans e Roma instaurata, considerate come un'unica opera (f. 11v: \"Romae Triumphantis instauratae\"). Il codice è copia della stampa veneziana del 1510. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-38> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1219443> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#biondo-roma-instaurata-2020'>BIONDO, Roma instaurata 2020</a>, pp. LXXXI-LXXXII </li><li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, p. 276 </li>" ;
        :has_url_manuscript    "http://bibliotecaestense.beniculturali.it/info/img/mss/i-mo-beu-gamma.d.1.20.html" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/modena-biblioteca-estense-universitaria-campori-10-manuscript/168180" ;
        :last_mod_form         "2024-02-23T12:04:45.292Z"^^xsd:dateTime .

