        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, p. 279 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/gubbio-(perugia)-archivio-di-stato-armanni-ii-f-2-manuscript/168182" ;
        :last_mod_form         "2024-01-09T16:49:31.306Z"^^xsd:dateTime .

