<https://imagoarchive.it/ontology/resources/manuscript/eton/etoncollegelibrary/213/1r268v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2230> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da VI, 276, IV ff. e misura 303x225 mm. Il Polychronicon è preceduto da un indice dei libri 1-6 e dai capitoli 1-44 del libro VII e da una discendenza genealogica illustrata dai re inglese da Egberto a Enrico VI. Sono moltissime le note marginali, la maggior parte delle quali della stessa mano che ha redatto la genealogia dei re. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2230> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q192088> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 10v disegno del Castello di Windsor e sotto di esso una scena identificata come la consacrazione di Thomas Bekynton nella cappella dell'Eton College il 13 ottobre 1443. Disegno della torre di Babele, f. 6v, e Romolo e Remo, f. 58r. La genealogia inglese è arricchita con immagini a penna e inchiostro dei vari re. Iniziali colorati. " ;
        :has_secondary_source  "" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://catalogue.etoncollege.com/B50165" ;
        :last_mod_form         "2023-05-29T07:49:28.519Z"^^xsd:dateTime .

