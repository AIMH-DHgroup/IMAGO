<https://imagoarchive.it/ontology/resources/lemma/l2360>
        rdf:type       <http://imagoarchive.it/ilrmoo/F28_Expression_Creation> ;
        <http://erlangen-crm.org/211015/P14_carried_out_by>
                <http://www.wikidata.org/entity/Q4233718> ;
        <http://imagoarchive.it/ilrmoo/R17_created>
                <http://www.mirabileweb.it/title/situs-orbis-terrae-vel-regionum-title/169088> ;
        <http://imagoarchive.it/ilrmoo/R18_created>
                <https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._4841/1r13v> ;
        :has_abstract  "Il Situs orbis terre vel regionum è una descrizione delle terre conosciute composta tra la fine del VII e l'inizio del IX secolo. Il piano dell'opera è isidoriano, ispirato ai libri XIII-XIV delle Etymologiae, ma con l'utilizzo anche delle Historiae adversos paganos di Orosio. Il Situs si apre con la descrizione degli Oceani, del mar Mediterrano, dei golfi dell'Oceano, dei laghi, per passare poi alla descrizione dei tre continenti. Lo scopo dell'opera sembra essere quello di fornire un compendio, forse destinato ad essere utilizzato come testo scolastico. " .

[ <http://erlangen-crm.org/211015/P106i_forms_part_of>
          <https://imagoarchive.it/ontology/resources/manifestation/manuscript/mm-941> ;
  <http://erlangen-crm.org/211015/P190_has_symbolic_content>
          ""
] .

<https://imagoarchive.it/ontology/resources/folios/mf-1128>
        rdf:type  :Folios ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
