<https://imagoarchive.it/ontology/resources/lemma/l2318>
        rdf:type       <http://imagoarchive.it/ilrmoo/F28_Expression_Creation> ;
        <http://erlangen-crm.org/211015/P14_carried_out_by>
                <http://www.wikidata.org/entity/Q4233718> ;
        <http://imagoarchive.it/ilrmoo/R17_created>
                <http://www.mirabileweb.it/title/liber-de-existencia-rivierarum-et-forma-maris-nost-title/172959> ;
        <http://imagoarchive.it/ilrmoo/R18_created>
                <https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/cotton_domitianus_a._xiii/114r129v> ;
        :has_abstract  "Il Libellus è il testo del più antico portolano fino a oggi conosciuto. Esemplato da un anonimo autore, esortato alla compilazione da un canonico della cattedrale di Pisa, probabilmente verso la fine del XII secolo, il testo si apre con una lista di 159 luoghi situati lungo il mar Mediterrano, fornendo le distanze tra essi. L'opera si propone di essere una descrizione sistematica del Mediterraneo e del Mar Nero organizzata in 45 sezioni regionali, ognuna introdotta da un breve testo che descrive il sito. " .

<https://imagoarchive.it/ontology/resources/manuscript/modena/bibliotecaestenseuniversitaria/lat._463_(alfa.x.1.3)/1r128v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1854> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 128, II ff. e misura 445x305 mm. Il testo è disposto su due colonne ed è esemplato in umanistica di una sola mano. Tra le guardie cartacee sono inseriti tre documenti dell'Archivio di stato di Modena che attestano il compenso nel 1466 di cento fiorini d'oro a Niccolò Germano da parte di Borso d'Este, a cui il manoscritto è dedicato.  " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1854> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1219443> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice contiene 27 mappe geografiche. Al f. 1 grande iniziale miniata e fregio a bianchi girari che impreziosisce la pagina di dedica, nel margine inferiore preparazione per lo stemma lasciato in bianco. Al f. 2r iniziale in oro su fondo policromo, decorata a bianchi girari e miniata, raffigurante Tolomeo con in mano un compasso. Iniziali maggiori in oro decorate a bianchi girari su fondo azzurro, rosso e verde. Le miniature sono opera di Francesco del Chierico. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 111-112. </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, I, p. 371. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/cnmd/0000166410" ;
        :last_mod_form         "2024-02-05T15:33:38.482Z"^^xsd:dateTime .

