<https://imagoarchive.it/ontology/resources/manuscript/klagenfurt/universittsbibliothek/pap._152/15r46v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          " Descriptio terrae sanctae et tabula auctoritatum et sententiarum bibliae et sermones de sanctis " ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-150> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto composito e cartaceo è formato da quattordici diverse unità, è composto in totale da 319 ff. e misura 280x195 mm. Il codice trasmette la redazione lunga della Descriptio di Burcardo da Monte Sion e riporta inoltre: Sermones, ff. 1r-10v; Tres anni iubilaei, ff. 11r-14v; Historia Alexandri Magni, ff. 46v-75v; Sermones de sanctis et de tempore, ff. 75v-193v; Sermones et legendae de sanctis, ff. 194r-203v; Sermones de s. Maria, ff. 204r-214v; Giovanni Calderini, Tabula auctoritatum et sententiarum Bibliae, ff. 216r-259r, e Tractatus de interdicto ecclesiastico, ff. 260r-283v; Vocabularium, ff. 284r-311v; Urbano IV, documento sulla punizione degli apostati di Boemia, ff. 312r-313r; Sermones varii, f. 313v; Alessandro V, Constitutiones 1409, ff. 314r-318v; Carmen in Azariam quendam, f. 319r; Oratio, ff. 319r-319v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-150> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2496301> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>, pp. 283-286. </li>" ;
        :has_url_manuscript    "https://ubdocs.aau.at/open/voll/handschriften/AC05989352.pdf" ;
        :has_url_manuscript_description
                "https://permalink.obvsg.at/UKL/AC05989352" ;
        :last_mod_form         "2024-04-19T07:35:41.984Z"^^xsd:dateTime .

