        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b8479009h" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/paris-bibliothèque-nationale-de-france-lat-1750-manoscript/361" ;
        :last_mod_form         "2024-04-04T15:26:05.903Z"^^xsd:dateTime .

