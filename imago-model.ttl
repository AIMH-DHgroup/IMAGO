<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_3724/5r44r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1151> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 59 ff. e misura 220x140 mm, rilegato in pelle rossa, lavorata in oro dopo il 1600. Esemplato in Irlanda, il manoscritto trasmette testi in latino e inglese, tra cui la Topographia Hiberniae nella prima versione e opere prevalentemente religiose. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1151> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice presenta dipinti marginali a colori di uccelli, lepri, ascia, calice, creature ibride. Bordi totali o parziali a colori con motivi geometrici o fogliati. Grandi iniziali a colori, molte riempite con un disegno a scacchi, alcuni con motivi fogliati. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/topographia-hiberniae-title/4005 </li><li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>, p. 318. </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002049556&indx=1&recIds=IAMS040-002049556&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=harley%203724&dum=true&dstmp=1676048647181" ;
        :last_mod_form         "2024-03-28T14:55:53.533Z"^^xsd:dateTime .

