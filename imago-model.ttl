<https://imagoarchive.it/ontology/resources/signature/ms-1295>
        rdf:type  <http://erlangen-crm.org/211015/E42_Identifier> ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Cotton Vespasianus E VI" .

<https://imagoarchive.it/ontology/resources/manuscript/napoli/bibliotecanazionalevittorioemanueleiii/vitt._eman._1119/1r9r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1344> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 66, I ff., con numerazione dei ff. recente a matita nell'angolo superiore esterno e misura 250x125 mm. Il manoscritto è costituito da 7 fascicoli. Vergato da mani diverse, sono presenti numerose annotazioni marginali. Il codice trasmette una delle versioni più antiche dei Mirabilia urbis Romae, l'Historia romana di un anonimo, ispirato a Paolo Diacono, ff. 9v-59r, e alcune poesie provenzali, ff. 59r-66v. Sul verso della prima carta di guardia è attestata una nota di possesso dell'umanista Pietro Vettori, che sembra aver postillato il manoscritto, e inoltre si segnalano altre note a penna di Carlo Lochis e Pietro Gaffuri. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1344> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2256644> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/mirabilia-urbis-romae-title/172558 </li><li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 69. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/cnmd/0000067934" ;
        :last_mod_form         "2024-04-06T12:39:48.696Z"^^xsd:dateTime .

