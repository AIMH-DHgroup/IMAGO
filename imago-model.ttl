<https://imagoarchive.it/ontology/resources/lemma/l2250>
        rdf:type       <http://imagoarchive.it/ilrmoo/F28_Expression_Creation> ;
        <http://erlangen-crm.org/211015/P14_carried_out_by>
                <http://www.mirabileweb.it/author/anselmus-remensis-monachus-fl-1049-1056-author/20996> ;
        <http://imagoarchive.it/ilrmoo/R17_created>
                <http://www.mirabileweb.it/title/historia-dedicationis-ecclesiae-sancti-remigii-apu-title/6224> ;
        :has_abstract  "Si tratta della relazione sulla consacrazione della chiesa del monastero di St-Remi a Reims da parte di Papa Leone IX, nel 1049, anno in cui si tenne anche il Concilio di Reims. L'opera fu probabilmente scritta tra il 1055 e il 1059 per volere dell'abate Herimar di Saint-Remi." .

<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._6186/115v117v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1633> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 151 ff. Il codice trasmette inoltre: Epistolae Dindymi et Alexandri, f. 4r; Eginardo, Vita Caroli Magni, ff. 4r-31v; Ugo di Fleury, Historia, ff. 31v-61v; Liber de restauratione monasterii Sancti Martini Tornacensis, ff. 61v-90v; Cronice de quibusdam sub veteri lege notans, ff. 90v-93v; estratti dal Liber Polypticus di Benedetto, canonico di San Pietro, ff. 94r-94v; estratti dal Liber Pontificalis, ff. 94v-101r; Mirabilia urbis Romae, ff. 101r-115v; descrizione di Santa Maria Maggione e catalogo di cardinali, ff. 118v-127v; corrispondenza tra Gerolamo e papa Damaso, f. 128r; Catalogo di papi, ff. 128r-132v; catalogo di vescovi e patriarchi di Gerusalemme, ff. 132v-133v; Notitia Galliae, ff. 134v-135v; Cena Cipriani, ff. 136r-141v; De christianis, de Iudeis, de Grecis, de Egiptiis, ff. 141v-146r; frammenti di Gesta Romanorum, ff. 146v-150v; De edificiis palatiis urbis Romae, ff. 150v-151r. La Descriptio Lateranensis ecclesiae è riportata in modo frammentario nella prima redazione del testo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1633> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#vogel-la-descriptio-ecclesiae-lateranensis-du-diacre-jean'>VOGEL 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#codice-topografico-della-citta-di-roma'>VALENTINI-ZUCCHETTI 1940-1953</a>, III, pp. 319-325. </li><li><a href='https://imagoarchive.it/bibliografia.html#oftestad-the-lateran-church'>OFTESTAD 2019</a>, pp. 193-203. </li><li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, pp. 65-66. </li>" ;
        :has_url_manuscript    "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc65245t" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc65245t" ;
        :last_mod_form         "2024-04-04T11:18:11.36Z"^^xsd:dateTime .

