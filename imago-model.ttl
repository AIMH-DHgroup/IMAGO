<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_7182/1r105v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1847> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 107 ff. e misura 570x420 mm. Il codice è scritto in umanistica. Lo scriba del manoscritto è lo stesso di Milano, Biblioteca Ambrosiana, B. 52 inf., e Madrid, Biblioteca Nazionale di Spagna, 255. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1847> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "La decorazione del codice è attribuita a Francesco di Antonio del Chierico. Al f. 1r grande fregio a bianchi girari su due lati della pagina che ingloba una grande iniziale in oro raffigurante il papa insieme a tre cardinali mentre accetta in dono dall'Angeli il testo; nel margine inferiore fregio a bianchi girari che attornia un festone rotondo, sorretto da due putti. Al f. 2r grande iniziale in oro decorata a bianchi girari raffigurante Tolomeo che osserva il cielo con una lente. Iniziali maggiori in oro a bianchi girari, iniziali minori di modulo inferiore, colorate e decorate a bianchi girari. Al f. 1v nel margine inferiore stemma cardinalizio abraso. Nel codice sono presenti 28 mappe, 27 della tradizione tolemaica e 1 mappamondo. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 105-106. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002053036&indx=1&recIds=IAMS040-002053036&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Harley%207182&dum=true&dstmp=1681822518797" ;
        :last_mod_form         "2024-02-05T15:25:02.345Z"^^xsd:dateTime .

