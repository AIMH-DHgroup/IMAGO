<https://imagoarchive.it/ontology/resources/manuscript/palermo/bibliotecacentraledellaregionesiciliana/i_e_16_1-2/1r90r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
