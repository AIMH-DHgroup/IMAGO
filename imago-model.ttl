<https://imagoarchive.it/ontology/resources/manuscript/klosterneuburg/bibliothekdesaugustinerchorherrenstiftes/795/108r114r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2032> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto trasmette solo il libro I dell'Imago mundi e riporta inoltre: Homiliae di Aimone, ff. 1r-39v; Soliloquia di Isidoro di Siviglia, ff. 41r-47r; Quaestiones Orosii ad sanctum Augustinum, ff. 47v-51v; Tractatus de spiritu et anima di Alcherus Claraevallensis, ff. 51r-60v; Liber de canone Missae di John of Cornwall, ff. 60v-62v; Liber de medicina animae di Ugo di Fouilloy, ff. 63r-65r; De natura animalium, de bestiis et aliis rebus di Ugo di San Vittore, ff. 65v-74r; Philosophia moralis de honesto et utili, ff. 74r-78v; Secretum secretorum dello Pseudo Aristotele, ff. 79r-102v; Physionomia Aristotelis, ff. 103r-107v; Tractatus de sideribus, ff. 114r-114v; Tractatulus de morte di Aristoteles, ff. 115r-116r; Versus ex II et III libro artis amatoriae di Ovidio, f. 116v; De promo medendi, quomodo et quibus modis medetur in medicandis corporibus, ff. 117r-125r; Formule medicinales et notae, ff. 125r-126r; Sermones de Lazaro, de Joanne evangelista, de adventu Domini, ff. 127r-137r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2032> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/klosterneuburg-bibliothek-des-augustiner-chorherrenstiftes> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
