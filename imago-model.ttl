<https://imagoarchive.it/ontology/resources/manuscript/leiden/universiteitsbibliotheek/voss._lat._q._62/841>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-841> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo e monografico, danneggiato; ff. 42. A f. 1v le informazione sull'acquisto del codice: «Hunc librum insularum Arcipologi [sic] emi ego Leonardus Marchesius ep. Albinganensis ab domino fratre Ambrosio de Vitalibus preposito ecclesie Sancte Cecilie de Urbe cui de precio illico satisreci ad laudem dei Rome die XV novembris 1476 tempore [...] Sixti [...] quarti anno suo sexto quo anno die XIIII octobris in civitate Reatina me promovit prefatus s.d.n. ad ecclesiam Albinganensem vacantem per translationem factam de persona R.di patris D. Jieronimi de Ruvere olim Bassi ac prelibati domini pape nepotis ad ecclesiam Racanatensem»." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-841> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q638395> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Oltre alle mappe delle isole, trasmette una carta nautica generale dell'Egeo." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ragone-g-liber-insularum'>RAGONE 2002</a>, pp. 182-183, n. 16; p. 185, n. 24; p. 204, n. 85 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. IV, p. 370 </li><li><a href='https://imagoarchive.it/bibliografia.html#de-meyier-1971'>DE MEYIER 1971</a>, pp. 300-303 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.persee.fr/doc/scrip_0036-9772_1971_num_25_2_3449" ;
        :last_mod_form         "2024-03-09T09:31:51.876Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/chartres/mdiathquelapostrophe/ms_205_(230)/176r183r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2114> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 323 ff. e misura 290x205 mm. Il codice è stato danneggiato dal bombardamento della biblioteca del 26 giugno 1944. Il manoscritto trasmette soltanto alcuni estratti dell'Imago mundi e inoltre riporta: Flores Bernardi; Bernardo, Auctoritates, De consideratione, Epistola ad Eugenium papam, Tractatus de interiore homine, Liber de gradibus humilitatis; Anselmo, Tractatus Cur Deus homo, Versus; De conflictu vitiorum et virtutum; Bernardo, De contemplatione; Testamenta XII patriarcharum; De corpore et sanguine Domini secundum magistrum Anselmum; Epistola beati Cipriani; S. Cipriano, De singularitate clericorum; Expositio Hugonis super Canticum Marie; Prologus Hugonis de sapiencia Christo et de sapiencia Christi; De tribus diebus; Bernardus, De gratia et liber arbitrio; Liber domini Odonis. Nel manoscritto l'Imago mundi è attribuito ad Anselmo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2114> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q3146242> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "https://ccfr.bnf.fr/portailccfr/jsp/index_view_direct_anonymous.jsp?record=eadcgm:EADC:D17011199" ;
        :has_url_manuscript_description
                "https://ccfr.bnf.fr/portailccfr/jsp/index_view_direct_anonymous.jsp?record=eadcgm:EADC:D17011199" ;
        :last_mod_form         "2024-04-02T08:40:05.401Z"^^xsd:dateTime .

