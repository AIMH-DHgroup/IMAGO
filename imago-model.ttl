<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._5273/13r83r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1603> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è scritto da due diverse mani del XIII secolo e trasmette: una breve cronaca universale fondata su quella di Isidoro, priva dell'inizio, un catalogo dei dogi fino a Pietro Ziani e brevi annali veneti, il catalogo dei patriarchi di Grado, il catalogo dei vescovi di Torcello e di Olivolo, il catalogo delle famiglie veneziane, la relazione sulla fondazione di Grado, sull'istituzione del patriarcato e la descrizione della vita degli antichi Veneziani, la cronaca di Torcello e di Grado, una storia su Enea e Attila, il racconto di Longino, un piccolo trattato teologico, un catalogo degli imperatori romano-bizantini fino a Giovanni Porfirogenito, un secondo catalogo dei dogi, un secondo catalogo di imperatori romano-bizantini, il racconto della lotta tra Franchi e Veneziani nel IX secolo, il catalogo dei papi fino a Damaso II e costituzioni papali. Sul f. 86v è apposta una notizia, purtroppo mutila, sul tempo in cui questo codice fu compilato, forse a settembre del 1277. Una terza mano aggiunge la storia della torre di Babele e un'antica ricetta. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1603> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#origo-civitatem'>Origo civitatum Italie 1933</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#marin-considerations-regarding-the-place'>MARIN 2013</a>,  </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Vat.lat.5273" ;
        :has_url_manuscript_description
                "https://opac.vatlib.it/mss/detail/Vat.lat.5273" ;
        :last_mod_form         "2024-04-03T13:19:23.948Z"^^xsd:dateTime .

