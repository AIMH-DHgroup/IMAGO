<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/lat._580_/10r19v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-791> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo consta di 178 ff. e misura 200 x 132 mm. Forse esemplato in Italia Meridionale, il manoscritto apparteneva a  Zsámboky, Janós (n. 1531, m. 1584) e trasmette inoltre: Isidoro di Siviglia, Proemia in Novum Testamentum, ff. 1r-1v; Isidoro di Siviglia, Allegoriae Novi Testamenti, ff. 2v-9r; Giuliano di Toledo, Prognosticorum futuri saeculi libri tres, ff. 20r-47v; Gerolamo, Epistola consolatoria ad Tyrasium de morte filiae suae, ff. 47v-50r; Agostino, De eo quod dicitur: sursum corda habemus ad dominum, ff. 50r-51v; De conflictu virtutum et vitiorum liber, perperam Isidoro Hispalensi tributus, ff. 52r-58v; Isidoro di Siviglia, Origines, 59r-150v; Chronica mundi usque ad annum 936 p. Chr, ff. 151r-165v; Isidoro di Siviglia, Chronica, ff. 165r-168v; Beda Il Venerabile, Chronicon, ff. 168v-171v; Isidoro di Siviglia, De mensuris et ponderibus, ff. 171v-178r; Catalogus imperatorum inde a Carolo Magno usque ad Henricum III, f. 178v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-791> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 12r raffigurazione della pianta della chiesa di Gerusalemme, realizzata in rosso; al f. 12v una colonna orientata in orizzontale con al suo interno i riferimenti ai luoghi della passione di Cristo; al f. 14v raffigurazione dell'Ascensione in Cielo; al f. 18r una croce rossa. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#httpswwwbedadlsgwiuni-muenchendeabout'>BEDA VENERABILIS, De locis sanctis </a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-locis-sanctis-beda-venerabilis-n-672-673-ca-m-2-title/8029 </li>" ;
        :has_url_manuscript    "https://onb.digital/result/10263C52" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/wien-österreichische-nationalbibliothek-580-(hist--manuscript/120805" ;
        :last_mod_form         "2024-02-14T12:30:27.584Z"^^xsd:dateTime .

