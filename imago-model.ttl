<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._3811/1v64r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1817> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 64, I' ff. Al f. 64 nota con attribuzione del codice a Niccolò Germano: \"Claudii Ptolomei viri Alexandrini Cosmographie liber VIII et ultimus finit. Opus donni Nicolai Germani\". Il codice si deve considerare unito al Vat. lat. 3810. La legatura reca gli stemmi di papa Pio IX e del cardinale bibliotecario Luigi Lambruschini. Il codice è costituito da 32 bifoli che contengono il planisfero seguiti da 26 carte della tradizione tolemaica e 5 carte moderne di Spagna, Francia, Europa del Nord, Italia e Terra Santa. Ogni tavola è introdotta dalla corrispondente expositio del libro VIII." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1817> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Sono presenti 32 mappe geografiche: 27 della tradizione tolemaica e 5 moderne. Iniziali in oro decorate a bianchi girari su fondo policromo. Le carte sono impaginate e disegnate da Niccolò Germano. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 83-84. </li>" ;
        :has_url_manuscript    "https://opac.vatlib.it/mss/detail/Vat.lat.3811" ;
        :has_url_manuscript_description
                "https://opac.vatlib.it/mss/detail/Vat.lat.3811" ;
        :last_mod_form         "2024-02-05T14:39:28.978Z"^^xsd:dateTime .

