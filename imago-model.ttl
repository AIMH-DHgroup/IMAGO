                "" ;
        :last_mod_form         "2023-04-13T08:38:54.943Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/padova/bibliotecacapitolare/d_45/80r132r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-42> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo, ff. IV+139, luogo di copia: Italia centrale. Contiene anche: Pio II, Historia Bohemica (ff. 1r-75v). Il copista Giovanni Ispano trascrive il testo della Roma instaurata, mentre un copista anonimo quello dell'Historia Bohemica, ricordando nel colophon l'elezione al pontificato di Enea Silvio Piccolomini: questa seconda sezione del codice dunque è stata composta dopo il 1459." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-42> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
