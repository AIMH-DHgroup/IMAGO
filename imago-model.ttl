<https://imagoarchive.it/ontology/resources/manuscript/klosterneuburg/bibliothekdesaugustinerchorherrenstiftes/723/268v269r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Isidori liber originum et tria alia M.S. 723" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-14> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è composto da 274 ff. e misura 260x207 mm. Proviene dal monastero di Santa Maria di Klosterneuburg come si legge nelle note di proprietà ai ff. 1r, 131r, 274r. Trasmette inoltre: Quaestiones enigmatum et rhetoricae artis claro ordine dictande, ff. 1r-5v; Isidoro di Siviglia, Epistolae tres ad Braulionem episcopum et responsiones Braulionis ad Isidorum, ff. 6r-9r, Etymologiarum libri XX, ff. 9r-264v, Anthologia ex codicibus Isidorianis, ff. 264v-265v; Sylloge Turonenses, ff. 265v-269r; Liber de computo, ff. 269r-274r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-14> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/klosterneuburg-bibliothek-des-augustiner-chorherrenstiftes> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Decorazione semplice, disegni di grande formato sui ff. 133r-133v." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-lerine-insula-dynamius-patricius-n-saec-vi-med--title/17304 </li>" ;
        :has_url_manuscript    "https://manuscripta.at/diglit/AT5000-723/0001" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/klosterneuburg-bibliothek-des-augustiner-chorherre-manoscript/39806" ;
        :last_mod_form         "2024-03-27T12:40:43.345Z"^^xsd:dateTime .

