<https://imagoarchive.it/ontology/resources/print_edition/pe-251>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Librum insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P2_has_type>
                <https://imagoarchive.it/ontology/resources/print_edition/edition/prima_edizione_/_editio_princeps> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Frontespizio: «Christophori Bondelmontii, / florentini, / Librum insularum archipelagi / e codicibus parisinis nunc primum / edidit, / praefatione et annotatione / instruxit / Gabr. Rud. Ludovicus de Sinner, / helveto – Bernas. / Lipsiae et Berolini, / apud G. Reimer 1824.»." ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/liber-insularum-archipelagi-title/4379> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-251> ;
        :compiled_form              "Alessio Luca Bartelloni" ;
        :has_ecdotic_type           <https://imagoarchive.it/ontology/resources/print_edition/edition/edizione_critica_commentata> ;
        :has_figure_note            "Il volume non contiene illustrazioni." ;
        :has_introduction_note      "L'opera è dedicata da Sinner al suo maestro, l'ellenista tedesco Karl Benedikt Hase (1780-1864). " ;
        :has_other_contents         "L'edizione critica a cura del filologo svizzero e bibliotecario della Sorbonne Gabriel Rudolf Ludwig von Sinner del \"Liber insularum archipelagi\" (pp. 49-134) è preceduta da un'ampia \"praefatio\" scandita in 33 paragrafi, a cui seguono (pp. 43-48) le note bio-bibliografiche su Buondelmonti del letterato e bibliografo bresciano Giammaria Mazzuchelli (\"Gli scrittori d'Italia\", Brescia, Bossini, 1753-1763, vol. II, parte 4, p. 2374). Completano l'edizione di Sinner gli apparati critici (\"annotationes\", pp. 135-224), le note di commento (\"notae\", pp. 225-256) e una doppia tavola degli indici dei nomi estremamente pratica (pp. 257-262), articolata secondo i capitoli del \"Liber insularum\" e secondo ordine alfabetico, dove i toponimi compaiono in colonne nelle forme antica (\"nomen antiquum\"), buondelmontiana (\"nomen Bondelmontii\") e moderna (\"nomen hodiernum\") e il riferimento alle pagine è relativo sia all'opera di Buondelmonti che all'apparato critico di Sinner." ;
        :has_primary_source         "Paris, Bibliothèque Nationale, mss. latt. 4823, 4824, 4825." ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#buondelmonti-liber-insularum-1824'>BUONDELMONTI, Liber insularum 1824</a>,  </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Cristoforo Buondelmonti" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-251> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-251> ;
        :last_mod_form              "2024-03-12T12:03:39.648Z"^^xsd:dateTime .

