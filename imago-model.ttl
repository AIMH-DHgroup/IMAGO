<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._6489/1r145r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1793> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 190 ff. Al f. 98r presenta una nota marginale: \"Nota quod ab inicio mundi usque ad adventum Christi sunt tria milia nongenti et quinquaginta duo anni; et nunc computatur a nativitate Christi usque ad presens tempus MCCCLXXXVIII et nunc fluxerunt tempora usque ad presens tempus una MIIICXXXV\". Al f. 145v copie, di mano diversa, di due lettere del conte Jean d' Armagnac e una del priore di Limoges. Il codice trasmette inoltre una breve cronaca di papi fino a Giovanni XXII e una di imperatori romani fino a Luigi IV e una lettera di Jean de Craon, arcivescovo di Reims, datata 4 Maggio 1372.  " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1793> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/otia-imperialia-gervasius-tilberiensis-n-1152-ca-m-title/4608 </li><li><a href='https://imagoarchive.it/bibliografia.html#caldwell-manuscripts-of-gervase-of-tilburys-otia-imperialia'>CALDWELL 1962</a>,  </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b9066547z/f1.item.zoom" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc65587n" ;
        :last_mod_form         "2024-02-02T14:00:30.558Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/anversantwerpen/museumplantinmoretusbibliotheek/_m_16.14_(denucé_195;_anc._79)/2r129v>
        rdf:type               :Manuscript ;
