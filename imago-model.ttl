<https://imagoarchive.it/ontology/resources/manuscript/frankfurtammain/universittsbibliothekjohannchristiansenckenberg/praed._96/52r151v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
