        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#bueno-dalla-guerra-alle-meraviglie-orientali'>BUENO 2018</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/flos-historiarum-terrae-orientis-haytonus-n-1235-1-title/9037 </li><li><a href='https://imagoarchive.it/bibliografia.html#concina-2020'>CONCINA 2020</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/risultati-ricerca-manoscritti/-/manus-search/detail/601593?fondo_id_s=1899&page=2" ;
        :last_mod_form         "2024-04-01T14:24:14.896Z"^^xsd:dateTime .

