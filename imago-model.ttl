        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1r iniziale in blu filigranata in rosso e blu, iniziali minori e segni di paragrafo in rosso e blu. Iniziali minori e segni di paragrafo alternativamente in rosso e blu." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 96-97. </li>" ;
