<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._3750/1r67r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1477> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da V, 68, V ff. e misura 328x225 mm. Il codice è una copia di presentazione per Paolo III Farnese, esemplato a Roma da Ferdinando Ruano e da lui sottoscritto, come si legge al f. 63r: \"Ferdinandus Ruano clericus pacensis Bibliothecae Apostolicae scriptor scribebat Romae Anno Domini MDXLIII\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1477> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Ricca ornamentazione della pagina incipitaria, decorata con una teoria di panoplie in grisaille e con maschere antropomorfe e zoomorfe. Il titolo dell'opera è dorato, inserito in un clipeo allungato dal fondo rosso. Nel bordo inferiore, stemma dorato di Paolo III Farnese, sormontato dal triregno e collocato tra due putti dormienti. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rebus-antiquis-memorabilibus-basilicae-sancti-p-title/9870 </li><li><a href='https://imagoarchive.it/bibliografia.html#della-schiava-il-de-rebus-antiquis-memorabilibus'>DELLA SCHIAVA 2011</a>, p. 191. </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, II, p. 323. </li>" ;
        :has_url_manuscript    "https://opac.vatlib.it/mss/detail/Vat.lat.3750" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/84108" ;
        :last_mod_form         "2024-02-05T10:35:01.43Z"^^xsd:dateTime .

