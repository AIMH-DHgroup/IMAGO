<https://imagoarchive.it/ontology/resources/print_edition/pe-174>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Roma instaurata. Italia illustrata." ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "L'edizione fu ideata dal teologo torinese Giovannino Baudo, da Guglielmo Ferrari e dall'umanista Giovanni Bremio: \"come si ricava dall'epistola prefatoria di Bremio, l'edizione dell'Italia illustrata fu condotta discostandosi appositamente dal testo edito a Verona e poi a Venezia, con alcuni piccoli interventi di emendazione testuale effettuati proprio dal curatore Giovanni Bremio [....]. In realtà, questi interventi risultano piuttosto limitati nel loro complesso e ovviamente rivolti ai luoghi evidentemente corrotti delle edizioni venete, sebbene in alcuni casi mostrino la notevole capacità congetturale del Bremio. [...] l'edizione torinese, epurata dunque solo in qualche caso dai più evidenti errori meccanici, non fu allestita attraverso l'impiego di ulteriori manoscritti ed ebbe ancora una volta per base il testo delle edizioni venete, con il quale condivide una serie di errori non facilmente riconoscibili o sanabili\" (BIONDO, Italia illustrata 2011, pp. 490-491). " ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/italia-illustrata-title/5381> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-174> ;
        :compiled_form              "Elena Vagnoni" ;
        :has_figure_note            "" ;
        :has_introduction_note      "" ;
        :has_other_contents         "Biondo Flavio, Roma instaurata; \r\nMarco Antonio Sabellico, De vetustate Aquileiensis patriae;\r\nMarco Antonio Sabellico, De Venetae Urbis situ; \r\nRaffaele Maffei da Volterra, Commentarii urbani;\r\nGiorgio Merula, Antiquitates Vicecomitum." ;
        :has_primary_source         "Ed. Venezia 1510" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 331-332 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Biondo Flavio" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-174> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-174> ;
        :last_mod_form              "2024-02-26T09:58:28.608Z"^^xsd:dateTime .

