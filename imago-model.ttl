<https://imagoarchive.it/ontology/resources/manuscript/gent/universiteitsbibliotheek/92/1287>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2200> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 287 ff. e misura 310x210 mm. Al f. 154v nota: \"Quaterniones XLI, hoc sunt folia CCCXXVIII\". Il manoscritto presenta una grande quantità di lacune: molti fogli sono stati ritagliati e quindi sono state rimosse parti delle note marginali e dei titoli correnti dall'alto delle pagine. All'inizio, un foglio di guardia che doveva appartenere a un altro manoscritto riporta l'iscrizione: \"In hoc codice continentur Sermones domni Gerrici abbatis, liber sancti Bavonis Gandensis ecclesie, Servanti benedictio, tollenti maledictio. Si quis eum abstulerit vel folium inde curtaverit, si non satisfecerit, anathema sit. Fiat. Fiat. Fiat. Amen\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2200> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q611001> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice è riccamente decorato con varie illustrazioni: al f. 153 Alessandro a cavallo e scene dell'Apocalisse; ai ff. 231v-232r Alberi del bene e del male; ai ff. 139v-140r otto alberi delle beatitudini; ai ff. 102v-103r alberi genealogici; al f. 208v arca di Noè; al f. 138v medaglione di Augusto; al f. 207r Carlo il Calvo; ai ff. 89r-91v costellazioni; al f. 61v coccodrillo, al f. 60v drago; al f. 58v grifone; al f. 65r Gerusalemme celeste e pianta di Gerusalemme con immagine del Santo Sepolcro; al f. 253r Cristo, al f. 88r Cristo; al f. 20r Labirinto; al f. 13r Lamberto che scrive il suo libro; al f. 62v Leviatano; al f. 56b leone; al f. 230 giglio e medaglione del mondo; al f. 232v Nabuchodonosor; ai ff. 6r e 260r Saint-Omer; al f. 76v palma; al f. 52 Paradiso Terrestre; al f. 168 Roma e San Pietro e Salomone; al f. 88v Sole e pianetI e Vergine con Bambino. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-floridus-lambertus-audomarensis-canonicus-fl-title/5759 </li><li><a href='https://imagoarchive.it/bibliografia.html#delisle-notice-sur-les-manuscrits-du-liber-floridus-de-lambert'>DELISLE 1906</a>, pp. 581-588. </li><li><a href='https://imagoarchive.it/bibliografia.html#woodward-the-illustrated-apocalypse-cycle'>WOODWARD (degree Master of Arts) 2010</a>, p. 53. </li><li><a href='https://imagoarchive.it/bibliografia.html#derolez-the-autograph-manuscripts'>DEROLEZ 1998</a>,  </li>" ;
        :has_url_manuscript    "https://lib.ugent.be/catalog/rug01:000763774" ;
        :has_url_manuscript_description
                "https://glossen.germ-ling.uni-bamberg.de/manuscripts/13537.html" ;
        :last_mod_form         "2024-04-02T15:12:06.003Z"^^xsd:dateTime .

