<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/12538/13v17r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2057> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 188 ff. e misura 215-222x155 mm. Il codice trasmette solo il libro I, 1-73 dell'Imago Mundi e riporta inoltre: Biblia figurata et depicta in forma arbori genealogicae ff. 1r-11v; Figurae septem f. 12r-13r; Quis divinorum sit numeros et ordo librorum versibus memorialibus expositus f. 17r; Initia prologorum et librorum Veteris et Novi Testamenti ff. 17v-18v; Quindecim signa ante judicium universale ff. 19r-19v; Sermones de tempore per circulum anni ff. 20r-92r; Septem criminalia et eorum remedia f. 120v; Miracula Salvatoris f. 120v; Sermones de aliquot festis ff. 121r-152v; Quaestiunculae de sacramentis ff. 153r-153v; Narratio de quodam regis filio cum sociis ad nundinas pergente f. 153v; Quadragesimale ff. 154r-171v; Sermones varii ff. 172r-176v; Notulae de septem beatitudinibus ff. 176r-176v; Innocenzo III, De miseria conditionis humanae, ff. 177r-187v; Gregorio Magno, Dialogi morales, f. 188r; Fructus confessionis f. 188r; Notabile scholasticum de Corpore Christi f. 188r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2057> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Disegni figurativi a penna. Illustrazioni con albero genealogico di Cristo, ff. 1r, 1v, 2r, 3v, 11v; f. 1r caduta dell'uomo; f.. 3r Aronne; f. 4r Mosè; f. 5r Davide in trono; f. 9v Alessandro Magno; f. 11r Adorazione dei Magi, Natività, Passione di Cristo; f. 11v, Resurrezione di Cristo; f. 12r Arti liberali; f. 12v Apostoli; f. 13r Adamo, Babilonia." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/imago-mundi-honorius-augustodunensis-presbyter-et--title/3444 </li>" ;
        :has_url_manuscript    "https://onb.digital/result/131ABDAE" ;
        :has_url_manuscript_description
                "https://manuscripta.at/hs_detail.php?ID=20285" ;
        :last_mod_form         "2024-04-02T06:23:25.15Z"^^xsd:dateTime .

