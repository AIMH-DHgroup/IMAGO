                <http://www.wikidata.org/entity/Q856651> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li><li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#giovanni-di-pian-del-carpine-storia-dei-mongoli'>GIOVANNI DI PIAN DEL CARPINE, Storia dei Mongoli 1989</a>, p. 100, 116-121. </li>" ;
        :has_url_manuscript    "https://bibliotheca-laureshamensis-digital.de/view/bnl_ms110" ;
        :has_url_manuscript_description
                "https://gallica.bnf.fr/ark:/12148/bpt6k376441x/f249.image" ;
        :last_mod_form         "2024-04-05T08:11:15.348Z"^^xsd:dateTime .

