<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/ott._lat._2072/43r44v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1331> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 58, I' ff. e misura 357x250 mm. Il testo è disposto su due colonne, mentre ai ff. 33r-36v su tre colonne. Esemplato in Italia, il manoscritto trasmette anche le Collectanea di Solino, ff. 2r-32v, la Cosmographia di Aethicus Ister, ff. 33r-39v, il De terminatione provinciarum Italiae, ff. 40r-41v, il Curiosum urbis Romae, ff. 41r-43r, il Liber de locis orbis et insularum et marium di Riccobaldo da Ferrara, ff. 45r-58v. Il codice fu posseduto da Ubaldino Bandinelli, che scrive al f. 1v \"Hic liber est Ubaldini Bandinelli et eius amicorum\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1331> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#codice-topografico-della-citta-di-roma'>VALENTINI-ZUCCHETTI 1940-1953</a>, III, p. 179. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/mirabilia-urbis-romae-title/172558 </li><li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, pp. 72-73. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdatab3aaa238e96d0bcd56024b9ff0cc56237f85bd6b" ;
        :last_mod_form         "2024-04-05T17:54:21.28Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/royal_13_e_ix/22v25v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2095> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da III, 326, I' ff. e misura 350x315 mm. Esemplato nell'abbazia di St. Alban, il codice potrebbe essere stato supervisionato da Thomas Walsingham, monaco e cantore (1360-1425 ca.). Il manoscritto fu presentato al British Museum da Giorgio II nel 1757 come parte della Old Royal Library. Trasmette l'Imago mundi per la sezione del libro I, 1-43 e inoltre gli Otia imperialia di Gervasio di Tilbury , le Profezie di Merlino, le Visioni di Thomas Becket, la Vita di Maometto, la Cronaca di Martin Polono, l'Historia Aurea di Giovanni di Tynemouth, il Polychronicon di Higden, l'Itinerarium di Mandeville." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2095> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali di puzzle di grandi dimensioni in rosso e blu con penna rossa (ff. 5, 28, 40, 78, 102, 116, 177, 203). Numerose iniziali più piccole in rosso o blu con penna fiorente nell'altro colore. Rubriche in rosso. Alcune prime lettere di rubriche evidenziate in giallo." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#caldwell-manuscripts-of-gervase-of-tilburys-otia-imperialia'>CALDWELL 1962</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#tzanaki-mandevilles-medieval-audiences'>TZANAKI 2003</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.bl.uk/catalogues/illuminatedmanuscripts/ILLUMIN.ASP?Size=mid&IllID=44856" ;
        :last_mod_form         "2024-04-02T08:20:21.535Z"^^xsd:dateTime .

