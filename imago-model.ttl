<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._4887/80v88v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1052> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da III, 102, I' ff. e misura 320x230 mm con il testo disposto su due colonne. Il codice trasmette anche l'Historiarium libri XII di Frecolfo, ff. 1r-73v; estratti dei Carmina di Ausonio, ff. 74v-75v; Carmen morale, ff. 76v-77v; Carmen IX, 2 di Venanzio Fortunato, ff. 77v-78r; Beda, Versus de die iudicii, ff. 78r-79r; Visio Anselli, ff. 79r-80v; Visio Wettini, ff. 88v-91v; Vita s. Hieronymi, ff. 92r-95r; Translatio capitis s. Iohannis Baptistae Angeriacum, ff. 95r-97v; Passio ss. Sergii et Bacchi, ff. 97v-102r; Versi misogeni, f. 102v. Varie mani si alternano nella trascrizione, una sola attiva nella Navigatio. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1052> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, p. 78. </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b10724309r" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc63764k" ;
        :last_mod_form         "2024-02-05T07:49:50.12Z"^^xsd:dateTime .

