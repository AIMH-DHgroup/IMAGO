<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/fondo_reginense_latino,_810/4v13r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Iacobi Bracellei genuensis ad Blondum Flavium apostolicum secretarium Descriptio ore Ligusticae" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-251> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo; mm 240 x 170 (specchio di scrittura 170 x 110; 17 righe di scrittura); ff. III 14 IV’ (bianco l’ultimo foglio; guardie antiche, in cattivo stato di conservazione sia nella parte anteriore che posteriore, e moderne, cartacee e di restauro). Numerazione dei fogli per cartulazione, moderna, sul mg. sup. sinistro, in numeri arabi. A Iv è possibile leggere la segnatura del codice a lapis. Fascicolazione non restituibile; segni di richiamo assenti. Scrittura di una sola mano, in minuscola umanistica. Rigatura mista (linee orizzontali a piombo e verticali a inchiostro) su pergamena pressoché priva di imperfezioni. Legatura in assi di legno ricoperti di cuoio. Sul dorso, su cui sono visibili quattro nervi, si legge in caratteri dorati la segnatura del codice e, più in alto, è apposta un’etichetta recante anch’essa la segnatura. Alla carta Ir l’ex libris rimanda a «Guglielmi Marlii» e più in alto a destra è vergata dalla stessa mano la precedente segnatura «B.58». \r\nContiene inoltre: GIACOMO BRACELLI, “De Familiis Genuensibus” " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-251> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Capitali miniate su fondo dorato ai ff. 1r e 4r, in inchiostro rosso, blu e verde; titolo dell’epistola a Biondo Flavio in inchiostro rosso (f. 4v)." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. II, p. 400 </li><li><a href='https://imagoarchive.it/bibliografia.html#galletti-2023'>BRACELLI, Descriptio (tesi di laurea) 2023</a>, p. 42 </li><li><a href='https://imagoarchive.it/bibliografia.html#albanese-pontari-2018'>ALBANESE-PONTARI 2018</a>, vol. I, p. 40 </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Reg.lat.810" ;
        :has_url_manuscript_description
                "https://digi.vatlib.it/mss/detail/325897?" ;
        :last_mod_form         "2024-03-14T16:42:17.808Z"^^xsd:dateTime .

