<https://imagoarchive.it/ontology/resources/manuscript/bernkastelkues/bibliothekdesstnikolaushospitals/157/1r56v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-18> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo, mm. 294x220, ff. I, 208, I', luogo di copia: Roma. Due copisti: il primo ha scritto le cc. 1r-197r in una corsiva semiumanistica, mentre il secondo ha copiato il resto del codice in una vera e propria corsiva umanistica. Varianti redazionali aggiunte a margine dalla mano di Giovanni Andrea Bucci (cfr. ff. 67r, 73r, 86r, 87v, 88rv, 92v, 106v, 107r, 112r, 122r, 141r) e cancellazioni simili a quelle apposte dalla mano di Biondo al codice Ottoboniano (cfr. ff. 92rv, 132v, 136r). Contiene inoltre: Biondo Flavio, Italia illustrata (ff. 145r-196v); Poggio Bracciolini, De varietate fortune (ff. 145r-196v); traduzione del Timeo di Platone di Gregorio Tifernate (ff. 199r-208v). Possessore del codice fu Niccolò Cusano, legato apostolico in Germania per conto di Niccolò V e vescovo di Bressanone, che soggiornò a Roma dal 1450 al 1453. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-18> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/bibliothek-des-st-nikolaus-hospitals> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "Ai ff. 202v-203r vi è un disegno in rosso, nel quale dovrebbe essere raffigurato lo schema delle tonalità musicali secondo Platone." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#biondo-roma-instaurata-2020'>BIONDO, Roma instaurata 2020</a>, pp. LXX-LXXI </li><li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, PP. 263-266 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/bernkastel-kues-bibliothek-des-st-nikolaus-hospita-manuscript/168175" ;
        :last_mod_form         "2024-02-18T21:12:58.55Z"^^xsd:dateTime .

