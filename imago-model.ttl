<https://imagoarchive.it/ontology/resources/print_edition/pe-282>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Situs aedificorum politiae et laudabilium consuetudinum inclytae civitatis Ragusij" ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "" ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/situs-aedificiorum-politiae-et-laudabilium-consuet-title/196193> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-282> ;
        :compiled_form              "Martina Piccolo" ;
        :has_ecdotic_type           <https://imagoarchive.it/ontology/resources/print_edition/edition/edizione_semidiplomatica_o_interpretativa> ;
        :has_figure_note            "" ;
        :has_introduction_note      "L'edizione del testo è preceduta da un'introduzione (pp. 3-9) nella quale l'editore traccia un breve profilo biografico dell'autore, a cui fa seguito una scarna disamina della tradizione manoscritta dell'opera. Alle pp. 8-9, Brunelli pubblica anche i distici elegiaci di Nicolò da Lazina, originario di Cremona e cancelliere della Repubblica di Ragusa, in lode dell'opera di Filippo Diversi." ;
        :has_other_contents         "" ;
        :has_primary_source         "" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Filippo Diversi" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-282> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-282> ;
        :last_mod_form              "2023-03-14T12:24:12.544Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._5572/112v132v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1057> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 132 ff. e misura 230x165 mm, con il testo disposto su due colonne. Il codice, composito, è una raccolta di testi agiografici e di Inni sacri. Al f. 3r si legge l'ex libris di Saint-Pierre a Montiéramey, nella diocesi di Troyes: \"Liber Sancti Petri Adremarensis cenobii\", ripetuto al f. 20v lungo il margine esterno. La Navigatio è copiata per il primo foglio e mezzo da una mano diversa dal resto con alcune correzioni apposte da una mano posteriore. Il testo rimane mutilo in corrispondenza di XXVI, 2. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1057> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 76-77. </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b9068279h" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/paris-bibliothèque-nationale-de-france-lat-5572-manoscript/123371" ;
        :last_mod_form         "2024-02-02T17:30:48.443Z"^^xsd:dateTime .

