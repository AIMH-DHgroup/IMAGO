<https://imagoarchive.it/ontology/resources/manuscript/augsburg/staatsundstadtbibliothek/2°_107/1r91r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1801> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 91 ff. e misura 290x215 mm. Scritto in littera antiqua di una sola mano. La legatura è in pelle con punzonature della bottega viennese del maestro Mathias. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1801> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2324633> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1r grande iniziale miniata in oro su fondo rosa e verde, nel margine inferiore stemma dell'umanista Wilhelm von Reichenau (1426-1496), vescovo di Eichstätt, possessore del codice. Iniziali maggiori in oro e blu, bianco e verde su fondo nero a rombi a inizio di ogni libro (ff. 2rb, 14rb; 26vb, 39rb, 49rb, 61rb, 70rb, 78va); iniziali minori rosse e blu alternate a inizio di ogni paragrafo, completate fino al f. 12r. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, p. 73. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/augsburg-staats-und-stadtbibliothek-2°-107-manoscript/189743" ;
        :last_mod_form         "2024-02-05T14:09:17.252Z"^^xsd:dateTime .

