<https://imagoarchive.it/ontology/resources/manuscript/cambrai/lelabocambrai/802/82r84r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1625> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 84, I ff. e misura 208x148 mm. Il codice trasmette: Roberto di San Remigio, Historia Hierosolymitana, ff. 2r-64v; Historia Apollonii regis Tyri, ff. 65v-76r; Marziano Capella, De nuptiis Philologiae et Mercurii, ff. 76r-76v; Publilio Sirio, Sententiae, ff. 76v-79v; Ildeberto di Lavardin, Carmen XIII, f. 79v; Carmen de cyclo paschali, ff. 79v-80r; Pseudo-Victor III papa, Admonitio, ff. 80r-80v; Ildeberto di Lavardin, Carmina, ff. 80v-81v; Descriptio Lateranensis ecclesiae, ff. 82r-84r, ma frammentaria e incompleta. Il codice trasmette una versione più breve della redazione composta prima del 1118. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1625> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q55598713> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 2r iniziale dipinta di blu arricchita di rosso e verde, altre iniziali rubricate o arricchite di rosso, alcuni titoli rubricati. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#vogel-la-descriptio-ecclesiae-lateranensis-du-diacre-jean'>VOGEL 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#oftestad-the-lateran-church'>OFTESTAD 2019</a>, pp. 193-203. </li><li><a href='https://imagoarchive.it/bibliografia.html#codice-topografico-della-citta-di-roma'>VALENTINI-ZUCCHETTI 1940-1953</a>, III, pp. 319-325. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/fr/ark:/43093/mdatac0ef59561350ba002442fe5d61d7a6b6cadb9c2c" ;
        :last_mod_form         "2024-04-04T08:36:55.035Z"^^xsd:dateTime .

