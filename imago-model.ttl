<https://imagoarchive.it/ontology/resources/manuscript/leiden/universiteitsbibliotheek/voss._lat._q._6/169>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1842> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 69, II' ff. e misura 271x212 mm. I toponimi sono scritti da una sola mano di provenienza incerta; su molte tavole sono riconoscibili interventi d'altre mani coeve o di poco posteriori che aggiungono in corsivo nomi di luogo, di cui una, di origine germanica, trascrive sulla tavola della Germania i nomi in lingua tedesca. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1842> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q638395> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice comprende le 27 tavole rimescolate rispetto all'ordine tradizionale: (1) Mauretania; (2) Africa; (3) Cyrene, Aegyptus; (4) Lybia, Aethiopia; (5) Asia Minor; (6) Sarmatia in Asia; (7) Armenia, Media; (8) Syria, Mesopotamia, Arabia septentrionalis; (9) Persia occidentalia; (10) Mare Rubrum,\r\nArabia Felix, Sinus Persicus; (11) Asia septentrionalis: media pars; (12) Asia septentrionalis: pars orientalis; (13) Persia meridionalis et orientalis; (14) India; (15) India extrema; (16) Taprobane; (17) Britannia et Hibernia; (18) Hispania;\r\n(19) Gallia; (20) Germania (in qua holandia); (21) Terrae ad occidentem Danubii sitae; (22) Italia; (23) Sardinia, Sicilia, Mare Tyrrhenum; (24) Sarmatia in Europa; (25) Terrae infra Danubium sitae; (26) Macedonia, Grecia, Creta; (27) Orbis\r\nterrarum descriptio inde a mari Atlantico usque ad mare Indicum." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, p. 102. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-02-05T15:19:59.673Z"^^xsd:dateTime .

