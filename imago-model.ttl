        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/topographia-terrae-promissionis-alexander-ariostus-title/22141 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, V, p. 500. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.beweb.chiesacattolica.it/manoscritti/manoscritto/4924/ms.+14" ;
        :last_mod_form         "2024-03-25T15:20:53.483Z"^^xsd:dateTime .

