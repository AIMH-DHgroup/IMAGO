<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/royal_13.b.viii/1r34v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1154> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto è formato da 147 ff. e misura 275x190 mm. Comprende un'antologia di testi riguardanti la topografia, la storia e la meraviglia del mondo, relativi all'Irlanda e al Galles. Tra questi, la Topographia Hiberniae nella terza versione con aggiunte marginali afferenti alla quarta edizione, l'Expugnatio Hibernica, ff. 34v-74v, l'Itinerarium Kambriae, ff. 74v-100v, il De Purgatorio di S. Patrizio di Enrico di Sawtry, ff. 100v-112v, estratti della Cronaca di Eusebio di Cesarea,ff. 112v-116v, e l'Anticlaudianus di Alano di Lilla, ff. 117-146. Esemplato in Inghilterra, forse a Lincoln sotto la supervisione di Gerald of Wales. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1154> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Sono presenti 45 miniature marginali a colori e disegni colorati di animali, persone e meraviglie d'Irlanda. Quattordici grandi iniziali con decorazione foliata e zoomorfa a colori, alcune con estensioni marginali. Il programma illustrativo fu probabilmente formulato da Gerald of Wales. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/topographia-hiberniae-title/4005 </li><li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>, p. 320. </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li>" ;
        :has_url_manuscript    "https://www.bl.uk/manuscripts/Viewer.aspx?ref=royal_ms_13_b_viii_f001r" ;
        :has_url_manuscript_description
                "https://www.bl.uk/manuscripts/FullDisplay.aspx?ref=Royal_MS_13_b_viii" ;
        :last_mod_form         "2024-03-28T15:13:10.11Z"^^xsd:dateTime .

