<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/6244a/2r122r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1266> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo consta di 266 ff. e misura 217x170 mm. Datato al 3 marzo 1440, fu vergato a Firenze da Elia Bosco, come riportato ai ff. 122r e 247v, per il committente Iacobus Finalis civis Tholonensis, un notaio della corte papale. Trasmette inoltre l'Epistola del Prete Gianni, ff. 124r-130v, l'Historia Hierosolymitana di Jacques de Vitry, ff. 131r-183v, Gesta romana, ff. 184r-219r, un decreto del Consiglio di Firenze del 4 settembre 1439 e un altro sugli Armeni del 22 Novembre 1439, ff. 248r-250r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1266> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 824-849. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-marci-pauli-de-veneciis-de-consuetudinibus-e-title/8347 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/paris-bibliothèque-nationale-de-france-lat-6244-a-manoscript/101186" ;
        :last_mod_form         "2024-02-02T13:15:22.963Z"^^xsd:dateTime .

