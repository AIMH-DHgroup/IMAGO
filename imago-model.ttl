        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/uz/wilhelm_von_boldensele.html </li><li><a href='https://imagoarchive.it/bibliografia.html#httpswwwgeschichtsquellendestart'>GESCHICHTSQUELLEN</a>, http://www.geschichtsquellen.de/werk/2564 </li><li><a href='https://imagoarchive.it/bibliografia.html#guillaume-de-boldensele-liber-de-quibusdam-ultramarinis-partibus-2018'>GUILLAUME DE BOLDENSELE, Liber de quibusdam ultramarinis partibus 2018</a>,  </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Guilielmus de Boldensele" ] ;
