<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_7195/1r103r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1848> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da III, 104, ff. e misura 570x420 mm. Molti fogli sono stati ritagliati, mentre i ff. 64, 65, 68, 69 sono stati asportati. Esemplato a Milano in littera humanistica di una sola mano, nel 1656 il codice apparteneva al convento dei frati minori di S. Omer ed entrò in seguito a far parte della collezione di Edward Harley. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1848> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1r grande iniziale in oro a bianchi girari, iniziali maggiori in oro a bianchi girari su fondo rosa, iniziali minori in oro a bianchi girari. Il codice contiene 27 mappe. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, p. 106. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002053049&indx=1&recIds=IAMS040-002053049&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Harley%207195&dum=true&dstmp=1681823062073" ;
        :last_mod_form         "2024-02-05T15:25:32.873Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/heiligenkreuz/zisterzienserstift/78/105v108v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1093> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto è membranaceo, composto da 154 ff., con il testo disposto su due colonne, e misura 325x212 mm. Il luogo di copia è il monastero di santa Maria a Heiligenkreuz. Trasmette i seguenti testi: Gerolamo, Liber quaestionum hebraicarum in Genesim, ff. 1v-20v; Pseudo- Gerolamo, Decem temptationes populi Israel in deserto, ff. 20v-21v; Pseudo Gerolamo, Succincta commemoratio decem temptationum, ff. 21v-22r; Pseudo Gerolamo, Commentarius in canticum Deborae, ff. 22r-24r; Quaestiones hebraicae in I-III Regum, ff. 25r-38v; Quaestiones hebraicae in I-II Paralipomenon, ff. 28v-50v; Hebraicae quaestiones in Habacuc prophetam, ff. 50v-52r; In Zachariam prophetam 8,18, ff. 52r-53r; Isidoro di Siviglia, In libros veteris ac novi Testamenti prooemia, ff. 53r-58v; De formis hebraicarum litterarum, ff. 58v-59r; Gerolamo, Liber interpretationis hebraicorum nominum, ff. 59r-83r; Gerolamo, De situ et nominibus locorum hebraicorum liber, ff. 83r-105v; Beda, Nomina regionum atque locorum de Actibus apostolorum, ff. 105v-108v; Interpretatio alphabeti hebraici, f. 108v; Eucherio, Formulae spiritalis intelligentiae, ff. 108v-135v; Isidoro di Siviglia, De ortu et obitu patrum, ff. 135v-144r; Isidoro di Siviglia, Allegoriae quaedam Sacrae Scripturae, ff. 144r-151v; De quattuor temporibus, ff. 151v-152r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1093> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/heiligenkreuz-bibliothek-des-zisterzienserstifts> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/nomina-regionum-atque-locorum-de-actibus-apostolor-title/2289 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manuscripta.at/hs_detail.php?ID=30630" ;
        :last_mod_form         "2024-03-02T13:31:12.077Z"^^xsd:dateTime .

