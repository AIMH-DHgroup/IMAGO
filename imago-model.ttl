        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#bousmanne-van-hemelryck-hoorebeeck-la-librairie'>BOUSMANNE-VAN HEMELRYCK-VAN HOOREBEECK 2015</a>, pp. 128-130. </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>, pp. 283-286. </li>" ;
