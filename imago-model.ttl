<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/563/59v112r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1084> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice membranaceo è formato da 177 ff. Composto da quattro unità codicologiche, la Navigatio fa parte della seconda, risalente all'XI secolo. Al f. 58r si annota che l'abate Mainardo ha commissionato il lavoro al monastero di Neuvillers, nell'episcopato di Metz: si tratta probabilmente del Mainardo monaco di Gorze, che fece adottare come nuovo patrono del monastero Gorgonio. Sul verso vi è la sottoscrizione dello scriptor, che si definisce appena arrivato: \"nam hec cum scripsit advena certe fuit, Arnulphus dictus monachili veste togatus\". Il testo della Navigatio, vergato da diversi scribi, si interrompe a XXVIII, 2. Altre due diverse lacune, dovute a caduta di carte, si trovano tra gli attuali ff. 93v-94r e 104v-105r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1084> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 103-104. </li>" ;
        :has_url_manuscript    "https://onb.digital/result/131ABFC1" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/wien-österreichische-nationalbibliothek-563-manoscript/464" ;
        :last_mod_form         "2024-02-05T07:54:12.17Z"^^xsd:dateTime .

