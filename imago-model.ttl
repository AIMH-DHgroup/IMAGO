<https://imagoarchive.it/ontology/resources/manuscript/modena/bibliotecaestenseuniversitaria/lat._140_(alpha_r._9,6)_/81r86v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-82> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto presenta una legatura databile tra 1771-1794, eseguita sotto la direzione di Girolamo Tiraboschi. La coperta del codice è in pelle, bazzana rossiccia. Sulla controguardia posteriore è applicato un cartellino settecentesco che riporta la  segnatura più antica (Ms.VI.B.18). La scrittura è una classica umanistica corsiva di due mani diverse.  Oltre all'opera vergeriana, qui intitolata \"De statu veteris et inclitae urbis Romae\", il manoscritto contiene: Recollectae in Persium (ff. 1r-80v); Francesco Filelfo, Senatus populique romani leges ex senatus consulto approbate (88v-94v); Marco Tullio Cicerone, Ad Caium Iulium Caesarem pro M. Marcello (94r/v); Marco Valerio Probo, Significatio litterarum atiquarum et breviaturae antiquae (95r-107v). " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-82> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1219443> ;
        :compiled_form         "Martina Piccolo" ;
        :has_decoration        "" ;
        :has_secondary_source  "" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/risultati-ricerca-manoscritti/-/manus-search/detail/644479?struct%3A1016=ricerca.parole_tutte%3A4%3D6&item%3A1016%3AKeywords=petrus+paulus+vergerius&fieldstruct%5B0%5D=ricerca.parole_tutte%3A4%3D6&fieldaccess%5B0%5D=item%3A1003%3Anome_t&struct%3A5003=ricerca.parole_tutte%3A4%3D6&struct%3A4=ricerca.parole_tutte%3A4%3D6&struct%3A5005=ricerca.parole_tutte%3A4%3D6&struct%3A5004=ricerca.parole_tutte%3A4%3D6&struct%3A4091=ricerca.parole_tutte%3A4%3D6&struct%3A5091=ricerca.parole_tutte%3A4%3D6&struct%3A9041=ricerca.parole_tutte%3A4%3D6&struct%3A3041=ricerca.parole_tutte%3A4%3D6&struct%3A5041=ricerca.parole_tutte%3A4%3D6&" ;
        :last_mod_form         "2023-03-14T12:41:49.133Z"^^xsd:dateTime .

