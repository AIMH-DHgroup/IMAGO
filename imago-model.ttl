<https://imagoarchive.it/ontology/resources/print_edition/pe-114>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Descrizione della Liguria" ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "L’edizione Andriani rappresenta il primo tentativo moderno di pubblicazione dell’opera di Bracelli. Non si tratta di un’edizione critica, bensì di un’edizione a carattere divulgativo che presenta, secondo il ragionamento condotto dallo studioso, i testi delle tre descrizioni della Liguria in ordine di tempo. Lo studioso stesso ci informa dei manoscritti consultati per la constitutio textus: il ms. Mss. Genova, Biblioteca civica Berio, m.r. Cf. Arm. 26 (10.6.65) per la prima redazione dell’opera; l’editio princeps del 1520 a cura di Agostino Giustiniani per la seconda redazione che, a detta dello studioso, è da identificare con la descrizione che Bracelli fa avere a Biondo; il ms. Genova, Biblioteca civica Berio, m.r. V, 1-23 (D bis 12.5.2) per la lettera al de Merla. I testi pubblicati, tuttavia, risultano poco attendibili sotto il profilo filologico non disponendo di un apparato critico basato sulla collazione dell’intera tradizione manoscritta e a stampa. Inoltre, si osservano una serie di errori nella costituzione del testo talvolta dovuti a una lettura erronea o affrettata dei codici." ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/descriptio-orae-ligusticae-title/8506> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-114> ;
        :compiled_form              "Alessio Luca Bartelloni" ;
        :has_figure_note            "" ;
        :has_introduction_note      "" ;
        :has_other_contents         "" ;
        :has_primary_source         "Mss. Genova, Biblioteca civica Berio, m.r. Cf. Arm. 26 (10.6.65) e m.r. V, 1-23 (D bis 12.5.2); editio princeps IACOBI BRACELLEI, \"De bello Hispaniensi. De claris Genuensibus. Descriptio Lyguriae. Epistolarum liber unus\", Parigi, Giovanni Badio Ascensio, 1520." ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#andriani-1924'>ANDRIANI 1924</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#galletti-2023'>BRACELLI, Descriptio (tesi di laurea) 2023</a>, p. 54 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Giacomo Bracelli" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-114> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-114> ;
        :last_mod_form              "2024-03-14T13:32:26.496Z"^^xsd:dateTime .

