<https://imagoarchive.it/ontology/resources/manuscript/seitenstetten/stiftsbibliothek/folio_56/1r101r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1887> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 104 ff. e misura 280x210 mm. Esemplato a Vienna, il codice fu postillato dal cosmografo tedesco Giovanni Regiomontano. Sono presenti notabilia e identificazioni moderne di toponimi antichi, soprattutto per le regioni germaniche. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1887> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q385745> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, p. 132. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manuscripta.at/hs_detail.php?ID=1749" ;
        :last_mod_form         "2024-02-06T08:51:28.13Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/incipit_dedication/mid-1663>
        rdf:type                   <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Semper memor tui etiam inter dubia bellorum nostrorum pericula carissime preceptor ac secundum matrem sororesque meas acceptissime. " ;
        :is_incipit_dedication_of  <https://imagoarchive.it/ontology/resources/manifestation/manuscript/mm-1663> .

<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/_harley_218/104r117v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2089> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo e cartaceo è formato da 174 ff. ed è composto da diverse unità, messe insieme probabilmente nell'abbazia cistercense di Herefordshire. I fogli sono di varia dimensioni. Esemplato in Inghilterra, il codice trasmette interamente l'Imago mundi e riporta inoltre: Johann Lichtenberger, Prognosticatio, ff. 1r-49r; Pseudo-Aristotele, Problemata, ff. 50r-51v; Pronostici per l'anno 166, f. 52r; John Lydgate, Testamento, ff. 52v-72r; Brevi trattati sulla cronologia, ff. 73r-79r; Cronaca inglese, ff. 79v-82v; Poema sulla vita e la passione di Gesù, ff. 83r-102r; Frammento di calendario ecclesiastico, ff. 102v-103r; Trattati teologici, ff. 118r-119v; Sesto Aurelio Vittore, De viris illustribus, ff. 122r-146r; Trattati astrologici, f. 147v-151v; Trattato in inglese con previsioni astrologiche, ff. 152r-152v; Trattato astrologico in latino, ff. 152v-153r; Previsioni di Girolamo di Hereford, f. 153r; Glossario per l'astrolabio, ff. 153v-154r; trattato in inglese relativo all'urina, ff. 154v-155v; Ricette alchemiche in inglese, ff. 156v-157v; Profezie per il 1572, f. 158v; John Wyclif (attribuito), Commentario ai Dieci Comandamenti, ff. 159r-167r; Brevi trattati teologici, ff. 167v-168v; Trattato sul computus, ff. 169r-173r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2089> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Una mappa O-T in inchiostro marrone e rosso su f. 104v. Aggiunti disegni a penna di figure umane che reggono archi e frecce in inchiostro marrone (ff. 102v-103v, 158r); e di una figura umana (f. 158r). Iniziali in rosso, ff. 51r-72r; iniziali maggiori (1-2 linee) in rosso con penne a contrasto in inchiostro grigio-marrone, iniziali più piccole (1 riga) in rosso, maiuscole in rosso e rubriche in rosso, ff. 73r-103v; iniziali grandi (2 righe) in rosso e rubriche in rosso, ff. 104r-121r; iniziali principali (3 righe) in rosso, rubriche e segni di paragrafo in rosso, ff. 159r-168r." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002046046&indx=1&recIds=IAMS040-002046046&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=harley%20218&dum=true&dstmp=1682203704770" ;
