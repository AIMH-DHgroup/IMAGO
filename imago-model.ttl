<https://imagoarchive.it/ontology/resources/manuscript/firenze/bibliotecamedicealaurenziana/plut._30.3/1r134v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1831> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 134, I' ff. e misura 435x395 mm. Il codice fu copiato da una sola mano, con il testo disposto su due colonne, in littera antiqua, mentre una seconda mano ha vergato i toponimi delle tavole. Il codice comprende il testo di Tolomeo nella traduzione di Jacopo Angeli preceduta dalla lettera di dedica del cartografo Niccolò Germano a Borso d'Este. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1831> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q856419> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1r grande iniziale dorata e fregio a bianchi girari con uccelli e puttini, nel margine inferiore preparazione per lo stemma lasciato in bianco. Al f. 2v grande iniziale dorata miniata raffigurante Tolomeo che regge un compasso. Iniziali maggiori in oro a bianchi girari, iniziali minori in rosso. Sono presenti 30 mappe geografiche. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 94-95. </li><li><a href='https://imagoarchive.it/bibliografia.html#crestani-il-rinascimento-italiano'>CRESTANI 2022</a>,  </li>" ;
        :has_url_manuscript    "http://mss.bmlonline.it/s.aspx?Id=AWOItKZRI1A4r7GxML8F#/oro/9" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/firenze-biblioteca-medicea-laurenziana-plut-30-3-manoscript/143383" ;
        :last_mod_form         "2024-02-05T15:02:12.795Z"^^xsd:dateTime .

