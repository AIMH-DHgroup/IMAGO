<https://imagoarchive.it/ontology/resources/manuscript/firenze/bibliotecanazionalecentrale/conv._sopp._c.vii._1170/1r69r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber qui dicitur Milion" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1239> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo consta di 100 ff. e misura 255x185 mm. Diviso in due diverse U.C., la prima, corrispondente ai ff. 1-70, ha il testo distribuito su due colonne, con le rubriche e i capitoli in rosso, la seconda U.C. corrisponde ai ff. 71r-100v, con iniziali in rosso o blu e ornamenti floreali. Vergato in Italia, la prima U.C. potrebbe essere datata al secondo quarto del XIV secolo, un periodo molto vicino alla data di stesura della traduzione da parte di Pipino. Il manoscritto riporta la versione estesa del miracolo della montagna (I, 19-20). Trasmette inoltre la Relatio di Odorico di Pordenone nella versione volgare, ff. 71r-100v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1239> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q460907> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 564-571 </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-marci-pauli-de-veneciis-de-consuetudinibus-e-title/8347 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/firenze-biblioteca-nazionale-centrale-conv-soppr-c-manoscript/22319" ;
        :last_mod_form         "2024-02-02T10:41:29.231Z"^^xsd:dateTime .

