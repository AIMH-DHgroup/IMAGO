<https://imagoarchive.it/ontology/resources/manuscript/dublin/trinitycollege/64/167v180v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2107> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 202 ff. e misura 381x274 mm; il testo è disposto su due colonne. Il codice reca nel f. 1r una nota di possesso del monastero di St. Peter di Gloucester \"Liber monasterii Sancti Petri Glouc.\", e nel margine inferiore del f. 2r un'altra nota, in parte erasa: \"Liber monasterii sancti Petri Glouc. ex adquisicione fratris...Hortone comonachi eiusdem\". Il codice venne donato al Trinity College dal fondatore sir Thomas Pope (m. 1559). Il manoscritto trasmette il testo completo dell'Imago mundi e riporta inoltre il De natura rerum di Rabano Mauro, ff. 2r-167r, e le Etymologiae di Isidoro di Siviglia, 181r-202r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2107> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q81165027> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#kottje-ziegler-verzeichnis-der-handschriften'>KOTTJE-ZIEGLER 2012</a>, pp. 133-134, n. 734. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_11161" ;
        :last_mod_form         "2024-04-02T08:34:07.99Z"^^xsd:dateTime .

