<https://imagoarchive.it/ontology/resources/manuscript/modena/bibliotecaestenseuniversitaria/campori_101_(gamma_d_1_20)/40v105v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-659> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice tramanda il testo della III fase redazionale dell'Italia illustrata. Cartaceo, mm 327x241, ff. 105. Al manoscritto è unito un foglio piegato su cui si legge \"Illust. Michel Angelo Gualandi Bologna\". Il foglio registra il contenuto delle opere di Biondo nell'edizione Froben 1559 e una breve biografia dell'autore. Il manoscritto tramanda anche altre opere di Biondo Flavio: Roma triumphans, proemio e breve tratto del primo libro (ff. 1r-v); Roma instaurata (ff. 1v-29v); De gestis Venetorum (ff. 30r-39v).  Il codice è copia della stampa veneziana del 1510. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-659> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1219443> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, p. 276 </li><li><a href='https://imagoarchive.it/bibliografia.html#biondo-roma-instaurata-2020'>BIONDO, Roma instaurata 2020</a>, pp. LXXXI-LXXXII </li>" ;
        :has_url_manuscript    "http://bibliotecaestense.beniculturali.it/info/img/mss/i-mo-beu-gamma.d.1.20.html" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/modena-biblioteca-estense-universitaria-campori-10-manuscript/168180" ;
        :last_mod_form         "2024-03-14T09:37:00.05Z"^^xsd:dateTime .

