<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/pal._lat._1226/186v190r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-543> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 240, I ff. e misura 210x140/150 mm. Il codice è una miscellanea di testi medici e storia naturale. Il manoscritto tramette: Gilles de Corbeil , Metrum de urinis, ff. 2r-80r; Teofilo, Liber de urinis cum glossa, ff. 81v-104v; Filareto, Liber de pulsibus cm glossa, ff. 106r-114r; Gilles de Corbeil, Metrum de pulsibus, ff. 115r-153r; De urinis, ff. 153v-157r; Bernard de Gordon, De pulsibus, ff. 244v-246r; Alessandro di Tralles , De pulsibus et urinis, ff. 165v-169r; Tractatus de negotio urinarum, ff. 169v-174v; Matteo Silvatico, De pulsibus, ff. 175r-179r; De morborum cognitione ex urinis, ff. 179v-183r; De significationibus urinarum, ff. 183v-184v; Riccardo Anglico, Regulae de urinis, ff. 191r-196r; Notae de minutione sanguinis, ff. 197v-198v; Tractatus de Phlebotomia cum glossa, ff. 199r-209r; De anatomia hominis, ff. 211r-219v; De secretis mulierum, ff. 220r-224r; Notata varia, ff. 224r-224v; De regimine mensium, ff. 225r-227r; estratti di opere mediche, Ps. Hippocrates, Prognostica, ff. 232r-233r; Signa et indicia mortis, ff. 233r-234v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-543> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 130-131. </li>" ;
        :has_url_manuscript    "https://portail.biblissima.fr/ark:/43093/mdatae519f4317428ab3e572302f0839a64076530b6c1" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdatae519f4317428ab3e572302f0839a64076530b6c1" ;
        :last_mod_form         "2024-03-26T15:39:36.7Z"^^xsd:dateTime .

