<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._3123/126r131v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Petri de Alliaco Tractatus de legibus etc. " ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-305> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 169 ff. e misura 287x210 mm. Il codice trasmette testi geografici e astronomici e si compone di due unità codicologiche, messe insieme probabilmente prima del 1589, secondo quanto si legge in una nota al f. 1r.  Al f. 3r stemma del possessore, Ch.M. Le Tellier, arcivescovo di Reims dal 1671 al 1710. Il codice trasmette inoltre: Pierre d'Ailly, Tractatus de legibus et sectis contra superstitiosos astronomos, ff. 3r-25r; Giovanni XXIII, Bolla sulla riforma del calendario, ff. 25v-26r; Tavola sinottica dei termini pasquali, ff. 26r-26v; Pierre d'Ailly, Vigintiloquium de concordancia theologie et astronomie, ff. 26v-70v; Iohannes de Muris, Sermo de regulis computistarum, ff. 71r-72v; Henricus de Langenstein, De reductione effectuum, ff. 74r-75r; Pierre d'Ailly, Imago Mundi, ff. 80r-125v; Iacopo di Angelo di Scarperia, Cosmographia, ff. 159r-170r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-305> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Disegni ad acquerello ai f. 106v e 169v-170r carta dell'Europa e di una parte dell'Asia.  " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/expositio-mappae-mundi-title/174709 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 121-122. </li><li><a href='https://imagoarchive.it/bibliografia.html#gautier-dalche-2001'>GAUTIER DALCHÉ 2001</a>,  </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b10545225t" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/paris-bibliothèque-nationale-de-france-lat-3123-manoscript/40956" ;
        :last_mod_form         "2024-04-05T12:14:06.527Z"^^xsd:dateTime .

