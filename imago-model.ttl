<https://imagoarchive.it/ontology/resources/manuscript/wolfenbttel/herzogaugustbibliothek/guelf._68.13_8°/95r129r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-549> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto è formato da 169 ff. Il codice trasmette testi di argomento astrologico, tra cui: Alphonsi regis Castellae tabulae astrologicae, ff. 1r-24v; Canon super tabulas regis Alphoncii., ff. 29r-32v; Anni 1445–1456 ab incarnatione et eorum dies, f. 36r; Notae variae astrologicae, f. 36v; De tempore eiusque mensura, ff. 37r-50r; Notae astrologicae, ff. 50r-50v; Versus de virtutibus et vitiis, f. 51v; De horologio orizontali, ff. 52r-52v; Bonus tractatus de epactis, aureo numero et termino pascali, ff. 53r-64v; Ex compoto phylosophorum magistri Ioannis de Sacrobosco, ff. 64v-94; Tractatus astronomicus, ff. 68v-94; estratti dei libri VIII e IV del De Proprietatibus rerum di Bartolomeo Anglico, ff. 95-129; Algorismus de minuciis physicis compositus Wyenne per magistrum Iohannem de Gemunden, ff. 122r-141v; Tabulae astronomicae, ff. 144r-144v; De formatione dorsi quadrantis, ff. 145-152v; Tractatus de sperra materiali, ff. 154v-159v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-549> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q663820> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 131. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://diglib.hab.de/?db=mss&list=ms&id=68-13-aug-8f&catalog=Heinemann" ;
        :last_mod_form         "2023-04-03T13:15:48.966Z"^^xsd:dateTime .

