<https://imagoarchive.it/ontology/resources/manuscript/london/collegeofarms/vincent_418/5r16v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1155> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto è formato da 175 ff. e misura 270x170/250x160 mm. Il codice fu esemplato in Inghilterra, con le carte 5-42 e 45-175v scritte dalla stessa mano. Il codice trasmette testi legati alla storia inglese e irlandese: Richiesta di Robert Winchesley, arcivescovo di Canterbury, a papa Bonifacio VIII dell'8 ottobre 1300; Bolla di Bonifacio VIII; lettera di Edoardo I a papa Bonifacio VIII riguardo ai diritti dei reali inglesi sulla Scozia; la replica dei baroni di Inghilterra dal papa Bonifacio VIII; la Topographia Hiberniae nella prima versione; Peter of Ickham, Compilatio de gestis Britonum et Anglorum; Martin Polono, Chronicon; Chronicon de gestis Britonum; De orbis divisione, de paradiso; Cronica; Nomina regum Christianorum; Enrico di Huntingdon, Historia gentis Anglorum; lista di reali inglesi da Alfredo a Edoardo II; Cronica di Inghilterra fino all'anno 1340; Speculum cronicorum. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1155> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1109101> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/topographia-hiberniae-title/4005 </li><li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>, pp. 323-324. </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/london-college-of-arms-vincent-418-manuscript/166878" ;
        :last_mod_form         "2024-03-28T16:15:09.304Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/cod._3964/1r213v>
        rdf:type               :Manuscript ;
