        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_3240" ;
        :last_mod_form         "2024-03-21T16:39:23.87Z"^^xsd:dateTime .

