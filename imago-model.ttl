<https://imagoarchive.it/ontology/resources/manuscript/roma/bibliotecavallicelliana/c_75/1v77v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1129> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da V + 77 + II ff. , con i ff. I-II del XV secolo e fascicoli legati e misura 218x154 mm. La datazione al 1483/1484 deriva dai ff. 3v-4r in cui si legge \"XI kalendas Iunias anno Domini MCCCCLXXXIII\". L'opera è dedicata al pontefice Sisto IV, morto nel 1484. Al f. IIr il titolo dell'opera è stato inserito dall'oratoriano Vincenzo Vettori (1740-1749), \"Alberti Bonstetten Descriptio Confederationis superioris Germaniae distincta libris tribus\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1129> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2901320> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Sono presenti disegni geografici che raffigurano la terra, rappresentata come un uomo chiuso all'interno di un cerchio, i tre continenti di Asia, Africa ed Europa, con particolare rilievo dell'Italia, e la Germania. Iniziali di colore verde o blu di modulo molto grande all'inizio di ogni capitolo del primo libro e di alcuni capitoli dei libri secondo e terzo. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#httpswwwgeschichtsquellendestart'>GESCHICHTSQUELLEN</a>, http://www.geschichtsquellen.de/werk/693 </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/manuscript/roma-biblioteca-vallicelliana-c-75-manoscript/124744 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/risultati-ricerca-manoscritti/-/manus-search/detail/646871?struct%3A1016=ricerca.parole_tutte%3A4%3D6&fieldstruct%5B0%5D=ricerca.parole_tutte%3A4%3D6&fieldaccess%5B0%5D=item%3A1003%3Anome_t&struct%3A5003=ricerca.parole_tutte%3A4%3D6&struct%3A4=ricerca.parole_tutte%3A4%3D6&struct%3A5005=ricerca.parole_tutte%3A4%3D6&struct%3A5004=ricerca.parole_tutte%3A4%3D6&struct%3A4091=ricerca.parole_tutte%3A4%3D6&struct%3A5091=ricerca.parole_tutte%3A4%3D6&struct%3A9041=ricerca.parole_tutte%3A4%3D6&struct%3A3041=ricerca.parole_tutte%3A4%3D6&struct%3A5041=ricerca.parole_tutte%3A4%3D6&_cacheid=1665177970854&&item:3091:segnature=C+75&struct:3091=ricerca.frase:4=1&item%3A4088%3Afondi%5B%5D=Biblioteca+Vallicelliana%7C%7C%7CIT-RM0281%7C%7C%7CRoma%7C%7C%7CManoscritti&struct:4088=ricerca.frase:4=1" ;
        :last_mod_form         "2024-03-21T11:19:45.257Z"^^xsd:dateTime .

