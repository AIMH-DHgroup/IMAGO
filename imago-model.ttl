<https://imagoarchive.it/ontology/resources/manuscript/klosterneuburg/bibliothekdesaugustinerchorherrenstiftes/787/170r180v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-795> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 184, I ff. e misura 200x148 mm. La rilegatura è del XV secolo. Ai ff. 138r, 172r, 184v note di possesso di Santa Maria a Klosterneuburg. Il codice trasmette inoltre: Agostino, Epistola 140, ff. 1r-42v, Liber retractationum, ff. 42v-43r, Contra Parmenianum Donatistam, ff. 43r-115v, Epistola ad Auxilium episcopum pro Classiciano, ff. 115v-117v, Admonitio de laude caritatis, ff. 118r-138r, De catechizandis rudibus, ff. 138v-168v; Nota de ligno crucis, ff. 168v-169r; Ex testimoniis IIII evangeliorum exempla. Hieronymus contra Helvidium, ff. 169r-169v; Pietro Cantore, Tractatus de paenitentia Salomonis, f. 169v; Versus de Christi morte, f. 170r; Beda il Venerabile, Historia ecclesiastica gentis Anglorum. Excerptum de vita sua, ff. 181r-182r; Cutberto, Epistola de obitu Bedae, ff. 182r-184v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-795> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/klosterneuburg-bibliothek-des-augustiner-chorherrenstiftes> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 172v disegno a piena pagina raffigurante Gerusalemme. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#httpswwwbedadlsgwiuni-muenchendeabout'>BEDA VENERABILIS, De locis sanctis </a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manuscripta.at/hs_detail.php?ID=1013" ;
        :last_mod_form         "2024-02-14T07:45:25.618Z"^^xsd:dateTime .

