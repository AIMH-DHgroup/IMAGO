<https://imagoarchive.it/ontology/resources/manuscript/graz/technischeuniversitt/303/335r336r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1513> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 417 ff. e misura 300x200 mm. Il codice è stato esemplato presso l'abbazia benedettina di St. Lambrecht intorno al 1420. Il manoscritto trasmette inoltre Iacopo da Varagine, Legenda aurea; Decalogus summorum pontificum; Tituli cardinalium et nomina epistopatuum; Stationes ecclesiarum urbis Romae; Indulgentiae ecclesiarum urbis Romae; De situ et mirabilibus Ierusalem; Onorio di Autun, De imagine mundi liber tertius; Arnaldo da Villanova, Regimen sanitatis; Thaddeus Florentinus, Dieta; Theobaldus de Saxonia, Pharetra fidei contra Iudaeos; Anastasio il Sinaita, Disputatio adversus Iudaeos; Tommaso d'Aquini, Libellus de articulis fidei; Pseudo-Bernardo di Chiaravalle, Meditationes. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1513> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2496350> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 38. </li><li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "https://unipub.uni-graz.at/obvugrscript/content/pageview/5893523" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-04-05T14:36:45.457Z"^^xsd:dateTime .

