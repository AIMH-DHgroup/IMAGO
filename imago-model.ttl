                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-654> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 291 ff. e misura 298x205 mm. Esemplato a Utrecht, trasmette anche il Liber de quibusdam ultramarinis di Guglielmo di Boldensele, ff. 160r-175r, e la Relatio di Odorico da Pordenone, ff. 175v-191r. Il codice riporta il testo dell'Historia Mongalorum interpolato con lo Speculum Historiale e con divagazioni riguardanti Egitto, Palestina, Libano non presenti nell'opera di Giovanni di Pian del Carpine. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-654> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q221653> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/author/iohannes-de-plano-carpini-n-1190-ca-m-1250-ca--author/20314 </li><li><a href='https://imagoarchive.it/bibliografia.html#giovanni-di-pian-del-carpine-storia-dei-mongoli'>GIOVANNI DI PIAN DEL CARPINE, Storia dei Mongoli 1989</a>, p. 103. </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-per-un-riordino'>CHIESA 1999-2000</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, p. 37. </li><li><a href='https://imagoarchive.it/bibliografia.html#guillaume-de-boldensele-liber-de-quibusdam-ultramarinis-partibus-2018'>GUILLAUME DE BOLDENSELE, Liber de quibusdam ultramarinis partibus 2018</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/utrecht-bibliotheek-der-rijksuniversiteit-737-(5-b-manoscript/134066" ;
        :last_mod_form         "2024-03-03T08:58:35.262Z"^^xsd:dateTime .

