<https://imagoarchive.it/ontology/resources/manuscript/dublin/trinitycollege/487/1r195v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2227> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 195 ff. e misura 310x225 mm. Il testo è disposto su due colonne di 48 righe, copiate da diverse mani. Sono presenti correzioni e aggiunte del XV e XVI secolo. Il testo del Polychronicon è trasmesso insieme alla continuazione fino al 1376. Il codice riporta inoltre alcuni versi al f. 192v: \"Cronica deducunt per devia sepe legentes, / Utique scribentes devios esse ferunt. / Laboris solacium spes premii largioris, / Set parit fastidium res muneris siccioris\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2227> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q81165027> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 4r schizzo di volto umano. Iniziali in rosso e blu con fioriture di vari colori. Ai ff. 27v e 47v iniziali con scudo araldico, al f. 99v iniziale con bestia serpentina rossa e bestia serpentina viola. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manuscripts.catalogue.tcd.ie/CalmView/Record.aspx?src=CalmView.Catalog&id=IE+TCD+MS+487&pos=2" ;
        :last_mod_form         "2023-05-28T21:18:45.835Z"^^xsd:dateTime .

