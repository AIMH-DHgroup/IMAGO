<https://imagoarchive.it/ontology/resources/manuscript/darmstadt/hessischesstaatsarchiv/2666/88r91v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1507> , <https://imagoarchive.it/ontology/resources/signature/ms-1368> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 191 ff. e misura 175x120 mm. Il codice trasmette: Florigerus, ff. 1r-15v; Auctoritates de vitiis et virtutibus, ff. 16r-49r; Summa de vitiis, ff. 50r-61v; De peccatis mortalibus, ff. 62r-65v; Sermones de communi sanctorum, ff. 66r-87r; Mirabilia Romae e le Indulgentiae ecclesiarum urbis Romae, ff. 88r-91v; Seneca, De beneficiis, ff. 93r-100v; De paupertate, ff. 100v-101v; Seneca, De clementia, ff. 101v-102v; Versus de inundantia Parisiana, ff. 103r-103v; Expositio super Galat. 5, 16, ff. 104r-106r; Interpretationes nominum evangelii sancti Matthaei, ff. 106r-108r; Auctoritates super fidem, caritatem, signa amoris, iudices, ff. 108r-120v; Sermo de unitate trinitatis, ff. 121r-121v; Gregorio Magno, Regula pastoralis, ff. 122r-153r; Versus de victoria Iohannis ducis Brabantie, f. 153v; Versus de Petro papa, f. 153v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1507> , <https://imagoarchive.it/ontology/resources/folios/mf-1368> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1616000> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 34. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.manuscripta-mediaevalia.de/dokumente/html/obj90040345,T" ;
        :last_mod_form         "2024-04-07T15:42:40.678Z"^^xsd:dateTime , "2024-04-07T15:42:30.572Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/berlin/staatsbibliothekpreuischerkulturbesitz/theol._lat._4°_339/1r21v21v22v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-953> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 27 ff. e misura 225x165 mm. Esemplato in Spagna, forse nel Nord del paese, il codice riporta nell'antico foglio di guardia sul recto un titolo di mano coeva in lingua castigliana: Libro della ordinacion della yslas di fortunia. I fogli di guardia sono ricavati da documenti, il secondo datato 1341 e scritto in parte in latino, in parte in francese. Lungo il testo della Navigatio, a margine e nelle parti di riga rimaste vuote, una mano annota gli eventi salienti del racconto. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-953> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q170109> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, p. 13. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/berlin-staatsbibliothek-zu-berlin-preußischer-kult-manoscript/188014" ;
        :last_mod_form         "2024-01-29T15:36:20.465Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/fermo/bibliotecacivicaromolospezioli/77_(4_ca_2/77)/57v60v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1371> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da II, 320, I ff. Nella carta di guardia iniziale è disegnato a penna lo stemma dei Della Rovere con il cappello e i quattro ordini di nappe della dignità vescovile riferibili a Giovanni L. Della Rovere (1503-1510), Domenico della Rovere e Giuliano della Rovere (papa Giulio II), di cui sono riportati anche alcuni versi. Il codice trasmette anche il Liber genealogiae regum Hispaniae di Alfonso de Cartagena, il De actibus Alfonsi de Cartagena episcopi Burgensis, De Machometo, Gesta Romanorum Pontificum, atti di pontefici da Gregorio IX a Clemente VI. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1371> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q3639616> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 36. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/cnmd/0000311374" ;
        :last_mod_form         "2024-04-07T16:04:38.134Z"^^xsd:dateTime .

