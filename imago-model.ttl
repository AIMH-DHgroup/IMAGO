<https://imagoarchive.it/ontology/resources/manuscript/atene/bibliotecagennadios/71/1r41v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-827> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo e monografico; specchio di scrittura: 32 linee; ff. II, 42, II' (bianco il f. 42); numerazione moderna, a lapis, in cifre arabe sul recto del foglio sul mg. sup. destro; segni di richiamo verticali. Scrittura di una sola mano in inchiostro nero, in minuscola umanistica corsiva; rigatura a piombo." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-827> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q5533346> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Numerose mappe colorate (verde per il mare e marrone chiaro per la terra) con didascalie in inchiostro nero e titolo in rosso. L'iniziale del primo paragrafo è finemente rubricata in blu scuro e decorata con motivi fitomorfi su sfondo blu (altezza: 5 linee di testo); i capilettera degli altri paragrafi sono sporadicamente rubricati in rosso (altezza: 2 linee di testo), nei rimanenti casi è presente uno spazio bianco con letterina guida." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. IV, p. 282 </li>" ;
        :has_url_manuscript    "" ;
