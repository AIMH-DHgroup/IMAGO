<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/add._38112/121v123v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-896> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da III, 233 ff. Il codice trasmette testi di vario genere: Passio beati Thome martyris, ff. 1r-12r; Giovanni Beleth, Rationale Divinorum Officiorum, ff. 12r-62r; Lamentatio de morte Karoli comitis Flandrie, ff. 62v-75v; Eginardo, Vita Karoli, ff. 75v-83v; Possidio, Vita sancti Augustini, ff. 84r-101r; Translatio santi Nicolai, ff. 101v-102r; Commento anonimo al Cantico, ff. 102v-121r; Estratti da Giovanni Cassiano, Collationes, ff. 124r-157r. Il codice è composto da tre unità codicologiche, in cui si avvicendano differenti mani. Il testo di Fretello, della prima redazione, risulta incompleto a causa della caduta dei fogli 124-129, perdita avvenuta successivamente all'unione delle unità codicologiche. Il codice fu di proprietà dell'abbazia belga di Tongerlo (Westerlo) e fu poi acquisito nella collezione di Thomas Philippis, come si evince dall'ex libris del f. II. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-896> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali in inchiostro rosso, con decorazioni più elaborate in rosso e verde ai ff. 1r, 3v, 62v, 84r, 102v. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#trovato-sulla-genealogia-e-la-cronologia'>TROVATO 2012</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#boeren-rorgo-fretellus-de-nazareth'>RORGO FRETELLO, Descriptio 1980</a>, p. 2. </li><li><a href='https://imagoarchive.it/bibliografia.html#yolles-latin-literature-and-frankish-culture'>YOLLES (PhD thesis) 2015</a>, pp. 134-135. </li><li><a href='https://imagoarchive.it/bibliografia.html#greco-2021-2022'>GRECO (tesi di dottorato) 2022</a>, pp. 39-40. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/dlDisplay.do?vid=IAMS_VU2&search_scope=default_scope&docId=IAMS032-002057320&fn=permalink" ;
        :last_mod_form         "2024-01-31T15:05:45.455Z"^^xsd:dateTime .

