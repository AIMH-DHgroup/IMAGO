        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#bueno-dalla-guerra-alle-meraviglie-orientali'>BUENO 2018</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#concina-2020'>CONCINA 2020</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002106868&indx=1&recIds=IAMS040-002106868&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=royal%2013%20c%20XII&dum=true&dstmp=1677063009260" ;
