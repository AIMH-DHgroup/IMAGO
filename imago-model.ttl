        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-constantinopoli-civitate-title/222527 </li><li><a href='https://imagoarchive.it/bibliografia.html#de-constantinopoli-civitate-1995'>CIGGAAR 1995</a>,  </li>" ;
