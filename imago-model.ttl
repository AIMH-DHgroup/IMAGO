<https://imagoarchive.it/ontology/resources/manuscript/cambridge/gonvilleandcaiuscollegelibrary/290/682/684693>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1139> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto composito è membranaceo e formato da 712 ff. Il codice trasmette principalmente testi religiosi e teologici e riporta solo alcuni estratti della Topographia Hiberniae di Gerald of Wales. Il codice reca due note, la prima sul risguardo: \"Liber collegii Annunciationis b. Marie Cantebrig' ex dono Mag. Ade Lakynggythe doctoris in theologia\", e un'altra \"Liber Coll. Annnunc. B. Marie Homo qui superbis I.W.\". Il manoscritto è appartenuto ad Adam di Lakenheat della diocesi di Norwich, eletto rettore dell'università nel 1372 fino al maggio 1374, che successivamente donò il codice al Gonville e Caius College. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1139> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q863940> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>, p. 309. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-29T08:14:46.256Z"^^xsd:dateTime .

