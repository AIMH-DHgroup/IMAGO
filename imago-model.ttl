<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_4875/1r228v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2254> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 229 ff. e misura 320x225 mm. Esemplato in Inghilterra in scrittura gotica, il codice riporta il testo del Polychronicon con la continuazione fino al 1399. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2254> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Due diagrammi in rosso (ff. 70r, 70v) che illustrano la teoria musicale pitagorica. Grandi iniziali in oro e colori con decorazione foliata comprendente foglie d'acanto combinate con un bordo a tre lati all'inizio del testo (f. 10v). Grandi iniziali in oro e colori con viticci foliati e acanto che si estendono nel margine (ff. 43r, 65r, 117r, 143v, 163v) o grande puzzle iniziale in rosso e blu con penna fiorente in rosso e viola (f. 94v) all'inizio di ogni libro. Numerose iniziali più piccole in blu con penna rossa fiorente tra cui decorazione foliata e fiori.\r\n\r\n" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002050718&indx=1&recIds=IAMS040-002050718&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Harley%204875&dum=true&dstmp=1685359420291" ;
        :last_mod_form         "2023-05-29T11:26:14.326Z"^^xsd:dateTime .

