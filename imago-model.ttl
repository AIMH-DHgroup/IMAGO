<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/urb._lat._275/1r86v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1824> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 129, II' ff. e misura 441x284 mm. Il testo della Cosmographia nella traduzione di Jacopo Angeli è preceduto dall'epistola dedicatoria di Niccolò Germano al pontefice Paolo II. La legatura reca al dorso le insegne di Clemente XIV e il numero di segnatura. Al f. 86v sono aggiunti gli esametri di Federico Veterani in lode di Federico da Montefeltro. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1824> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice contiene 30 mappe geografiche comprensive del planisfero, delle tradizionali 26 tavole tolemaiche a cui si aggiungono la Spagna moderna, l'Europa del Nord e l'Italia moderna. Ogni tavola è preceduta dall'expositio in una cornice colorata con capilettera in oro a bianchi girari su fondo policromo. Al f. 1r cornice a bianchi girari con stemma di Federico da Montefeltro nel margine inferiore; al f. 2r grande iniziale in oro decorata a bianchi girari con la raffigurazione di Tolomeo con copricapo orientale e in mano un codice e un compasso. Iniziali in oro con decorazioni a bianchi girari su fondo policromo. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 89-90. </li>" ;
        :has_url_manuscript    "https://opac.vatlib.it/mss/detail/Urb.lat.275" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdata978c1f04a223444090918cf9c8f14a9f27534770" ;
        :last_mod_form         "2024-02-05T14:50:36.544Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manifestation_creation/mmc-1499>
