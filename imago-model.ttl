        :has_decoration        "Iniziali fiorite in rosso e blu, contenenti ritratti immaginari di re. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, pp. 48-49. </li>" ;
