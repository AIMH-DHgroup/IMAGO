                <http://www.wikidata.org/entity/Q1135137> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali alternativamente in blu e oro. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#brewer-kane-the-conquest-of-the-holy-land-2019'>BREWER-KANE 2019</a>,  </li>" ;
