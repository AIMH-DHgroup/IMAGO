<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/sloane_511/2r377r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-404> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 336 ff. e misura 245x165 mm. All'interno del testo manca il libro XV, il libro XIV finisce al f. 176r, il libro XVI inizia a 176v, aggiunti successivamente da altra mano al f. 334v gli articoli su Esula e Ebulus del libri XVII. Nessun apparato per le note marginali, ma sono presenti numerosi lemmi aggiunti da mani successive che testimoniano interesse per le questioni mediche. Sono presenti inoltre aggiunte al testo di varie mani soprattutto nel XVII libro sulle piante. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-404> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 2r iniziale C istoriata con la figura di un monaco seduto in un banco. Disegni schematici di costellazioni si trovano ai margini dei corrispondenti capitoli dell'VIII libro." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 71-72. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002112860&indx=1&recIds=IAMS040-002112860&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=sloane%20511&dum=true&dstmp=1680169888832" ;
        :last_mod_form         "2024-03-26T14:51:17.183Z"^^xsd:dateTime .

