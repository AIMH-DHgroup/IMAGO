<https://imagoarchive.it/ontology/resources/manuscript/gent/universiteitsbibliotheek/13/83r113v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1241> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è composto da 158 ff. e misura 510x385 mm. Esemplato in Olanda, la prima parte (ff. 1-124) fu probabilmente copiata dopo il 1500, la seconda (ff. 125-158) dopo il 1486. Il possessore fu Raphael de Mercatellis (1437-1508), abate di S. Bavon a Gand, e alla sua morte il manoscritto rimase nell'abbazia fino al 1540, quando l'archivio della biblioteca fu inglobato nella nuova cattedrale di Gand, per poi arrivare all'Università di Gand nel 1817. Trasmette: Auctoritates Aristotelis et aliorum philosophorum, ff. 1r-27r; Problemata Aristotelis, ff. 27r-42r; Iohannes de Hese, Itinerarium, ff. 43r-52v; Itinerarium Brugense, ff. 54r-60v; Ludolfo de Sudheim, De itinere Terrae Sanctae, ff. 61r-82r; Peregrinationes totius Terrae Sanctae, ff. 114r-123v, Johann Reger, Registrum alphabeticum, ff. 125r-157v, estratti dal De Bello Gallico di Giulio Cesare, ff. 157v-158v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1241> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q611001> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 575-594. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-marci-pauli-de-veneciis-de-consuetudinibus-e-title/8347 </li>" ;
        :has_url_manuscript    "https://lib.ugent.be/catalog/rug01:000960423/items/910000094727" ;
        :has_url_manuscript_description
                "https://lib.ugent.be/catalog/rug01:000960423" ;
        :last_mod_form         "2024-02-05T06:48:11.821Z"^^xsd:dateTime .

