<http://www.mirabileweb.it/title/epistola-iohannis-presbyteri-regis-indiae-title/172754>
        rdf:type    <http://imagoarchive.it/ilrmoo/F2_Expression> ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Epistola Iohannis presbyteri, regis Indiae" ] ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                <https://imagoarchive.it/ontology/resources/toponym/asia> , <https://imagoarchive.it/ontology/resources/toponym/india> ;
