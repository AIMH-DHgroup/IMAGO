<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/_lat._8501_a/16r22v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Vita s. Patric. Etico" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1740> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 131 ff, preceduto e seguito da tre guardie di carta e misura 248x195 mm. La rilegatura è del XVII secolo in pergamena. Sul f. 1r. e 131r timbro della \"Bibliotheca Regia\". Esemplato in Francia, molto probabilmente in Normandia, forse a Mont-Saint-Michel, il manoscritto trasmette: Vita sancti Patricii, ff. 1r-1v; Genealogia Francorum, f. 1v; Giulio Valerio, Res gestae Alexandri Macedonic, ff. 1v-11v; Collatio Alexandri et Dindimi, ff. 12r-15v; Epistola Alexandri ad Aristotelem, ff. 16r-22v; Galterius Compendiensis, Otia de Machomete, ff. 23r-32r; Sententiae philosophorum, ff. 32v-33r; Haito, Visio Wettini, ff. 33v-36v; Miraculum sancti Hieronymi de leone, ff. 36v-37r; De aetate mundi et chronicon, ff. 37v-39v; Goffredo di Monmouth, Historia regum Britanniae, ff. 63v-129v; Seneca, Apocolocyntosis, ff. 130r-131v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1740> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 63v due iniziali disegnate con una penna. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li><li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b10542189p/f1.item" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc677861" ;
        :last_mod_form         "2024-04-05T09:36:58.959Z"^^xsd:dateTime .

