        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 116-117. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://data.onb.ac.at/rec/AC13950519" ;
        :last_mod_form         "2023-10-10T10:37:05.017Z"^^xsd:dateTime .

