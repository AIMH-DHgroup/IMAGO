        :is_text_incipit_of  <https://imagoarchive.it/ontology/resources/manifestation/manuscript/mm-1862> .

<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/795/184r187v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1307> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 205 ff. e misura 230x135 mm. Il codice fu esemplato probabilmente nell'abbazia benedettina di Saint-Amand per l'arcivescovo Arn di Salisburgo (785-821) e dalla Biblioteca della Cattedrale della città giunse alla biblioteca di corte viennese dopo il 1806. Esemplato da circa 30 mani diverse, di cui tre principali, il codice riporta: Alcuino, Epistolae, ff. 1v-4v, De orthographia, ff. 5r-18v; Commenti al Nuovo Testamento, ff. 21r-150v; Commento alla Bibbia, ff. 103r-147r; Alcuni, scritti esegetici, ff. 148v-150v, ed Epistolae, ff. 150v-183v; Notitia ecclesiarum urbis Romae, ff. 184r-187v; De locis sanctis martyrum quae sunt foris civitatis Romae, ff. 187v-191v; Alcuino, Epistolae, ff. 192r-199r; Versus ad Candidum, ff. 199r-199v; Carlo Magno, lettera ad Alcuino, ff. 200r-203v; Inno di S. Agostino, f. 204r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1307> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali semplici, in parte colorate di rosso o tratteggiate, intestazioni in onciale rossa o nera. Al f. 204r disegno di una figura umana. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/notitia-ecclesiarum-urbis-romae-title/172194 </li>" ;
        :has_url_manuscript    "https://onb.digital/result/1002EC92" ;
        :has_url_manuscript_description
                "https://glossen.germ-ling.uni-bamberg.de/manuscripts/13188.html" ;
        :last_mod_form         "2024-04-04T06:17:59.923Z"^^xsd:dateTime .

