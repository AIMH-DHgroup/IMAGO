<https://imagoarchive.it/ontology/resources/manuscript/krakw/bibliotekajagielloska/813/85r90r39r79v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-538> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto trasmette alcuni estratti del \"De proprietatibus rerum\" di Bartolomeo Anglico di argomento medico. Il codice trasmette inoltre: Iohannitius, Isagoge ad Tegni Galeni, ff. 1r-5r; Expositio Aphorismi, ff. 5r-10v; Teofilo, Liber urinarum, ff. 10v-15v; Prognostica, ff. 15v-19v; Ars medica, ff. 21r-37r; Arnaldo da Villanova, Capitula astrologiae de iudiciis infirmitatum secundum motum planetarum, ff. 124v-130r; Gilles de Corbeil, Carmen de urinis, ff. 141r-152r; Averroè, Commentarium in parva naturalia, ff. 108v-109v; Hugo Ripelin de Argentina, Compendium theologicae veritatis, ff. 109v-110v; De aqua ardente, ff. 82v-83v; De compositione cylindri, ff. 178v-180v; De consideratione dierum creticorum, ff. 130r-134r; Interpretationes somniorum, ff. 124r-124v; Introductio in astrologiam medicam, ff. 79v-82v; Enrico de Hassia, Quaestio de cometa, ff. 173v-174r; Receptae variae, ff. 109v-110v, 137r-137v; Secretum secretorum, ff. 153r-173v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-538> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q24101> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li><li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 130. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/kraków-biblioteka-jagiellonska-813-manoscript/110449" ;
        :last_mod_form         "2024-03-26T15:35:28.492Z"^^xsd:dateTime .

