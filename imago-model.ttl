<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/ott._lat._909/1r2r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1660> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 102 ff. e misura 350x282 mm. Il codice è formato da due parti: la prima è composta dai ff. 1-48 e risale alla fine dell'XI inizio del XII secolo, la seconda, ff. 49-102, risale al XV secolo e riporta testi in francese. Il manoscritto riporta inoltre la Vita Caroli Magni di Eginardo, ff. 2r-9v e l'Historia Longobardorum di Paolo Diacono, ff. 9v-48v. Esemplato in Francia, il codice deve essere allegato al ms. Parigi, Biblioteca Nazionale, lat. 5062. Al f.48v si legge: \"Iste liber est de ecclesia sancte Trinitatis Fiscanensis\"." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1660> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Ott.lat.909/0001" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdata81abdd70bb702becef3395ed5d06a242965e7674" ;
        :last_mod_form         "2023-03-25T11:25:05.431Z"^^xsd:dateTime .

