<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/bodl._565_/98r101v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-738> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 103 ff. e misura 238x175 mm. Il testo è disposto su una colonna di circa 30 righe. Al f. 1r elenco dei contenuti di due mani successive. Il codice trasmette: elenco dei beni di William Wey, ff. 2r-2v; tassi di conversione, ff. 3r-4v; raccomandazioni e consigli pratici per i pellegrini, ff. 4v-7v; versetti in inglese sui luoghi santi, ff. 8r-13v; luoghi santi, ff. 14r-16v; elenco di dieci motivi per compiere un pellegrinaggio, ff. 17r-34v; Itinerarium peregrinacionis ad sepulcrum sanctissimum, ff. 35r-49r; tabella delle città e delle distanze lungo il percorso, ff. 49v-50v; Itinerarium secundum ad Terram Sanctam, ff. 51r-64r; tabella del vocabolario inglese-greco, greco-latino e latino-ebraico, ff. 64r-76r; selezioni di posti visitati da Wey, ff. 76r-83v; lista di luoghi, ff. 83v-86r, 86r-89r; distanza tra i luoghi della Terra Santa, ff. 89r-90v; vocabolario latino-greco, ff. 91r-91v; Indulgenze a Roma, ff. 92r-98r; Itinerarium peregrinacionis ad sanctum Iacobum in Ispannya, ff. 98r-101v; canzone con musica, f. 101v; testi su Compostella, ff.102r-105r. Al f. 105v nota: \"Ex dono magistri Willelmi Wey quondam socii collegii regalis beatissime Marie Etone iuxta Windesoram huic sancto monasterio de Edyngton qui videlicet magister obijt Anno domini MCCCXXXVI XXX die mensis Novembris\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-738> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali blu con penna fiorita in rosso ai ff. 17r-34r, 35r-49r, 76r-78r, 92r." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#william-wey-itinerarium-peregrinacionis-1458'>WILLIAM WEY, Itinerarium peregrinacionis 2010</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/itinerarium-peregrinacionis-ad-sanctum-iacobum-in--title/190518 </li><li><a href='https://imagoarchive.it/bibliografia.html#boyle-william-weys-itinerary'>BOYLE 2015</a>,  </li>" ;
        :has_url_manuscript    "https://digital.bodleian.ox.ac.uk/objects/b7258770-61c5-4ff9-b030-7f3fbc379a06/" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_1584" ;
        :last_mod_form         "2023-05-31T10:14:44.346Z"^^xsd:dateTime .

