<https://imagoarchive.it/ontology/resources/manuscript/firenze/bibliotecanazionalecentrale/magliabecchiano_xiii_7/1r47r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-835> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo e monografico; mm 290 x 205 (specchio di scrittura: 33 linee); ff. III, 48, I' (membranaceo il secondo foglio di guardia anteriore; bianco il f. 47v); numerazione moderna, a lapis, in cifre arabe sul recto del foglio sul mg. inf. sinistro; segni di richiamo assenti. Scrittura di una sola mano in inchiostro marrone, in minuscola umanistica; rigatura a piombo. Legatura di restauro moderno. Il codice appartiene al nucleo originario della Biblioteca Magliabechiana, costituito dal lascito del bibliofilo ed erudito Antonio Magliabechi (1714)." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-835> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q460907> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Mappe colorate (verde per il mare e marrone chiaro per la terra; edifici in rosso e rosa) con didascalie in inchiostro nero e titolo in rosso. L'iniziale del primo paragrafo è vergata in blu decorata con motivi fitomorfi in inchiostro rosso (altezza del capolettera: 6 linee di testo); i capilettera degli altri paragrafi sono rubricati in rosso e blu (altezza: 2 linee di testo) e sempre decorati con elementi floreali marginali; le iniziali di periodi sono toccati di giallo. Presenta una mappa colorata a tutta pagina sul verso del secondo foglio di guardia anteriore (membranaceo)." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#targioni-tozzetti-1768'>TARGIONI TOZZETTI 1768-1775</a>, vol. V, cc. 6-8 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. I, p. 118 </li>" ;
        :has_url_manuscript    "https://archive.org/details/magliabechiano-xiii.-7/mode/2up" ;
        :has_url_manuscript_description
                "https://archive.org/details/sala-mss.cat.-45-class.-xiii-a-xvi/page/n11/mode/1up" ;
        :last_mod_form         "2024-03-02T14:16:05.629Z"^^xsd:dateTime .

