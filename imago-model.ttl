<https://imagoarchive.it/ontology/resources/manifestation/manuscript/mm-273>
        rdf:type  <http://imagoarchive.it/ilrmoo/F3_Manifestation> ;
        <http://imagoarchive.it/ilrmoo/R7i_is_materialized_in>
