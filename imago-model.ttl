<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/ott._lat._1863/197r238r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1475> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 1-296 ff. e misura 288x207 mm. Il codice è una miscellanea di testi di argomento prevalentemente storico-antiquario, scritto da almeno quattro mani differenti dell'Italia centro-settentrionale, alle quali si aggiunge quella del suo possessore, l'umanista Giovanni Tortelli (1400 ca-1466). Il manoscritto trasmette il De captivitate Pisarum di Matteo Palmieri, ff. 1r-19v, Poggio Bracciolini, De varietate Fortunae, ff. 21r-76r, Lorenzo Valla, De falso credita et ementia Constantini donatione, ff. 82v-106v, Mattia Palmieri, Aristeas ad Philocratem in de interpretatione LXX, ff. 106v-124v, Giovanni Tortelli, De medicina et medicis, ff. 125r-130v, Giannantonio Campano, Oratio cineritia, ff. 130v-142v, Benvenuto da Imola, Liber Augustalis, ff. 143r-153r, Enea Silvio Piccolomini, Continuatio libri Augustalis, ff. 153r-154r, Giovanni Tortelli, Romae origo ac Romuli vita, ff. 155r-172r, Poggio Bracciolini, Vitae quorumdam pontificum, ff. 177r-187r, Maffeo Vegio, De verborum significatione in iure, ff. 247r-264v, Biondo Flavio, Roma triumphans, ff. 267r-285v, Gasparino Barzizza, De compositione, ff. 287r-290r, Donato Aretino, Relazione sulla morte di Antonello della Torre, ff. 291r-292r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1475> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rebus-antiquis-memorabilibus-basilicae-sancti-p-title/9870 </li><li><a href='https://imagoarchive.it/bibliografia.html#della-schiava-il-de-rebus-antiquis-memorabilibus'>DELLA SCHIAVA 2011</a>, pp. 185-190. </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, II, p. 400. </li>" ;
        :has_url_manuscript    "https://opac.vatlib.it/mss/detail/Ott.lat.1863" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/17975" ;
        :last_mod_form         "2024-02-05T10:30:46.584Z"^^xsd:dateTime .

