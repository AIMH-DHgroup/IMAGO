<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/harley_655/14r338r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2243> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 338 ff. Esemplato in scrittura gotica in Inghilterra, il codice trasmette il testo del Polychronicon che arriva fino al 1345. Nel margine inferiore del f. 321v nota del XVII secolo: \"Transcripta sunt sequintia ex veteri libro MSo in Bibliotheca Regia\". Il manoscritto riporta inoltre: Goffredo di Monmouth, Vita Merlini, ff. 200v-204v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2243> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Otto  grandi iniziali di puzzle all'inizio del prologo e libri, in rosso e blu con disegni riservati e penne fiorenti negli stessi colori che si estendono ai margini includendo creature ibride (ff. 14r, 15r, 63v, 134v, 166r, 194r, 237v, 257r). Le iniziali in blu o rosso con fioritura a penna nell'altro colore, compresi motivi foliati e talvolta teste umane o animali, sono usate in tutto il manoscritto (vedi esempi su ff. 10r, 17v, 23r, 24v, 28v, 34v, 48v, 91v, 322r, 324r, 329v). " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/polychronicon-ranulphus-higden-m-12-3-1364-ca--title/4071 </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002046484&indx=1&recIds=IAMS040-002046484&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=Harley%20655&dum=true&dstmp=1685354510644" ;
        :last_mod_form         "2023-05-29T10:10:46.986Z"^^xsd:dateTime .

