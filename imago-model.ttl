<https://imagoarchive.it/ontology/resources/manuscript/reims/bibliothquedetudeetdupatrimoine/1414/54r64r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-899> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 102 ff. e misura 362x260 mm. Il testo è disposto su due colonne. Esemplato nel capitolo della cattedrale di Reims, il codice riporta il Liber di Rorgo Fretellus nella prima redazione e trasmette testi legati alla tematica dei pellegrinaggi in Terra Santa e a Santiago di Compostela, tra cui estratti del Liber sancti Iacobi, ff. 1r-35r, 51v-54r, le pseudoepistole di Cromazio, Eliodoro e Girolamo, ff. 35r-35v. Al f. 88r nota di possesso della Chiesa di Saint-Euverte a Orléans: \"Explicit Expositio super libum qui hebrayce Syrasyrim latine autem Cantica Canticorum dicitur. Liber beati Evurcii Aurelianensis. Quicumque eum furatus fuerit vel furatum celaverit vel titulum istum deleverit, anathemata sit\", ripetuta al f. 102r: \"Quicumque enim furatur anathemata sit liber beati Evurcii Aurelianensis\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-899> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q257342> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#trovato-sulla-genealogia-e-la-cronologia'>TROVATO 2012</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#yolles-latin-literature-and-frankish-culture'>YOLLES (PhD thesis) 2015</a>, pp. 134-135. </li><li><a href='https://imagoarchive.it/bibliografia.html#boeren-rorgo-fretellus-de-nazareth'>RORGO FRETELLO, Descriptio 1980</a>, p. 2. </li><li><a href='https://imagoarchive.it/bibliografia.html#greco-2021-2022'>GRECO (tesi di dottorato) 2022</a>, pp. 43-44. </li>" ;
        :has_url_manuscript    "https://arca.irht.cnrs.fr/ark:/63955/md246q184j90" ;
        :has_url_manuscript_description
                "https://ccfr.bnf.fr/portailccfr/ark:/06871/004D38C13179" ;
        :last_mod_form         "2024-02-05T11:19:50.695Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/add._15835/163r200r>
