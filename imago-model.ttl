<https://imagoarchive.it/ontology/resources/manuscript/columbia/universitdellacarolinadelsud/early_ms_61/1366>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2330> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 336 ff. e misura 295x192 mm. Il manoscritto era un tempo di proprietà di Richard Towneley (1629-1707) e porta il suo ex libris datato al 1702. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2330> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1024426> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Decorazione con iniziali alternate in blu e oro con dettagli a penna a contrasto, rosso su blu e blu su oro. All'apertura e alle divisioni dei capitoli iniziali a due, tre o quattro righe in oro brunito con fondi blu e rossi a contrasto e lumeggiature a penna bianca. Dalle iniziali più grandi emergono steli con foglie verdi e foglie di edera dorata. " ;
        :has_secondary_source  "" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://digital.tcl.sc.edu/digital/collection/p17173coll20/id/228/" ;
        :last_mod_form         "2024-04-16T07:46:33.023Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/cambridge/peterhousecollegelibrary/269/11r16v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1649> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 158 ff. e misura 325x230 mm. Esemplato a Bruges. Nell'ultimo foglio si legge: \"Hoc volumen comparavit Raphael de Marcatellis Dei gratia Episcopus Rosensis Abbas S. Bavonis iuxta Gandavum et quoad potuit correxit. Anno Domini 1495\". La rilegatura è moderna, ma mantiene alcuni elementi originali. Il testo trasmette la Vita di Alessandro Magno, Alexandri et Dindimi collatio, Supplementum ad Historias Alexandri Magni Curtii Rufi. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1649> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q650068> ;
