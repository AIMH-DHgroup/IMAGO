<https://imagoarchive.it/ontology/resources/manifestation/manuscript/mm-2006>
        rdf:type  <http://imagoarchive.it/ilrmoo/F3_Manifestation> ;
        <http://imagoarchive.it/ilrmoo/R7i_is_materialized_in>
                <https://imagoarchive.it/ontology/resources/manuscript/mnchen/bayerischestaatsbibliothek/clm_22225/130v167v> .

<https://imagoarchive.it/ontology/resources/manuscript/augsburg/staatsundstadtbibliothek/_2°_8/4v5r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1906> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto è composito, formato da cinque parti originariamente indipendenti (I, ff. 1-10, II, ff. 11-26, III, ff. 27-66, IV, ff. 67-100, V, ff. 101-110); membranaceo, è composto in totale da 111 ff, ma del f. 100 si conserva solo la metà superiore. Esemplato in minuscola carolingia, i ff. 1r-100r da più mani dell'inizio del XII secolo, i ff. 101r-110v da una mano dell'XI secolo. Il codice trasmette alcuni estratti del testo di Rabano Mauro all'interno delle Allegoriae di Isidoro di Siviglia, ff. 1r-9v e riporta inoltre: Beda il Venerabile, In epistolas catholicas expositio, ff. 11r-26v; Amalario di Metz, Liber officialis, ff. 27v-66v; Glossario erboristico latino-tedesco, f. 67r; Burcardo di Worms, Decretum, ff. 67v-100r; Scritti computazionali e tavolette, ff. 101r-101v; Helperic di Auxerre, Computus, ff. 102r-109v; Scritti computazionali e tavolette, ff. 110r-110v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1906> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2324633> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://glossen.germ-ling.uni-bamberg.de/manuscripts/12038.html" ;
        :last_mod_form         "2024-01-25T13:48:47.904Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._5129/70r71r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-80> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 141, I ff. e misura 318x225 mm. Il codice è formato dall'insieme di due parti: la prima, ff. 1-87, trasmette: Roberto il monaco, Historia Hierosolymitana, ff. 1v-54v; Descriptio locorum circa Hierusalem adiacentium, ff. 54v-65v; Catalogo di vescovi e patriarchi di Gerusalemme, ff. 66r-67r; Beda, De monumento Domini, ff. 67r-67v; Relatio miraculi in regione Saxonum, ff. 67v-68r; Lamentum Lacrymabile, ff. 68v-69v; De situ urbis Jerusalem, ff. 70r-71r; Lettera di Callisto, f. 71r; Historia de via Hierosolimitana, ff. 71v-86r; Ildeberto di Lavardin, De operibus sex dierum, ff. 86v-87v. La seconda unità, ff. 88-141, trasmette: Cataloghi di papi e cardinali, ff. 88v-89v; Descriptio Lateranensis ecclesiae, nella prima redazione, ff. 89v-93r; Ildeberto di Lavardin, Versus de nummo, ff. 94r-101r e Historia de Mahumet, ff. 127r-135v." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-80> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#vogue-les-eglises'>VOGUE 1860</a>, p. 408. </li><li><a href='https://imagoarchive.it/bibliografia.html#vogel-la-descriptio-ecclesiae-lateranensis-du-diacre-jean'>VOGEL 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#oftestad-the-lateran-church'>OFTESTAD 2019</a>, pp. 193-203. </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b10721271n" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc640354" ;
        :last_mod_form         "2024-04-04T20:39:48.175Z"^^xsd:dateTime .

