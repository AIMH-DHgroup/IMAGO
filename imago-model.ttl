        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 227 ff. e misura 320x210 mm. Il codice è composto da cinque diverse unità e trasmette la Topographia Hibernica nella prima versione. Il codice trasmette inoltre il Polychronicon di Ranulph of Higden, ff. 37r-192r; Giovanni di Hildesheim, Historia Trium Regum, ff. 193r-213r; Goffredo di Monmouth, Historia regum Britanniae, ff. 222r-227v." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1134> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q650068> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/topographia-hiberniae-giraldus-cambrensis-n-1145-1-title/4005 </li><li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>, p. 310. </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/cambridge-peterhouse-mediaeval-and-musical-manuscr-manuscript/166876" ;
        :last_mod_form         "2024-03-07T17:49:10.441Z"^^xsd:dateTime .

