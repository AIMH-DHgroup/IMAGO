<https://imagoarchive.it/ontology/resources/manuscript/luxembourg/bibliothquenationale/131/1r299r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-410> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 353 ff. e misura 285x200 mm. La struttura del testo di Bartolomeo Anglico è in 19 libri, ma i numeri romani grezzi dei libri sopra le pagine recto corrispondono a questa numerazione fino al VII libro, f. 83r, poi vengono cancellati fino a 107r e differiscono nel resto del codice. Il manoscritto proviene dal monastero cistercense di Orbal, in Belgio, come si legge al f. 353r \"Liber beate Marie Aureevallis\". Il codice trasmette inoltre un trattato, De preparatione cordis, ai ff. 301r-353r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-410> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q856651> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, p. 74. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2023-03-30T12:07:07.583Z"^^xsd:dateTime .

