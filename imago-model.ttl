<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/urb._lat._274/1r133v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1823> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 133, II' ff. e misura 444x299 mm. Le tavole sono di Niccolò Germano. Il codice si apre con la dedica al pontefice Paolo II. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1823> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice contiene 31 tavole geografiche: il planisfero e 13 tavole dell'Europa, 4 dell'Africa, 12 dell'Asia. Un secondo planisfero con le nuove scoperte è stato aggiunto prima del planisfero tradizionale. A f. 1r cornice a\r\n«bianchi girari» su fondo policromo. Titoli dei capitoli in oro. Al f. 2r grande iniziale in oro decorata a «bianchi girari» con all'interno raffigurato Tolomeo in vesti orientali con in mano libro e compasso." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, pp. 88-89. </li>" ;
        :has_url_manuscript    "https://opac.vatlib.it/mss/detail/Urb.lat.274" ;
        :has_url_manuscript_description
                "https://opac.vatlib.it/mss/detail/Urb.lat.274" ;
        :last_mod_form         "2023-04-18T08:01:05.11Z"^^xsd:dateTime .

