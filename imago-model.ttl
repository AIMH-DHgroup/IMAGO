<https://imagoarchive.it/ontology/resources/manuscript/frankfurtammain/universittsbibliothekjohannchristiansenckenberg/praed._14/325r382v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-378> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 396 ff. e misura 310x215 mm. Il testo di Bartolomeo Anglico inizia con il prologo del libro XIV e si interrompe nel capitolo \"De argento vivo\" del libro XVI. Al f. 372v si legge \"Hic est defectus. Cetera require in de proprietatibus rerum\". il codice trasmette inoltre: Enrico di Assia, Super pater nostre, ff. 1r-5v; Henricus de Hassia, Super Ave Maria, ff. 5v-7v; Henricus de Hassia, De contemptu mundi, ff. 8r-12r; Henricus de Hassia, De antichristo et schismate, ff. 13r-26r; Sermo de adventu Domini dominica secunda, ff. 27r-28r; Henricus Totting de Oyta, Conclusiones, ff. 28r-30v; Sermones, ff. 30v-36r; Nota de Psalterio, f. 36v; Distinctiones in Psalmos, ff. 37r-46v; Pietro di Poitiers, Distinctiones super Psalterium, ff. 46v-156v, 373r-381r; Thomas Guallensis, Expositio super libros I-X; Agostino De civitate Dei, ff. 157r-274v; Umberto di Romans, De abundantia exemplorum, ff. 277r-311r; Henricus de Hassia, De missa, ff. 313r-321v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-378> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q875587> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li><li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 59-60. </li>" ;
        :has_url_manuscript    "https://sammlungen.ub.uni-frankfurt.de/msma/urn/urn:nbn:de:hebis:30:2-16004" ;
        :has_url_manuscript_description
                "https://sammlungen.ub.uni-frankfurt.de/msma/urn/urn:nbn:de:hebis:30:2-16004" ;
        :last_mod_form         "2024-03-26T14:43:46.615Z"^^xsd:dateTime .

