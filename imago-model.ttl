<https://imagoarchive.it/ontology/resources/manuscript/cambridge/thelibraryoftrinitycollege/25/1191>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
