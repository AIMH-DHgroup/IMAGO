<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._636/73v75v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1333> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è diviso in due volumi: il primo riporta in fondo la nota \"Liber sancte Marie de Esrom\" e contiene opere di Beda, di Adamanno di Hy, l'Itinerarium Antonini Placentini e altri scritti, un frammento dei Mirabilia. Nel margine sinistro, in rosso, si legge \"de politico\" e sotto, di mano posteriore \"Fortasse excerpta sunt Libri Politici quem laudant antiqui libri rituales Ecclesie Romane\". Il testo comincia con un brano riguardante le basiliche del Laterano, di san Pietro e san Paolo, mentre i Mirabilia arrivano solo alla menzione del Colosseo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1333> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/mirabilia-urbis-romae-title/172558 </li><li><a href='https://imagoarchive.it/bibliografia.html#codice-topografico-della-citta-di-roma'>VALENTINI-ZUCCHETTI 1940-1953</a>, III, pp. 12-13. </li><li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 76. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/21948" ;
        :last_mod_form         "2023-03-17T16:03:24.11Z"^^xsd:dateTime .

