<https://imagoarchive.it/ontology/resources/manuscript/mnchen/bayerischestaatsbibliothek/clm_14373/33r35r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1406> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 192 ff. e misura 265x200 mm. Nel XV secolo il codice era in possesso dell'Ospedale dello Spirito Santo a Markgröningen, come si legge al f. 2r: \"Iste liber est ordinis sancti spiritus et pertinet ad hospitale in Greningen\". Il primo fascicolo, ff. 1-37, trasmette: Summa in foro poenitentiali, ff. 1r-21v; Versi, f. 21v; Hermann von Schildesche, Speculum manuale sacerdotum, ff. 21v-26v; Inno a Maria in latino e tedesco, f. 26v; De defectibus divini officii et missae, ff. 26v-30r; De divinis officiis, ff. 30r-33r; Mirabilia urbis Romae, ff. 33r-35r; Indulgentiae ecclesiarum urbis Romae, ff. 36r-37v. Il secondo fascicolo, ff. 38-55, trasmette: Sermones de diversis, ff. 38r-54v. Il terzo fascicolo, ff. 56-192, trasmette: Alberico da Rosciate, Dictionarium utriusque iuris, ff. 56r-192r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1406> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q256507> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 56. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://resolver.staatsbibliothek-berlin.de/HSP000588B400000000" ;
        :last_mod_form         "2024-04-08T06:16:06.67Z"^^xsd:dateTime .

