<https://imagoarchive.it/ontology/resources/manuscript/chicagoil/thenewberrylibrary/33.1/15r142v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2329> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 142 ff. e misura 380x360 mm. Il testo è disposto su due colonne di 54 righe. Esemplato in Inghilterra nel XV secolo, il codice riporta il testo del Polychronicon fino al 1190 e trasmette inoltre: Cronica bona et compendiosa de regibus Anglie, ff. 8r-11v; lettera di Edoardo I, ff. 11v-13v; Lettera di conti e baroni d'Inghilterra al pontefice, ff. 13v-14r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2329> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q616527> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 15r iniziale istoriata raffigurante sant'Antonio con cinghiale e campana, bordi d'acanto pieni decorati di blu, verde e oro; iniziali con decorazioni floreali all'inizio dei libri II-VII. " ;
        :has_secondary_source  "" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://i-share-nby.primo.exlibrisgroup.com/discovery/fulldisplay?docid=alma994409838805867&context=L&vid=01CARLI_NBY:CARLI_NBY&lang=en&search_scope=MyInstitution&adaptor=Local%20Search%20Engine&tab=LibraryCatalog&query=any,contains,33.1&offset=0" ;
        :last_mod_form         "2024-04-17T10:32:10.114Z"^^xsd:dateTime .

