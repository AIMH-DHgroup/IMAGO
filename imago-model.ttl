        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1r miniatura di autore che scrive alla sua scrivania. Ai ff. 15r, 274r, 278r tre piccoli diagrammi con inchiostro nero che illustrano il testo." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-proprietatibus-rerum-bartholomaeus-anglicus-v-1-title/257 </li><li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 96-97. </li>" ;
