<https://imagoarchive.it/ontology/resources/manuscript/madrid/bibliotecanacionaldeespaa/res._255/1r110v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1849> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 110 ff. e misura 560x410 mm. Il codice fu esemplato a Firenze in littera humanistica su due colonne da una sola mano, forse da attribuire a Domenico di Cassio de Narni. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1849> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q750403> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice contiene 27 mappe, la cui realizzazione è da ricondurre all'atelier di Francesco Antonio del Chierico. Al f. 1r cornice miniata, iniziale miniata che raffigura papa Alessandro e tre cardinali che ricevono l'opera dall'Angeli; al f. 2r iniziale miniata raffigurante Tolomeo che sostiene nella mano una sfera. Capitali maggiori miniate con decorazioni fitomorfe. Le 27 mappe si trovano nell'VIII libro, la maggior parte a doppia pagina, finemente colorate. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, p. 107. </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, IV, p. 581b. </li>" ;
        :has_url_manuscript    "http://bdh.bne.es/bnesearch/detalle/bdh0000061306" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/madrid-biblioteca-nacional-de-españa-res-255-manoscript/143494" ;
        :last_mod_form         "2024-02-05T15:26:52.116Z"^^xsd:dateTime .

