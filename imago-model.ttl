<https://imagoarchive.it/ontology/resources/manuscript/cambridge/thelibraryoftrinitycollege/632_(e.5.20)/46r88r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1237> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 236 ff. e misura 206x140 mm. Vergato da più mani, probabilmente nel Norfolk, riporta una versione abbreviata del testo di Pipino, senza la suddivisione in tre libri e distribuendo il materiale in 31 capitoli. Trasmette inoltre numerosi testi: Leges Edwardi Confessoris; De Fundatoribus Ecclesiarum Per Angliam; Alexandri Magni Iter Ad Paradisum; il Romanzo di Walfed;  De Palmistria; Providencia Predestinacionum Hominum Et Mulierum Per Duodecim; De Mirabilibus Britannie; De fabula Phetontis; Seneca, De Beneficiis; alcuni passi di argomento morale tratti da autori latini classici, come Seneca, Cicerone, Quintiliano e Cesare, Lucano, Petronio. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1237> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q856559> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-marci-pauli-de-veneciis-de-consuetudinibus-e-title/8347 </li><li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 547-556. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manuscripts.catalogue.tcd.ie/CalmView/Record.aspx?src=CalmView.Catalog&id=IE+TCD+MS+632&pos=5" ;
        :last_mod_form         "2024-02-02T10:38:47.327Z"^^xsd:dateTime .

