<https://imagoarchive.it/ontology/resources/print_edition/pe-401>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Claudii Ptolemaei Cosmographiae liber primus-octavus" ] ;
        <http://erlangen-crm.org/211015/P2_has_type>
                <https://imagoarchive.it/ontology/resources/print_edition/edition/prima_edizione_/_editio_princeps> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Alla c. G10v si legge: \"En tibi lector Cosmographia Ptolemaei ab Hermano Levilapide Coloniensi Vicentiae accuratissime impressa, Benedicto Trivisano et Angelo Michaele praesidibus. MCCCCLXXV. Idi. Sept\". Il volume in folio è composto da 144 carte non numerate di 292x196 mm. Cartulato, manca del registro, probabilmente stampato su un foglio volante che deve essere stato eleminato subito dopo la legatura. Il testo è disposto su una sola colonna di 39 righe. Alla carta 2r-2v dedica a papa Alessandro V dell'Angeli, poi il sommario del libro primo e l'incipit. Il codice fu stampato senza l'apparato illustrativo della tradizione manoscritta. " ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-401> ;
        :compiled_form              "Sara Crea" ;
        :has_figure_note            "Il testo è interrotto solo da tre dei quattro disegni geometrici del capitolo XXIV del primo libro e da una quarta figura dell'ultimo capitolo del libro VII. " ;
        :has_introduction_note      "" ;
        :has_other_contents         "" ;
        :has_primary_source         "" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#opac-sbn'>OPAC SBN</a>, http://id.sbn.it/bid/VEAE143000 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Claudius Ptolomaeus" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-401> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-401> ;
        :last_mod_form              "2024-02-06T09:05:09.632Z"^^xsd:dateTime .

