<https://imagoarchive.it/ontology/resources/manuscript/dresden/staatsunduniversittsbibliothek/f_168/146>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1602> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 46 ff. Anticamente posseduto da Bernardo Trevisani, fu consultato nella sua libreria da B. de Montfaucon e Apostolo Zeno. Il codice consta di sei quaderni, di cui i primi cinque consistono di sedici pagine e l'ultimo di due mezzi fogli e una carta. All'interno del Chronicon si trova un compendio della storia troiano-romana, ma senza il proemio, il catalogo degli imperatori romani e bizantini da Cesare fino ad Enrico, fratello di Balduino di Fiandra, un catalogo di papi da Pietro a Damaso II, un catalogo di dogi fino a Pietro Ziani, un catalogo di patriarchi di Grado fino ad Angelo Baroccio, che rivestì la carica tra il 1212-1238 (termine post quem dell'opera), la lista dei vescovi di Torcello e di Olivolo, la storia della fondazione di Torcello e di Grado, un racconto sull'istituzione del patriarcato di Grado e sulla vita degli antichi Veneziani, un catalogo delle famiglie veneziane, il racconto di Longino, brevi discussioni scolastiche, la donazione di Costantino, due formule per l'incoronazione degli imperatori, il Concordato di Worms e il privilegio di Leone VIII ad Ottone I. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1602> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q323270> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#marin-considerations-regarding-the-place'>MARIN 2013</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#origo-civitatem'>Origo civitatum Italie 1933</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/chronicon-altinate-title/171574 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.manuscripta-mediaevalia.de/dokumente/html/obj40173861" ;
        :last_mod_form         "2024-04-03T13:19:15.602Z"^^xsd:dateTime .

