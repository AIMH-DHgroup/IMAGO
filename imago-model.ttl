<https://imagoarchive.it/ontology/resources/manuscript/berlin/staatsbibliothekpreuischerkulturbesitz/hamilton_277/1r72r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
