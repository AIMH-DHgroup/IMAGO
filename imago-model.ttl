        :has_decoration        "Iniziali decorate. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 520-541. </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li><li><a href='https://imagoarchive.it/bibliografia.html#bueno-dalla-guerra-alle-meraviglie-orientali'>BUENO 2018</a>,  </li>" ;
        :has_url_manuscript    "" ;
