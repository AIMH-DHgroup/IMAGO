<https://imagoarchive.it/ontology/resources/manuscript/treviso/bibliotecacomunaleditreviso/cod._5/75r76v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "P. P. Vergerii Orationes, Epistolae, et Opuscula ex ms. cod. Patavino pugillari apud Zabarellas" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-93> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da I, 80, I ff. e misura 206x151 mm; foliazione a matita nell'angolo in alto a destra; firme A-K sul primo foglio di ogni fascicolo e F ripetuto al f. 42. La rilegatura è in cartone e la coperta in pergamena. Esemplato a Padova, come si legge nella titolazione \"P. P. Vergerii Orationes, Epistolae, et Opuscula ex ms. cod. Patavino pugillari apud Zabarellas, cura I. C. Z.\" il manoscritto è copia di un codice appartenuto un tempo al conte Giacomo Zabarella. Le note presenti sul testo potrebbero essere di Gian Roberto Papafava; sul verso del foglio di guardia anteriore \"ex libris\" di Giambattista Rossi (1737-1826): \"ex libris: Biblioteca Rossi\". Il codice trasmette inoltre epistole e orazioni di Vergerio e la sua Vita Petrarcae, ff. 66r-74v. Il De situ urbis Iustinopolitane, privo del titolo, è seguito dal testo di Giustino (Ivst. 32, 3, 13-15). " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-93> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q3639649> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#vergerio-2023'>VERGERIO, De situ Iustinopolitane 2023</a>, pp. 19-20. </li><li><a href='https://imagoarchive.it/bibliografia.html#reserch-aids-pierpaolo-vergerio-the-elder'>McMANAMON 2016</a>, pp. 44-45. </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, II, p. 195a. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.nuovabibliotecamanoscritta.it/Generale/ricerca/AnteprimaManoscritto.html?codiceMan=30533&tipoRicerca=A&urlSearch=codBiblioteca%3D54%26segnatura%3D5%26nome%3D%26responsabilita%3D%26titolo%3D%26incipit%3D%26explicit%3D%26argomento%3D%26anticasegnatura%3D%26parola%3D%26tipo_parola%3DA%26linguaMan%3D0%26tipo_corpo_codice%3D%26__checkbox_palinsesto%3Dtrue%26__checkbox_composito%3Dtrue%26__checkbox_autografi%3Dtrue%26__checkbox_carteggio%3Dtrue%26__checkbox_datati%3Dtrue%26__checkbox_restauro%3Dtrue%26__checkbox_decorati%3Dtrue%26__checkbox_musicali%3Dtrue%26__checkbox_immagini%3Dtrue%26__checkbox_astampa%3Dtrue%26data_da%3D%26data_a%3D%26tipoRicerca%3DA%26language%3Dit&codice=&codiceDigital=" ;
        :last_mod_form         "2024-03-06T15:12:11.906Z"^^xsd:dateTime .

