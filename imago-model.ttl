<https://imagoarchive.it/ontology/resources/manuscript/siena/bibliotecacomunaledegliintronati/k_ii_11/1r159v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Flavii Blondi Italia illustrata / secolo XVI (codice mutilo)" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-670> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo, mm 340x240, ff. II, 161. A f. IV nota di possesso: \"Adì sette Gennajo 1764 fu regalato il presente manoscritto a questa Libreria dell'Università di Siena dall'ecc.mo sig. dott. Pio Malaspina nel soprascritto giorno\"; a f. IIr: \"Flavii Blondi Italia illustrata / secolo XVI (codice mutilo)\". Il codice, infatti, è stato donato il 7 gennaio 1764 alla Libreria dell'Università di Siena da Pio Malaspina (1724-1775), membro dell'Accademia dei Rozzi e priore della Contrada della Selva. Il testo dell'Italia illustrata manca della Praefatio e di una parte del Liber Primus. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-670> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q3639643> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 290-292 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-14T09:38:48.49Z"^^xsd:dateTime .

