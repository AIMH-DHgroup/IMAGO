<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/borg._lat._326/82v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1659> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 206 ff. e misura 240x155 mm. Il codice è formato da tre parti: i ff. 1-99 vergati nel XII secolo, i ff. 100-159 nel XIII-XIV, i ff. 106-206 nel XII-XIII secolo. Sono presenti numerose glosse marginali ai ff. 1-159. Il codice trasmette: Seneca, Epistulae ad Lucilium, ff. 1r-71r; Palladio, ff. 71r-77v; Alexandri Magni et Dindimi collatio, ff. 78r-82v; Epistola Alexandri ad Aristotelem, f. 82v; Macrobio, Saturnalia, ff. 83r-99v; Cicerone, Opera, ff. 100r-182v; Virgilio, Aeneis, f. 206v. Il manoscritto riporta solo un frammento dell'Epistola Alexandri ad Aristotelem. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1659> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Borg.lat.326/0001" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdata878b09d0fb20e213c57b61a6eb62c22921836415" ;
        :last_mod_form         "2024-04-05T06:31:48.649Z"^^xsd:dateTime .

