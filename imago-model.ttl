<https://imagoarchive.it/ontology/resources/manuscript/oxford/corpuschristicollegelibrary/21/1r167v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2206> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 179, 2 ff. e misura 378x262 mm. Al f. 356 si legge la nota di possesso: \"Istum librum Henricus Somer dedit Hospitali S. Johannis Evangeliste Cantebrigie cuius anime propicietur deus, e più sotto: Hic Henricus Somer fuit dominus manerii de Jakes in Grancestre et s(? trenu)us Inimicus Collegio Corporis Christi Cantabrigiae ratione decimarum in Grancestre ut in libris Collegii patet\". Il codice trasmette il Polychronicon di Ranulf Higden insieme a una continuazione fino al 1377 e fu copiato poco dopo quella data. Nel 1511 il manoscritto passò in possesso del St. John's College. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2206> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1135137> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Ogni libro ha una decorazione iniziale in oro e colori vari. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/polychronicon-ranulphus-higden-m-12-3-1364-ca--title/4071 </li><li><a href='https://imagoarchive.it/bibliografia.html#edwards-geography-and-illustration'>EDWARDS 1995</a>,  </li>" ;
        :has_url_manuscript    "https://parker.stanford.edu/parker/catalog/fn144fw3359" ;
        :has_url_manuscript_description
                "https://parker.stanford.edu/parker/catalog/fn144fw3359" ;
        :last_mod_form         "2024-04-15T14:49:53.235Z"^^xsd:dateTime .

