<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/add._34762/2r71v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1145> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto è formato da 172 ff. Esemplato in Inghilterra, probabilmente nella cattedrale di Norwich. La Topographia Hibernica segue la prima versione fino al cap. XII, poi riporta un testo affine alla seconda o terza versione. Presenta la prefazione dedicatoria, ma non la tabella dei capitoli o la lettera al vescovo di Hereford. Nell'ultima parte sono assenti le rubriche. Il codice trasmette inoltre l'Expugnatio Hibernica e l'Itinerarium Kambriae di Gerald of Wales. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1145> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/manuscript/london-british-library-add-34762-manuscript/166881 </li><li><a href='https://imagoarchive.it/bibliografia.html#sumithra-looking-east-and-west'>SUMITHRA (PhD thesis) 2009</a>, pp. 314-315. </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002087749&indx=2&recIds=IAMS040-002087749&recIdxs=1&elementId=1&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=add.%2034762&dum=true&dstmp=1676045511033" ;
        :last_mod_form         "2024-03-28T14:46:01.331Z"^^xsd:dateTime .

