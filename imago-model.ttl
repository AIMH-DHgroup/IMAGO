        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 173 ff. Composito, il codice è formato da dieci diverse unità codicologiche: il testo dei Mirabilia, insieme a quello dell'Epistola del Prete Gianni, fa parte dell'ottava unità, risalente alla metà del XIV secolo ed esemplata a Bologna." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1416> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Sono presenti tre iniziali dipinte e istoriate (ff. 141r, 143v, 150r). Iniziali filigranate blu e rosse." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, pp. 64-65. </li><li><a href='https://imagoarchive.it/bibliografia.html#wagner-die-epistola-presbiteri-johannis'>WAGNER 2000</a>, pp. 20-149. </li><li><a href='https://imagoarchive.it/bibliografia.html#brewer-prester-john'>BREWER 2015</a>, p. 306. </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b100353583" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc612508" ;
