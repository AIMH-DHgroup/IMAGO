<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._6041a/132v143v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1058> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 213 ff. e misura 305x195 ff. Esemplato in Francia, trasmette anche l'Historia Karoli Magni e Rotholandi dello Pseudo-Turpino, l'Historia de via Hierosolymis, l'Historia regum Britanniae di Goffredo di Monmouth, la Sibylla Tiburtina, la Flos historiarum terrae Orientis. Nella guardia cartacea una nota del 1931 avverte che i ff. 204-213 dovevano in origine collocarsi prima del f. 180 ed essere stati preceduti da 20 fogli ora perduti, come indica la foliazione antica. Il finale della Navigatio è seguito da un'annotazione di mano posteriore su s. Macuto e sui suoi rapporti con Brendano. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1058> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 84-85. </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b10721381f" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/paris-bibliothèque-nationale-de-france-lat-6041-a-manoscript/123372" ;
        :last_mod_form         "2024-02-02T17:33:35.347Z"^^xsd:dateTime .

