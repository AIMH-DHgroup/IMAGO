<https://imagoarchive.it/ontology/resources/print_edition/pe-15>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "De Canaria et de insulis reliquis ultra Hispaniam in Oceano" ] ;
        <http://erlangen-crm.org/211015/P2_has_type>
                <https://imagoarchive.it/ontology/resources/print_edition/edition/prima_edizione_/_editio_princeps> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "LINK AL TESTO: https://books.google.it/books?id=4t2wtkT7uY4C&printsec=frontcover&hl=it&source=gbs_ge_summary_r&cad=0#v=onepage&q&f=false" ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/de-canaria-et-insulis-reliquis-ultra-hispaniam-nov-title/13274> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-15> ;
        :compiled_form              "Rita Nicoli" ;
        :has_ecdotic_type           <https://imagoarchive.it/ontology/resources/print_edition/edition/edizione_commentata_con_traduzione> ;
        :has_figure_note            "" ;
        :has_introduction_note      "Dedica dell'autore a Sua Eccellenza il Marchese Gian Giacomo Trivulzio" ;
        :has_other_contents         "Contenuto nel libro dal titolo: Monumenti d'un manoscritto autografo di Messer Gio. Boccaccio da Certaldo trovati ed illustrati da Sebastiano Ciampi.\r\nLa materia trattata nel libro segue questo prospetto: \r\n1. Descrizione dello Zibaldone Autografo di Giovanni Boccaccio;\r\n2. Cronologia dI una parte della vita di Boccaccio dedotta dai documenti che in questo libro sono contenuti;\r\n3. Navigazione deI Fiorentini alla Canaria e ad altre isole Oceaniche l'anno 1541;\r\n4. Epistola Iohannis de Certaldo Zenobio de Strata;\r\n5. La stessa tradotta in volgare da Sebastiano Ciampi;\r\n6. Sonetto di Giovanni Boccaccio;\r\n7. Lettera di Francesco Petrarca a Giovanni Boccaccio tradotta di latino in volgare dal suddetto;\r\n8. Epistola magistri Zenobii de Florentia poetae;\r\n9. Parte d'un discorso latino di Zanobi da Strada;\r\n10.Titoli delle Sentenze di Seneca;\r\n11.Fac-simile del Carattere di mano di Giovanni Boccaccio." ;
        :has_primary_source         "manoscritto B.R.50, noto come Zibaldone Magliabechiano" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
