<https://imagoarchive.it/ontology/resources/manuscript/berlin/staatsbibliothekpreuischerkulturbesitz/lat._4°_466/36v62v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
