        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 71. </li><li><a href='https://imagoarchive.it/bibliografia.html#della-schiava-per-la-storia-della-basilica-vaticana-nel-500'>DELLA SCHIAVA 2007</a>,  </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Arch.Cap.S.Pietro.H.79" ;
