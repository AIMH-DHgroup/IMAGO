<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/121/1157>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber de narratione terre, acque, orbis et regionum et de omnibus in eis contentis" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1959> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 157, II ff. e misura 280x235 mm. Il testo è disposto su due colonne. Al f. 1r nota di mano del XV-XVI secolo \"Codex sancte crucis Lumpurgensis cenobii Spirensis dyocesis\" e al f. 158v, di mano del XV secolo: \"Nos Lymburg, vere virgo lucis, tuere, cuius nobis vere brachium gaudemus habere\". La nota è seguita da una poesia e da una regola dietetica del XIII secolo. Il manoscritto nell'852 si trovava a Worms, da dove passò all'abbazia benedettina di Heilige Kreuz a Limburg, nella diocesi di Spira e giunse nella biblioteca imperiale di Vienna nel 1576. Il codice trasmette soltanto i libro XII-XXII del testo di Rabano Mauro." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1959> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li>" ;
        :has_url_manuscript    "https://digital.onb.ac.at/RepViewer/viewer.faces?doc=DTL_8921648&order=1&view=SINGLE" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/wien-österreichische-nationalbibliothek-121-manoscript/3968" ;
        :last_mod_form         "2024-02-05T08:27:52.342Z"^^xsd:dateTime .

