                <http://www.mirabileweb.it/title/italia-illustrata-title/5381> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-175> ;
        :compiled_form              "Elena Vagnoni" ;
        :has_figure_note            "" ;
        :has_introduction_note      "" ;
        :has_other_contents         "Roma instaurata; \r\nDe origine et gestis Venetorum; \r\nRoma triumphans;\r\nDecades" ;
        :has_primary_source         "Ed. Venezia 1510" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 332-333 </li>" ;
