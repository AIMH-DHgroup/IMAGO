<https://imagoarchive.it/ontology/resources/manuscript/leiden/universiteitsbibliotheek/voss._lat._2°_31/1r213r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2199> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 284 ff. e misura 320x225 mm. Il testo è disposto su due colonne. Il codice è composto da sei parti, di cui le prime due derivano solo dal Liber Floridus. I ff. 1-120 sono quasi tutti tratti dal Liber; i ff. 121-123 sono altri brani tratti dal Liber con estratti che erano lasciati da parte nella prima sezione, sulla pagina bianca che chiude questa seconda parte restano alcune note di un verbale redatto per saldare il conto del miniatore. Le altre quattro sezioni sono frammenti messi insieme in modo del tutto arbitrario, tra cui una copia del Liber Tacuini, un riassunto della storia santa, una copia delle costituzioni di Gregorio X. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2199> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q638395> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il codice è riccamente decorato con immagini dell'Apocalisse. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/liber-floridus-lambertus-audomarensis-canonicus-fl-title/5759 </li><li><a href='https://imagoarchive.it/bibliografia.html#delisle-notice-sur-les-manuscrits-du-liber-floridus-de-lambert'>DELISLE 1906</a>, pp. 589-593. </li><li><a href='https://imagoarchive.it/bibliografia.html#woodward-the-illustrated-apocalypse-cycle'>WOODWARD (degree Master of Arts) 2010</a>, p. 53. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/leiden-bibliotheek-der-universiteit-voss-lat-2°-31-manoscript/7782" ;
        :last_mod_form         "2023-05-02T18:18:44.431Z"^^xsd:dateTime .

