<https://imagoarchive.it/ontology/resources/manuscript/madrid/bibliotecanacionaldeespaa/18246/3r63r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-877> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo e miscellaneo; ff. 71. Il manoscritto fu commissionato da Galeazzo Marescotti de’ Calvi, che incaricò il mantovano Girolamo de’ Preti, dottore in legge, della sua copiatura, come emerge dalla sottoscrizione a f. 69v: «Hunc librum feci exemplari ego Galeaz Marescottus de Calvis per Hieronimum de Pretis». Il codice appartenne poi al grammatico quattrocentesco Stefano Fieschi da Soncino, come testimoniato dalla nota a f. 1r «Hic liber est mei Stephani Flisci». Contiene inoltre: (f. 63v) GIROLAMO DE' PRETIS, epigramma a Galeazzo Marescotti de’ Calvi (Magnifico ac praestanti equestris ordinis viro insigni domino Galeaz Marescotto de Calvis Hieronymus de Pretis, inc.: «Ecce lubens, Galeaz, nuper tua vota peregi»); (ff. 63v-64v) PANORMITA, Epitaphium Nichine\r\nFlandrensis scorti (cfr. Hermaphroditus II 30), un carme dei Priapea, due dall’Ermafrodito; (ff. 65r-70v) MAFFEO VEGIO, Rusticalia (25 carmina)." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-877> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q750403> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Oltre alle mappe delle isole, il codice trasmette una carta nautica generale dell'Egeo." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ragone-g-liber-insularum'>RAGONE 2002</a>, pp. 182-183, n. 16; p. 196, n. 60 </li><li><a href='https://imagoarchive.it/bibliografia.html#roca-1904'>ROCA 1904</a>, p. 8, n. 10 </li><li><a href='https://imagoarchive.it/bibliografia.html#dominguez-bordona-1933'>DOMÌNGUEZ BORDONA 1933</a>, vol. I, p. 308, n. 706 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. IV, p. 575 </li><li><a href='https://imagoarchive.it/bibliografia.html#lopomo-2013'>MAFFEO VEGIO, Elegiae (tesi di dottorato) 2013</a>, pp. 36-37 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-04T12:00:33.304Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/laud_misc._529/1r122v>
