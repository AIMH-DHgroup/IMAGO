<https://imagoarchive.it/ontology/resources/manuscript/wien/sterreichischenationalbibliothek/795/187v191v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-72> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 205 ff. e misura 230x135 mm; f. 64 strappato in alto a destra. Il codice fu esemplato probabilmente poco prima dell'800 nell'abbazia benedettina di Saint-Amand, scritto per l'arcivescovo di Salisburgo Arno (785-821); rimase nella biblioteca del Duomo di Salisburgo fino al 1806 e da lì passò poi alla biblioteca di corte di Vienna. Trasmette inoltre: Alcuino, Epistolae, ff. 1v-4v, De orthographia, ff. 5r-18v; Commenti al Nuovo Testamento, ff. 21r-150v; Commento alla Bibbia, ff. 103r-147r; Alcuni, scritti esegetici, ff. 148v-150v, ed Epistolae, ff. 150v-183v; Notitia ecclesiarum urbis Romae, ff. 184r-187v; Alcuino, Epistolae, ff. 192r-199r; Versus ad Candidum, ff. 199r-199v; Carlo Magno, lettera ad Alcuino, ff. 200r-203v; Inno di S. Agostino, f. 204r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-72> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q304037> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali semplici, in parte colorate in rosso o circondate da puntini; titoli in onciale rossa o semionciale nera. Al f. 204r disegno di una figura umana. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-locis-sanctis-martyrum-quae-sunt-foris-civitati-title/172868 </li>" ;
        :has_url_manuscript    "https://onb.digital/result/1002EC92" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/wien-österreichische-nationalbibliothek-795-manoscript/3974" ;
        :last_mod_form         "2024-04-03T17:06:48.431Z"^^xsd:dateTime .

