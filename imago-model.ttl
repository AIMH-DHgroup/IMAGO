<https://imagoarchive.it/ontology/resources/manuscript/oxford/bodleianlibrary/rawlinson_b.188/73r97v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-723> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 98 ff. Il codice trasmette i testi di Gerald of Wales: la Topographia Hibernica nella terza versione, l'Expugnatio Hibernica, 37r-72v, e l'Itinerarium Kambriae, ff. 73r-97v. Nota di possesso del priorato benedettino della cattedrale di Canterbury al f. 1r: \"Liber fratris W. Bonyngton monachi ecclesie Christi Cantuar. et per eum reparatus anno Domini 1438\"." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-723> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Alla fine del manoscritto, f. 98r, è presente una mappa dell'Inghilterra con una breve descrizione della posizione dell'isola tratta dai testi di Beda e Isidoro. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/itinerarium-kambriae-title/4725 </li><li><a href='https://imagoarchive.it/bibliografia.html#borrego-sargent-visions-and-revisions'>BORREGO SARGENT (PhD thesis) 2009</a>,  </li>" ;
