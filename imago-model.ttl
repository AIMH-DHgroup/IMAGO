<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/cotton_titus_a._xxvii/206v216v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1700> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 219 ff. e misura 190x145 mm. Esemplato probabilmente a Canterbury, proviene dall'abbazia benedettina della città e fu poi acquistato da John Twyne, maestro di scuola e antiquario, e da Robert Bruce Cotton, la cui biblioteca, ampliata dal figlio e dal nipote, passò al British Museum nel 1753. Il codice è formato da tre parti, redatte alla fine del XII o all'inizio del XIII e unite insieme (ff. 2v-88r, 89r-174v, 176r-217v): trasmette una versione integrale del Quadripartitus, una raccolta latina di leggi, l'Historia regum Brittaniae di Goffredo di Monmouth, testi riguardanti Alessandro Magno e l'Epistola del Prete Gianni. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1700> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali in verde o rosso con decorazioni in entrambi i colori. Rubriche in rosso." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li><li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#wagner-die-epistola-presbiteri-johannis'>WAGNER 2000</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#brewer-prester-john'>BREWER 2015</a>, p. 304. </li>" ;
        :has_url_manuscript    "https://www.bl.uk/manuscripts/Viewer.aspx?ref=cotton_ms_titus_a_xxvii_fs001r" ;
        :has_url_manuscript_description
                "https://www.bl.uk/manuscripts/FullDisplay.aspx?ref=Cotton_MS_Titus_A_XXVII" ;
        :last_mod_form         "2023-03-20T18:46:31.688Z"^^xsd:dateTime .

