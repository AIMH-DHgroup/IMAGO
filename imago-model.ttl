<https://imagoarchive.it/ontology/resources/print_edition/pe-171>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Roma instaurata. De origine et gestis Venetorum. Italia illustrata." ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Nuova edizione dell'Italia illustrata allestita a Verona tra la fine del 1481 e l'inizio del 1482: dalla tipografia di Bonino de' Bonini fuoriuscirono due volumi, curati dall'intellettuale veronese Giovanni Antonio Panteo, contenenti, il primo, la Roma instaurata e il De origine et gestis Venetorum, mentre il secondo l'Italia illustrata. Per la prima volta approda alle stampe il testo vulgato dell'Italia illustrata, ossia quello della III fase redazionale dell'opera: \"dalla prefazione del Panteo all'edizione veronese apprendiamo che l'umanista fu incaricato dalla tipografia del de' Bonini di vagliare accuratamente la correttezza testuale di un manoscritto della Roma instaurata e dell'Italia illustrata procurato per l'edizione delle opere di Biondo, affinché dal testo di questo codice si potesse ricavare una stampa da immettere sul mercato in numerose copie [...]. L'edizione del Panteo, con le tre opere di Biondo, ebbe certamente parecchia fortuna, come dimostra la riedizione delle medesime tre opere che fu stampata il 28 febbraio 1503 per i tipi di Bernardino de' Vitali e l'immediata ristampa nella tipografia di Gregorio de' Gregori il 1° luglio 1510, due edizioni veneziane pubblicate sotto gli auspici del doge di Loredano Loredan. Le due cinquecentine veneziane, infatti, non solo riproducono la medesima scelta editoriale dell'incunabolo veronese, ma, per quanto riguarda l'Italia illustrata, riproducono esattamente il testo curato dal Panteo, condividendone la lezione anche laddove esso si presenta palesemente errato senza che traspaia un consistente intervento correttivo\" (BIONDO, Italia illustrata 2011, pp. 489-490). " ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/italia-illustrata-title/5381> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-171> ;
        :compiled_form              "Elena Vagnoni" ;
        :has_figure_note            "" ;
        :has_introduction_note      "" ;
        :has_other_contents         "Roma instaurata; De origine et gestis Venetorum" ;
        :has_primary_source         "" ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 326-328 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Biondo Flavio" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-171> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-171> ;
        :last_mod_form              "2024-02-25T23:20:35.584Z"^^xsd:dateTime .

