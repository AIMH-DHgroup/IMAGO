<https://imagoarchive.it/ontology/resources/manuscript/berlin/staatsbibliothekpreuischerkulturbesitz/lat._qu._618/105r118r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
