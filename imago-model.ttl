<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._13395/83r84v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-970> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 84, I' ff. e misura 211x162 mm. Il codice trasmette: Ambrogio, De officiis ministrorum, ff. 1r-74v; un estratto del Liber scintillarum, ff. 74v-75r; estratti dell'epistola 54 di Agostino, ff. 75r-76v; Pascadio Radberto, De corpore et sanguine Domini, ff. 77r-81v; papa Gregorio I, estratti dei Dialogi, ff. 81v-82v; estratto IV, 22 dell'Historia ecclesiastica gentis Anglorum di Beda, ff. 82v-83r; visione diabolica da Cassiodoro, Historia Ecclesiastica tripartita, XII, 9, f. 84v; testo intitolato \"Quos requirendi sint spiritus qui sint et exemplum de beato Nicolao Mirensi episcopo\", f. 84v. Il codice, di diverse mani, introduce un estratto dal capitolo XXV della Navigatio. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-970> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 102-103. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/188173" ;
        :last_mod_form         "2024-01-29T17:55:29.254Z"^^xsd:dateTime .

