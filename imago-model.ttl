<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/royal_14_c_xiii_/14r165v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2260> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "ll manoscritto membranaceo consta di 310 ff. e misura 371x222 mm. Fu vergato in Inghilterra e riporta note di possesso di Simon Bozoun (f. 13v \"Liber fratris Symonis Bozoun\", f. 14r \"Liber fratris Symonis Bozoun prioris Norwiciensis)\" e la segnatura di John Lumley al f. 3r. Il contenuto del codice è storico-geografico: il manoscritto riporta infatti il Polychronicon di Ranulf Higden, ff. 3r-165v, l'Historia Hierosolymitana abbreviata di Jacques de Vitry, ff. 195r-215r; la Relatio de mirabilibus orientalium Tatarorum di Odorico da Pordenone ff. 216r-224v, l'Itinerarium di Guglielmo di Rubruck, ff. 225r-236r, Francesco Pipino, Liber Marci Pauli de Veneciis de consuetudinibus et condicionibus orientalium regionum, ff. 236r-269r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2260> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/polychronicon-ranulphus-higden-m-12-3-1364-ca--title/4071 </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li><li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 704-717. </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-per-un-riordino'>CHIESA 1999-2000</a>, pp. 141-142. </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, pp. 25-26. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/display.do?tabs=detailsTab&ct=display&fn=search&doc=IAMS040-002106994&indx=1&recIds=IAMS040-002106994&recIdxs=0&elementId=0&renderMode=poppedOut&displayMode=full&frbrVersion=&frbg=&&dscnt=0&scp.scps=scope%3A%28BL%29&mode=Basic&vid=IAMS_VU2&srt=rank&tab=local&vl(freeText0)=royal%2014%20C%20XIII&dum=true&dstmp=1685362072512" ;
        :last_mod_form         "2024-04-15T17:17:25.843Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/wrocaw/bibliotekauniwersytecka/iv_f._103/1r67r>
        rdf:type               :Manuscript ;
