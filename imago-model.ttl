<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._16879/1r272v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1952> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 272 ff. e misura 480x290 mm. Il testo è disposto su due colonne. Nel margine superiore destro del f. 1r una mano recente, a matita, ha indicato \"Bouth. 10\", indicazione dell'appartenenza del codice al presidente Jean Bouhier (m. 1746), la cui raccolta, entrata nell'abbazia di Clairvaux, era stata poi trasferita alla biblioteca di Troyes per arrivare alla Biblioteca Nazionale nel 1804. Il testo di Rabano Mauro si interrompe al capitolo 14 del libro XXII per la caduta di un foglio." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1952> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Grandi iniziali dipinte decorate all'inizio del codice; iniziali dipinte ornate all'inizio di ogni capitolo in tre colori alternati, blu, rosso e verde; rare iniziali dipinte decorate per segnare le divisioni all'interno dei capitoli. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#kottje-ziegler-verzeichnis-der-handschriften'>KOTTJE-ZIEGLER 2012</a>, pp. 163-164, n. 929. </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b10506225x" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc68224k" ;
        :last_mod_form         "2024-02-02T15:06:30.037Z"^^xsd:dateTime .

