<https://imagoarchive.it/ontology/resources/manuscript/oxford/corpuschristicollegelibrary/157/72r77r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-775> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto, membranaceo, è composto da 202 ff. e misura circa 330 x 250 mm. Parzialmente autografo, è stato in larga parte vergato da Giovanni di Worcester (m. 1140), di cui trasmette la Chronica chronicarum. Il codice proviene dalla cattedrale di Worcester ed è stato donato al Corpus College di Oxford da Henry Parry, vescovo di Worcester, nel 1618. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-775> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1135137> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Cinque grandi miniature di due differenti artisti: Crocifissione, Croce, diagramma circolare in rosso e oro per rappresentare le macchie solari nel 1128 e due immagini che rappresentano le visioni di Enrico I e la tempesta in cui il re rischiò di morire. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#httpswwwbedadlsgwiuni-muenchendeabout'>BEDA VENERABILIS, De locis sanctis </a>,  </li>" ;
        :has_url_manuscript    "https://digital.bodleian.ox.ac.uk/objects/93b83416-7972-40d7-9789-18f54e17ae25/" ;
        :has_url_manuscript_description
                "https://iiif.biblissima.fr/collections/manifest/00389e3dae25d8f731d9b48c4fe18742eb8f7fab" ;
        :last_mod_form         "2024-02-14T09:30:28.604Z"^^xsd:dateTime .

