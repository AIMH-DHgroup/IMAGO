<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/15009/144r160v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1991> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 259 ff., preceduti da tre guardie di carta e due guardie di pergamena e seguite da tre guardie di carta. Le dimensioni sono 240x170 mm. Il codice apparteneva alla biblioteca dell'abbazia di Saint-Victor a Parigi. In inchiostro nero sulla copertina si legge: \"Iste liber est sancti Victoris Parisiensis. Quicumque eum furatus fuerit vel celaverit vel titulum istum deleverit, anathema sit\". La stessa nota si legge anche sul retro del foglio, poi in scrittura libresca in fondo al f. 1r, seguita da un vecchio numero \"B\". Sul f. 1v si legge: \"Jhesus, Maria, sanctus Victor, sanctus Augustinus\", accompagnato dallo stemma dell'abbazia. Il manoscritto trasmette inoltre: Ugo di San Vittore, Chronicon, ff. 1r-42r; Chronica et excerpta, ff. 42r-143r; Nennio, Historia Brittonum, ff. 160v-186v; Bernardo Silvestre, Cosmographia, ff. 178r-204v; Pietro Alfonsi, Cosmographia, ff. 205r-255r; Catalogo dei re di Francia, ff. 255v-256v; Note storiche, f. 257r. Il codice riporta i libri I-III dell'Imago mundi. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1991> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li>" ;
        :has_url_manuscript    "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc75726m" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc75726m" ;
        :last_mod_form         "2024-04-01T15:24:50.979Z"^^xsd:dateTime .

