<https://imagoarchive.it/ontology/resources/manuscript/mariasaal/stiftsbibliothek/15/134r155r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-163> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 200 ff. e misura 205x150 mm. Il codice riporta la Descriptio di Bucardo da Monte Sion nella redazione lunga e trasmette inoltre: Computus ecclesiasticus, ff. 1r-20v; Algorismus, ff. 21r-24r; Extractio radicum, f. 24v; Alessandro di Villedieu, Compotus, ff. 25r-40v; Computus cirometralis, ff. 42r-63v; Calendarium, ff. 66r-71v; Versus memorabiles, f. 72r; Computus Nurengergensis, ff. 74r-84v; Giovanni di Sacrobosco, Tractatus de sphaera, ff. 85r-104v; Corrado da Monte puellarum, Tractatus de mortalitate in Alamania, ff. 106r-115r; Figura mundi, ff. 116v-133v; Iohannicius, De regimine sanitatis, ff. 156v-183v; John of Erfurt, De complexionibus, ff. 184r-186v; Complexiones, ff. 187r-200v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-163> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <https://imagoarchive.it/resource/maria-saal-stiftsbibliothek> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manuscripta.at/diglit/menhardt_1927/0291?sid=a3049d176021e1598e8b802f7012e8fd" ;
        :last_mod_form         "2024-03-26T08:08:23.533Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/pal._lat._291/1r274v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Rabanus De universo cum figuris depictus" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1912> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 274 ff. e misura 350x265 mm. Esemplato in Germania meridionale, il testo è disposto su due colonne di 37-39 righe in scrittura gotica. Il De rerum naturis è privo delle lettere dedicatorie.  Al f. 263r nota: \"Explicit liber Rabani viri doctissimi anno Domino millesimo CCCCXXV, VIIII die mensis Novembris, scilicet quinta feria ante festum Martini episcopi\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1912> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il manoscritto presenta 337 miniature che di solito accompagnano ogni capitolo, realizzate da almeno dieci mani diverse. Al f.1r immagine di Ludovico VIII, principe del Palatinato, presentato alla Vergine col Bambino da S. Giorgio. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#kottje-ziegler-verzeichnis-der-handschriften'>KOTTJE-ZIEGLER 2012</a>, p. 201, n. 1149. </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li>" ;
        :has_url_manuscript    "https://digi.ub.uni-heidelberg.de/diglit/bav_pal_lat_291/0551/image,info,thumbs" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdata78ddaed745b9563cb8231b06dc9e8cd23ecabe20" ;
        :last_mod_form         "2024-02-05T08:19:43.309Z"^^xsd:dateTime .

