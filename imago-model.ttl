<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._8834/1r110r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Ptolomei Alexandrini viri clarissimi geographiae libri VIII continentur in hoc ornatissimo volumine" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1876> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 110 ff. e misura 600x455 mm. Il codice è esemplato a Firenze per Mattia Corvino, re d'Ungheria. Esemplato da tre diverse mani, quelle di Hugues Commineau de Mézières, ff. 2-5, 8-61, Niccolò Mangona, ff. 5-6, e Pietro Strozzi, ff. 64-110. Il codice fu probabilmente portato a Costantinopoli dopo che i turchi entrarono a Buda nel 1526 ed entrò nella Biblioteca Nazionale nel 1794. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1876> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 1r ricco frontespizio decorato da Francesco Rosselli nel quale si legge a lettere dorate su fondo blu \"Ptolemaei Alexandrini viri clarissimi Geographiae libri VIII continentur in hoc ornatissimo volumine\". Il resto della decorazione è di Attavante, allievo di Francesco Antonio del Chierico: al f. 2 cornice costituita da motivi vegetali e floreali stilizzati valorizzati da nodi intrecciati, pietre preziose, perle, uccelli e animali, accompagnati da medaglioni, alcuni sostenuti da putti, imitando cammei o monete antiche, rappresentazioni di antichi geografi e ritratti di busti da giovani e anziani. Sono presenti altre cornici con motivi vegetali e floreali dipinti e dorati accompagnati da vasi, uccelli, animali e putti, le braccia incomplete di Mattia Corvino. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, p. 126. </li>" ;
        :has_url_manuscript    "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc62367g" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc62367g" ;
        :last_mod_form         "2024-02-06T08:33:37.749Z"^^xsd:dateTime .

