<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquemazarine/v.b.9/141v231r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-613> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 237 ff. Il codice trasmette alcuni estratti del testo di Bartolomeo Anglico relativi alle stelle, animali, piante, minerali e parti del corpo. Il manoscritto trasmette inoltre: Pietro Lombardo, Sententiae, ff. 1r-72r, Palladii liber de re rustica per Gotfridum abbreviatus, ff. 103r-112v; Onorio di Autun, Imago mundi, ff. 112v-137v.  " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-613> ;
