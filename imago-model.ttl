        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 88-89. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/padova-biblioteca-universitaria-1622-manoscript/13738" ;
        :last_mod_form         "2024-01-30T18:03:27.304Z"^^xsd:dateTime .

