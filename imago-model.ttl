<https://imagoarchive.it/ontology/resources/manuscript/venezia/bibliotecanazionalemarciana/lat._x,_215_(3773)/1r52r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi [Liber insularum maris Aegaei]" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-868> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo, monografico e mutilo del primo foglio; mm 203×143; ff. 56; bianchi i ff. 52v-56v; numerazione in cifre arabe sul mg. sup. destro, da 1 a 56 (con 37bis al posto di 38). Scrittura umanistica posata di un’unica mano. Legatura antica. Sul contropiatto anteriore è incollata, al centro, l’etichetta con lo stemma leonino della Marciana; in alto, a matita, è appuntata la precedente segnatura \"XCVII.6\" ripetuta due volte; sul mg. inf. sinistro è incollata l’etichetta che riferisce la segnatura, la collocazione attuale del codice e la sua provenienza \"Morelli Giacomo 165\"." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-868> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q578460> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Il codice trasmette mappe di scarsa fattura, tutte colorate in verde, marroncino, azzurro e rosso, con didascalie." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ragone-g-liber-insularum'>RAGONE 2002</a>, p. 188, n. 33; p. 189 n. 35; p. 190 n. 37; p. 196 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. II, p. 232 </li>" ;
        :has_url_manuscript    "https://www.internetculturale.it/jmms/iccuviewer/iccu.jsp?id=oai%3A193.206.197.121%3A18%3AVE0049%3ACSTOR.244.13019" ;
        :has_url_manuscript_description
                "https://www.internetculturale.it/it/16/search/detail?id=oai%3A193.206.197.121%3A18%3AVE0049%3ACSTOR.244.13019" ;
        :last_mod_form         "2024-03-02T16:45:04.033Z"^^xsd:dateTime .

