                <http://www.wikidata.org/entity/Q3298462> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali filigranate. Disegni a inchiostro ai margini con motivi zoomorfi e vegetali. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 78-79. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.calames.abes.fr/pub/#details?id=FileId-61" ;
