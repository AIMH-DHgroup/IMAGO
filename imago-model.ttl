<https://imagoarchive.it/ontology/resources/manuscript/krakw/bibliotekajagielloska/431/61v116r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1249> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo consta di 244 + 1 ff., con il testo disposto su due colonne, e misura 290x205 mm. Vergato in Polonia, in scrittura minuscola corsiva gotica, non presenta marginalia. Al f. 210r presenta questa annotazione: \"Explicit liber per manus cuiusdam pauperis pro quo Deus sit gloriosus trinus in personis et unus in essencia per infinita secula seculorum. Amen. Et est finitus feria sexta in die sanctorum Fabiani et Sebastiani sub anno Domini millessimo CCC quadragesimo primo\", e questo ha permesso di datare il manoscritto al 20 Gennario 1441. \r\nTrasmette: Jacques de Vitry, Historia Hierosolymitana abbreviata, ff. 2r-60r; Epistola Iohannis presbyteri, regis Indiae, ff. 116r-119r; Vita Adae et Evae, ff. 119v-121v;  Heinrich von Friemar, De decem praeceptis, ff. 138v-178r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1249> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q24101> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Presenta iniziali rosse e blu." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 647-654. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/author/franciscus-pipinus-n-1270-ca-m-1327-1328-author/20207 </li><li><a href='https://imagoarchive.it/bibliografia.html#wagner-die-epistola-presbiteri-johannis'>WAGNER 2000</a>, pp. 20-149. </li><li><a href='https://imagoarchive.it/bibliografia.html#brewer-prester-john'>BREWER 2015</a>, p. 303. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/kraków-biblioteka-jagiellonska-431-manoscript/127520" ;
        :last_mod_form         "2024-02-02T12:44:03.425Z"^^xsd:dateTime .

