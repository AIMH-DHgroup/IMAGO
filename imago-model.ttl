<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/royal_12.g.xiv/1282>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1929> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 282 ff. e misura 420x285 mm. Il codice proviene dall'abbazia benedettina di St. Albans come si legge al f. 6r: \"Hic est liber sancti Albani, quem qui ei abstulerit aut titulum deleverit anathema sit. Amen\". Al f. 1r monogramma \"TC\", forse per Thomas Wolsey (1470/1471-1530), ministro reale, arcivescovo di York e cardinale. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1929> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Al f. 6r grande iniziale abitata da figure umane e animali, a colori e oro, all'inizio del testo. Iniziali decorate con ornamento foliato arabesco in blu, rosso e verde, più grandi all'inizio dei libri e più piccole all'inizio dei capitoli. Piccole iniziali in rosso, blu o verde in tutto il testo. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#kottje-ziegler-verzeichnis-der-handschriften'>KOTTJE-ZIEGLER 2012</a>, p. 92, n. 514 </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://searcharchives.bl.uk/primo_library/libweb/action/dlDisplay.do?vid=IAMS_VU2&search_scope=default_scope&docId=IAMS040-002106812&fn=permalink" ;
