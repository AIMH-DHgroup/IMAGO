<https://imagoarchive.it/ontology/resources/manuscript/basel/universittsbibliothek/a_i_28/187r195r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
