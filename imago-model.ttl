<https://imagoarchive.it/ontology/resources/manuscript/mnchen/bayerischestaatsbibliothek/clm_249/190v195r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1183> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è composto da 224 ff. Fu scritto da tre diverse mani in Germania durante il XIV secolo, due delle quali erano di Valentino Eber e Hermann Schedel (1410-1485), che fu possessore del manoscritto. Trasmette: Giovanni Boccaccio, De casibus virorum illustrium, ff. 1r-114v; Francesco Petrarca, Invective contra medicum, ff. 118r-141r; Prologus in tractatum de Iudiciis virtutum et viciorum, ff. 142r-152v; Francesco Pipino, Liber Marci Pauli de Veneciis de consuetudinibus et condicionibus orientalium regionum, ff. 153r-190v; Mirabilia urbis Romae, ff. 195r-198r; Francesco Petrarca, Responsiva exhortativa ad inceptae vitae perseverantiam, ff. 200r-202v; Dyalogus pulcer, ff. 203r-205v, Gasparino Barzizza, Oratio, ff. 215r-216v; Probae Falconiae cento Virgilianus de fabrica mundi, ff. 217r-224v." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1183> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q256507> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Sono presenti iniziali in rosso e blu. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 732-747 </li><li><a href='https://imagoarchive.it/bibliografia.html#puliero-il-volgarizzamento-veneziano'>PULIERO 2018</a>, p. 56 </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/tractatus-de-locis-terrae-sanctae-anno-1320-visita-title/120692 </li><li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 52. </li>" ;
        :has_url_manuscript    "https://www.digitale-sammlungen.de/de/view/bsb00120614?page=,1" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/münchen-bayerische-staatsbibliothek-clm-249-manoscript/6241" ;
        :last_mod_form         "2024-03-07T16:11:17.58Z"^^xsd:dateTime .

