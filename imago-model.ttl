<https://imagoarchive.it/ontology/resources/manuscript/besanon/bibliothquemunicipale/671/120v126r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-917> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 159 ff. e misura 224x179 mm. Il codice trasmette la seconda redazione del testo di Fretello e riporta inoltre: Eusebio di Cesarea, Historia ecclesiastica, ff. 1r-106v; Liber provicialis (interrotto), ff. 108r-118v; versi De mensuris vulgaribus, f. 126v; ripresa e fine del Liber provincialis, ff. 127r-127v; De dignitatibus supremiis, ff. 128v-157v. Il testo è organizzato su due colonne. Il manoscritto mostra interventi di correzione da parte del primo copista, che ai ff. 120v, 121r, 121v, 122v e 125v reintegra parti di testo saltate durante la copiatura. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-917> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q2901451> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#greco-2021-2022'>GRECO (tesi di dottorato) 2022</a>, pp. 57-58. </li><li><a href='https://imagoarchive.it/bibliografia.html#p-trovato-new-perspectives'>TROVATO-KEDAR 2018</a>, p. 12. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://ccfr.bnf.fr/portailccfr/jsp/index_view_direct_anonymous.jsp?record=eadcgm:EADC:D35B10611" ;
        :last_mod_form         "2024-02-05T11:43:32.024Z"^^xsd:dateTime .

