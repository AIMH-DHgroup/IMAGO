<https://imagoarchive.it/ontology/resources/manuscript/toledo/archivoybibliotecacapitulares/25_50/1r58r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1486> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da II, 58, XXXIV ff. e misura 185x127 mm. Al f. 1r si legge una nota di possesso di \"F. Nerlius\", che rimanda forse al cardinale Francesco Nerli (1636-1708), canonico della basilica di San Pietro dal 1661 e arciprete dal 1704. Esemplato a Roma, il manoscritto riporta al f. II \"Mense aprili 1665 transcriptum bp. ex libro manuscripto in archivo basilicae vaticanae existente\", che permette di riconoscere l'antigrafo in Vaticano, Arch. Cap. S. Pietro G 12, da cui viene desunta anche la notizia biografica sul Vegio di f. II: \"Floruit sub Eugenio IV, qui Eugenius obiit circa annum domini 1447\". " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1486> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q85692455> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rebus-antiquis-memorabilibus-basilicae-sancti-p-title/9870 </li><li><a href='https://imagoarchive.it/bibliografia.html#della-schiava-il-de-rebus-antiquis-memorabilibus'>DELLA SCHIAVA 2011</a>, pp. 179-180. </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, IV, p. 641. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/toledo-archivo-y-biblioteca-capitulares-(olim-bibl-manoscript/182476" ;
        :last_mod_form         "2024-01-29T13:10:37.277Z"^^xsd:dateTime .

