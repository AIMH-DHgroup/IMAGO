        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 38. </li>" ;
        :has_url_manuscript    "https://unipub.uni-graz.at/urn:nbn:at:at-ubg:2-26935" ;
        :has_url_manuscript_description
                "https://manuscripta.at/hs_detail.php?ID=23418" ;
