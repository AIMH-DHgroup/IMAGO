<https://imagoarchive.it/ontology/resources/manuscript/mnchen/bayerischestaatsbibliothek/clm_3703/53v56r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1935> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 80 ff. e misura 175x125 mm. Il codice trasmette soltanto alcuni estratti del libro IV del testo di Rabano Mauro e riporta inoltre: Meditationes de divinis, ff. 1r-8v; Innocenzo III, Sermo I in nativitate Domini, f. 8v; Florilegium, f. 9r; Regolae, ff. 9v-11r; Sermones et meditationes, ff. 11r-16r; Versi, f. 16r; Citazioni dalla Bibbia e dai Padri della Chiesa, f. 16v; Iohannes de Castello, Sermones de tempore, ff. 17r-23r; Sermones et dispositiones, ff. 23v-25r; Glossarium biblicum, ff. 25v-30r; Alano di Lilla, Elucidatio in Canticum canticorum, ff. 31r-34r; Graeculus, Sermo de beato Blasio, ff. 33v-36r; Note sulla Vergine Maria, ff. 34v-35r; Flores ascetici-morales, ff. 35r-39v; Philuppus Cancellarius, Sermo, ff. 40r-41r; Dicta patrum et notae, ff. 41r-42v; Pietro Comestore, Historia scholastica, ff. 43r-44v; Sermones et meditationes, ff. 45r-52v; Giuliano di Toledo, Prognosticum, ff. 56r-59v; Germanus Parisiensis, Expositio brevis antiquae liturgiae Gallicanae, f. 59v; Interrogationes et responsiones, ff. 60r-80r; Hymnus in honorem s. Katherinae, f. 80v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1935> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q256507> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.manuscripta-mediaevalia.de/dokumente/html/obj31795374" ;
        :last_mod_form         "2024-01-26T10:43:23.728Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/milano/bibliotecanazionalebraidense/ad.ix.43/210r248r>
