<https://imagoarchive.it/ontology/resources/manuscript/lucca/bibliotecacapitolarefeliniana/545/81r92r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1340> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da II, 399, II' ff., con numerazione visibile a partire dal nr. 22, a causa della perdita di materiale dei primi fascicoli. Il manoscritto è composito: i ff. 1-20 e 351-410 costituivano un'unità indipendente, numerata autonomamente, mentre i ff. 21-350 furono inseriti successivamente. Il codice appartenne a Felino Sandeo, che numera complessivamente i fogli. La prima unità, vergata da una sola mano in scrittura bastarda, trasmette Bolle, atti e documenti; la seconda unità, vergata in scrittura corsiva molto regolare, presenta testi dedicati alle competenze morali e territoriali della Sede pontificia. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1340> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q86537159> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/mirabilia-urbis-romae-title/172558 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/lucca-biblioteca-capitolare-feliniana-545-manoscript/224933" ;
        :last_mod_form         "2024-04-05T18:02:49.125Z"^^xsd:dateTime .

