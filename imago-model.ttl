<https://imagoarchive.it/ontology/resources/manuscript/roma/bibliotecanazionalecentralevittorioemanueleii/ms._2044_(sess._290)/7r31v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "De basilica Lateranensi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1623> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da II, 58, II ff. e misura 206x140 mm. Il codice è composto da sette fascicoli, I-VI quaternioni, VII binione. Esemplato da mani diverse, tra il XV e il XVI secolo, la legatura è del 1973 in assi di cartone e coperta in pergamena. Il codice contiene tre testi aventi come oggetto la basilica di San Giovanni in Laterano: la Descriptio Lateranensis ecclesiae, in una ulteriore diversa redazione, una raccolta di iscrizioni della basilica, ff. 32r-33r, e una liturgia da seguire in occasione dell'apertura della Porta Santa, ff. 34r-36r. Sono presenti aggiunte e correzioni ai margini. Al f. 1r si legge la nota di possesso: \"Maximiniani Agathonii liber\" in una scrittura risalente al XVII secolo. All'interno del piatto anteriore è incollato un frammento cartaceo contenente l'annotazione a penna: \"Dalla c. 61. di questo codice è stato tagliato un frammento dell'angolo inferiore esterno per mandarlo a Vienna al Prof. Sickel. 18 Marzo 1887. Vedi posizione 3D\", posto quando il manoscritto era già in Biblioteca nazionale, con l'indicazione \"posizione 3D\" che si riferisce all'archivio della Sala Manoscritti.  Al f. 1r compare il timbro a inchiostro della biblioteca di S. Croce in Gerusalemme con la dicitura: \"Abb. S. Crucis in Jerusalem. Ord. Cist.\". Il manoscritto è pervenuto alla Biblioteca nazionale nel 1885, in seguito alla legge sulla soppressione degli ordini religiosi del 1873. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1623> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q6382871> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#vogel-la-descriptio-ecclesiae-lateranensis-du-diacre-jean'>VOGEL 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#oftestad-the-lateran-church'>OFTESTAD 2019</a>, pp. 193-203. </li><li><a href='https://imagoarchive.it/bibliografia.html#codice-topografico-della-citta-di-roma'>VALENTINI-ZUCCHETTI 1940-1953</a>, III, pp. 319-325. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/cnmd/0000067062" ;
        :last_mod_form         "2024-04-04T08:33:56.504Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manuscript/elescorial/realbibliotecadelmonasteriodesanlorenzodeelescorial/f._ii_17/832>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-832> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "" ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-832> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q3848863> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Il codice attesta un notevole ampliamento del corredo iconografico del \"Liber\" dal numero 'standard' prevalente di 79 mappe a 150 carte geografiche, a testimonianza della sua evoluzione in atlante universale (es. di aggiunte: Sicilia, Sardegna, Corsica, Malta, isole dell'Adriatico e del Tirreno, Danimarca, Baleari, Ceylon ecc.)." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ragone-g-liber-insularum'>RAGONE 2002</a>, p. 197 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-02-09T17:33:06.986Z"^^xsd:dateTime .

