        :has_url_manuscript_description
                "https://www.corpus.cam.ac.uk/sites/default/files/downloads/m.r._james_cccc_catalogue_1912_vol._ii.pdf" ;
        :last_mod_form         "2024-02-13T14:52:39.114Z"^^xsd:dateTime .

