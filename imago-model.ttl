<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/ott._lat._1630/1r154v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
