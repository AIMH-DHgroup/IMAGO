<https://imagoarchive.it/ontology/resources/manuscript/oxford/newcollegelibrary/152/10r165v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Polychronicon Ranulphi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2300> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da I, 165, II ff. e misura 377x250 mm. Il testo è disposto su due colonne di 51 righe con uno spazio interlineare di 13 mm, rigate a matita. Le annotazioni sono confinate ai libri IV e V, dimostrando che l'interesse principale era riservato alla storia romana e britannica, di mani del XVI-XVII secolo. La rilegatura è di vitello rovesciato su cartoncino. Al f. 1v risguardo vuoto, a eccezione di alcune righe che danno informazioni su Ranulf Higden. Il testo del Polychronicon arriva fino al 1376. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2300> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1376987> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali foliate, intrecciate in rosa e blu con riempimento in oro. Al f. 165v in basso è disegnato nell'angolo sinistro una figura notarile con la scritta in basso \"Grace ys best\", simbolo del proprietario, William North, notaio, e un'iscrizione accanto \"Liber magistri Willelmi North\", che donò poi il codice alla biblioteca. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.new.ox.ac.uk/sites/default/files/inline-files/Ms152.pdf" ;
        :last_mod_form         "2024-04-16T06:51:19.388Z"^^xsd:dateTime .

