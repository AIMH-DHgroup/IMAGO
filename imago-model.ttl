<https://imagoarchive.it/ontology/resources/manuscript/montpellier/sectiondemdecine/section_de_médecine_h_39/1r15v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-897> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 111 ff. e misura 342x252 mm. Il testo è disposto su due colonne di 31-32 righe. Il codice, proveniente dall’abbazia di Pontigny in Borgogna, contiene testi accomunati dal tema del pellegrinaggio: Oddone di Deuil, De profectione Ludovici VII in Orientem libelli VII, ff. 15v-41r; estratti dal Liber sancti Iacobi, ff. 42r-101v; versi, ff. 101v-102r; Pseudo-Innocenzo, Epistola, f. 102v; Epistola a Girolamo, ff. 102v-103r; Vita Amici et Amelii, ff. 103r-111v. L'opera di Fretello è riportata nella prima redazione del testo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-897> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q3298462> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali con filigrana rossa e blu. Titoli in rosso. Disegni a inchiostro al f. 41v. Alcuni elementi decorativi del manoscritto possono essere visionati al link: https://bvmm.irht.cnrs.fr//consult/consult.php?reproductionId=7935" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, https://www.mirabileweb.it/author/rorgo-fretellus-fl-saec-xii-author/21454 </li><li><a href='https://imagoarchive.it/bibliografia.html#boeren-rorgo-fretellus-de-nazareth'>RORGO FRETELLO, Descriptio 1980</a>, p. 2. </li><li><a href='https://imagoarchive.it/bibliografia.html#trovato-sulla-genealogia-e-la-cronologia'>TROVATO 2012</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#yolles-latin-literature-and-frankish-culture'>YOLLES (PhD thesis) 2015</a>, pp. 134-135. </li><li><a href='https://imagoarchive.it/bibliografia.html#greco-2021-2022'>GRECO (tesi di dottorato) 2022</a>, pp. 40-42. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.calames.abes.fr/pub/#details?id=D01040518" ;
        :last_mod_form         "2024-02-05T11:13:39.242Z"^^xsd:dateTime .

