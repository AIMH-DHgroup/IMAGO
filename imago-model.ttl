<https://imagoarchive.it/ontology/resources/manuscript/york/minsterlibrary/xvi.g.23/121r122v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1087> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da V, 187, V' ff. e misura 466x335 mm con il testo disposto su due colonne. Esemplato in Inghilterra, forse nel 1454, trasmette Legendae de sanctis. Il codice è di grande formato, in una fitta gotica. Sono presenti 154 Vitae di santi, precedute, ai ff. 108r-108v, dalla lista dei santi. Il copista si sottoscrive H' al f. 107r e Herri al f. 192v, dove è annotato anche l'anno 1454 che potrebbe essere la datazione del codice. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1087> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q120869294> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Capilettera filigranati e iniziali interne tracciate con gli stessi colori azzurro e rosso. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, p. 132. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/york-minster-library-xvi-g-23-manoscript/133733" ;
