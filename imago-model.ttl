<https://imagoarchive.it/ontology/resources/toponym/valenciennes>
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Valenciennes" .

<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/reginense_latino_729/1r161r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-673> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo, mm 330x229, ff. III, 161, III'. Testo a piena pagina, inchiostro di colore nero. Mano umanistica. Il codice tramanda il testo della IV fase redazionale dell'Italia illustrata. Il testo dell'Italia illustrata si ferma alla regio tertiadecima, la Campania (manca la regio Apulia). Il testo della Lombardia è acefalo, trascritto in continuità con il testo della precedente regione, la Romandiola, il cui testo risulta mutilo (ff. 82v-83r). Il codice appartenne forse al senese Federico Ubaldini (161-1657), segretario a Roma del Sacro Collegio, erudito, bibliofilo e commentatore di Dante ed editore delle Rime di Petrarca. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-673> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "Titoli per regioni e per alcuni libri in capitali rosse. A f. 1r capitale C in foglia d'oro e fregio a bianchi girari su sfondo rosa, verde, blu e oro, esteso su tre lati (mg. sup., sin. e inf.), in basso lo stemma, contornato da una ghirlanda d'alloro, non più visibile perché parzialmente ricoperto in oro, e affiancato dalle lettere V e F in foglia d'oro su riquadri di colore azzurro. Iniziali decorate in foglia d'oro su sfondo rosa, verde e blu, girari per ciascuna regione (ff. 1v, 8v, 24v, 43v, 53r, 61v, 96v, 103v, 115v, 118r, 121r, 141v), a eccezione della Lombardia. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 296-298 </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Reg.lat.729" ;
        :has_url_manuscript_description
                "https://mirabileweb.it/manuscript/citt%C3%A0-del-vaticano-biblioteca-apostolica-vaticana--manuscript/168191" ;
        :last_mod_form         "2024-03-14T09:39:17.502Z"^^xsd:dateTime .

