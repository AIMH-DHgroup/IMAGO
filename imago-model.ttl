<https://imagoarchive.it/ontology/resources/manuscript/basel/universittsbibliothek/d.iii.2/3r138v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-599> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 263 ff. e misura 285x200 mm. Il testo mantiene la disposizione originale, ad eccezione del libro XIX che è diviso in due parti. Il codice proviene dal convento dei domenicani di Basilea, f. 140r: \"Finitus est liber iste anno Domini millesimo CCCCXX die XII mensis Ianuarii Deo gratias\". Il manoscritto trasmette inoltre: De medicinis, ff. 139r-140r; Iohannes de Tornamira, Praeservatio et cura apostematum autrosorum pestilentialium, ff. 140r-143r; Remedia diversa, f. 143v; De actu curativo, ff. 143v-145v; Libellus de virtute cibariorum usitatorum, ff. 147r-154v; Pseudo Alberto Magno, Liber naturalium, ff. 155r-176r; Arnaldo da Villanova, De conservanda iuventute et retardanda senectute, ff. 177r-185v; Regimen sanitatis, ff. 186r-193v; Consilium super passionibus cutis, ff. 194r; Regimen sanitatis, ff. 195r-197r; Iohannitius, Epistola de proprietate arborum fraxini et thamarici, f. 197r; Matteo Plateario, De simplicibus sive circa instans, ff. 198r-226r; Synonyma Antidotario Nicolai Salernitani applicata, ff. 227r-229v; Vocabularium herbarum latine-germanice, ff. 230r-234r; Quid pro quo, ff. 234r-235r; Chirurgia magna, ff. 236r-262r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-599> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q81164649> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#meyer-die-enzyklopadie'>MEYER 2000</a>, pp. 164-165. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-03-26T16:07:07.954Z"^^xsd:dateTime .

