<https://imagoarchive.it/ontology/resources/manuscript/milano/bibliotecanazionalebraidense/morbio_73_(767)/sf>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1465> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice riporta testi legati alla città di Milano: Nicolò Lunati, Compendio storico della città e stato di Milano, de' suoi dominatori, Governi e Tribunali; Gaspare Ghirlanda, Compendio della storia Milanese anteriore alle accreditatissime Memorie del Conte Giulini; Confalonerii, Vitae de Archiepiscopis Mediolani ad a. Domini 1402; Opusculum de urbe Mediolanensi, l'estratto dal Chonicon di Benzo riguardante la città di Milano; Chronica Danielis; Tristano Calco, Genealogia Vicecomitum Mediolani Principum; Index familiarum quarum sit mentio in Libro epistolarum Ducum Mediolani; Summarium libri mss. cui tit. Litterae, Privilegia Ducum Med.; Observationes ex libro mss. in Bibl. Amb. signat. D. 193 in folio, cuius titulus: Literae et Privilegia Mediolani Ducum, videlicet Philippi Mariae Vicec. Mediol. Ducis; Extracta ex antiquis Mediolani Ducum Decretis; Extracta ex Statutis Modoetiae; Adnotationes ex vita Philippi Mariae Vicecomitis; Parentelae multae erutae ex Decretis Mediolani Ducum; Mediolanensis civitatis et Status Domini Vicarii Imp. et Duces ab anno 1259 ad ann. 1736; Signoria de' Visconti e suoi successori; estratti di una Historia Milanese; Carlo Andre Castiglioni, Cronaca Milanese dall'anno 1635 al 1647; Regolamento dello stato di Milano dell'anno 1707; Relazione di Filippo Archinto e Girolamo Pozzobonelli al Consiglio Generale della città di Milano. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1465> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q771894> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#petoletti-il-chronicon-di-benzo-dalessandria'>PETOLETTI 2000</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, https://www.mirabileweb.it/title/chronica-a-mundi-principio-usque-ad-tempora-henric-title/5466 </li><li><a href='https://imagoarchive.it/bibliografia.html#mazzatinti-catalogo'>MAZZATINTI 1890</a>, VII, p. 99-101. </li>" ;
