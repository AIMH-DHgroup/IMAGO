<https://imagoarchive.it/ontology/resources/manuscript/baltimoremd/waltersartmuseum/w._309/2r40v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-828> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo; mm 260 x 180 (42 linee di testo); ff. I, 42, I' (bianco il f. 42v); numerazione moderna, a lapis, in cifre arabe sul recto del foglio sul mg. sup. destro; segni di richiamo orizzontali nel mg. inf. destro dello specchio di scrittura. Scrittura di due mani: la prima (ff. 2r-40v) per il \"Liber insularum\" in inchiostro nero, in gotica posata; la seconda (ff. 1r, 41r-42r) in inchiostro marrone, in libraria cinquecentesca. Contiene inoltre: (f. 41r) FRANCESCO I (attribuito a), epitaffio a Laura (in francese; inc.: «En petit lieu compris vous poues veoyr»); (f. 41v) MAURICE SCÈVE, sonetto apocrifo petrarchesco (in italiano; inc.: «Qui riposan quei casti et felici ossa»; con nota: «Repertus Avinione in Franciscanis / Anno 1533 XI kal febru.»).\r\nIl manoscritto fu esemplato nella Francia sud-orientale, forse ad Avignone, nel terzo quarto del XV sec. Appartenuto alla collezione Ashburnham-Barrois, fu acquistato dal filantropo e collezionista Henry Walters prima del 1931." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-828> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q210081> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "78 mappe finemente realizzate, con didascalie e colorate ad acquarello (azzurro per il mare e i corsi d'acqua, marroncino per la terra, verde per la vegetazione, rosso per i tetti delle abitazioni). Capolettera del primo paragrafo riccamente miniato in blu, giallo, verde e rosso e decorato marginalmente con motivi fitomorfi (altezza: 11 linee di testo); titolo e iniziali (altezza: 2 linee di testo) rubricati in rosso." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ragone-g-liber-insularum'>RAGONE 2002</a>, p. 181, n. 12 </li><li><a href='https://imagoarchive.it/bibliografia.html#randall-1992'>RANDALL 1992</a>, nr. 141 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. V, p. 213 </li>" ;
        :has_url_manuscript    "https://www.thedigitalwalters.org/Data/WaltersManuscripts/html/W309/" ;
        :has_url_manuscript_description
                "https://art.thewalters.org/detail/25351/78-illummapsislandsportsportolan/" ;
        :last_mod_form         "2024-03-06T15:28:35.865Z"^^xsd:dateTime .

