<https://imagoarchive.it/ontology/resources/manuscript/reims/bibliothquedetudeetdupatrimoine/118_(e_243)/79r81v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1110> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto composito è membranaceo, composto da 140 ff. e misura 278 x 222 mm. Il copista è forse Hincmarus Laudunensis episcopus, di cui si legge al f.1r: «Hincmarus diaconus dedit Stephano». Il manoscritto passò poi successivamente alla chiesa di Santa Maria di Reims per donazione proprio del diacono Stefano, come si legge al f. 4r: «Stephanus dedit Sancte Marie». Trasmette: Praefatio de libro Psalmorum, ff. 1r-2v; Beda, De titulis psalmorum, ff. 4r-37v; Quaestiones Hebraicae in I-II Regum et in I-II Paralipomenon, ff. 38r-67r; Beda, In libros Regum quaestiones XXX, ff. 67r-79r; Beda, Nomina regionum atque locorum de Actibus apostolorum, ff. 79r-81v; Concordia quorundam testimoniorum Sacrae Scripturae, ff. 81v-90v; Expositio in Canticum Canticorum, ff. 90v-102r; Alcuino, Enchiridion in Psalmos poenitentiales, ff. 103r-124r, 133v-140v.  " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1110> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q257342> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/nomina-regionum-atque-locorum-de-actibus-apostolor-title/2289 </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b8448985v" ;
        :has_url_manuscript_description
                "https://ccfr.bnf.fr/portailccfr/jsp/index_view_direct_anonymous.jsp?record=eadcgm:EADC:D38A10818" ;
        :last_mod_form         "2024-03-02T17:38:15.9Z"^^xsd:dateTime .

