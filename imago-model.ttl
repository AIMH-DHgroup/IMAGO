<https://imagoarchive.it/ontology/resources/print_edition/pe-102>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Creta sacra sive de episcopis utriusque ritus graeci latini in insula Cretae" ] ;
        <http://erlangen-crm.org/211015/P2_has_type>
                <https://imagoarchive.it/ontology/resources/print_edition/edition/prima_edizione_/_editio_princeps> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Flaminio Corner basa l’editio princeps della Descriptio insule Crete su un unico manoscritto, il Laurenziano Pluteo 29.42. Nell’intento di ampliare la conoscenza sull’Oriente greco tramandata dall’Oriens Christianus (3 voll., Paris, 1740) del teologo e storico Michel le Quien (1661-1733), Corner confezionò la dottissima e imponente Creta sacra, suddivisa dall’autore in quattro parti ripartite in due volumi: le partes prima e secunda nel primo e le partes tertia e quarta nel secondo, precedute da un’ampia prefazione e da numerosi indici (toponomastico, di documenti, di nomi di persone illustri, di cose notevoli…). La prima parte (vol. I, pp. 1-124) vede le edizioni della Descriptio Cretae (vol. I, pp. 1-18) basata sul ms. Marciano Lat. X, 124 (=3177), ff. 355r-362r, e della Descriptio insule Candiae (vol. I, pp. 77-109) in base al codice Laurenziano Pluteo 29.42, ff. 1v-28r, entrambe seguite da note di commento.\r\nL'edizione è consultabile online al link: https://archive.org/details/cretasacrasivede01corn/page/n9/mode/2up" ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/descriptio-insulae-cretae-title/4834> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-102> ;
        :compiled_form              "Alessio Luca Bartelloni" ;
        :has_ecdotic_type           <https://imagoarchive.it/ontology/resources/print_edition/edition/edizione_commentata> ;
        :has_figure_note            "Mappa di Creta a vol. 1, p. 1 (Cretae sacrae pars prima) con didascalia \"Creta insula ex Ptolomaeo\" e toponomastica in corsivo." ;
        :has_introduction_note      "Praefatio alle pp. 5-12." ;
        :has_other_contents         "La seconda (vol. I, pp. 125-327) e la terza parte (vol. II, pp. 3-184), in ottemperanza al sottotitolo dell’opera («sive de episcopis utriusque ritus graeci latini») riportano la successione cronologica degli arcivescovi e vescovi cretesi di rito greco (pars secunda) e latino (pars tertia), ripartiti secondo le rispettive dottrine e diocesi (e.g. «Ecclesia Eleuthernae», vol. I, p. 256; «Ecclesia Milopotamensis» vol. II, p. 173). La quarta parte (vol. II, pp. 185-458), in conclusione, è dedicata ai «Ducae Veneti in Creta»,  presentati in ordine cronologico con la pubblicazione di documenti inediti." ;
        :has_primary_source         "Descriptio Crete: ms. Marciano Lat. X, 124 (=3177), ff. 355r-362r;\r\nDescriptio insule Candie: ms. Laurenziano Pluteo 29.42, ff. 1v-28r." ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#buondelmonti-descriptio-1755'>BUONDELMONTI, Descriptio 1755</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#bartelloni-al-descriptio-insule-crete'>BUONDELMONTI, Descriptio (tesi di laurea) 2022</a>, pp. 44-45 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Flaminius Cornelius" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-102> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-102> ;
        :last_mod_form              "2024-01-28T17:55:09.952Z"^^xsd:dateTime .

