<https://imagoarchive.it/ontology/resources/manuscript/basel/universittsbibliothek/n_i_2_nr._12-13/ni2nr1213>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-941> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 2 ff. e misura 30x260/265 mm. Esemplato nella regione dell'alto Reno in scrittura minuscola, il codice è frammentario. I due fogli, oggi separati, formavano un rotolo e furono scoperti all'inizio del XIX secolo da Franz Dorotheus Gerlach nella legatura di un libro non oggi identificato che si trovava presso l'Università di Basilea e furono poi rimossi dai bibliotecari tra il 1829 e il 1866. Nel rotolo sono trasmessi:  Memoria de illis monasteriis quae sunt in extremis Hierusalem in Terra Promissionis,  Breve commemoratorii de illis casis Dei vel monasteriis qui sunt in sancta Hierusalem vel in circuitu eius e Dispensa patriarchae inter presbiteris, diaconibus, monachis, clericis et omne congregatione ecclesiae per unum annum." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-941> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q81164649> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/memoria-de-illis-monasteriis-quae-sunt-in-extremis-title/182586 </li><li><a href='https://imagoarchive.it/bibliografia.html#mccormick-charlemagnes-survey'>MCCORMICK 2011</a>, pp. 121-133. </li>" ;
        :has_url_manuscript    "https://www.e-codices.unifr.ch/en/list/one/ubb/N-I-0002-12-13" ;
        :has_url_manuscript_description
                "https://swisscollections.ch/Record/991170457673705501#Inhalt_und_innere_Ordnung" ;
        :last_mod_form         "2024-04-09T13:09:02.453Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-121>
