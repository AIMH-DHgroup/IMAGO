        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#greco-2021-2022'>GRECO (tesi di dottorato) 2022</a>, pp. 66-67. </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, pp. 29-30. </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-per-un-riordino'>CHIESA 1999-2000</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>,  </li>" ;
