<https://imagoarchive.it/ontology/resources/manuscript/modena/bibliotecaestenseuniversitaria/est._647/3r83v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1855> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 83 ff. e misura 334x235 mm. Esemplato da diverse mani su due colonne, il codice è privo di elementi esornativi. Al f. nota: \"Cosmographia di Ptolomeo trascritta avanti l'anno 1475\". Nel margine superiore del f. 3r nota di possesso: \"Magister Petrus Bonus Advogarius qui floruit circa annum Dominum MCCCCLXXV huius libri possessor erat\". Il codice contiene solo il testo della Cosmographia, senza la dedica e mutilo dei capitoli finali del libro VIII. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1855> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1219443> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, p. 112. </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, I, p. 372. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/cnmd/0000169062" ;
