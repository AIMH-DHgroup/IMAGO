<https://imagoarchive.it/ontology/resources/manuscript/venezia/bibliotecanazionalemarciana/it._vi_159-160_(=_6006-6007)/96>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "De commentari istorico-geografici della Provincia dell’Istria libri otto" ] ;
