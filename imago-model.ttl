<https://imagoarchive.it/ontology/resources/manuscript/jena/thringeruniversittsundlandesbibliothek/bos._4°_10/1r139v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
