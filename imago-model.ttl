<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/royal_14.c.xiii/236r269r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1255> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo consta di 310 ff. e misura 371x222 mm. Fu vergato in Inghilterra e riporta note di possesso di Simon Bozoun  (f. 13v \"Liber fratris Symonis Bozoun\", f. 14r \"Liber fratris Symonis Bozoun prioris Norwiciensis)\" e la segnatura di John Lumley al f. 3r. Il manoscritto costituisce una delle prime copie del testo di Francesco Pipino. Trasmette diversi testi: Il Polychronicon di Ranulf Higden, ff. 3r-165v,  l'Historia Hierosolymitana abbreviata di Jacques de Vitry, ff. 195r-215r; la Relatio de mirabilibus orientalium Tatarorum di Odorico da Pordenone ff. 216r-224v e l'Itinerarium di Guglielmo di Rubruck, ff. 225r-236r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1255> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali in rosso e blu " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 704-717. </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/author/franciscus-pipinus-n-1270-ca-m-1327-1328-author/20207 </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, pp. 25-26. </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>, pp. 133-134. </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-testo-e-tradizione'>CHIESA 2008</a>, pp. 141-142. </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-guglielmo-di-rubruk'>GUGLIELMO DI RUBRUCK, Itinerarium 2011</a>,  </li>" ;
        :has_url_manuscript    "" ;
