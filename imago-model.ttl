        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 72. </li>" ;
        :has_url_manuscript    "https://opac.vatlib.it/mss/detail/Ott.lat.1267" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/fr/ark:/43093/mdatad2a46fe7c42c738ae1d8b4d3cae71b522ddc2819" ;
