<https://imagoarchive.it/ontology/resources/manuscript/wolfenbttel/herzogaugustbibliothek/481/1r88r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Gervasius Tilberiensis" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1778> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 88 ff. e misura 270x180 mm. Il testo è disposto su due colonne di 40 linee. Esemplato in Francia meridionale, presenta marginalia rubricati, note di commento o di riassunto. Al f. 1r si legge il titolo \"De otiis imperialibus per Gervasium Tilberiensem nepotem Henrici II regis Anglie\". Al f. 88v sono riportati versi e sentenze. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1778> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q663820> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Sono presenti diversi disegni: f. 1r leone e tre montagne stilizzate, f. 30r porta a doppia torre, f. 30v triangolo con base di mattoni, f. 31r illustrazione di paludi, f. 38v muro merlato e rinforzato con torre, f. 41r rappresentazione di Londra, ff. 42v, 43v, 44v spade, f. 46r vista dall'alto di una fortificazione. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#caldwell-manuscripts-of-gervase-of-tilburys-otia-imperialia'>CALDWELL 1962</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/otia-imperialia-gervasius-tilberiensis-n-1152-ca-m-title/4608 </li>" ;
        :has_url_manuscript    "https://diglib.hab.de/?db=mss&list=ms&id=481-helmst&catalog=Lesser" ;
        :has_url_manuscript_description
                "https://diglib.hab.de/?db=mss&list=ms&id=481-helmst&catalog=Lesser" ;
        :last_mod_form         "2024-02-05T08:02:11.02Z"^^xsd:dateTime .

