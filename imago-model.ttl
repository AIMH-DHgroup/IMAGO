<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._7310/121r158v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-63> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo, ff. III+158+I, luogo di copia: Roma. Contiene anche: Svetonio, De vita Caesarum I-XII (ff. 1r-63v); Senofonte, Cyropaedia, trad. lat. di Poggio Bracciolini (ff. 64r-120r); Cicerone, Epistulae ad Atticum, X VIIIa (f. 120v). Il codice si divide in due parti: la Vita Caesarum di Svetonio è scritta su due colonne da una mano semigotica libraria verso la fine del Trecento; le altre opere sono scritte su linee continue da un'unica mano semigotica tra il 1446 e il 1458. Risulta invece successiva all'assemblaggio del codice l'aggiunta di un bifolio di guardia membr. che riporta un sommario, della fine del Quattrocento, delle materie contenute nel codice: a ogni libro della Roma instaurata viene attribuito un titolo peculiare \"Liber Blondi de Urbe Roma et mirabilibus eius primus; Secundus de instauratione Rome;Tertius et in utroque tabula\". Il testo della Roma instaurata è aneprigrafo. Il codice è appartenuto al cardinale Domenico Capranica (1400-1458). " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-63> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#biondo-roma-instaurata-2020'>BIONDO, Roma instaurata 2020</a>, p. XCIX </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Vat.lat.7310" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/citt%C3%A0-del-vaticano-biblioteca-apostolica-vaticana--manuscript/182704" ;
        :last_mod_form         "2024-02-25T19:59:17.811Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/manifestation/manuscript/mm-41>
        rdf:type  <http://imagoarchive.it/ilrmoo/F3_Manifestation> ;
