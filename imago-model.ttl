<https://imagoarchive.it/ontology/resources/manuscript/leiden/universiteitsbibliotheek/b.p.l._191b/168r183v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-809> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto composito è formato da 183 ff. Formato da quattro diverse unità codicologiche, il codice trasmette testi diversi. Nella prima unità il manoscritto riporta: Agostino, De catechizandis rudibus, ff. 1r-42v. Nella seconda unità riporta: Instructio pie vivendi et superna meditandi, ff. 43v-112r; Ugo di San Vittore, De institutione noviciorum, ff. 112v-124r; Pseudo-Seneca, Formula vitae honestae, ff. 124r-128v; Pseudo-Bernardo di Chiaravalle, Speculum monasticum, ff. 128v-130v; Arsenio, Sermone, ff. 130v-135v. La terza parte trasmette: Seneca, Epistolae morales, ff. 136r-142r; Seneca, De beneficiis, ff. 142v-144r; Pseudo-Seneca, De remediis fortuitorum, ff. 144v-145v; Pseudo-Seneca, Formula vitae honestae, ff. 146r-148v; Seneca, Epistolae morales, ff. 149r-153v; Pseudo-Seneca e Pseudo-Paolo, Lettere, ff. 153v-155r; Seneca, estratti di tragedie, ff. 155r-159v; Plinio il Giovane, Sidonio e Ennodio, Lettere, ff. 159v-163r; Cicerone, De senectute, ff. 163v-167v. \r\nL'ultima parte del manoscritto, ff. 168-183, trasmette il Liber di Guillelmus de Boldensele, ed è stata esemplata nei Paesi Bassi ed è datata al 1351. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-809> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q638395> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, https://www.mirabileweb.it/title/liber-de-quibusdam-ultramarinis-partibus-et-praeci-title/7772 </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/uz/wilhelm_von_boldensele.html </li><li><a href='https://imagoarchive.it/bibliografia.html#guillaume-de-boldensele-liber-de-quibusdam-ultramarinis-partibus-2018'>GUILLAUME DE BOLDENSELE, Liber de quibusdam ultramarinis partibus 2018</a>,  </li>" ;
        :has_url_manuscript    "http://hdl.handle.net/1887.1/item:3261831" ;
        :has_url_manuscript_description
                "http://hdl.handle.net/1887.1/item:3261831" ;
        :last_mod_form         "2024-03-03T08:16:38.18Z"^^xsd:dateTime .

