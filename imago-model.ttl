<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._1944/1r81r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-61> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Cartaceo, ff. I+132+II, luogo di copia: Roma?. Contiene anche: Lodovico de' Guasti, Epitoma Plinii Secundi in Historia Naturali (ff. 82r-130v); Tavola cronistorica dei papi da Stefano III (768) a Onorio IV (1288) e degli imperatori da Lotario (841) a Massimiliano I (1508) (ff. 131r-132r). La Roma instaurata e l'Epitoma di Ludovico Guasti sono scritte su carte coeve da copisti diversi, una mano cinquecentesca aggiunge le tavole cronistoriche e note marginali al testo di Biondo. Il testo della Roma instaurata è incompleto. Altre note sono apposte da una quarta mano, anch'essa cinquecentesca." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-61> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#biondo-roma-instaurata-2020'>BIONDO, Roma instaurata 2020</a>, p. XCVII </li>" ;
