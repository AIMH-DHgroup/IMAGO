<https://imagoarchive.it/ontology/resources/manuscript/dublin/trinitycollege/486/1r190v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2226> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 190 ff. e misura 392x278 mm. Il testo è disposto su due colonne sui ff. 1r-7v e 26v-28r. Il codice è esemplato in scrittura anglicana di più mani. Sono presenti note del XVI secolo sulla storia irlandese, basate di solito su informazioni contenute nel testo, a eccezione del f. 82r dove si legge: \"Anno 6 post mortem Alexandri Cimbaeth Mac Fintain incipit regnare Mac Eamain, qui reg(nauit) annis 28. Tunc item quidam Eochu Buadach athair Augaine regnasse ab aliis fertur, at Hibernici scripto referunt Augaine predictum imperasse\". Nota di possesso al f. 1r \"Ex dono Milonis Symneri Liber collegii Trinitatis Dubli\" del XVII secolo. Il testo del Polychronicon arriva fino al 1357. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2226> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q81165027> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Diagrammi in rosso e giallo verdastro: due al f. 39r rappresentano l'arca di Noè e mostrano dove erano conservate le diverse creature e magazzini. Un diagramma ai ff. 65r e 65v trattano dei toni. Al f. 8r bordo di viti e fiori in oro e colori. Iniziale al f. 1r in oro e motivi vegetali. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/qt/ranulf_higden.html </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manuscripts.catalogue.tcd.ie/CalmView/Record.aspx?src=CalmView.Catalog&id=IE+TCD+MS+486&pos=1" ;
        :last_mod_form         "2024-04-16T07:48:26.722Z"^^xsd:dateTime .

