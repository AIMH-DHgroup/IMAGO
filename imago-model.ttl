        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/paris-biblioth%C3%A8que-nationale-de-france-lat-6746-manuscript/176476" ;
        :last_mod_form         "2024-02-26T18:38:02.993Z"^^xsd:dateTime .

