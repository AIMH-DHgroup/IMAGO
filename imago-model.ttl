<https://imagoarchive.it/ontology/resources/manuscript/cambridge/universitylibrary/dd.13.4/1116>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1919> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 116 ff. e misura 392x283 mm. Il testo è disposto su due colonne. Di origine inglese, conserva la parte iniziale dell'opera di Rabano (libri I-X), la cui parte finale è tramandata dal ms. Dd.8.13. Il codice fu precedentemente posseduto dall'abbazia di St. Mary di Kirkstead, come si legge dalla nota di possesso al f. 3v: \"Liber monachorum de Kyrkestede\". Al f. 118r è presente una tavola astrologica, al f. 118v una tavola di segni zodiacali e mesi scritta da una mano diversa e probabilmente più tarda; al f. 119r un alfabeto con l'indicazione del significato attribuito a ogni lettera. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1919> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1028334> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#kottje-ziegler-verzeichnis-der-handschriften'>KOTTJE-ZIEGLER 2012</a>, p. 32, n. 185. </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/cambridge-university-library-dd-13-4-manoscript/223622" ;
        :last_mod_form         "2024-01-25T14:42:28.583Z"^^xsd:dateTime .

