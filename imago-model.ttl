<https://imagoarchive.it/ontology/resources/manuscript/trier/stadtbibliothek/hs._1143/445_8°_(414)/281r293v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1080> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da III, 294 ff. con il testo disposto su due colonne. Il codice trasmette un Passionale, ff. 1r-293v e la Vita s. Oswaldi, ff. 294r-294v. Sul verso della terza guardia si legge l'ex libris di mano del XV secolo: \"Iste liber est fratrum Carthusiensium prope Confluentiam\". Nel 1781 fu donato dal vescovo Giovanni Nicola ad Hontheim alla biblioteca di Sankt Simeon di Treviri, da cui nel 1802 passò alla Biblioteca di Stato. Il codice è trascritto da varie mani, una sola delle quali responsabile della Navigatio. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1080> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1590176> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/navigatio-sancti-brendani-title/172643 </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 98-99. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/trier-stadtbibliothek-hs-1143-445-8°-(414)-manoscript/141785" ;
