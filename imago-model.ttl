        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#biondo-roma-instaurata-2020'>BIONDO, Roma instaurata 2020</a>, pp. C-CI </li><li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 301-304 </li>" ;
        :has_url_manuscript    "" ;
