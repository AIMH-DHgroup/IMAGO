<https://imagoarchive.it/ontology/resources/manuscript/london/collegeofarms/arundel_1/194v198r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1710> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è una miscellanea di testi di genere diversi: il codice trasmette cronache e storie, come il Polychronicon di Ranulph Higden, Onorio di Autun, Imago Mundi, Jacques de Vitry, Historia Hierosolymitana, l'Historia regum Britanniae di Goffredo di Monmouth e due cronache sui popoli irlandesi e sui Franchi. Il codice trasmette inoltre testi religiosi, filosofici e brevi resoconti storici, come un libro dei santi Gioacchino e Anna, un trattato sulla nascita della Vergine Maria, un estratto del Contra Jovinianum di San Girolamo, testi riguardanti Alessandro Magno, una storia di Apollonio, re di Tiro, e la visione di Thomas Becket. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1710> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q1109101> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Il testo del Polychronicon di Higden è stato illustrato con una mappa del mondo: Adamo ed Eva sono sopra la mappa, con a sinistra il serpente con una testa umana, che indica la posizione dell'Eden. La mappa pone al centro il Mediterraneo, con Scozia, Inghilterra, Galles e Irlanda nel bordo inferiore. Nel codice si trova inoltre un'illustrazione di Giulio Cesare che si consulta con uomini dotti. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://whitelionsociety.co.uk/news/16-college-of-arms-arundel-ms-1-from-mappa-mundi-to-necromancy" ;
        :last_mod_form         "2024-04-05T08:07:46.748Z"^^xsd:dateTime .

