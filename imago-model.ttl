        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/itinerarium-title/5663 </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-guglielmo-di-rubruk'>GUGLIELMO DI RUBRUCK, Itinerarium 2011</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#chiesa-testo-e-tradizione'>CHIESA 2008</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#giovanni-di-pian-del-carpine-storia-dei-mongoli'>GIOVANNI DI PIAN DEL CARPINE, Storia dei Mongoli 1989</a>, pp. 102, 172-176. </li>" ;
        :has_url_manuscript    "https://parker.stanford.edu/parker/catalog/gg784fk0128" ;
        :has_url_manuscript_description
                "https://parker.stanford.edu/parker/catalog/gg784fk0128" ;
