<https://imagoarchive.it/ontology/resources/lemma/l2413>
        rdf:type       <http://imagoarchive.it/ilrmoo/F28_Expression_Creation> ;
        <http://erlangen-crm.org/211015/P14_carried_out_by>
                <http://www.mirabileweb.it/author/nicolaus-signorilis-fl-1425-author/22290> ;
        <http://imagoarchive.it/ilrmoo/R17_created>
                <http://www.mirabileweb.it/title/de-iuribus-et-excellentiis-urbis-romae-nicolaus-si-title/200545> ;
        :has_abstract  "L'opera, scritta su commissione di Giorgio Marcellini, Giovanni Damiani e Giovanni Paolo della Torre nel 1425, dedicata a papa Martino V, è una descrizione di Roma, delle sue istituzioni e i suoi diritti, dei rioni e degli uffici, delle basiliche e delle chiese. Il testo ha lo scopo di legittimare il potere pontificio su Roma, attraverso una raccolta di norme dimenticate, o soppresse, durante gli anni in cui la sede del papato si trovava ad Avignone. " .

<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/royal_13.a.xiv/198r213r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-644> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 279 ff. e misura 240x175 mm, ma i ff. 177-186 furono aggiunti successivamente nella prima metà del XIV secolo. Esemplato in Irlanda, trasmette inoltre la Topographia Hiberniae (ff.10v-58v) e l'Expugnatio Hibernica (ff. 58v-106v) di Giraldus Cambrensis, la Sibylla Tiburtina (ff.244r-247v), l'Historia beate virginis Mariae di Paschalis Romanus (ff.270v-272r), il De miseria humanae conditionis di papa Innocenzo III (ff. 117v-129r), il De philosophia mundi di Guglielmo di Conches (ff. 217v-243v).  Il codice riporta la prima versione dell'Historia Mongalorum. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-644> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Iniziali in rosso e blu. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/historia-mongalorum-iohannes-de-plano-carpini-n-11-title/6155 </li><li><a href='https://imagoarchive.it/bibliografia.html#giovanni-di-pian-del-carpine-storia-dei-mongoli'>GIOVANNI DI PIAN DEL CARPINE, Storia dei Mongoli 1989</a>, pp. 101, 147-152. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://www.bl.uk/catalogues/illuminatedmanuscripts/record.asp?MSID=7442&CollID=16&NStart=130114" ;
        :last_mod_form         "2024-01-25T09:07:29.952Z"^^xsd:dateTime .

<https://imagoarchive.it/ontology/resources/incipit_text/mit-2170>
