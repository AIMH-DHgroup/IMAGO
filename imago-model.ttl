<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._5255/120r130r130v139v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1115> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è miscellaneo, composto da 165 ff. con otto quinterni di varia grandezza, rilegati in pergamena. Ai ff. 1r-22v è trasmessa una dissertazione anonima dal titolo \"De nobilitate Italiae\", di cui segue una copia ai ff. 23r-47v; seguono \"Viazo de Caloria\", ff. 53v-72v, notizie su alcune isole orientali, ff. 77r-81v, la descrizione di un \"Viaggio di Venetia a India\", ff. 83r-93r, la novella di Grasso Legnaiulo, ff. 95r-105r, la descrizione del viaggio di Domenico di Muzzatto nell'anno 1526, ff. 106r-110v, descrizione di reliquie di santi, ff. 111r-112v, Cronologia francescana, ff. 113r-117r, un'altra \"Peregrinationes totius terrae sanctae et indulgentie concesse a beato Silvestro papa\", ff. 142r-147v, Notizie sull'origine di Venezia, ff. 148r-148v, Nota delle feste religiose che ricorrono in ciascun mese, ff. 149r-149v, Annali Romani dal 1422 fino al 1484, ff. 150r-165r. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1115> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/peregrinationes-totius-terrae-sanctae-guillelmus-g-title/6068 </li><li><a href='https://imagoarchive.it/bibliografia.html#kraack-hirschbiegel-2000'>PARAVICINI-KRAACK-HIRSCHBIEGEL 2000</a>, p. 70. </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Vat.lat.5255" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/città-del-vaticano-biblioteca-apostolica-vaticana--manoscript/100030" ;
        :last_mod_form         "2024-03-30T11:01:45.02Z"^^xsd:dateTime .

