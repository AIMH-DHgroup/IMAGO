<https://imagoarchive.it/ontology/resources/manuscript/mnchen/bayerischestaatsbibliothek/clm_14583/496r506v516v520r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2004> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 525 ff. e misura 215x155 mm. Esemplato nella abbazia di St. Emmeram a Regensburg, il codice fu in parte vergato dal copista Fridericus Amann (ff. 62v, 70r, 122r, 127r, 226r, 249r, 350v, 425r, 434r, 463r). Il codice trasmette: Annuario astronomico, ff. 1r-43v; Johannes von Gmunden, Tabulae stellarum, ff. 44r-62v; Imagines coeli, ff. 70r-76v; Iacobo di Angelo da Scarperia, Cosmographia, ff. 81r-219v; Cosmographia septem climatum, ff. 222r-235v; Nova cosmographia, ff. 236r-277v; Tabulae, ff. 286r-298v e 300r-312r; Cosmographia septem climatum secundum antiquos, ff. 315r-319r; Tabula territoriorum, f. 337r; Istruzioni per il disegno e la costruzione di uno strumento, ff. 339v-352v; Johannes von Gmunden, De compositione et usu instrumenti Albyon, ff. 340r-409v; Ps.-Māšāʾallāh Ibn-Aṯarī (Messahalla), De compositione astrolabi, ff. 410r-425r; Yaʽcaqov Ben-Māḵîr Ibn-Tibbōn (Prophatius Iudaeus), Quadrans novus, ff. 426r-434r; Johannes von Gmunden, Tractatus de quadrantibus, ff. 435r-442v; Descriptio Asiae, ff. 491r-494r; Tabula imperatorum et regum Christianorum, ff. 494r-495r; Onorio di Autun, Imago mundi, ff. 496r-506v e 516v-520r; Mappae, ff. 507r-514r; De partibus mundi, ff. 520r-521v; Nota de solemnitatibus legalibus, f. 521v e alcuni estratti della Descriptio di Burcardo da Monte Sion, ff. 469v-470v, 476v-485r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2004> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q256507> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/imago-mundi-honorius-augustodunensis-presbyter-et--title/3444 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#rubin-the-manuscript-tradition'>RUBIN 2020</a>,  </li>" ;
        :has_url_manuscript    "https://www.digitale-sammlungen.de/en/details/bsb00075061" ;
        :has_url_manuscript_description
                "http://www.manuscripta-mediaevalia.de/dokumente/html/obj31784519" ;
        :last_mod_form         "2024-04-01T15:38:42.79Z"^^xsd:dateTime .

