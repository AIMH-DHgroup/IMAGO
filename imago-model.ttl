        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/cosmographia-iacobus-angeli-de-scarperia-n-1360-ca-title/4154 </li><li><a href='https://imagoarchive.it/bibliografia.html#azzini-domizio-calderini'>AZZINI (tesi di dottorato) 2010</a>, p. 115. </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, I, p. 416. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://manus.iccu.sbn.it/cnmd/0000180684" ;
        :last_mod_form         "2024-02-06T08:17:57.367Z"^^xsd:dateTime .

