<https://imagoarchive.it/ontology/resources/manuscript/london/britishlibrary/arundel_93/129r159v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Liber insularum archipelagi" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-843> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo e miscellaneo, lussuoso; ff. 162 (specchio di scrittura: 47 linee); numerazione moderna, a lapis, in cifre arabe sul recto del foglio nel mg. sup. destro. Formato in-folio. Scrittura in inchiostro nero, in gotica libraria, grafia franco-fiamminga; rigatura a secco; numerose glosse marginali. Acquistato ed emendato nel 1485 in Fiandra da Raphael de Mercatellis (Raphael de Mercatel), figlio naturale di Filippo il Buono duca di Borgogna e abate di Saint-Bavon a Gand (alla fine del codice: «Hoc volumen comparavit Raphael de Marcotellis [sic] dei gratia episcopus Rosensis Abbas Sancti Bavonis iuxta Gandavum et quoad potuit correxit anno domini 1485»).\r\nContiene inoltre: (3v-111r) DIODORO SICULO, Bibliotheca historica (libri I-VI, tradotti da Poggio Bracciolini, con prefazione e in fondo a f. 111r data 1482); (112r-118r)\r\nENEA SILVIO PICCOLOMINI, De situ et origine Pruthenorum; (118v-120v) ID., De Livonia; (120v-121v) ID., De bello Thurcorum et Hungarorum (epistola a Filippo Maria Visconti); (121v-124r) ID., De officio et origine heraldorum (epistola a Giovanni Hinderbach); (124r-128v) LEONARDO BRUNI, De studiis et litteris; (160r-161v) Tavola dei contenuti." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-843> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q23308> ;
        :compiled_form         "Alessio Luca Bartelloni" ;
        :has_decoration        "Mappe finemente tracciate e splendidamente colorate, con didascalie e titoli. Capilettera miniati in rosso e blu (altezza: 2 linee di testo); l'iniziale iconica (alta 12 linee di testo) offre un'immagine agreste di cinque uccellini su prato verde con campi e una città sullo sfondo." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#ragone-g-liber-insularum'>RAGONE 2002</a>, p. 181, n. 12; p. 217, n. 136 </li><li><a href='https://imagoarchive.it/bibliografia.html#derolez-1979'>DEROLEZ 1979</a>, pp. 90-94 </li><li><a href='https://imagoarchive.it/bibliografia.html#iter'>KRISTELLER 1963-1992</a>, vol. IV, p. 127 </li>" ;
        :has_url_manuscript    "https://bl.iro.bl.uk/concern/datasets/1dc7e1d8-7d08-4548-b7e8-eebe19a7c4e6?locale=en" ;
        :has_url_manuscript_description
                "https://archive.org/details/b30455881_0001/page/26/mode/1up" ;
        :last_mod_form         "2024-03-03T18:36:55.656Z"^^xsd:dateTime .

