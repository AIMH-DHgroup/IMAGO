<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/palatino_latino_948/1r191rsecondonum192r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-674> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Membranaceo, mm 286-203, ff. II, 192, I'. Testo scritto a piena pagina (ca. 31 righe per pagina), scrittura umanistica corsiva. Marginalia di colore rosso e scuro, della mano del copista, e correzioni di omissioni dello stesso copista. Potrebbe trattarsi del codice dell'Italia Illustrata presente nella Biblioteca di Hartmann Schedel (1440-1514), medico e umanista tedesco che studiò a Lipsia e a Padova e si dedicò a studi di geografia, lingua e arte, la cui biblioteca fu venduta nel 1552 ad Hans Jacob Fugger e poi per mezzo di Ulrich Fugger confluì nella Biblioteca Palatina di Heidelberg. Il codice tramanda il testo della III fase redazionale dell'Italia illustrata." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-674> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Elena Vagnoni" ;
        :has_decoration        "Titoli per ciascuna regione in capitali rosse e titoli correnti, sempre in inchiostro rosso sul recto di ogni carta. Iniziali decorate in foglia d'oro su sfondo blu, rosa, verde e bianchi girari per ciascuna regione (ff. 1v, 27v, 49r, 60r, 70r, 90v, 110v, 119r, 134r, 137r, 140v, 166r, 188v). A f. 1r capitale C in foglia d'oro e fregio a bianchi girari su sfondo blu, rosa e verde esteso al mg. sup. e sin." ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#p-pontari-italia-illustrata'>BIONDO, Italia illustrata 2011</a>, pp. 298-300 </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Pal.lat.948" ;
        :has_url_manuscript_description
                "https://www.mirabileweb.it/manuscript/citt%C3%A0-del-vaticano-biblioteca-apostolica-vaticana--manuscript/107268" ;
        :last_mod_form         "2024-03-14T09:39:27.902Z"^^xsd:dateTime .

