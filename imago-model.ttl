        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/tarragona-biblioteca-pública-del-estado-(provincia-manoscript/147783" ;
        :last_mod_form         "2024-03-03T18:40:35.507Z"^^xsd:dateTime .

