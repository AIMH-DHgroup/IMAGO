<https://imagoarchive.it/ontology/resources/manifestation/manuscript/mm-1966>
        rdf:type  <http://imagoarchive.it/ilrmoo/F3_Manifestation> ;
        <http://imagoarchive.it/ilrmoo/R7i_is_materialized_in>
                <https://imagoarchive.it/ontology/resources/manuscript/graz/technischeuniversitt/_303/338r345r> .

<https://imagoarchive.it/ontology/resources/manuscript/gent/universiteitsbibliotheek/13/54r60v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-734> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è composto da 158 ff. e misura 510x385 mm. Esemplato in Olanda, la prima parte (ff. 1-124) fu probabilmente copiata dopo il 1500, la seconda (ff. 125-158) dopo il 1486. Il possessore fu Raphael de Mercatellis (1437-1508), abate di S. Bavon a Gand, e alla sua morte il manoscritto rimase nell'abbazia fino al 1540, quando l'archivio della biblioteca fu inglobato nella nuova cattedrale di Gand, per poi arrivare all'Università di Gand nel 1817. Trasmette: Auctoritates Aristotelis et aliorum philosophorum, ff. 1r-27r; Problemata Aristotelis, ff. 27r-42r; Iohannes de Hese, Itinerarium, ff. 43r-52v; Ludolfo de Sudheim, De itinere Terrae Sanctae, ff. 61r-82r; Francesco Pipino, Liber Marci Pauli de Veneciis, ff. 83r-113v; Peregrinationes totius Terrae Sanctae, ff. 114r-123v, Johann Reger, Registrum alphabeticum, ff. 125r-157v, estratti dal De Bello Gallico di Giulio Cesare, ff. 157v-158v." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-734> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q611001> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/itinerarium-de-brugis-title/173427 </li><li><a href='https://imagoarchive.it/bibliografia.html#itinerarium-de-brugis-1908'>Itinerarium de Brugis 1908</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#c-w-dutschke-francesco-pipino'>DUTSCHKE (PhD thesis) 1993</a>, pp. 575-594. </li>" ;
        :has_url_manuscript    "https://lib.ugent.be/catalog/rug01:000960423" ;
        :has_url_manuscript_description
                "https://lib.ugent.be/catalog/rug01:000960423" ;
        :last_mod_form         "2024-04-09T10:15:14.039Z"^^xsd:dateTime .

