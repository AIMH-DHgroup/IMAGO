        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#httpswwwbedadlsgwiuni-muenchendeabout'>BEDA VENERABILIS, De locis sanctis </a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#k-halm-catalogus'>HALM 1892</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, https://www.mirabileweb.it/title/de-locis-sanctis-title/8029 </li>" ;
