        rdf:type             <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Incipit liber primus domini Marci Pauli de Veneciis de mirabilibus orientalium regionum. Qualiter et quare dominus Nicholaus Pauli de Veneciis et dominus Matheus transierunt ad partes orientales. Capitulum I. Tempore quo Balduinus princeps septrum Constantinopolitanum " ;
        :is_text_incipit_of  <https://imagoarchive.it/ontology/resources/manifestation/manuscript/mm-1274> .

