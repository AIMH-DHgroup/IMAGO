                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1560> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 203 ff. Formato da tre diverse unità codicologiche, il codice trasmette diversi testi, tra cui l'Historia Mongalorum di Giovanni di Pian del Carpine, l'Itinerarium di Odorico da Pordenone, componimenti brevi e due summae, di cui una attribuita a Roberto Grossatesta, i Mirabilia urbis Romae, le Stationes ecclesiarum urbis Romae e le Indulgentiae ecclesiarum urbis Romae. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1560> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q82133> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 60. </li><li><a href='https://imagoarchive.it/bibliografia.html#odorico-da-pordenone-relatio'>ODORICO DA PORDENONE, Relatio 2016</a>, p. 30. </li><li><a href='https://imagoarchive.it/bibliografia.html#marchisio-la-tradizione-manoscritta'>MARCHISIO (tesi di dottorato) 2013</a>, pp. 302-303. </li><li><a href='https://imagoarchive.it/bibliografia.html#giovanni-di-pian-del-carpine-storia-dei-mongoli'>GIOVANNI DI PIAN DEL CARPINE, Storia dei Mongoli 1989</a>, pp. 140-141. </li><li><a href='https://imagoarchive.it/bibliografia.html#odoherty-the-viaggio-in-inghilterra'>O'DOHERTY 2009</a>, pp. 209-210. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "https://medieval.bodleian.ox.ac.uk/catalog/manuscript_4232" ;
        :last_mod_form         "2023-03-16T16:58:36.892Z"^^xsd:dateTime .

