<https://imagoarchive.it/ontology/resources/manuscript/montecassino/archiviodellabbaziabibliotecastataledelmonumentonazionale/132/1530>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Rabanus De origine rerum" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1934> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice è formato da 530 ff. e misura 480x350 mm. Una mano otto-novecentesca ha apposto una nota al centro del recto della carta di guardia: \"Seculi XI codex exaratus anno 1023, cura Theobaldi Abbatis Casinensis, ut ex chronicon casin. lib. 2 cap. 52\". Il codice è ricordato nell'elenco dei manoscritti fatti realizzare dall'abate Teobaldo. Il testo di Rabano Mauro inizia con la tavola dei capitoli, dal capitolo 8 del libro XIX al libro XXII. A causa delle cadute di fogli tra i ff. 266-267 e ff. 458-459 il testo presenta delle lacune. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1934> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q334051> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "Codice riccamente decorato con 335 miniature disegnate a penna direttamente sulla pergamena, eseguite probabilmente da un'unica mano prima della stesura grafica. Tutti i capitoli sono introdotti da un'iniziale decorata geometrica, nastriforme o zoomorfa; in due casi la lettera è figurata: f. 112 la O di oratio è sostituita da una grande testa maschile, f. 235 la A di Aura presenta una testa alata. " ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#il-codice-cassinese-132-di-rabano-mauro-in'>DI MAJO-MITA-PALMA-PASCALICCIO-SALVATI-VALENTI 1994</a>,  </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "" ;
        :last_mod_form         "2024-01-26T10:26:31.403Z"^^xsd:dateTime .

