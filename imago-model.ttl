<https://imagoarchive.it/ontology/resources/manuscript/mnchen/bayerischestaatsbibliothek/clm_14747/128r138r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1100> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice composito è membranaceo, composto da 165 ff. e misura 175x125 mm. L'ente possessore era l'abbazia di St. Emmeram di Regensburg. Consta di due unità codicologiche: la prima, del IX secolo, corrispondente ai ff. 1-62, ha il testo disposto su due colonne e trasmette Beda Venerabile, In epistolas catholicas expositio; la seconda del terzo quarto del IX secolo, trasmette le epistole di Gerolamo, il De haeresibus di Augustino, l'Expositio Psalmorum di Cassiodoro, In acta apostolorum expositio, l'Explanatio Apocalypsis di Beda, Explanatio super epistolam Pauli ad Romanos di Origene e alcuni estratti delle Etimologie di Isidoro. La parte principale della Parte I è stata scritta da uno scriba con influenze irlandesi. Ulteriori passaggi sono scritti in minuscola carolingia tedesca da mani diverse. La parte II è stata scritta da più mani il cui stile di scrittura si riferisce al territorio della Germania meridionale." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1100> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q256507> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/nomina-regionum-atque-locorum-de-actibus-apostolor-title/2289 </li><li><a href='https://imagoarchive.it/bibliografia.html#innovating-knowledge'>INNOVATING KNOWLEDGE</a>, https://db.innovatingknowledge.nl/#detail/M0221 </li>" ;
        :has_url_manuscript    "https://handschriftenportal.de/search?hspobjectid=HSP-f2901d29-52fa-3b3f-aff8-9a87378e666a&q=Clm+14747&hl=true" ;
        :has_url_manuscript_description
                "http://www.manuscripta-mediaevalia.de/?xdbdtdn!%22obj%2031773479%22&dmode=doc#|4" ;
        :last_mod_form         "2024-03-02T17:02:42.138Z"^^xsd:dateTime .

