<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._6041a/180r203v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-329> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da II, 213 ff. e misura 305x195 mm. Esemplato in Francia, il codice trasmette anche l'Historia Britonum di Goffredo de Monmouth, una Vita Caroli Magni, una cronaca universale, l'Historia Francorum di Raymond d'Aguilers, un frammento della Vita Alexandri Magni e la Navigatio sancti Brendani. Nella guardia cartacea una nota del 1931 avverte che i ff. 204-213 dovevano in origine collocarsi prima del f. 180 ed essere stati preceduti da 20 fogli ora perduti, come indica la foliazione antica. Del testo del Flos manca la parte finale. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-329> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#bueno-dalla-guerra-alle-meraviglie-orientali'>BUENO 2018</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#arlima'>ARLIMA</a>, https://www.arlima.net/mp/nicolo_falconi.html </li><li><a href='https://imagoarchive.it/bibliografia.html#guglielmetti-orlandi-navigatio-sancti-brendani'>Navigatio sancti Brendani 2017</a>, pp. 84-85. </li><li><a href='https://imagoarchive.it/bibliografia.html#concina-2020'>CONCINA 2020</a>,  </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b10721381f" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc65061x" ;
        :last_mod_form         "2024-04-04T07:22:07.837Z"^^xsd:dateTime .

