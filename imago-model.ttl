                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-2126> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo e cartaceo è formato da 322 ff. e misura 390x270 mm. Esemplato in parte da Gregorius Pawngarter, il codice è composto da due unità codicologiche: la prima, ff. 1-14, trasmette il Compendium historiae in genealogia Christi di Pietro di Poitiers, la seconda, ff. 16-322, la Chronica Hussitarum di Andreas von Regensburg, il Chronicon di Martin Polono, il Libellus de fundacione ecclesiae consecratis Petri Ratisponae, il Pantheon di Goffredo da Viterbo, la Quaestio utrum monachis liceat praedicare di Ruperto di Liegi, la Summa gloria e l'Imago mundi, riportato per intero, di Onorio di Autun. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-2126> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q256507> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/imago-mundi-honorius-augustodunensis-presbyter-et--title/3444 </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/münchen-bayerische-staatsbibliothek-clm-9711-manoscript/157927" ;
        :last_mod_form         "2024-04-02T08:55:10.419Z"^^xsd:dateTime .

