<https://imagoarchive.it/ontology/resources/manuscript/bonn/universittsundlandesbibliothek/s_448/43v64v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1995> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo e cartaceo è formato da V+ 126+97, I' ff. e misura 205x145 mm. Il codice è composto da quattro differenti parti: la prima risalente al 1475 ca. fu esemplata nel monastero di Roermond e corrisponde ai ff. II-III; la seconda trasmette l'Historia Hierosolymitana, ff. 1r-126v; la terza, risalente al 1475 ca., esemplata nel monastero di Roermond, corrisponde ai ff. 1-2 e trasmette alcuni capitoli dell'Itinerario di Mandeville; la quarta, risalente al 1450-1465, esemplata nel monastero di Roermond, trasmette l'Itinerarius di Mandeville e l'Imago mundi di Onorio di Autun in una versione abbreviata del testo. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1995> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q101248363> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#imago-mundi'>IMAGO MUNDI</a>, https://imagomundi.hum.uu.nl/ </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/imago-mundi-honorius-augustodunensis-presbyter-et--title/3444 </li><li><a href='https://imagoarchive.it/bibliografia.html#tzanaki-mandevilles-medieval-audiences'>TZANAKI 2003</a>,  </li>" ;
        :has_url_manuscript    "http://www.manuscripta-mediaevalia.de/dokumente/html/obj31275295" ;
        :has_url_manuscript_description
                "http://www.manuscripta-mediaevalia.de/dokumente/html/obj31275295" ;
        :last_mod_form         "2024-04-01T15:27:05.056Z"^^xsd:dateTime .

