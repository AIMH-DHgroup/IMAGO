<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/nal_873/148v161r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1751> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 192 ff. e misura 222x170 mm. Questo codice è formato da tre unità codicologiche, la prima e la seconda esemplate in Inghilterra, la terza nel nord della Francia. La prima unità, vergata in tarda carolina da quattro mani principali, corrisponde ai ff. 1-127 e trasmette: Remigio di Auxerre, Expositio missae; Mirabilia Britanniae; Ildeberto di Lavardin, Versus de mysterio missae, Carmen; Commentarius in Apocalypsin. La seconda unità, ff. 128-161, trasmette l'Historia magni regis Alexandri; Epistola Alexandri ad Aristotelem; Epitaphium Alexandri. La terza unità, ff. 164-201, trasmette il De pulsibus; Marbodo di Rennes, Liber lapidum seu de gemmis; Beda il Venerabile, De natura regum; Signa vivendi; Versus de mensibus; Lunarium. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1751> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li><li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b10548488f/f315.item" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc715425" ;
        :last_mod_form         "2024-04-05T09:44:24.33Z"^^xsd:dateTime .

