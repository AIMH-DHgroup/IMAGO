        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da 158 ff. Il codice trasmette: compendio delle sentenze di Pietro Lombardo, ff. 1r-91r; Burcardo del Monte Sion, Descriptio Terrae Sanctae, ff. 92r-119v; Tractatus, ff. 120r-130v; Rorgo Fretello, Liber locorum sanctorum terrae Ierusalem, ff. 136r-152r; testo sui Germani, ff. 153r-168v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-171> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q256507> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/descriptio-terrae-sanctae-title/1185 </li><li><a href='https://imagoarchive.it/bibliografia.html#bartlett-burchard-of-mount-sion'>BURCHARD OF MOUNT SION, Descriptio Terrae Sanctae 2019</a>, pp. XVIII-XLI. </li><li><a href='https://imagoarchive.it/bibliografia.html#greco-2021-2022'>GRECO (tesi di dottorato) 2022</a>, p. 66. </li><li><a href='https://imagoarchive.it/bibliografia.html#p-trovato-new-perspectives'>TROVATO-KEDAR 2018</a>, pp. 1-32. </li><li><a href='https://imagoarchive.it/bibliografia.html#boeren-rorgo-fretellus-de-nazareth'>RORGO FRETELLO, Descriptio 1980</a>, p. 88. </li>" ;
        :has_url_manuscript    "" ;
        :has_url_manuscript_description
                "http://www.mirabileweb.it/manuscript/münchen-bayerische-staatsbibliothek-clm-5307-manoscript/188942" ;
