<https://imagoarchive.it/ontology/resources/manuscript/cittdelvaticano/bibliotecaapostolicavaticana/vat._lat._636_a/99r107v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-701> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il codice membranaceo è formato da 127 ff. divisi in due sezioni. La seconda trasmette: Beda il Venerabile, De locis sanctis, ff. 72r-78r; Beda il Venerabile, Historia ecclesiastica, ff. 78r-79v; Adamnano di Hy, De locis sanctis, ff. 80r-99r; Itinerarium Antonini Placentini, ff. 99r-107v; Pseudo-Eucherio, De situ Hierosolimitanae Urbis atque ipsius Iudaeae epistola ad Faustum presbyterum, ff. 107v-109v; Gregorio di Tours, Miraculorum liber I, ff. 109v-199v; De septem spectaculis mundi, ff. 119v-120v; De septem miraculis, ff. 120v-122r; Beda il Venerabile, Hymnus de die iudicii, ff. 122v-123v; Versus de contemptu saeculi, ff. 124v-125r. Il codice trasmette la recensio altera dell'Itinerarium Antonini." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-701> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
