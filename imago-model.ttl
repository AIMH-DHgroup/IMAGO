<https://imagoarchive.it/ontology/resources/manuscript/paris/bibliothquenationaledefrance/lat._11684/1r218r>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1951> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è composto da 221 ff. e misura 410 x 280 mm. Esemplato nell'abbazia di Saint Pierre di Corbie, il copista potrebbe essere Iohannes Monoculus Corbeiensis monachus, che ha vergato anche i mss. 11564, 11576, 11700, 11864, 16943, oggi conservati presso la Bibliothèque Nationale de France. Il manoscritto trasmette anche: Beda il Venerabile, De locis sanctis, ff. 218r-221v. Il De rerum naturis è seguito da una nota biografica su Rabano Mauro, f. 218r, e dal suo epitaffio, f. 218r. Nel margine superiore di f. 1r \"ex libris\" di Saint-Pierre di Corbie e di Saint-Germanis-des Prés. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1951> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q193563> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/de-rerum-naturis-hrabanus-maurus-n-780-ca-m-4-2-85-title/5211 </li><li><a href='https://imagoarchive.it/bibliografia.html#braga-genesi-e-fortuna'>BRAGA 1994</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#httpswwwbedadlsgwiuni-muenchendeabout'>BEDA VENERABILIS, De locis sanctis </a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#kottje-ziegler-verzeichnis-der-handschriften'>KOTTJE-ZIEGLER 2012</a>, p. 160, n. 908 </li>" ;
        :has_url_manuscript    "https://gallica.bnf.fr/ark:/12148/btv1b9072638c/f2.item.zoom" ;
        :has_url_manuscript_description
                "https://archivesetmanuscrits.bnf.fr/ark:/12148/cc73163d" ;
        :last_mod_form         "2024-02-02T15:03:04.089Z"^^xsd:dateTime .

