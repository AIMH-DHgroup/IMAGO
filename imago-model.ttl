<https://imagoarchive.it/ontology/resources/manuscript/frankfurtammain/universittsbibliothekjohannchristiansenckenberg/praed._44/195v201r229r230v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
