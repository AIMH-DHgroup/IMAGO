<https://imagoarchive.it/ontology/resources/manuscript/rimini/bibliotecacivicagambalunga/43/1r16v>
        rdf:type               :Manuscript ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "" ] ;
        <http://erlangen-crm.org/211015/P1_is_identified_by>
                <https://imagoarchive.it/ontology/resources/signature/ms-1422> ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto cartaceo è formato da I, 96, I ff. e misura 233x162 mm. Il manoscritto è di due diverse mani: la prima, ff. 1-87, è umanistica, la seconda, ff. 88-95, è del riminese Ranieri Maschi e risale al 1476. Il codice trasmette: Mirabilia urbis Romae, ff. 1-16; De significatione quattuor elementorum que sunt signa populi Romani prisca capitulum, ff. 17-53; Indulgentiae ecclesiarum urbis Romae, ff. 54v-59v; Dicta philosophorum, ff. 61-79; Tacito, Liber de origine et situ Germanorum, ff. 79v-95r." ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1422> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q3639590> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#miedema-die-mirabilia-romae'>MIEDEMA 1996</a>, p. 68. </li>" ;
