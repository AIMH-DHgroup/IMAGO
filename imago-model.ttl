        <http://erlangen-crm.org/211015/P3_has_note>
                "Il manoscritto membranaceo è formato da 138 ff. Il manoscritto membranaceo è formato da 138 ff. e misura 167x125 mm. Esemplato probabilmente in Francia, fu posseduto dalla regina Cristina di Svezia. Il codice riporta  l'Historia Karoli Magni et Rotholandi dello Pseudo-Turpino, ff. 1r-37r; l'Epistola del Prete Gianni, ff. 37v-43v; Excidium Troiae, ff. 44r-54r; De Philoctete et De Polymestore, ff. 54v-55r; Darete Frigio, Historia de excidio Troiae, ff. 55r-83v; Giulio Valerio, Res gestae Alexandri Magni, ff. 85v-108r; Epistola Alexandri ad Aristotelem, ff. 108r-128r; Collatio Alexandri Magni et Dindimi, ff. 128v-138v. " ;
        <http://erlangen-crm.org/211015/P46_is_composed_of>
                <https://imagoarchive.it/ontology/resources/folios/mf-1665> ;
        <http://erlangen-crm.org/211015/P50_has_current_keeper>
                <http://www.wikidata.org/entity/Q213678> ;
        :compiled_form         "Sara Crea" ;
        :has_decoration        "" ;
        :has_secondary_source  "<li><a href='https://imagoarchive.it/bibliografia.html#boer-epistola-alexandri-ad-aristotelem'>Epistola Alexandri ad Aristotelem 1953</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#ross-a-check-list'>ROSS 1956</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#mirabile'>MIRABILE</a>, http://www.mirabileweb.it/title/epistola-alexandri-ad-aristotelem-title/203413 </li><li><a href='https://imagoarchive.it/bibliografia.html#wagner-die-epistola-presbiteri-johannis'>WAGNER 2000</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#brewer-prester-john'>BREWER 2015</a>, p. 308. </li>" ;
        :has_url_manuscript    "https://digi.vatlib.it/view/MSS_Reg.lat.657" ;
        :has_url_manuscript_description
                "https://portail.biblissima.fr/ark:/43093/mdata7a3ac801c0c5f65a98de6b203ea1449dda9a1e1b" ;
        :last_mod_form         "2024-04-05T06:50:59.457Z"^^xsd:dateTime .

