<https://imagoarchive.it/ontology/resources/print_edition/pe-253>
        rdf:type                    :Printed_Edition ;
        <http://erlangen-crm.org/211015/P102_has_title>
                [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Description des îles de l'Archipel par Christophe Buondelmonte" ] ;
        <http://erlangen-crm.org/211015/P3_has_note>
                "L’edizione a cura dell’ellenista e filologo francese Émile Legrand, sotto gli auspici dell’École des langues orientales (serie IV, tomo XIV), pubblica per la prima volta integralmente la traduzione anonima di età umanistica in greco del \"Liber insularum\" (pp. 1-100), trasmessa dal codex unicus Seragliensis gr. 24 del Topkapı Sarāyı Kütüphanesi di Istanbul (ex Biblioteca del Serraglio di Costantinopoli). Il volume è consultabile online al link: https://gallica.bnf.fr/ark:/12148/bpt6k5439459k/f50.item.zoom" ;
        <http://imagoarchive.it/ilrmoo/R4_embodies>
                <http://www.mirabileweb.it/title/liber-insularum-archipelagi-title/4379> ;
        <http://imagoarchive.it/ilrmoo/R69_has_physical_form>
                <https://imagoarchive.it/ontology/resources/print_edition/format/pf-253> ;
        :compiled_form              "Alessio Luca Bartelloni" ;
        :has_ecdotic_type           <https://imagoarchive.it/ontology/resources/print_edition/edition/edizione_con_traduzione> ;
        :has_figure_note            "36 illustrazioni di isole greche tratte dalla descrizione del \"Liber insularum\", tutte sotto forma di mappa con didascalie: p. 161 (Corfù); p. 162 (Paxos); p. 163 (Leucade); p. 164 (Itaca); p. 167 (Zante); p. 171 (Sapienza); p. 172 (Citera); p. 174 (Cerigotto); p. 179 (Scarpanto); p. 181 (Rodi); p. 185 (Simi); p. 187 (Piscopi, Nisiro); p. 189 (Astypalea); p. 192 (Policandro); p. 193 (Milo); p. 200 (Andro); p. 202 (\"Caloyer\"); p. 203 (Tino); p. 204 (Mykonos); p. 205 (Delo); p. 209 (Paro); p. 211 (Nasso); p. 215 (Anafi); p. 216 (Amorgo); p. 218 (Coo); p. 221 (Calimno); p. 222 (Lero); p. 223 (Patmo); p. 226 (Samo); p. 230 (Chio); p. 233 (Mitilene); p. 235 (Tenedo); p. 246 (Lemno); p. 254 (Eubea); 256 (Egina)." ;
        :has_introduction_note      "Préface alle pp. VII-XL." ;
        :has_other_contents         "Oltre alla versione greca del \"Liber insularum\", Legrand offre l'edizione della \"Descriptio insule Candie\" (pp. 101-137) e della \"Descriptio Cretae\" (pp. 139-156), versione compendiata della prima (le forme monottongata per «Candie» e dittongata per «Cretae» sono così in Legrand). L'edizione è completata da un’ampia introduzione ai testi (pp. VII-XL) e dalla traduzione in francese della versione greca del \"Liber insularum\", intervallata da 36 carte geografiche (pp. 157-256). Il secondo volume, annunciato da Legrand ma mai pubblicato, avrebbe dovuto contenere il commento all’opera." ;
        :has_primary_source         "\"Liber insularum archipelagi\" (versione greca): Istanbul, Topkapı Sarāyı Kütüphanesi, ms. Seragliensis gr. 24 (ex Biblioteca del Serraglio di Costantinopoli). \"Descriptio insule Candie\": Firenze, Biblioteca Medicea Laurenziana, ms. Plut. 29.42, ff. 1v-28r. \"Descriptio Crete\": Venezia, Biblioteca Nazionale Marciana, ms. lat. X, 124 (=3177), ff. 355r-362r." ;
        :has_reprint_date           "" ;
        :has_secondary_source       "<li><a href='https://imagoarchive.it/bibliografia.html#buondelmonti-liber-insularum-1897'>BUONDELMONTI, Liber insularum 1897</a>,  </li><li><a href='https://imagoarchive.it/bibliografia.html#bartelloni-al-descriptio-insule-crete'>BUONDELMONTI, Descriptio (tesi di laurea) 2022</a>, pp. 15-16, 45-46 </li>" ;
        :is_composed_of_author      [ <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                          "Émile Legrand" ] ;
        :is_composed_of_pages       <https://imagoarchive.it/ontology/resources/print_edition/pages/ppg-253> ;
        :is_composed_of_place_name  <https://imagoarchive.it/ontology/resources/print_edition/place/ppaa-253> ;
        :last_mod_form              "2024-03-11T15:09:44.32Z"^^xsd:dateTime .

