<https://imagoarchive.it/ontology/resources/fragment176>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :scadinavia ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Eya, facite, <i class='1'>Scandinavie</i> soboles, ut, cuius merito trepidatis adventum, quod ex vobis est, presentiam sitiatis." ;
        :has_textual_place  "Ep. V 12" .

