<https://imagoarchive.it/ontology/resources/fragment244>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                <https://imagoarchive.it/ontology/oc(c)eanus> ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Sed Monarcha non habet quod possit optare: sua nanque iurisdictio terminatur <i class='1'>Occeano</i> solum: quod non contingit principibus aliis, quorum principatus ad alios terminantur, ut puta regis Castelle ad illum qui regis Aragonum. Ex quo sequitur quod Monarcha sincerissimum inter mortales iustitie possit esse subiectum." ;
        :has_textual_place  "Mon. I xi 12" .

