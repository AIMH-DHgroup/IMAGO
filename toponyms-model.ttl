<https://imagoarchive.it/ontology/resources/fragment233>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :casentinenses ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Post hos Aquilegienses et Ystrianos cribremus, qui Ces fas- tu? crudeliter accentuando eructuant. Cumque hiis montaninas omnes et rusticanas loquelas eicimus, que semper mediastinis civibus accentus enormitate dissonare videntur, ut <i class='1'>Casentinenses</i> et Fractenses" ;
        :has_textual_place  "De vulg. I xi 6" .

<https://pleiades.stoa.org/places/422865>
        rdf:type  <http://erlangen-crm.org/211015/E53_Place> .

<https://imagoarchive.it/ontology/resources/fragment201>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :tuscia ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Serenissime atque piissime domine domine Margarite celestis miserationis intuitu Romanorum regine et semper Auguste, devotissima sua G. de Batifolle Dei et Imperii gratia largiente comitissa in <i class='1'>Tuscia</i> palatina, flexis humiliter genibus reverentie debitum exhibet." ;
        :has_textual_place  "Ep. IX 1" .

