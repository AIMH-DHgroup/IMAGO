foaf:Organization  rdf:type  owl:Class .

<https://imagoarchive.it/ontology/resources/fragment13>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :alpes ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Nec tantum ut assurgatis exhortor, sed ut illius obstupescatis aspectum. Qui bibitis fluenta eius maria navigatis; qui calcatis arenas littorum et <i class='1'>Alpium</i> summitates, que sue sunt; qui publicis quibuscunque gaudetis, et res privatas vinculo sue legis, non aliter, possidetis; nolite, velut ignari, decipere vosmetipsos tanquam sompniantes, in cordibus et dicentes: «Dominum non habemus»." ;
        :has_textual_place  "Ep. V 20" .

