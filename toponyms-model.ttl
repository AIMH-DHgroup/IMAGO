<https://imagoarchive.it/ontology/resources/fragment245>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :capitolium ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Cumque Galli, reliqua urbe iam capta, noctis tenebris confisi <i class='1'>Capitolium</i> furtim subirent, quod solum restabat ad ultimum interitum romani nominis, anserem ibi non ante visum cecinisse Gallos adesse atque custodes ad defensandum Capitolium excitasse Livius et multi scriptores illustres concorditer contestantur." ;
        :has_textual_place  "Mon. II iv 7" .

