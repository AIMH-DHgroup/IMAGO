                :marchia_anconitana ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Post hos incolas <i class='1'>Anconitane Marchie</i> decerpamus, qui Chignamente sciate, sciate locuntur: cum quibus et Spoletanos abicimus." ;
        :has_textual_place  "De vulg. I xi 3" .

