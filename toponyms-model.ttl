<https://www.wikidata.org/entity/Q160954>
        rdf:type                   <http://erlangen-crm.org/211015/E53_Place> ;
        <http://erlangen-crm.org/211015/P168_place_is_defined_by>
                "POINT(12.41 42.296111)" ;
        :is_identified_by_toponym  :civitas_castellana .

<https://imagoarchive.it/ontology/resources/fragment9>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :affrica ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Secunda Dido fuit, regina et mater Cartaginensium in <i class='1'>Affrica</i>; et quod fuerit coniunx, Idem noster vaticinatur in quarto; inquit enim de Didone: Nec iam furtivum Dido meditatur amorem: coniugium vocat; hoc pretexit nomine culpam." ;
        :has_textual_place  "Mon. II iii 15" .

<https://imagoarchive.it/ontology/resources/fragment218>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
