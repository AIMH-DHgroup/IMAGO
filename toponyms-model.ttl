<https://imagoarchive.it/ontology/resources/fragment156>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :roma ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Nos quoque eundem Patrem et Filium, eundem Deum et hominem, nec non eandem Matrem et Virginem profitentes, propter quos et propter quorum salutem ter de caritate interrogatum et dictum est: Petre, pasce sacrosanctum ovile; <i class='1'>Romam</i> - cui, post tot triumphorum pompas, et verbo et opere Christus orbis confirmavit imperium, quam etiam ille Petrus, et Paulus gentium predicator, in apostolicam sedem aspergine proprii sanguinis consecravit -, cum Ieremia, non lugenda prevenientes sed post ipsa dolentes, viduam et desertam lugere compellimur." ;
        :has_textual_place  "Ep. XI 4" .

