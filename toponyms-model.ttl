<https://imagoarchive.it/ontology/resources/fragment232>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :meotidis_palus ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Ab uno postea eodemque ydiomate in vindice confusione recepto diversa vulgaria traxerunt originem, sicut inferius ostendemus. Nam totum quod ab hostiis Danubii sive <i class='2'>Meotidis paludibus</i> usque ad fines occidentales Anglie Ytalorum Francorumque finibus et Oceano limitatur, solum unum obtinuit ydioma, licet postea per Sclavones, Ungaros, Teutonicos, Saxones, Anglicos et alias nationes quamplures fuerit per diversa vulgaria dirivatum, hoc solo fere omnibus in signum eiusdem principii remanente, quod quasi predicti omnes iò affirmando respondent." ;
        :has_textual_place  "De vulg. I viii 3" .

<https://pleiades.stoa.org/places/383804>
        rdf:type  <http://erlangen-crm.org/211015/E53_Place> .

