<https://imagoarchive.it/ontology/resources/fragment138>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                <https://imagoarchive.it/ontology/oc(c)eanus> ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Nam etsi vim passa in angustum gubernacula sua contraxerit, undique tamen de inviolabili iure fluctus Amphitritis attingens vix ab inutili unda <i class='1'>Oceani</i> se circumcingi dignatur." ;
        :has_textual_place  "Ep. VII 12" .

