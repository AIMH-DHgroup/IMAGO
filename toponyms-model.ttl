<https://imagoarchive.it/ontology/resources/fragment235>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :trinacria ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Sed hec fama <i class='1'>Trinacrie</i> terre, si recte signum ad quod tendit inspiciamus, videtur tantum in obproprium ytalorum principum remansisse, qui non heroico more sed plebeio secuntur superbiam." ;
        :has_textual_place  "De vulg. I xii 3" .

