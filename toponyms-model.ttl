<https://imagoarchive.it/ontology/resources/fragment58>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :europa ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Ab isto incipiens ydiomate, videlicet a finibus Ungarorum versus orientem, aliud occupavit totum quod ab inde vocatur <i class='1'>Europa</i>, nec non ulterius est protractum." ;
        :has_textual_place  "De vulg. I viii 4" .

