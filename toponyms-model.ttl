<https://imagoarchive.it/ontology/resources/fragment7>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :affrica ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Quod vero Athlas de Affrica fuerit, mons in illa suo nomine dictus est testis, quem esse in <i class='2'>Affrica</i> dicit Orosius in sua mundi descriptione sic: «Ultimus autem finis eius est mons Athlas et insule quas Fortunatas vocant»; “eius”, idest Affrice, quia de ipsa loquebatur." ;
        :has_textual_place  "Mon. II iii 13" .

