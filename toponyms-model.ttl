<https://imagoarchive.it/ontology/resources/fragment65>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :europa ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Post hos vero Xerxes, Darii filius et rex in Persis, cum tanta gentium multitudine mundum invasit, cum tanta potentia, ut transitum maris Asyam ab <i class='3'>Europa</i> dirimentis inter Sexton et Abidon ponte superaverit. Cuius operis admirabilis Lucanus in secundo Farsalie memor fuit; canit enim ibi sic: Tales fama canit tumidum super equora Xerxem construxisse vias. Et tandem, miserabiliter ab incepto repulsus, ad bravium pervenire non potuit." ;
        :has_textual_place  "Mon. II viii 7" .

<https://imagoarchive.it/ontology/resources/fragment161>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :roma ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Sed quod <i class='1'>Roma</i> palmam tanti bravii sit adepta, multis comprobatur testimoniis. Ait enim Poeta noster in primo: Certe hinc Romanos olim volventibus annis hinc fore ductores, revocato a sanguine Teucri, qui mare, qui terras omni ditione tenerent." ;
        :has_textual_place  "Mon. II viii 11" .

<https://www.wikidata.org/entity/Q21>
