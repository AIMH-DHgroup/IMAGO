<https://imagoarchive.it/ontology/resources/fragment53>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :ethna ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "arida Ciclopum placeant quod saxa sub <i class='1'>Ethna</i>»." ;
        :has_textual_place  "Eg. IV 27" .

<https://imagoarchive.it/ontology/resources/fragment21>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :apulia ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Et dextri regiones sunt Apulia, sed non tota, Roma, Ducatus, Tuscia et Ianuensis Marchia; sinistri autem pars <i class='6'>Apulie</i>, Marchia Anconitana, Romandiola, Lombardia, Marchia Trivisiana cum Venetiis. Forum Iulii vero et Ystria non nisi leve Ytalie esse possunt; nec insule Tyreni maris, videlicet Sicilia et Sardinia, non nisi dextre Ytalie sunt, vel ad dextram Ytaliam sociande." ;
        :has_textual_place  "De vulg. I x 5" .

