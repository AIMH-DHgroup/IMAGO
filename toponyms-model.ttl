<https://pleiades.stoa.org/places/383603>
        rdf:type  <http://erlangen-crm.org/211015/E53_Place> .

<https://imagoarchive.it/ontology/resources/fragment206>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :vercelle ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Quid, preses unice mundi, peregisse preconicis cum cervicem Cremone deflexeris contumacis? nonne tunc vel Brixie vel Papie rabies inopina turgescet? Ymo, que cum etiam flagellata resederit, mox alia <i class='4'>Vercellis</i> vel Pergami vel alibi returgebit, donec huius scatescentie causa radicalis tollatur, et radice tanti erroris avulsa, cum trunco rami pungitivi arescant." ;
        :has_textual_place  "Ep. VII 22" .

<http://erlangen-crm.org/211015/E42_Identifier>
        rdf:type         owl:Class ;
        rdfs:subClassOf  [ rdf:type            owl:Restriction ;
