<https://imagoarchive.it/ontology/resources/fragment30>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :asya ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Post hos vero Xerxes, Darii filius et rex in Persis, cum tanta gentium multitudine mundum invasit, cum tanta potentia, ut transitum maris <i class='2'>Asyam</i> ab Europa dirimentis inter Sexton et Abidon ponte superaverit. Cuius operis admirabilis Lucanus in secundo Farsalie memor fuit; canit enim ibi sic: Tales fama canit tumidum super equora Xerxem construxisse vias. Et tandem, miserabiliter ab incepto repulsus, ad bravium pervenire non potuit." ;
        :has_textual_place  "Mon. II viii 7" .

