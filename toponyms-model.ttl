<https://imagoarchive.it/ontology/resources/fragment208>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :verona ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Magnifico atque victorioso domino domino Cani Grandi de la Scala sacratissimi Cesarei Principatus in urbe <i class='1'>Verona</i> et civitate Vicentie Vicario generali, devotissimus suus Dantes Alagherii florentinus natione non moribus, vitam orat per tempora diuturna felicem et gloriosi nominis perpetuum incrementum." ;
        :has_textual_place  "Ep. XIII 1" .

