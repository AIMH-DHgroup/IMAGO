<https://imagoarchive.it/ontology/resources/fragment157>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :roma ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Quod ut gloriosa longanimitas foveat et defendat, <i class='1'>Romam</i> urbem, nunc utroque lumine destitutam, nunc Annibali nedum alii miserandam, solam sedentem et viduam prout superius proclamatur, qualis est, pro modulo vestre ymaginis ante mentales oculos affigatis oportet." ;
        :has_textual_place  "Ep. XI 22" .

