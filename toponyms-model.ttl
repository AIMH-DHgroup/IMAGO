<https://imagoarchive.it/ontology/resources/fragment43>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :brixia ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Quid, preses unice mundi, peregisse preconicis cum cervicem Cremone deflexeris contumacis? nonne tunc vel <i class='2'>Brixie</i> vel Papie rabies inopina turgescet? Ymo, que cum etiam flagellata resederit, mox alia Vercellis vel Pergami vel alibi returgebit, donec huius scatescentie causa radicalis tollatur, et radice tanti erroris avulsa, cum trunco rami pungitivi arescant." ;
        :has_textual_place  "Ep. VII 22" .

