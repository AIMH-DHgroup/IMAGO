<https://imagoarchive.it/ontology/resources/fragment5>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :egiptus ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Preter istos et post, Alexander rex Macedo maxime omnium ad palmam Monarchie propinquans, dum per legatos ad deditionem Romanos premoneret, apud <i class='1'>Egiptum</i> ante Romanorum responsionem, ut Livius narrat, in medio quasi cursu collapsus est." ;
        :has_textual_place  "Mon. II viii 8" .

