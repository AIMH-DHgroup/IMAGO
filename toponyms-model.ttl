<https://pleiades.stoa.org/places/383798>
        rdf:type  <http://erlangen-crm.org/211015/E53_Place> .

<https://imagoarchive.it/ontology/resources/fragment148>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :pergama ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Videbitis edificia vestra non necessitati prudenter instructa sed delitiis inconsulte mutata, que <i class='1'>Pergama</i> rediviva non cingunt, tam ariete ruere, tristes, quam igne cremari." ;
        :has_textual_place  "Ep. VI 15" .

