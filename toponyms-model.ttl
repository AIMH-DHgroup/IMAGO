<https://imagoarchive.it/ontology/resources/fragment250>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :ytali ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Ab uno postea eodemque ydiomate in vindice confusione recepto diversa vulgaria traxerunt originem, sicut inferius ostendemus. Nam totum quod ab hostiis Danubii sive Meotidis paludibus usque ad fines occidentales Anglie <i class='4'>Ytalorum</i> Francorumque finibus et Oceano limitatur, solum unum obtinuit ydioma, licet postea per Sclavones, Ungaros, Teutonicos, Saxones, Anglicos et alias nationes quamplures fuerit per diversa vulgaria dirivatum, hoc solo fere omnibus in signum eiusdem principii remanente, quod quasi predicti omnes iò affirmando respondent." ;
        :has_textual_place  "De vulg. I viii 3" .

<https://www.wikidata.org/entity/Q1229>
