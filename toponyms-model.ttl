dcterms:modified  rdf:type  owl:AnnotationProperty .

<https://imagoarchive.it/ontology/resources/fragment200>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :tuscia ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Gloriosissime atque clementissime domine domine Margarite divina providentia Romanorum regine et semper Auguste, G. de Batifolle Dei et adiuvalis Magnificentie gratia comitissa in <i class='1'>Tuscia</i> palatina, tam debite quam devote subiectionis officium ante pedes." ;
        :has_textual_place  "Ep. VIII 1" .

