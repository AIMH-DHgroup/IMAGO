<https://imagoarchive.it/ontology/resources/fragment210>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :verona ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Determinata est hec phylosophia dominante invicto domino, domino Cane Grandi de Scala pro Imperio sacrosancto Romano, per me Dantem Alagherium, phylosophorum minimum, in inclita urbe <i class='1'>Verona</i>, in sacello Helene gloriose, coram universo clero Veronensi, preter quosdam qui, nimia caritate ardentes, aliorum rogamina non admittunt, et per humilitatis virtutem Spiritus Sancti pauperes, ne aliorum excellentiam probare videantur, sermonibus eorum interesse refugiunt." ;
        :has_textual_place  "Questio 87" .

