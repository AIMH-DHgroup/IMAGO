<https://imagoarchive.it/ontology/resources/fragment187>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :tiberis ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Nonne transitus Clelie mirabilis fuit, cum mulier cumque captiva, in obsidione Porsenne, abruptis vinculis, miro Dei auxilio adiuta, transnavit <i class='1'>Tyberim</i>, sicut omnes fere scribe romane rei ad gloriam ipsius commemorant?" ;
        :has_textual_place  "Mon. II iv 10" .

<https://pleiades.stoa.org/places/1332>
        rdf:type  <http://erlangen-crm.org/211015/E53_Place> .

<https://www.wikidata.org/entity/Q1282>
        rdf:type                   <http://erlangen-crm.org/211015/E53_Place> ;
        <http://erlangen-crm.org/211015/P168_place_is_defined_by>
                "POINT(12.5 42.5)" ;
        owl:sameAs                 <https://pleiades.stoa.org/places/432900> ;
        :is_identified_by_toponym  :latium .

<https://imagoarchive.it/ontology/resources/fragment109>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :ytalia ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Letare iam nunc miseranda <i class='1'>Ytalia</i> etiam Saracenis, que statim invidiosa per orbem videberis, quia sponsus tuus, mundi solatium et gloria plebis tue, clementissimus Henricus, divus et Augustus et Cesar, ad nuptias properat." ;
        :has_textual_place  "Ep. V 5" .

:is_text_explicit_of  rdf:type  owl:ObjectProperty ;
        rdfs:comment        "In the IMAGO Ontology 'is text explicit of' links E90 Symbolic Object to class Manuscript"@en ;
