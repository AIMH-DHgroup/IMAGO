<https://imagoarchive.it/ontology/resources/fragment217>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :marchia_trivisiana ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Et dextri regiones sunt Apulia, sed non tota, Roma, Ducatus, Tuscia et Ianuensis Marchia; sinistri autem pars Apulie, Marchia Anconitana, Romandiola, Lombardia, <i class='10'>Marchia Trivisiana</i> cum Venetiis. Forum Iulii vero et Ystria non nisi leve Ytalie esse possunt; nec insule Tyreni maris, videlicet Sicilia et Sardinia, non nisi dextre Ytalie sunt, vel ad dextram Ytaliam sociande." ;
        :has_textual_place  "De vulg. I x 5" .

