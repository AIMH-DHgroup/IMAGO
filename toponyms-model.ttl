<https://imagoarchive.it/ontology/resources/fragment196>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :tuscia ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Nam qui virtutem honorabat in terris, nunc a Virtutibus honoratur in celis; et qui Romane aule palatinus erat in <i class='1'>Tuscia</i>, nunc regie sempiterne aulicus preelectus in superna Ierusalem cum beatorum principibus gloriatur." ;
        :has_textual_place  "Ep. II 6" .

<https://www.wikidata.org/entity/Q9430>
