<https://imagoarchive.it/ontology/resources/fragment249>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :caudine_furce ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Et hoc Lucanus in secundo ad exemplum reducit sic: Aut Collina tulit stratas quot porta catervas tunc cum pene caput mundi rerumque potestas mutavit translata locum, romanaque Samnis ultra <i class='1'>Caudinas</i> speravit vulnera <i>furcas*</i>." ;
        :has_textual_place  "Mon. II ix 17" .

