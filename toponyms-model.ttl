        rdfs:label          "is composed of pages"@en ;
        rdfs:subPropertyOf  <http://erlangen-crm.org/211015/P106_is_composed_of> .

<https://pleiades.stoa.org/places/1004>
        rdf:type  <http://erlangen-crm.org/211015/E53_Place> .

<https://imagoarchive.it/ontology/resources/fragment150>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :perusium ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "De <i class='1'>Perusio</i>, Urbe Veteri, Viterbio, nec non de Civitate Castellana, propter affinitatem quam habent cum Romanis et Spoletanis, nichil tractare intendimus." ;
        :has_textual_place  "De vulg. I xiii 3" .

