<https://imagoarchive.it/ontology/resources/fragment55>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :europa ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Sed sive advene tunc primitus advenissent, sive ad <i class='1'>Europam</i> indigene repedassent, ydioma secum tripharium homines actulerunt; et afferentium hoc alii meridionalem, alii septentrionalem regionem in Europa sibi sortiti sunt; et tertii, quos nunc Grecos vocamus, partim Europe, partim Asye occuparunt." ;
        :has_textual_place  "De vulg. I viii 2" .

<https://imagoarchive.it/ontology/resources/fragment151>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :petramala ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "In hoc, sicut etiam in multis aliis, <i class='1'>Petramala</i> civitas amplissima est, et patria maiori parti filiorum Adam. Nam quicunque tam obscene rationis est ut locum sue nationis delitiosissimum credat esse sub sole, hic etiam pre cunctis proprium vulgare licetur, idest maternam locutionem, et per consequens credit ipsum fuisse illud quod fuit Ade." ;
        :has_textual_place  "De vulg. I vi 2" .

<https://imagoarchive.it/ontology/resources/fragment23>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :asya ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Sed sive advene tunc primitus advenissent, sive ad Europam indigene repedassent, ydioma secum tripharium homines actulerunt; et afferentium hoc alii meridionalem, alii septentrionalem regionem in Europa sibi sortiti sunt; et tertii, quos nunc Grecos vocamus, partim Europe, partim <i class='4'>Asye</i> occuparunt." ;
        :has_textual_place  "De vulg. I viii 2" .

