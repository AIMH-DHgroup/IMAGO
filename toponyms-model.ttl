<https://imagoarchive.it/ontology/resources/fragment228>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :perse ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Post hos vero Xerxes, Darii filius et rex in <i class='1'>Persis</i>, cum tanta gentium multitudine mundum invasit, cum tanta potentia, ut transitum maris Asyam ab Europa dirimentis inter Sexton et Abidon ponte superaverit. Cuius operis admirabilis Lucanus in secundo Farsalie memor fuit; canit enim ibi sic: Tales fama canit tumidum super equora Xerxem construxisse vias. Et tandem, miserabiliter ab incepto repulsus, ad bravium pervenire non potuit." ;
        :has_textual_place  "Mon. II viii 7" .

