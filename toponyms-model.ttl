<https://imagoarchive.it/ontology/resources/fragment19>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                <https://imagoarchive.it/ontology/apen(n)inus> ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Cumque tu, Cesaris et Augusti successor, <i class='1'>Apennini</i> iuga transiliens veneranda signa Tarpeia retulisti, protinus longa substiterunt suspiria diluvia desierunt; et, ceu Titan, preoptatus exoriens, nova spes Latio seculi melioris effulsit." ;
        :has_textual_place  "Ep. VII 5" .

<https://imagoarchive.it/ontology/resources/fragment115>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :ytalia ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Missum de Castro Poppii xv Kalendas Iunias, faustissimi cursus Henrici Cesaris ad <i class='2'>Ytaliam</i> anno primo." ;
        :has_textual_place  "Ep. X 6" .

