        owl:sameAs                 <https://pleiades.stoa.org/places/98912> ;
        :is_identified_by_toponym  :anglia .

<https://imagoarchive.it/ontology/resources/fragment33>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :ausonia ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "O felicem populum, o <i class='1'>Ausoniam</i> te gloriosam, si vel nunquam infirmator ille Imperii tui natus fuisset, vel nunquam sua pia intentio ipsum fefellisset!" ;
        :has_textual_place  "Mon. II xi 8" .

