<https://imagoarchive.it/ontology/resources/fragment86>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :ierusalem ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Quod quidem de specula punctalis eternitatis intuens qui solus eternus est, mentem Deo dignam viri prophetici per Spiritum Sanctum sua iussione impressit, et is sanctam <i class='1'>Ierusalem</i> velut exstinctam per verba presignata et nimium, proh dolor!, iterata deflevit." ;
        :has_textual_place  "Ep. XI 3" .

<https://imagoarchive.it/ontology/resources/fragment182>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :spoletum ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Sed recensete fulmina Federici prioris, et Mediolanum consulite pariter et <i class='2'>Spoletum</i>; quoniam ipsorum perversione simul et eversione discussa viscera vestra nimium dilatata frigescent, et corda vestra nimium ferventia contrahentur." ;
        :has_textual_place  "Ep. VI 20" .

<https://imagoarchive.it/ontology/resources/fragment104>
        rdf:type            <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
        <http://erlangen-crm.org/211015/P106_is_composed_of>
                :ytalia ;
        <http://erlangen-crm.org/211015/P190_has_symbolic_content>
                "Hoc autem vulgare quod illustre, cardinale, aulicum et curiale ostensum est, dicimus esse illud quod vulgare latium appellatur. Nam sicut quoddam vulgare est invenire quod proprium est Cremone, sic quoddam est invenire quod proprium est Lombardie; et sicut est invenire aliquod quod sit proprium Lombardie, sic est invenire aliquod quod sit totius sinistre <i class='4'>Ytalie</i> proprium; et sicut omnia hec est invenire, sic et illud quod totius Ytalie est. Et sicut illud cremonense ac illud lombardum et tertium semilatium dicitur, sic istud, quod totius Ytalie est, latium vulgare vocatur. Hoc enim usi sunt doctores illustres qui lingua vulgari poetati sunt in Ytalia, ut Siculi, Apuli, Tusci, Romandioli, Lombardi et utriusque Marchie viri." ;
        :has_textual_place  "De vulg. I xix 1" .

