###  http://imagoarchive.it/ilrmoo/R33_has_content
:R33_has_content rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf <http://erlangen-crm.org/211015/P3_has_note> ;
                 rdfs:domain :F12_Nomen ;
                 rdfs:range xsd:string ;
                 rdfs:comment "This property associates an instance of F12 Nomen with a sign or arrangement of signs that is used to refer to something through that instance of F12 Nomen."@en ;
                 rdfs:label "R33 has content"@en .


