###  http://imagoarchive.it/ilrmoo/R4_embodies
:R4_embodies rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://erlangen-crm.org/211015/P165_incorporates> ;
             owl:inverseOf :R4i_is_embodied_in ;
             rdfs:domain :F3_Manifestation ;
             rdfs:range :F2_Expression ;
             rdfs:comment "This property associates an instance of F3 Manifestation with one or more instances of F2 Expression which are rendered by this instance of F3 Manifestation. The manifestation formats the expression(s) in the way they are to be presented to some public, including specifying the intended sensory impression (such as visual appearance or audio rendition). The content of the embodied instances of F2 Expression should be defined at a symbolic level (such as a text or notated music) more abstract than the embodying instance of F3 Manifestation (such as a book or a notated score)."@en ;
             rdfs:label "R4 embodies"@en .


