###  http://imagoarchive.it/ilrmoo/R10_has_member
:R10_has_member rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://erlangen-crm.org/211015/P148_has_component> ;
                owl:inverseOf :R10i_is_member_of ;
                rdfs:domain :F1_Work ;
                rdfs:range :F1_Work ;
                rdfs:comment "This property associates an instance of F1 Work with another instance of F1 Work that forms a part of it. This property is transitive. An instance of F1 Work may neither directly nor indirectly be a member of itself. Instances of F1 Work that are not members of one another may not share a common member."@en ;
                rdfs:label "R10 has member"@en .


###  http://imagoarchive.it/ilrmoo/R10i_is_member_of
:R10i_is_member_of rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://erlangen-crm.org/211015/P148i_is_component_of> ;
                   rdfs:domain :F1_Work ;
                   rdfs:range :F1_Work ;
                   rdfs:label "R10i is member of"@en .


###  http://imagoarchive.it/ilrmoo/R11_has_issuing_rule
:R11_has_issuing_rule rdf:type owl:ObjectProperty ;
                      owl:inverseOf :R11i_is_issuing_rule_of ;
                      rdfs:domain :F18_Serial_Work ;
                      rdfs:range <http://erlangen-crm.org/211015/E29_Design_or_Procedure> ;
                      rdfs:label "R11 has issuing rule"@en .


###  http://imagoarchive.it/ilrmoo/R11i_is_issuing_rule_of
:R11i_is_issuing_rule_of rdf:type owl:ObjectProperty ;
                         rdfs:domain <http://erlangen-crm.org/211015/E29_Design_or_Procedure> ;
                         rdfs:range :F18_Serial_Work ;
                         rdfs:label "R11i is issuing rule of"@en .


###  http://imagoarchive.it/ilrmoo/R15_has_fragment
:R15_has_fragment rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://erlangen-crm.org/211015/P106_is_composed_of> ;
                  owl:inverseOf :R15i_is_fragment_of ;
                  rdfs:domain :F2_Expression ;
                  rdfs:range <http://erlangen-crm.org/211015/E90_Symbolic_Object> ;
                  rdfs:comment """This property associates an instance of E90 Symbolic Object with an instance of F2 Expression of which it is a fragment. The fragment is not itself an instance of F2 Expression as it does not express any instance of F1 Work. When the fragment consists of intelligible words it is an instance of E33 Linguistic Object.

An instance of E90 Symbolic Object can be extracted from an instance of F2 Expression due to an accident, such as loss of material over time, e.g. the only remaining manuscript of an ancient text being partially eaten by worms, or due to deliberate isolation, such as excerpts taken from a text by the compiler of a collection of excerpts.

An instance of E90 Symbolic Object is only considered a fragment of an instance of F2 Expression when related to its occurrence in a known or assumed whole by the R15 has fragment (is fragment of) property. The size of an instance of E90 Symbolic Object ranges from more than 99% of an instance of F2 Expression to tiny bits (a few words from a text, one bar from a musical composition, one detail from a still image, a two-second clip from a video, etc.)."""@en ;
                  rdfs:label "R15 has fragment"@en .


###  http://imagoarchive.it/ilrmoo/R15i_is_fragment_of
:R15i_is_fragment_of rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://erlangen-crm.org/211015/P106i_forms_part_of> ;
                     rdfs:label "R15i is fragment of"@en .


###  http://imagoarchive.it/ilrmoo/R16_initiated
:R16_initiated rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://erlangen-crm.org/211015/P94_has_created> ;
               owl:inverseOf :R16i_was_initiated_by ;
               rdfs:domain :F27_Work_Conception ;
               rdfs:range :F1_Work ;
               rdfs:comment """This property associates the first conception of a work and the instance of F1 Work itself that ensued from a given initial idea.

It marks the origin of the causality chain that results in a work’s coming into existence."""@en ;
               rdfs:label "R16 initiated"@en .


###  http://imagoarchive.it/ilrmoo/R16i_was_initiated_by
:R16i_was_initiated_by rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://erlangen-crm.org/211015/P94i_was_created_by> ;
                       rdfs:domain :F1_Work ;
                       rdfs:range :F27_Work_Conception ;
                       rdfs:label "R16i was initiated by"@en .


###  http://imagoarchive.it/ilrmoo/R17_created
:R17_created rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://erlangen-crm.org/211015/P94_has_created> ;
             owl:inverseOf :R17i_was_created_by ;
             rdfs:domain :F28_Expression_Creation ;
             rdfs:range :F2_Expression ;
             rdfs:comment "This property associates the instance of F2 Expression that was first externalised during a particular instance of F28 Expression Creation event with that particular creation event."@en ;
             rdfs:label "R17 created"@en .


###  http://imagoarchive.it/ilrmoo/R17i_was_created_by
:R17i_was_created_by rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://erlangen-crm.org/211015/P94i_was_created_by> ;
                     rdfs:domain :F2_Expression ;
                     rdfs:range :F28_Expression_Creation ;
                     rdfs:label "R17i was created by"@en .


###  http://imagoarchive.it/ilrmoo/R18_created
:R18_created rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://erlangen-crm.org/211015/P108_has_produced> ;
             owl:inverseOf :R18i_was_created_by ;
             rdfs:domain :F28_Expression_Creation ;
             rdfs:range :F5_Item ;
             rdfs:comment "This property associates an instance of F28 Expression Creation with the first physical objects, instances of F5 Item, in which the resulting instance of F2 Expression was embodied."@en ;
             rdfs:label "R18 created"@en .


###  http://imagoarchive.it/ilrmoo/R18i_was_created_by
:R18i_was_created_by rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://erlangen-crm.org/211015/P108i_was_produced_by> ;
                     rdfs:domain :F5_Item ;
                     rdfs:range :F28_Expression_Creation ;
                     rdfs:label "R18i was created by"@en .


###  http://imagoarchive.it/ilrmoo/R19_created_a_realisation_of
:R19_created_a_realisation_of rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf <http://erlangen-crm.org/211015/P16_used_specific_object> ;
                              owl:inverseOf :R19i_was_realised_through ;
                              rdfs:domain :F28_Expression_Creation ;
                              rdfs:range :F1_Work ;
                              rdfs:comment "This property associates an instance of F28 Expression Creation with the instance of F1 Work which was externalised in the instance of F2 Expression created by this creation event."@en ;
                              rdfs:label "R19 created a realisation of"@en .


###  http://imagoarchive.it/ilrmoo/R19i_was_realised_through
:R19i_was_realised_through rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://erlangen-crm.org/211015/P16i_was_used_for> ;
                           rdfs:domain :F1_Work ;
                           rdfs:range :F28_Expression_Creation ;
                           rdfs:label "R19i was realised through"@en .


###  http://imagoarchive.it/ilrmoo/R1_is_logical_successor_of
:R1_is_logical_successor_of rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf <http://erlangen-crm.org/211015/P130_shows_features_of> ;
                            owl:inverseOf :R1i_has_successor ;
                            rdfs:domain :F1_Work ;
                            rdfs:range :F1_Work ;
                            rdfs:label "R1 is logical successor of"@en .


###  http://imagoarchive.it/ilrmoo/R1i_has_successor
:R1i_has_successor rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://erlangen-crm.org/211015/P130i_features_are_also_found_on> ;
                   rdfs:domain :F1_Work ;
                   rdfs:range :F1_Work ;
                   rdfs:label "R1i has successor"@en .


###  http://imagoarchive.it/ilrmoo/R20_recorded
:R20_recorded rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://erlangen-crm.org/211015/P15_was_influenced_by> ;
              owl:inverseOf :R20i_was_recorded_through ;
              rdfs:domain :F29_Recording_Event ;
              rdfs:range :F31_Performance ;
              rdfs:label "R20 recorded"@en .


###  http://imagoarchive.it/ilrmoo/R20i_was_recorded_through
:R20i_was_recorded_through rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://erlangen-crm.org/211015/P15i_influenced> ;
                           rdfs:domain :F31_Performance ;
                           rdfs:range :F29_Recording_Event ;
                           rdfs:label "R20i was recorded through"@en .


###  http://imagoarchive.it/ilrmoo/R24_created
:R24_created rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :R17_created ;
             owl:inverseOf :R24i_was_created_through ;
             rdfs:domain :F30_Manifestation_Creation ;
             rdfs:range :F3_Manifestation ;
             rdfs:comment "This property associates the instance of F3 Manifestation that was created during a particular instance of F30 Manifestation Creation with that instance of F30 Manifestation Creation event."@en ;
             rdfs:label "R24 created"@en .


###  http://imagoarchive.it/ilrmoo/R24i_was_created_through
:R24i_was_created_through rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf :R17i_was_created_by ;
                          rdfs:domain :F3_Manifestation ;
                          rdfs:range :F30_Manifestation_Creation ;
                          rdfs:label "R24i was created through"@en .


###  http://imagoarchive.it/ilrmoo/R26_produced_things_of_type
:R26_produced_things_of_type rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf <http://erlangen-crm.org/211015/P186_produced_thing_of_product_type> ;
                             owl:inverseOf :R26i_was_produced_by ;
                             rdfs:domain :F32_Carrier_Production_Event ;
                             rdfs:range <http://erlangen-crm.org/211015/E99_Product_Type> ;
                             rdfs:comment "This property associates an instance of F32 Carrier Production Event directly with the instance of E99 Product Type that is the prototype displaying the features that all of the F5 Items produced should display. This property is used in preference to R27 materialized (was materialized by) when the instance of F3 Manifestation that is materialized by the instance of F32 Carrier Production Event is also an instance of E99 Product Type."@en ;
                             rdfs:label "R26 produced things of type"@en .


###  http://imagoarchive.it/ilrmoo/R26i_was_produced_by
:R26i_was_produced_by rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://erlangen-crm.org/211015/P186i_is_produced_by> ;
                      rdfs:domain <http://erlangen-crm.org/211015/E99_Product_Type> ;
                      rdfs:range :F32_Carrier_Production_Event ;
                      rdfs:label "R26i was produced by"@en .


###  http://imagoarchive.it/ilrmoo/R27_materialized
:R27_materialized rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://erlangen-crm.org/211015/P16_used_specific_object> ;
                  owl:inverseOf :R27i_was_materialized_by ;
                  rdfs:domain :F32_Carrier_Production_Event ;
                  rdfs:range :F3_Manifestation ;
                  rdfs:comment "This property associates an instance of F32 Carrier Production Event with the set of signs provided by the publisher to be carried by all of the produced items (i.e., the instances of F5 Item) and any other physical features foreseen as integral to the instance of F3 Manifestation that is materialised."@en ;
                  rdfs:label "R27 materialized"@en .


###  http://imagoarchive.it/ilrmoo/R27i_was_materialized_by
:R27i_was_materialized_by rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://erlangen-crm.org/211015/P16i_was_used_for> ;
                          rdfs:domain :F3_Manifestation ;
                          rdfs:range :F32_Carrier_Production_Event ;
                          rdfs:label "R27i was materialized by"@en .


###  http://imagoarchive.it/ilrmoo/R28_produced
:R28_produced rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://erlangen-crm.org/211015/P108_has_produced> ;
              owl:inverseOf :R28i_was_produced_by ;
              rdfs:domain :F32_Carrier_Production_Event ;
              rdfs:range :F5_Item ;
              rdfs:comment "This property associates an instance of F32 Carrier Production Event with any one of the produced items (i.e., the instances of F5 Item)."@en ;
              rdfs:label "R28 produced"@en .


###  http://imagoarchive.it/ilrmoo/R28i_was_produced_by
:R28i_was_produced_by rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://erlangen-crm.org/211015/P108i_was_produced_by> ;
                      rdfs:domain :F5_Item ;
                      rdfs:range :F32_Carrier_Production_Event ;
                      rdfs:label "R28i was produced by"@en .


###  http://imagoarchive.it/ilrmoo/R29_reproduced_object
:R29_reproduced_object rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://erlangen-crm.org/211015/P16_used_specific_object> ;
                       owl:inverseOf :R29i_was_object_reproduced_by ;
                       rdfs:domain :F33_Reproduction_Event ;
                       rdfs:range :F5_Item ;
                       rdfs:comment "This property associates an instance of F33 Reproduction Event with an instance of F5 Item it reproduces."@en ;
                       rdfs:label "R29 reproduced object"@en .


###  http://imagoarchive.it/ilrmoo/R29i_was_object_reproduced_by
:R29i_was_object_reproduced_by rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf <http://erlangen-crm.org/211015/P16i_was_used_for> ;
                               rdfs:domain :F5_Item ;
                               rdfs:range :F33_Reproduction_Event ;
                               rdfs:label "R29i was object reproduced by"@en .


###  http://imagoarchive.it/ilrmoo/R2_is_derivative_of
:R2_is_derivative_of rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://erlangen-crm.org/211015/P130_shows_features_of> ;
                     owl:inverseOf :R2i_has_derivative ;
                     rdfs:domain :F1_Work ;
                     rdfs:range :F1_Work ;
                     rdfs:comment """This property associates an instance of F1 Work which modifies the content of another instance of F1 Work with the latter. This property is transitive. 

The property R2.1 has type of this property allows for specifying the kind of derivation, such as adaptation, summarisation, etc."""@en ;
                     rdfs:label "R2 is derivative of"@en .


###  http://imagoarchive.it/ilrmoo/R2i_has_derivative
:R2i_has_derivative rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://erlangen-crm.org/211015/P130i_features_are_also_found_on> ;
                    rdfs:domain :F1_Work ;
                    rdfs:range :F1_Work ;
                    rdfs:label "R2i has derivative"@en .


###  http://imagoarchive.it/ilrmoo/R30_reproduced_publication
:R30_reproduced_publication rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf <http://erlangen-crm.org/211015/P16_used_specific_object> ;
                            owl:inverseOf :R30i_was_publication_reproduced_by ;
                            rdfs:domain :F33_Reproduction_Event ;
                            rdfs:range :F3_Manifestation ;
                            rdfs:comment "This property associates an instance of F33 Reproduction Event with an instance of F3 Manifestation it reproduces."@en ;
                            rdfs:label "R30 reproduced publication"@en .


###  http://imagoarchive.it/ilrmoo/R30i_was_publication_reproduced_by
:R30i_was_publication_reproduced_by rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf <http://erlangen-crm.org/211015/P16i_was_used_for> ;
                                    rdfs:domain :F3_Manifestation ;
                                    rdfs:range :F33_Reproduction_Event ;
                                    rdfs:label "R30i was publication reproduced by"@en .


###  http://imagoarchive.it/ilrmoo/R34_has_validity_period
:R34_has_validity_period rdf:type owl:ObjectProperty ;
                         owl:inverseOf :R34i_is_validity_period_of ;
                         rdfs:domain :F34_Controlled_Vocabulary ;
                         rdfs:range <http://erlangen-crm.org/211015/E52_Time-Span> ;
                         rdfs:comment "This property associates an instance of F34 Controlled Vocabulary with the instance of E52 Time-Span describing the period for which the particular expression of the controlled vocabulary was regarded as valid by its maintainers. Each change of validity status of a nomen within the controlled vocabulary should be associated with a release change of the controlled vocabulary. The individual time-span of a validity state of a nomen would be the union of the time-spans of the controlled vocabulary in which the nomen was declared to have the particular validity status (provisional, accepted, obsolete, etc.)"@en ;
                         rdfs:label "R34 has validity period"@en .


