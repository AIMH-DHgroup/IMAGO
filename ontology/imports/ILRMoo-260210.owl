                    owl:inverseOf :R68i_is_inspiration_for ;
                    rdfs:domain :F1_Work ;
                    rdfs:range :F1_Work ;
                    rdfs:comment "This property associates an instance of F1 Work with another instance of F1 Work whose content was inspired by that instance of F1 Work. The content of the range work instance served in some way as a source of ideas for the domain work instance. Neither instance of F1 Work may be a part of the other."@en ;
                    rdfs:label "R68 is inspired by"@en .


