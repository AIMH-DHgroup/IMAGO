<http://imagoarchive.it/thes/tid/> rdf:type owl:Ontology ;
                                    owl:versionIRI <http://imagoarchive.it/thes/tid/1.0.1/> ;
                                    dcterms:audience "Researchers, data curators, digital humanities scholars, cultural heritage institutions, and ontology engineers working on genre classification and semantic modelling of historical textual sources." ;
                                    dcterms:conformsTo "SKOS (Simple Knowledge Organization System)" ;
                                    dcterms:contributor <https://www.isti.cnr.it/it/chi-siamo/people-detail/909/Emanuele_Lenzi> ,
                                                        "Luca Ruggio" ,
                                                        "Paolo Pontari" ;
                                    dcterms:creator <https://www.isti.cnr.it/en/about/people-detail/38/Valentina_Bartalesi_Lenzi> ,
                                                    <https://www.isti.cnr.it/en/about/people-detail/820/Nicol%C3%B2_Pratelli> ;
                                    dcterms:description """The IMAGO Thesaurus of Genres (TID) provides a controlled vocabulary 
                                     for describing literary genres represented in Middle Ages and Renaissance 
                                     manuscripts and printed editions within the IMAGO project. The thesaurus supports 
                                     semantic annotation, indexing, and interoperability of genre classifications 
                                     in digital humanities and cultural heritage datasets."""@en ;
                                    dcterms:issued "2021-07-12" ;
                                    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
                                    dcterms:modified "2026-02-16" ;
                                    dcterms:publisher <https://www.isti.cnr.it/> ;
                                    dcterms:rightsHolder <https://www.isti.cnr.it/> ;
                                    dcterms:subject "Literary genres"@en ;
                                    dcterms:title "IMAGO Thesaurus of Genres (TID)"@en ;
                                    vann:preferredNamespacePrefix "tid" ;
                                    rdfs:comment """The TID thesaurus models genre concepts as SKOS concepts 
                                     organised in hierarchical and associative structures. It enables 
                                     semantic interoperability across manuscript catalogues, bibliographic 
                                     datasets, and image-based representations described in the IMAGO ontology."""@en ;
                                    owl:versionInfo "1.0.0"@en ;
                                    prov:wasGeneratedBy "Developed within the IMAGO project following ontology engineering best practices and alignment with the IMAGO Ontology and CIDOC-CRM compatible models." ;
                                    foaf:homepage <https://imagoarchive.it/documentation/doc/index-en.html> .

