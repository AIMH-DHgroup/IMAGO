<http://imagoarchive.it/thes/tid/> rdf:type owl:Ontology ;
                                    <http://purl.org/dc/elements/1.1/description> "Il Thesaurus Geografico è lo strumento utilizzabile nell'indicizzazione dei generi geografici per l'ontologia Imago, realizzato a cura del gruppo di Digital Humanities del laboratorio AIMH dell'ISTI-CNR."@it ;
                                    <http://purl.org/dc/elements/1.1/format> "text/xml" ;
                                    <http://purl.org/dc/elements/1.1/identifier> <http://imagoarchive.it/thes/tid/> ;
                                    <http://purl.org/dc/elements/1.1/language> "it-IT" ;
                                    <http://purl.org/dc/elements/1.1/title> "Thesaurus Geografico Medioevale"@it ;
                                    <http://purl.org/dc/terms/audience> "Researchers, data curators, digital humanities scholars, cultural heritage institutions, and ontology engineers working on genre classification and semantic modelling of historical textual sources." ;
                                    <http://purl.org/dc/terms/conformsTo> "RDF (http://www.w3.org/TR/rdf-syntax-grammar/)" ,
                                                                          "SKOS (Simple Knowledge Organization System)" ,
                                                                          "SKOS (http://www.w3.org/TR/skos-reference/)" ;
                                    <http://purl.org/dc/terms/contributor> <https://www.isti.cnr.it/it/chi-siamo/people-detail/909/Emanuele_Lenzi> ,
                                                                           "Luca Ruggio" ,
                                                                           "Paolo Pontari" ;
                                    <http://purl.org/dc/terms/created> "2022-02-14" ;
                                    <http://purl.org/dc/terms/creator> <https://www.isti.cnr.it/en/about/people-detail/38/Valentina_Bartalesi_Lenzi> ,
                                                                       <https://www.isti.cnr.it/en/about/people-detail/820/Nicol%C3%B2_Pratelli> ;
                                    <http://purl.org/dc/terms/description> """The IMAGO Thesaurus of Genres (TID) provides a controlled vocabulary 
                                     for describing literary genres represented in Middle Ages and Renaissance 
                                     manuscripts and printed editions within the IMAGO project. The thesaurus supports 
                                     semantic annotation, indexing, and interoperability of genre classifications 
                                     in digital humanities and cultural heritage datasets."""@en ;
                                    <http://purl.org/dc/terms/issued> "2021-07-12" ,
                                                                      "2022-03-01" ;
                                    <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by-nc/4.0/> ,
                                                                       "http://creativecommons.org/licenses/by/2.5/it/deed.it" ;
                                    <http://purl.org/dc/terms/modified> "2026-02-16" ;
                                    <http://purl.org/dc/terms/publisher> <https://www.isti.cnr.it/> ;
                                    <http://purl.org/dc/terms/rightsHolder> <https://www.isti.cnr.it/> ,
                                                                            "ISTI - CNR" ;
                                    <http://purl.org/dc/terms/subject> "Literary genres"@en ;
                                    <http://purl.org/dc/terms/title> "IMAGO Thesaurus of Genres (TID)"@en ;
                                    <http://purl.org/vocab/vann/preferredNamespacePrefix> "tid" ;
                                    rdfs:comment """The TID thesaurus models genre concepts as SKOS concepts 
                                     organised in hierarchical and associative structures. It enables 
                                     semantic interoperability across manuscript catalogues, bibliographic 
                                     datasets, and image-based representations described in the IMAGO ontology."""@en ;
                                    rdfs:label "Imago Genre Thesaurus"@en ;
                                    owl:versionInfo "1.0.0"@en ;
                                    <http://www.w3.org/2004/02/skos/core#hasTopConcept> <https://imagoarchive.it/thes/tid/1000> ;
                                    <http://www.w3.org/ns/prov#wasGeneratedBy> "Developed within the IMAGO project following ontology engineering best practices and alignment with the IMAGO Ontology and CIDOC-CRM compatible models." ;
                                    <http://xmlns.com/foaf/0.1/homepage> <https://imagoarchive.it/documentation/doc/index-en.html> .

