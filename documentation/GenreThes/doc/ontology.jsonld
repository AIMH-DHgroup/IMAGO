[ {
  "@id" : "http://imagoarchive.it/thes/tid/",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "it",
    "@value" : "Il Thesaurus Geografico è lo strumento utilizzabile nell'indicizzazione dei generi geografici per l'ontologia Imago, realizzato a cura del gruppo di Digital Humanities del laboratorio AIMH dell'ISTI-CNR."
  } ],
  "http://purl.org/dc/elements/1.1/format" : [ {
    "@value" : "text/xml"
  } ],
  "http://purl.org/dc/elements/1.1/identifier" : [ {
    "@id" : "http://imagoarchive.it/thes/tid/"
  } ],
  "http://purl.org/dc/elements/1.1/language" : [ {
    "@value" : "it-IT"
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "it",
    "@value" : "Thesaurus Geografico Medioevale"
  } ],
  "http://purl.org/dc/terms/audience" : [ {
    "@value" : "Researchers, data curators, digital humanities scholars, cultural heritage institutions, and ontology engineers working on genre classification and semantic modelling of historical textual sources."
  } ],
  "http://purl.org/dc/terms/conformsTo" : [ {
    "@value" : "RDF (http://www.w3.org/TR/rdf-syntax-grammar/)"
  }, {
    "@value" : "SKOS (Simple Knowledge Organization System)"
  }, {
    "@value" : "SKOS (http://www.w3.org/TR/skos-reference/)"
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@id" : "https://www.isti.cnr.it/it/chi-siamo/people-detail/909/Emanuele_Lenzi"
  }, {
    "@value" : "Luca Ruggio"
  }, {
    "@value" : "Paolo Pontari"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@value" : "2022-02-14"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "https://www.isti.cnr.it/en/about/people-detail/38/Valentina_Bartalesi_Lenzi"
  }, {
    "@id" : "https://www.isti.cnr.it/en/about/people-detail/820/Nicol%C3%B2_Pratelli"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "The IMAGO Thesaurus of Genres (TID) provides a controlled vocabulary \n                                     for describing literary genres represented in Middle Ages and Renaissance \n                                     manuscripts and printed editions within the IMAGO project. The thesaurus supports \n                                     semantic annotation, indexing, and interoperability of genre classifications \n                                     in digital humanities and cultural heritage datasets."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@value" : "2021-07-12"
  }, {
    "@value" : "2022-03-01"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by-nc/4.0/"
  }, {
    "@value" : "http://creativecommons.org/licenses/by/2.5/it/deed.it"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@value" : "2026-02-16"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@id" : "https://www.isti.cnr.it/"
  } ],
  "http://purl.org/dc/terms/rightsHolder" : [ {
    "@id" : "https://www.isti.cnr.it/"
  }, {
    "@value" : "ISTI - CNR"
  } ],
  "http://purl.org/dc/terms/subject" : [ {
    "@language" : "en",
    "@value" : "Literary genres"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "IMAGO Thesaurus of Genres (TID)"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "tid"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The TID thesaurus models genre concepts as SKOS concepts \n                                     organised in hierarchical and associative structures. It enables \n                                     semantic interoperability across manuscript catalogues, bibliographic \n                                     datasets, and image-based representations described in the IMAGO ontology."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Imago Genre Thesaurus"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@language" : "en",
    "@value" : "1.0.0"
  } ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept" : [ {
    "@id" : "https://imagoarchive.it/thes/tid/1000"
  } ],
  "http://www.w3.org/ns/prov#wasGeneratedBy" : [ {
    "@value" : "Developed within the IMAGO project following ontology engineering best practices and alignment with the IMAGO Ontology and CIDOC-CRM compatible models."
  } ],
  "http://xmlns.com/foaf/0.1/homepage" : [ {
    "@id" : "https://imagoarchive.it/documentation/doc/index-en.html"
  } ]
